<Project>
  <PropertyGroup>
    <!-- DataGrid is released independently of the Avalonia package family. -->
    <AvaloniaDataGridVersion>12.1.2</AvaloniaDataGridVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Avalonia.Controls.DataGrid" Version="[$(AvaloniaDataGridVersion)]" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)build\WindowsAutomation.targets" />
</Project>
