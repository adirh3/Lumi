<Project>
  <PropertyGroup>
    <!-- Only the core package carries the local text fixes; peer packages stay on AvaloniaVersion. -->
    <AvaloniaCoreVersion>12.1.3.1</AvaloniaCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Avalonia" Version="[$(AvaloniaCoreVersion)]" />
  </ItemGroup>
</Project>
