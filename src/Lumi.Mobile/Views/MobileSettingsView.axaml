<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:layout="using:Lumi.Mobile.Layout"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             x:Class="Lumi.Mobile.Views.MobileSettingsView"
             x:DataType="vm:MobileShellViewModel"
             FlowDirection="{x:Static loc:ChatSessionStrings.UiFlowDirection}"
             Background="{DynamicResource Brush.Surface0}">

  <Panel>
  <!--
    Settings as the desktop lays it out: its pages listed under the PC this phone belongs to, and
    the open page beside the list when there is room. A phone shows the list, then one page.
  -->
  <layout:ListDetailPanel x:Name="SettingsPanes"
                          IsTwoPane="{Binding IsTwoPane}"
                          ListWidth="{Binding ListPaneWidth}"
                          IsDetailOpen="{Binding ShowSettingsDetail}">

  <!-- ═══ The list of pages ═══ -->
  <Grid x:Name="SettingsListPane" RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource Brush.NavigationSurface}">
    <Panel x:Name="SettingsHeaderChrome" Grid.Row="0" ZIndex="1" Background="Transparent">
    <Panel Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
      <sc:StrataBackdropBlur Classes="chrome-frost" Fade="Bottom"
                             FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
      <Border Background="{DynamicResource Brush.PageEdgeTop}" />
    </Panel>
    <Border x:Name="SettingsTopInset" Padding="{Binding SafeAreaTop}">
      <Border x:Name="SettingsHeaderSideInset" Padding="{Binding SafeAreaSides}">
        <Grid x:Name="SettingsHeaderLayout"
              RowDefinitions="Auto,Auto"
              MinHeight="{DynamicResource Touch.MinTarget}"
              MaxWidth="620"
              HorizontalAlignment="Stretch"
              Margin="{DynamicResource Mobile.Page.HeaderMargin}">
          <TextBlock x:Name="SettingsTitle" Text="{loc:Str Settings}" Classes="place-title" />
          <views:WebAppUpdateBannerView x:Name="SettingsUpdateBanner" Grid.Row="1" />
        </Grid>
      </Border>
    </Border>
    </Panel>

    <!-- The list runs under the floating header and places; ScrollEdgeChrome keeps it clear of both at rest. -->
    <Border x:Name="SettingsListInset" Grid.Row="0" Grid.RowSpan="3">
      <Border x:Name="SettingsContentSideInset" Padding="{Binding SafeAreaSides}">
        <ScrollViewer x:Name="SettingsScroll" Classes="mobile-scroll"
                      behaviors:ScrollEdgeChrome.Header="{Binding #SettingsHeaderChrome}"
                      behaviors:ScrollEdgeChrome.Footer="{Binding #SettingsFooterChrome}">
          <Border x:Name="SettingsScrollInset">
          <StackPanel x:Name="SettingsContent"
                      Spacing="12"
                      MaxWidth="620"
                      HorizontalAlignment="Stretch"
                      Margin="16,4,16,24">

            <!-- You and the PC this phone belongs to, as the desktop's Settings opens with your profile. -->
            <Border x:Name="SettingsConnectionCard" Classes="group-card">
              <StackPanel>
                <Button x:Name="SettingsProfileRow" Classes="list-row"
                        IsVisible="{Binding UserName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        AutomationProperties.Name="{Binding UserName, StringFormat={loc:Str ProfileNamed}}"
                        Command="{Binding ShowMemoriesCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.AccentSelection}">
                      <TextBlock Text="{Binding UserInitial}" FontSize="{DynamicResource Font.SizeBody}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.AccentText}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding UserName}" Classes="row-title" />
                      <TextBlock Text="{Binding Library.MemoryCountLabel, StringFormat={loc:Str ProfileMemories}}" Classes="row-meta" />
                    </StackPanel>
                    <PathIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                  </Grid>
                </Button>
                <Panel>
                  <Border Classes="row-divider"
                          IsVisible="{Binding UserName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Button x:Name="SettingsConnectionRow" Classes="list-row"
                          Classes.selected="{Binding IsConnectionSectionVisible}"
                          AutomationProperties.Name="{Binding HostName, StringFormat={loc:Str ConnectionNamed}}"
                          Command="{Binding OpenSettingsSectionCommand}" CommandParameter="Connection">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="row-tile">
                        <PathIcon Data="{DynamicResource Mobile.Icon.Monitor}" Foreground="{DynamicResource Brush.Hue.Connector}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HostName}" Classes="row-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border x:Name="SettingsConnectionDot" Classes="status-dot" Classes.live="{Binding IsLive}" />
                          <TextBlock Text="{Binding ConnectionStateLabel}" Classes="row-meta" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <PathIcon Grid.Column="2" Classes="row-chevron" IsVisible="{Binding IsSinglePane}"
                                Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                    </Grid>
                  </Button>
                </Panel>
              </StackPanel>
            </Border>

            <Border x:Name="SettingsPagesCard" Classes="group-card">
              <StackPanel>
                <Button x:Name="SettingsMemoriesRow" Classes="list-row"
                        AutomationProperties.Name="{loc:Str Memories}"
                        Command="{Binding ShowMemoriesCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Border Classes="row-tile">
                      <PathIcon Data="{DynamicResource Mobile.Icon.Memory}" Foreground="{DynamicResource Brush.Hue.Memory}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{loc:Str Memories}" Classes="row-title" />
                    <TextBlock Grid.Column="2" Text="{Binding Library.MemoryCount}" Classes="row-value" />
                    <PathIcon Grid.Column="3" Classes="row-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                  </Grid>
                </Button>
                <Panel>
                  <Border Classes="row-divider" />
                  <Button x:Name="SettingsAppearanceRow" Classes="list-row"
                          Classes.selected="{Binding IsAppearanceSectionVisible}"
                          AutomationProperties.Name="{loc:Str Appearance}"
                          Command="{Binding OpenSettingsSectionCommand}" CommandParameter="Appearance">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                      <Border Classes="row-tile">
                        <PathIcon Data="{DynamicResource Mobile.Icon.Palette}" Foreground="{DynamicResource Brush.Hue.Appearance}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{loc:Str Appearance}" Classes="row-title" />
                      <TextBlock Grid.Column="2" Text="{Binding ThemeLabel}" Classes="row-value" />
                      <PathIcon Grid.Column="3" Classes="row-chevron" IsVisible="{Binding IsSinglePane}"
                                Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                    </Grid>
                  </Button>
                </Panel>
                <Panel>
                  <Border Classes="row-divider" />
                  <Button x:Name="SettingsAboutRow" Classes="list-row"
                          Classes.selected="{Binding IsAboutSectionVisible}"
                          AutomationProperties.Name="{loc:Str About}"
                          Command="{Binding OpenSettingsSectionCommand}" CommandParameter="About">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                      <Border Classes="row-tile">
                        <PathIcon Data="{DynamicResource Mobile.Icon.Info}" Foreground="{DynamicResource Brush.Hue.About}" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{loc:Str About}" Classes="row-title" />
                      <TextBlock Grid.Column="2" Text="{Binding AppVersion}" Classes="row-value" />
                      <PathIcon Grid.Column="3" Classes="row-chevron" IsVisible="{Binding IsSinglePane}"
                                Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                    </Grid>
                  </Button>
                </Panel>
              </StackPanel>
            </Border>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- The places stay centred in the thumb zone while the list scrolls underneath, as on Chats. -->
    <Panel x:Name="SettingsFooterChrome" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom"
           ZIndex="1" Background="Transparent">
      <Border x:Name="SettingsBottomInset" Padding="{Binding SafeAreaBottom}">
        <Border Padding="{Binding SafeAreaSides}">
          <views:PlacesBarView x:Name="SettingsPlaces"
                               IsVisible="{Binding !IsKeyboardOpen}"
                               Margin="12,8,12,12" />
        </Border>
      </Border>
    </Panel>
  </Grid>

  <!-- ═══ The open page ═══ -->
  <Grid x:Name="SettingsDetailPane" RowDefinitions="Auto,*"
        Background="{DynamicResource Brush.ChatCanvas}">
    <Panel x:Name="SettingsDetailHeaderChrome" Grid.Row="0" ZIndex="1" Background="Transparent">
    <Panel Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
      <sc:StrataBackdropBlur Classes="chrome-frost" Fade="Bottom"
                             FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
      <Border Background="{DynamicResource Brush.PageEdgeTop}" />
    </Panel>
    <Border x:Name="SettingsDetailTopInset" Padding="{Binding SafeAreaTop}">
      <Border x:Name="SettingsDetailHeaderSideInset" Padding="{Binding SafeAreaSides}">
        <Grid x:Name="SettingsDetailHeaderLayout"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              MinHeight="{DynamicResource Touch.MinTarget}"
              MaxWidth="620"
              HorizontalAlignment="Stretch"
              Margin="{DynamicResource Mobile.Page.HeaderMargin}">
          <Button x:Name="SettingsBackButton" Grid.Column="0" Classes="chat-header-action floating-action"
                  IsVisible="{Binding IsSinglePane}"
                  AutomationProperties.Name="{loc:Str BackToSettings}"
                  Command="{Binding GoBackCommand}">
            <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                      Data="{DynamicResource Mobile.Icon.Back}" />
          </Button>
          <TextBlock x:Name="SettingsDetailTitle" Grid.Column="1" Text="{Binding SettingsDetailTitle}"
                     Classes="section-title" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Border>
    </Panel>

    <Border x:Name="SettingsDetailBottomInset" Grid.Row="0" Grid.RowSpan="2" Padding="{Binding SafeAreaBottom}">
      <Border x:Name="SettingsDetailSideInset" Padding="{Binding SafeAreaSides}">
        <ScrollViewer x:Name="SettingsDetailScroll" Classes="mobile-scroll"
                      behaviors:ScrollEdgeChrome.Header="{Binding #SettingsDetailHeaderChrome}">
          <Border x:Name="SettingsDetailScrollInset">
          <StackPanel x:Name="SettingsDetailContent"
                      Spacing="16"
                      MaxWidth="620"
                      HorizontalAlignment="Stretch"
                      Margin="{DynamicResource Mobile.Page.FormContentMargin}">

            <sc:StrataSettingGroup x:Name="AppearanceSettings" Header="{loc:Str Theme}" Classes="mobile"
                                   IsVisible="{Binding IsAppearanceSectionVisible}">
              <!-- Three-way rather than a dark switch: "match my phone" is what most people want, and on
                   Android the OS flips it on a schedule the app has no other way to follow. -->
              <sc:StrataSetting Header="{loc:Str LightOrDark}" Classes="mobile stacked"
                                Description="{loc:Str ThemeDescription}">
                <Grid x:Name="ThemeOptions" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" x:Name="ThemeSystemButton" Classes="theme-option"
                          Classes.selected="{Binding IsSystemTheme}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="System"
                          Content="{loc:Str System}" />
                  <Button Grid.Column="1" x:Name="ThemeLightButton" Classes="theme-option"
                          Classes.selected="{Binding IsLightTheme}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="Light"
                          Content="{loc:Str Light}" />
                  <Button Grid.Column="2" x:Name="ThemeDarkButton" Classes="theme-option"
                          Classes.selected="{Binding IsDarkTheme}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="Dark"
                          Content="{loc:Str Dark}" />
                </Grid>
              </sc:StrataSetting>
            </sc:StrataSettingGroup>

            <sc:StrataSettingGroup Header="{loc:Str Language}" Classes="mobile"
                                   IsVisible="{Binding IsAppearanceSectionVisible}">
              <sc:StrataSetting Header="{loc:Str Language}" Classes="mobile stacked"
                                Description="{loc:Str LanguageDescription}">
                <StackPanel Spacing="10">
                  <sc:StrataComboBox x:Name="SettingsLanguagePicker" FlowDirection="LeftToRight"
                                     ItemsSource="{Binding LanguageOptions}"
                                     SelectedItem="{Binding SelectedLanguageName, Mode=TwoWay}"
                                     MinHeight="{DynamicResource Touch.MinTarget}"
                                     AutomationProperties.Name="{loc:Str Language}">
                    <sc:StrataComboBox.Styles>
                      <Style Selector="sc|StrataComboBox#SettingsLanguagePicker /template/ Popup#PART_Popup">
                        <Setter Property="ShouldUseOverlayLayer" Value="True" />
                      </Style>
                      <Style Selector="sc|StrataComboBoxItem">
                        <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
                      </Style>
                    </sc:StrataComboBox.Styles>
                  </sc:StrataComboBox>
                  <TextBlock Text="{loc:Str LanguageRestart}" Classes="supporting" TextWrapping="Wrap"
                             IsVisible="{Binding LanguageRestartRequired}" />
                </StackPanel>
              </sc:StrataSetting>
            </sc:StrataSettingGroup>

            <StackPanel x:Name="ConnectionSettings" Spacing="16"
                        IsVisible="{Binding IsConnectionSectionVisible}">
              <sc:StrataSettingGroup Header="{loc:Str ThisConnection}" Classes="mobile">
                <sc:StrataSetting Header="{loc:Str Pc}" Classes="mobile" Description="{Binding HostName}" />
                <sc:StrataSetting Header="{loc:Str Status}" Classes="mobile" Description="{Binding ConnectionStateLabel}" />
                <sc:StrataSetting Header="{loc:Str ThisDevice}" Classes="mobile" Description="{Binding DeviceName}" />
                <sc:StrataSetting Header="{loc:Str RefreshConnection}" Classes="mobile stacked"
                                  Description="{loc:Str RefreshConnectionHelp}">
                  <Button x:Name="RefreshButton" Classes="touch open-action"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding RefreshCommand}">
                    <TextBlock Text="{loc:Str Refresh}" Foreground="{Binding $parent[Button].Foreground}" />
                  </Button>
                </sc:StrataSetting>
                <sc:StrataSetting x:Name="ConnectionActivitySetting" Header="{loc:Str ConnectionActivity}" Classes="mobile"
                                  IsVisible="{Binding ConnectionDiagnostics, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                  Description="{Binding ConnectionDiagnostics}" />
                <sc:StrataSetting x:Name="ReloadWebAppSetting" Header="{loc:Str BrowserSignIn}" Classes="mobile stacked"
                                  IsVisible="{Binding CanReloadWebApp}"
                                  Description="{loc:Str BrowserSignInHelp}">
                  <Button x:Name="ReloadWebAppButton" Classes="touch open-action"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Content="{loc:Str ReloadWebApp}"
                          Command="{Binding ReloadWebAppCommand}" />
                </sc:StrataSetting>
              </sc:StrataSettingGroup>

              <TextBlock Text="{Binding ConnectionMessage}" Classes="supporting"
                         IsVisible="{Binding ConnectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <StackPanel Spacing="8">
                <Button x:Name="ForgetButton" Classes="touch subtle"
                        Foreground="{DynamicResource Brush.DangerDefault}"
                        Content="{loc:Str DisconnectPc}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenDisconnectConfirmationCommand}" />
                <TextBlock Text="{loc:Str ChatsStayOnPc}" Classes="muted"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <sc:StrataSettingGroup x:Name="AboutSettings" Header="Lumi" Classes="mobile"
                                   IsVisible="{Binding IsAboutSectionVisible}">
              <sc:StrataSetting Header="{loc:Str AppVersion}" Classes="mobile" Description="{Binding AppVersion}" />
              <sc:StrataSetting Header="{loc:Str YourAssistant}" Classes="mobile"
                                Description="{loc:Str AboutDescription}" />
            </sc:StrataSettingGroup>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- The same quiet edge the chat keeps beside its list. -->
    <Border x:Name="SettingsPaneSeparation" Grid.RowSpan="2"
            Width="1" HorizontalAlignment="Left" IsHitTestVisible="False"
            IsVisible="{Binding IsTwoPane}"
            Background="{DynamicResource Brush.ChatPaneSeparation}"
            BoxShadow="{DynamicResource Shadow.ChatPaneSeparation}" />
  </Grid>
  </layout:ListDetailPanel>

  <sc:StrataBottomSheet x:Name="DisconnectSheet" Classes="safe-area"
                        IsOpen="{Binding IsDisconnectConfirmationOpen, Mode=TwoWay}"
                        Title="{loc:Str DisconnectQuestion}"
                        Description="{loc:Str DisconnectDescription}">
    <Border>
      <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,0,16,8" Spacing="10">
          <Border Classes="sheet-card" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" />
              <TextBlock Grid.Column="1" Text="{Binding HostName}" FontWeight="Medium"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Button x:Name="ConfirmDisconnectButton" Classes="sheet-action destructive"
                  Content="{loc:Str DisconnectRevoke}"
                  Command="{Binding ForgetPcCommand}" />
          <Button x:Name="CancelDisconnectButton" Classes="sheet-action" Content="{loc:Str KeepConnected}"
                  Command="{Binding CancelDisconnectCommand}" />
          <TextBlock Text="{Binding ConnectionMessage}" Classes="sheet-body" Margin="8,4"
                     IsVisible="{Binding ConnectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <StackPanel Spacing="2" Margin="8,0">
              <TextBlock Text="{loc:Str CantReachPcQuestion}" FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeMeta}" />
              <TextBlock Text="{loc:Str RemoveLocalConnectionHelp}"
                         Classes="sheet-body" FontSize="{DynamicResource Font.SizeMeta}" LineHeight="{DynamicResource Font.LineHeightMeta}" />
            </StackPanel>
            <Button x:Name="ForgetLocalButton" Classes="sheet-action" Content="{loc:Str RemoveLocalConnection}"
                    IsEnabled="{Binding !ForgetPcCommand.IsRunning}"
                    Command="{Binding ForgetPcLocallyCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </sc:StrataBottomSheet>
  </Panel>
</UserControl>
