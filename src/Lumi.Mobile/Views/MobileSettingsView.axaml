<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             x:Class="Lumi.Mobile.Views.MobileSettingsView"
             x:DataType="vm:MobileShellViewModel"
             Background="{DynamicResource Brush.Surface0}">

  <Panel>
  <Grid RowDefinitions="Auto,*">
    <Panel x:Name="SettingsHeaderChrome" Grid.Row="0" ZIndex="1" Background="Transparent">
    <Panel Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
      <sc:StrataBackdropBlur Classes="chrome-frost" Fade="Bottom"
                             FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
      <Border Background="{DynamicResource Brush.PageEdgeTop}" />
    </Panel>
    <Border x:Name="SettingsTopInset" Padding="{Binding SafeAreaTop}">
      <Border x:Name="SettingsHeaderSideInset" Padding="{Binding SafeAreaSides}">
        <Grid x:Name="SettingsHeaderLayout"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              MaxWidth="620"
              HorizontalAlignment="Stretch"
              Margin="{DynamicResource Mobile.Page.HeaderMargin}">
          <Button x:Name="SettingsBackButton" Grid.Column="0" Classes="page-back"
                  AutomationProperties.Name="Back to chat"
                  Command="{Binding GoBackCommand}">
            <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          </Button>
          <TextBlock Grid.Column="1" Text="Settings" Classes="section-title"
                     VerticalAlignment="Center" />
          <views:WebAppUpdateBannerView x:Name="SettingsUpdateBanner"
                                        Grid.Row="1" Grid.ColumnSpan="2" />
        </Grid>
      </Border>
    </Border>
    </Panel>

    <!-- Settings run under the floating header; ScrollEdgeChrome keeps them clear of it at rest. -->
    <Border x:Name="SettingsBottomInset" Grid.Row="0" Grid.RowSpan="2" Padding="{Binding SafeAreaBottom}">
      <Border x:Name="SettingsContentSideInset" Padding="{Binding SafeAreaSides}">
        <ScrollViewer x:Name="SettingsScroll" Classes="mobile-scroll"
                      behaviors:ScrollEdgeChrome.Header="{Binding #SettingsHeaderChrome}">
          <Border x:Name="SettingsScrollInset">
          <StackPanel x:Name="SettingsContent"
                      Spacing="16"
                      MaxWidth="620"
                      HorizontalAlignment="Stretch"
                      Margin="{DynamicResource Mobile.Page.FormContentMargin}">

            <!-- Connection identity stays on the same canvas as the settings below. -->
            <Border x:Name="SettingsConnectionCard" Classes="mobile-card" Padding="14">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                  <PathIcon Width="24" Height="24"
                            Foreground="{DynamicResource Brush.AccentDefault}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M3 4h18v12H3V4zm2 2v8h14V6H5zm3 12h8v2H8v-2z" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding HostName}" FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeSubtitle}"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <sc:StrataPulse Width="9" Height="9" VerticalAlignment="Center"
                                    IsLive="{Binding IsLive}" />
                    <TextBlock Text="{Binding ConnectionStateLabel}" Classes="supporting"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <sc:StrataSettingGroup Header="Appearance" Classes="mobile">
              <!-- Three-way rather than a dark switch: "match my phone" is what most people want, and on
                   Android the OS flips it on a schedule the app has no other way to follow. -->
              <sc:StrataSetting Header="Theme" Classes="mobile stacked"
                                Description="Choose a look, or match your phone.">
                <Grid x:Name="ThemeOptions" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" x:Name="ThemeSystemButton" Classes="theme-option"
                          Classes.selected="{Binding IsSystemTheme}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="System"
                          Content="System" />
                  <Button Grid.Column="1" x:Name="ThemeLightButton" Classes="theme-option"
                          Classes.selected="{Binding IsLightTheme}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="Light"
                          Content="Light" />
                  <Button Grid.Column="2" x:Name="ThemeDarkButton" Classes="theme-option"
                          Classes.selected="{Binding IsDarkTheme}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="Dark"
                          Content="Dark" />
                </Grid>
              </sc:StrataSetting>
            </sc:StrataSettingGroup>

            <sc:StrataSettingGroup Header="Connection" Classes="mobile">
              <sc:StrataSetting Header="This device" Classes="mobile" Description="{Binding DeviceName}" />
              <sc:StrataSetting Header="Refresh connection" Classes="mobile stacked"
                                Description="Bring your chats and library up to date.">
                <Button x:Name="RefreshButton" Classes="touch open-action"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding RefreshCommand}">
                  <TextBlock Text="Refresh" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
              </sc:StrataSetting>
              <sc:StrataSetting x:Name="ReloadWebAppSetting" Header="Browser sign-in" Classes="mobile stacked"
                                IsVisible="{Binding CanReloadWebApp}"
                                Description="Reload through your browser if sign-in has expired. Pairing is kept; unsent text is not.">
                <Button x:Name="ReloadWebAppButton" Classes="touch open-action"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="Reload web app"
                        Command="{Binding ReloadWebAppCommand}" />
              </sc:StrataSetting>
              <sc:StrataSetting Header="App version" Classes="mobile" Description="{Binding AppVersion}" />
            </sc:StrataSettingGroup>

            <TextBlock Text="{Binding ConnectionMessage}" Classes="supporting"
                       IsVisible="{Binding ConnectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="8">
              <Button x:Name="ForgetButton" Classes="touch subtle"
                      Foreground="{DynamicResource Brush.DangerDefault}"
                      Content="Disconnect from this PC"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding OpenDisconnectConfirmationCommand}" />
              <TextBlock Text="Your chats and files stay on your PC." Classes="muted"
                         HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding UserName, StringFormat='Connected as {0}'}" Classes="muted"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding UserName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>

  <sc:StrataBottomSheet x:Name="DisconnectSheet" Classes="safe-area"
                        IsOpen="{Binding IsDisconnectConfirmationOpen, Mode=TwoWay}"
                        Title="Disconnect from this PC?"
                        Description="This phone loses access and returns to setup. Your chats and files stay on the PC.">
    <Border>
      <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,0,16,8" Spacing="10">
          <Border Classes="sheet-card" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" />
              <TextBlock Grid.Column="1" Text="{Binding HostName}" FontWeight="Medium"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Button x:Name="ConfirmDisconnectButton" Classes="sheet-action destructive"
                  Content="Disconnect and revoke access"
                  Command="{Binding ForgetPcCommand}" />
          <Button x:Name="CancelDisconnectButton" Classes="sheet-action" Content="Keep connected"
                  Command="{Binding CancelDisconnectCommand}" />
          <TextBlock Text="{Binding ConnectionMessage}" Classes="sheet-body" Margin="8,4"
                     IsVisible="{Binding ConnectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <StackPanel Spacing="2" Margin="8,0">
              <TextBlock Text="Can't reach your PC?" FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeMeta}" />
              <TextBlock Text="Remove the saved connection from this phone only. Its access on the PC stays active."
                         Classes="sheet-body" FontSize="{DynamicResource Font.SizeMeta}" LineHeight="20" />
            </StackPanel>
            <Button x:Name="ForgetLocalButton" Classes="sheet-action" Content="Remove from this phone only"
                    IsEnabled="{Binding !ForgetPcCommand.IsRunning}"
                    Command="{Binding ForgetPcLocallyCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </sc:StrataBottomSheet>
  </Panel>
</UserControl>
