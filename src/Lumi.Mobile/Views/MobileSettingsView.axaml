<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:layout="using:Lumi.Mobile.Layout"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             x:Class="Lumi.Mobile.Views.MobileSettingsView"
             x:DataType="vm:MobileShellViewModel"
             FlowDirection="{x:Static loc:ChatSessionStrings.UiFlowDirection}"
             Background="{DynamicResource Brush.Surface0}">

  <UserControl.Styles>
    <!-- ══ The list ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- You at the top, as the desktop's Settings opens with your profile: your initial on the accent
         gradient, with a breath of it behind you, so the palette you pick shows here too. -->
    <Style Selector="Button.list-row.profile-row">
      <Setter Property="Padding" Value="14,14" />
      <Setter Property="MinHeight" Value="80" />
    </Style>
    <Style Selector="Border.profile-avatar">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.profile-avatar TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.profile-name">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.profile-glow">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
      <Setter Property="Opacity" Value="0.16" />
      <Setter Property="OpacityMask">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="#FF000000" />
          <GradientStop Offset="0.8" Color="#00000000" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <!-- Dividers start where a row's words do, so the icons read as one column. -->
    <Style Selector="Border.row-divider.inset">
      <Setter Property="Margin" Value="62,0,0,0" />
    </Style>
    <!-- The accent you chose, as a dot before the look's summary. -->
    <Style Selector="Ellipse.accent-dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ A page ═════════════════════════════════════════════════════════════════════════════ -->

    <!-- A page's own identity on top: the PC it talks to, or Lumi itself. -->
    <Style Selector="Border.hero-card">
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.row-tile.hero-tile">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.row-tile.hero-tile PathIcon">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="TextBlock.hero-title">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeSubtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A section's name over its card, with what is chosen at its far end. -->
    <Style Selector="TextBlock.section-value">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.section-footnote">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="LineHeight" Value="{DynamicResource Font.LineHeightMeta}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="6,8,6,0" />
    </Style>
    <Style Selector="Border.appearance-card">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.segment-track.settings-track">
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ══ Live preview: a small chat drawn from the live tokens, so every choice shows here at once ══ -->
    <Style Selector="Border.appearance-preview">
      <Setter Property="Background" Value="{DynamicResource Brush.ChatCanvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GroupBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Group}" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Border.preview-label">
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="10,3,10,4" />
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.preview-label TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Your message wears the chat's own bubble. -->
    <Style Selector="Border.preview-bubble">
      <Setter Property="Background" Value="{DynamicResource Brush.ChatUserSurface}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,10,14,11" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.preview-text">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
      <Setter Property="LineHeight" Value="{DynamicResource Font.LineHeightBody}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.preview-composer">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,5,5,5" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingGlass}" />
    </Style>
    <Style Selector="Border.preview-composer TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.preview-send">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.preview-send sc|StrataLineIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══ Choices drawn as pictures: the button only lends them a press ══ -->
    <Style Selector="Button.bare-choice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.bare-choice /template/ Border#PART_Surface,
                     Button.bare-choice:pointerover /template/ Border#PART_Surface,
                     Button.bare-choice:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.bare-choice:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.bare-choice /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Theme tiles: a chat in each look, whatever look the phone is in now. -->
    <Style Selector="Border.theme-frame">
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.theme-outline">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.selected Border.theme-outline">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Border.check-badge">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,6,6,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.4)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.selected Border.check-badge">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Border.check-badge sc|StrataLineIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="StrokeThickness" Value="2.6" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <!-- A check reads the same in every language; only directional glyphs mirror. -->
      <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>
    <Style Selector="TextBlock.choice-label">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.selected TextBlock.choice-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Panel.theme-picture.light Border.pic-canvas">
      <Setter Property="Background" Value="#F5F5F7" />
    </Style>
    <Style Selector="Panel.theme-picture.dark Border.pic-canvas">
      <Setter Property="Background" Value="#18181B" />
    </Style>
    <Style Selector="Panel.theme-picture.light Border.pic-chrome">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E0E0E6" />
    </Style>
    <Style Selector="Panel.theme-picture.dark Border.pic-chrome">
      <Setter Property="Background" Value="#242428" />
      <Setter Property="BorderBrush" Value="#34343A" />
    </Style>
    <Style Selector="Panel.theme-picture.light Border.pic-line">
      <Setter Property="Background" Value="#C9C9D1" />
    </Style>
    <Style Selector="Panel.theme-picture.dark Border.pic-line">
      <Setter Property="Background" Value="#3A3A42" />
    </Style>
    <Style Selector="Panel.theme-picture.light Border.pic-line.faint">
      <Setter Property="Background" Value="#DEDEE4" />
    </Style>
    <Style Selector="Panel.theme-picture.dark Border.pic-line.faint">
      <Setter Property="Background" Value="#2A2A30" />
    </Style>
    <Style Selector="Border.pic-bubble">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.pic-send">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    </Style>

    <!-- Accent swatches: the palette as a disc, ringed and checked when chosen. -->
    <Style Selector="Button.bare-choice.accent-swatch">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.swatch-ring">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.selected Border.swatch-ring">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="views|AccentSwatch">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="sc|StrataLineIcon.swatch-check">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="2.6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.4)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.selected sc|StrataLineIcon.swatch-check">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <Style Selector="views|GlowMark">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.toggle-row:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <!--
    Settings as the desktop lays it out: its pages listed under you and the PC this phone belongs to,
    and the open page beside the list when there is room. A phone shows the list, then one page.
  -->
  <layout:ListDetailPanel x:Name="SettingsPanes"
                          IsTwoPane="{Binding IsTwoPane}"
                          ListWidth="{Binding ListPaneWidth}"
                          IsDetailOpen="{Binding ShowSettingsDetail}">

  <!-- ═══ The list of pages ═══ -->
  <Grid x:Name="SettingsListPane" RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource Brush.NavigationSurface}">
    <Panel x:Name="SettingsHeaderChrome" Grid.Row="0" ZIndex="1" Background="Transparent">
    <Panel Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
      <sc:StrataBackdropBlur Classes="chrome-frost" Fade="Bottom"
                             FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
      <Border Background="{DynamicResource Brush.PageEdgeTop}" />
    </Panel>
    <Border x:Name="SettingsTopInset" Padding="{Binding CanvasHeaderInset}">
      <Border x:Name="SettingsHeaderSideInset" Padding="{Binding SafeAreaSides}">
        <Grid x:Name="SettingsHeaderLayout"
              RowDefinitions="Auto,Auto"
              MinHeight="{DynamicResource Touch.MinTarget}"
              MaxWidth="620"
              HorizontalAlignment="Stretch"
              Margin="{DynamicResource Mobile.Page.HeaderMargin}">
          <TextBlock x:Name="SettingsTitle" Text="{loc:Str Settings}" Classes="place-title" />
          <views:WebAppUpdateBannerView x:Name="SettingsUpdateBanner" Grid.Row="1" />
        </Grid>
      </Border>
    </Border>
    </Panel>

    <!-- The list runs under the floating header and places; ScrollEdgeChrome keeps it clear of both at rest. -->
    <Border x:Name="SettingsListInset" Grid.Row="0" Grid.RowSpan="3">
      <Border x:Name="SettingsContentSideInset" Padding="{Binding SafeAreaSides}">
        <ScrollViewer x:Name="SettingsScroll" Classes="mobile-scroll"
                      behaviors:ScrollEdgeChrome.Header="{Binding #SettingsHeaderChrome}"
                      behaviors:ScrollEdgeChrome.Footer="{Binding #SettingsFooterChrome}">
          <Border x:Name="SettingsScrollInset">
          <StackPanel x:Name="SettingsContent"
                      MaxWidth="620"
                      HorizontalAlignment="Stretch"
                      Margin="16,4,16,24">

            <!-- You and the PC this phone belongs to, as the desktop's Settings opens with your profile. -->
            <Border x:Name="SettingsConnectionCard" Classes="group-card">
              <StackPanel>
                <Panel x:Name="SettingsProfile"
                       IsVisible="{Binding UserName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Border Classes="profile-glow" />
                  <Button x:Name="SettingsProfileRow" Classes="list-row profile-row"
                          AutomationProperties.Name="{Binding UserName, StringFormat={loc:Str ProfileNamed}}"
                          Command="{Binding ShowMemoriesCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <Border x:Name="SettingsProfileAvatar" Classes="profile-avatar">
                        <TextBlock Text="{Binding UserInitial}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" Classes="profile-name" />
                        <TextBlock Text="{Binding Library.MemoryCountLabel, StringFormat={loc:Str ProfileMemories}}" Classes="row-meta" />
                      </StackPanel>
                      <PathIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                    </Grid>
                  </Button>
                </Panel>
                <Panel>
                  <Border Classes="row-divider"
                          IsVisible="{Binding UserName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <Button x:Name="SettingsConnectionRow" Classes="list-row"
                          Classes.selected="{Binding IsConnectionSectionVisible}"
                          AutomationProperties.Name="{Binding HostName, StringFormat={loc:Str ConnectionNamed}}"
                          Command="{Binding OpenSettingsSectionCommand}" CommandParameter="Connection">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="row-tile">
                        <PathIcon Data="{DynamicResource Mobile.Icon.Monitor}" Foreground="{DynamicResource Brush.Hue.Connector}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HostName}" Classes="row-title" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border x:Name="SettingsConnectionDot" Classes="status-dot" Classes.live="{Binding IsLive}" />
                          <TextBlock Text="{Binding ConnectionStateLabel}" Classes="row-meta" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                      <PathIcon Grid.Column="2" Classes="row-chevron" IsVisible="{Binding IsSinglePane}"
                                Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                    </Grid>
                  </Button>
                </Panel>
              </StackPanel>
            </Border>

            <!-- Each page says what is inside it, so the list reads at a glance. -->
            <TextBlock x:Name="SettingsPreferencesLabel" Classes="section-label" Text="{loc:Str Preferences}" />
            <Border x:Name="SettingsPagesCard" Classes="group-card">
              <StackPanel>
                <Button x:Name="SettingsAppearanceRow" Classes="list-row"
                        Classes.selected="{Binding IsAppearanceSectionVisible}"
                        AutomationProperties.Name="{loc:Str Appearance}"
                        Command="{Binding OpenSettingsSectionCommand}" CommandParameter="Appearance">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="row-tile">
                      <PathIcon Data="{DynamicResource Mobile.Icon.Palette}" Foreground="{DynamicResource Brush.Hue.Appearance}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{loc:Str Appearance}" Classes="row-title" />
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Classes="accent-dot" />
                        <TextBlock x:Name="SettingsAppearanceSummary" Text="{Binding AppearanceSummary}"
                                   Classes="row-meta" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                    <PathIcon Grid.Column="2" Classes="row-chevron" IsVisible="{Binding IsSinglePane}"
                              Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                  </Grid>
                </Button>
                <Panel>
                  <Border Classes="row-divider inset" />
                  <Button x:Name="SettingsMemoriesRow" Classes="list-row"
                          AutomationProperties.Name="{loc:Str Memories}"
                          Command="{Binding ShowMemoriesCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="row-tile">
                        <PathIcon Data="{DynamicResource Mobile.Icon.Memory}" Foreground="{DynamicResource Brush.Hue.Memory}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str Memories}" Classes="row-title" />
                        <TextBlock Text="{Binding Library.MemoryCountLabel}" Classes="row-meta" />
                      </StackPanel>
                      <PathIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                    </Grid>
                  </Button>
                </Panel>
              </StackPanel>
            </Border>

            <Border x:Name="SettingsAboutCard" Classes="group-card" Margin="0,12,0,0">
              <Button x:Name="SettingsAboutRow" Classes="list-row"
                      Classes.selected="{Binding IsAboutSectionVisible}"
                      AutomationProperties.Name="{loc:Str About}"
                      Command="{Binding OpenSettingsSectionCommand}" CommandParameter="About">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="row-tile">
                    <PathIcon Data="{DynamicResource Mobile.Icon.Info}" Foreground="{DynamicResource Brush.Hue.About}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str About}" Classes="row-title" />
                    <TextBlock Text="{Binding AppVersion, StringFormat={loc:Str VersionNamed}}" Classes="row-meta" />
                  </StackPanel>
                  <PathIcon Grid.Column="2" Classes="row-chevron" IsVisible="{Binding IsSinglePane}"
                            Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                </Grid>
              </Button>
            </Border>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- The places stay centred in the thumb zone while the list scrolls underneath, as on Chats. -->
    <Panel x:Name="SettingsFooterChrome" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom"
           ZIndex="1" Background="Transparent">
      <Border x:Name="SettingsBottomInset" Padding="{Binding SafeAreaBottom}">
        <Border Padding="{Binding SafeAreaSides}">
          <views:PlacesBarView x:Name="SettingsPlaces"
                               IsVisible="{Binding !IsKeyboardOpen}"
                               Margin="12,8,12,12" />
        </Border>
      </Border>
    </Panel>
  </Grid>

  <!-- ═══ The open page: an island on the canvas, beside its list or on its own, as the chat is ═══ -->
  <layout:Island x:Name="SettingsDetailIsland" Frame="{Binding PageIslandFrame}" Margin="{Binding PageIslandMargin}" Padding="{Binding PageIslandPadding}">
  <Grid x:Name="SettingsDetailPane" RowDefinitions="Auto,*"
        Background="{DynamicResource Brush.ChatCanvas}">
    <Panel x:Name="SettingsDetailHeaderChrome" Grid.Row="0" ZIndex="1" Background="Transparent">
    <Panel Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
      <sc:StrataBackdropBlur Classes="chrome-frost" Fade="Bottom"
                             FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
      <Border Background="{DynamicResource Brush.IslandEdgeTop}" />
    </Panel>
    <Border x:Name="SettingsDetailTopInset">
      <Border x:Name="SettingsDetailHeaderSideInset">
        <Grid x:Name="SettingsDetailHeaderLayout"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="4"
              MinHeight="{DynamicResource Touch.MinTarget}"
              MaxWidth="620"
              HorizontalAlignment="Stretch"
              Margin="{DynamicResource Mobile.Page.HeaderMargin}">
          <Button x:Name="SettingsBackButton" Grid.Column="0" Classes="chat-header-action floating-action"
                  IsVisible="{Binding IsSinglePane}"
                  AutomationProperties.Name="{loc:Str BackToSettings}"
                  Command="{Binding GoBackCommand}">
            <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                      Data="{DynamicResource Mobile.Icon.Back}" />
          </Button>
          <TextBlock x:Name="SettingsDetailTitle" Grid.Column="1" Text="{Binding SettingsDetailTitle}"
                     Classes="section-title" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Border>
    </Panel>

    <Border x:Name="SettingsDetailBottomInset" Grid.Row="0" Grid.RowSpan="2">
      <Border x:Name="SettingsDetailSideInset">
        <ScrollViewer x:Name="SettingsDetailScroll" Classes="mobile-scroll"
                      behaviors:ScrollEdgeChrome.Header="{Binding #SettingsDetailHeaderChrome}">
          <Border x:Name="SettingsDetailScrollInset">
          <StackPanel x:Name="SettingsDetailContent"
                      MaxWidth="620"
                      HorizontalAlignment="Stretch"
                      Margin="{DynamicResource Mobile.Page.FormContentMargin}">

            <!-- ═══ Appearance: make Lumi yours. Every choice shows at once, in the preview and across the app. ═══ -->
            <StackPanel x:Name="AppearanceSettings" IsVisible="{Binding IsAppearanceSectionVisible}">
              <Border x:Name="AppearancePreview" Classes="appearance-preview">
                <Panel>
                  <views:GlowPreview x:Name="AppearancePreviewGlow"
                                     Brightness="{Binding GlowMultiplier}"
                                     IsVisible="{Binding IsGlowOn}" />
                  <StackPanel Margin="14,12,14,14" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                      <Border Classes="preview-label">
                        <TextBlock Text="{loc:Str LivePreview}" />
                      </Border>
                      <Border x:Name="PreviewUserBubble" Grid.Column="1" Classes="preview-bubble">
                        <TextBlock Text="{loc:Str PreviewUserMessage}" Classes="preview-text" />
                      </Border>
                    </Grid>
                    <TextBlock x:Name="PreviewAnswer" Text="{loc:Str PreviewAssistantMessage}"
                               Classes="preview-text" Margin="2,0,20,0" />
                    <Border x:Name="PreviewComposer" Classes="preview-composer">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{loc:Str MessageLumi}" />
                        <Border Grid.Column="1" Classes="preview-send">
                          <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.ArrowUp}" />
                        </Border>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Panel>
              </Border>

              <!-- Three looks rather than a dark switch: "match my phone" is what most people want, and on
                   Android the OS flips it on a schedule the app has no other way to follow. -->
              <TextBlock Classes="section-label" Text="{loc:Str Theme}" />
              <Border Classes="group-card appearance-card">
                <Grid x:Name="ThemeOptions" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Button x:Name="ThemeSystemButton" Grid.Column="0" Classes="bare-choice theme-tile"
                          Classes.selected="{Binding IsSystemTheme}"
                          AutomationProperties.Name="{loc:Str System}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="System">
                    <StackPanel Spacing="8">
                      <Border Classes="theme-frame">
                        <Panel>
                          <Panel Classes="theme-picture light">
                            <Border Classes="pic-canvas" />
                            <Border Classes="pic-chrome" Width="34" Height="9" CornerRadius="4.5" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <StackPanel Margin="10,26,10,0" Spacing="6" VerticalAlignment="Top">
                              <Border Classes="pic-bubble" Width="38" Height="11" CornerRadius="5.5" HorizontalAlignment="Right" />
                              <Border Classes="pic-line" Width="54" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                              <Border Classes="pic-line faint" Width="36" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Classes="pic-chrome" Height="16" CornerRadius="8" BorderThickness="1"
                                    VerticalAlignment="Bottom" Margin="8,0,8,8">
                              <Border Classes="pic-send" Width="10" Height="10" CornerRadius="5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                            </Border>
                          </Panel>
                          <!-- The dark half, cut on the diagonal. -->
                          <Panel Classes="theme-picture dark">
                            <Panel.OpacityMask>
                              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0.5" Color="#00000000" />
                                <GradientStop Offset="0.5" Color="#FF000000" />
                              </LinearGradientBrush>
                            </Panel.OpacityMask>
                            <Border Classes="pic-canvas" />
                            <Border Classes="pic-chrome" Width="34" Height="9" CornerRadius="4.5" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <StackPanel Margin="10,26,10,0" Spacing="6" VerticalAlignment="Top">
                              <Border Classes="pic-bubble" Width="38" Height="11" CornerRadius="5.5" HorizontalAlignment="Right" />
                              <Border Classes="pic-line" Width="54" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                              <Border Classes="pic-line faint" Width="36" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Classes="pic-chrome" Height="16" CornerRadius="8" BorderThickness="1"
                                    VerticalAlignment="Bottom" Margin="8,0,8,8">
                              <Border Classes="pic-send" Width="10" Height="10" CornerRadius="5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                            </Border>
                          </Panel>
                          <Border Classes="theme-outline" />
                          <Border Classes="check-badge">
                            <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Check}" />
                          </Border>
                        </Panel>
                      </Border>
                      <TextBlock Classes="choice-label" Text="{loc:Str System}" />
                    </StackPanel>
                  </Button>

                  <Button x:Name="ThemeLightButton" Grid.Column="1" Classes="bare-choice theme-tile"
                          Classes.selected="{Binding IsLightTheme}"
                          AutomationProperties.Name="{loc:Str Light}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="Light">
                    <StackPanel Spacing="8">
                      <Border Classes="theme-frame">
                        <Panel>
                          <Panel Classes="theme-picture light">
                            <Border Classes="pic-canvas" />
                            <Border Classes="pic-chrome" Width="34" Height="9" CornerRadius="4.5" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <StackPanel Margin="10,26,10,0" Spacing="6" VerticalAlignment="Top">
                              <Border Classes="pic-bubble" Width="38" Height="11" CornerRadius="5.5" HorizontalAlignment="Right" />
                              <Border Classes="pic-line" Width="54" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                              <Border Classes="pic-line faint" Width="36" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Classes="pic-chrome" Height="16" CornerRadius="8" BorderThickness="1"
                                    VerticalAlignment="Bottom" Margin="8,0,8,8">
                              <Border Classes="pic-send" Width="10" Height="10" CornerRadius="5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                            </Border>
                          </Panel>
                          <Border Classes="theme-outline" />
                          <Border Classes="check-badge">
                            <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Check}" />
                          </Border>
                        </Panel>
                      </Border>
                      <TextBlock Classes="choice-label" Text="{loc:Str Light}" />
                    </StackPanel>
                  </Button>

                  <Button x:Name="ThemeDarkButton" Grid.Column="2" Classes="bare-choice theme-tile"
                          Classes.selected="{Binding IsDarkTheme}"
                          AutomationProperties.Name="{loc:Str Dark}"
                          Command="{Binding SelectThemeCommand}" CommandParameter="Dark">
                    <StackPanel Spacing="8">
                      <Border Classes="theme-frame">
                        <Panel>
                          <Panel Classes="theme-picture dark">
                            <Border Classes="pic-canvas" />
                            <Border Classes="pic-chrome" Width="34" Height="9" CornerRadius="4.5" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <StackPanel Margin="10,26,10,0" Spacing="6" VerticalAlignment="Top">
                              <Border Classes="pic-bubble" Width="38" Height="11" CornerRadius="5.5" HorizontalAlignment="Right" />
                              <Border Classes="pic-line" Width="54" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                              <Border Classes="pic-line faint" Width="36" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Classes="pic-chrome" Height="16" CornerRadius="8" BorderThickness="1"
                                    VerticalAlignment="Bottom" Margin="8,0,8,8">
                              <Border Classes="pic-send" Width="10" Height="10" CornerRadius="5"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                            </Border>
                          </Panel>
                          <Border Classes="theme-outline" />
                          <Border Classes="check-badge">
                            <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Check}" />
                          </Border>
                        </Panel>
                      </Border>
                      <TextBlock Classes="choice-label" Text="{loc:Str Dark}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <TextBlock Classes="section-footnote" Text="{loc:Str ThemeDescription}" />

              <!-- The desktop's palettes: the one chosen recolours buttons, selection, your messages and the glow. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section-label" Text="{loc:Str AccentColor}" />
                <TextBlock x:Name="AccentNameText" Grid.Column="1" Classes="section-label section-value"
                           Text="{Binding AccentName}" />
              </Grid>
              <Border Classes="group-card appearance-card">
                <ItemsControl x:Name="AccentSwatches" ItemsSource="{Binding AccentChoices}"
                              SizeChanged="OnAccentSwatchesSizeChanged">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccentChoice">
                      <Button Classes="bare-choice accent-swatch" Classes.selected="{Binding IsSelected}"
                              AutomationProperties.Name="{Binding Name}"
                              Command="{Binding SelectCommand}">
                        <Panel>
                          <Border Classes="swatch-ring" />
                          <views:AccentSwatch Palette="{Binding Palette}" />
                          <sc:StrataLineIcon Classes="swatch-check" Data="{x:Static sc:StrataIcons.Check}" />
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <!-- Lumi's own text size, on top of the phone's font size. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section-label" Text="{loc:Str TextSize}" />
                <TextBlock x:Name="TextSizeText" Grid.Column="1" Classes="section-label section-value"
                           Text="{Binding TextSizeLabel}" />
              </Grid>
              <Border Classes="group-card appearance-card">
                <Border Classes="segment-track settings-track">
                  <ItemsControl x:Name="TextSizeOptions" ItemsSource="{Binding TextSizeChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSizeChoice">
                        <Button Classes="segment" Classes.selected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding SelectCommand}">
                          <TextBlock Text="Aa" FontSize="{Binding SampleSize}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Border>
              <TextBlock Classes="section-footnote" Text="{loc:Str TextSizeDescription}" />

              <!-- Lumi's presence behind the chat: how brightly it shines, and whether it moves while Lumi works. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section-label" Text="{loc:Str GlowTitle}" />
                <TextBlock x:Name="GlowText" Grid.Column="1" Classes="section-label section-value"
                           Text="{Binding GlowLabel}" />
              </Grid>
              <Border Classes="group-card appearance-card">
                <StackPanel>
                  <Border Classes="segment-track settings-track">
                    <UniformGrid x:Name="GlowOptions" Rows="1">
                      <Button x:Name="GlowOffButton" Classes="segment" Classes.selected="{Binding IsGlowOff}"
                              AutomationProperties.Name="{loc:Str Off}"
                              Command="{Binding SelectGlowCommand}" CommandParameter="Off">
                        <views:GlowMark Brightness="0" />
                      </Button>
                      <Button x:Name="GlowSubtleButton" Classes="segment" Classes.selected="{Binding IsGlowSubtle}"
                              AutomationProperties.Name="{loc:Str GlowSubtle}"
                              Command="{Binding SelectGlowCommand}" CommandParameter="Subtle">
                        <views:GlowMark Brightness="0.6" />
                      </Button>
                      <Button x:Name="GlowBalancedButton" Classes="segment" Classes.selected="{Binding IsGlowBalanced}"
                              AutomationProperties.Name="{loc:Str GlowBalanced}"
                              Command="{Binding SelectGlowCommand}" CommandParameter="Balanced">
                        <views:GlowMark Brightness="1" />
                      </Button>
                      <Button x:Name="GlowVividButton" Classes="segment" Classes.selected="{Binding IsGlowVivid}"
                              AutomationProperties.Name="{loc:Str GlowVivid}"
                              Command="{Binding SelectGlowCommand}" CommandParameter="Vivid">
                        <views:GlowMark Brightness="1.45" />
                      </Button>
                    </UniformGrid>
                  </Border>
                  <Border Classes="row-divider" Margin="0,12,0,0" />
                  <Grid x:Name="AnimateGlowRow" Classes="toggle-row" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                        Margin="4,10,0,0" IsEnabled="{Binding IsGlowOn}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{loc:Str AnimateGlow}" Classes="row-title" TextWrapping="Wrap" />
                      <TextBlock Text="{loc:Str AnimateGlowDescription}" Classes="supporting" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AnimateGlowSwitch" Grid.Column="1"
                                  IsChecked="{Binding AnimateGlowWhileWorking}"
                                  AutomationProperties.Name="{loc:Str AnimateGlow}"
                                  VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Classes="section-label" Text="{loc:Str Language}" />
              <Border Classes="group-card appearance-card">
                <StackPanel Spacing="10">
                  <sc:StrataComboBox x:Name="SettingsLanguagePicker" FlowDirection="LeftToRight"
                                     ItemsSource="{Binding LanguageOptions}"
                                     SelectedItem="{Binding SelectedLanguageName, Mode=TwoWay}"
                                     MinHeight="{DynamicResource Touch.MinTarget}"
                                     AutomationProperties.Name="{loc:Str Language}">
                    <sc:StrataComboBox.Styles>
                      <Style Selector="sc|StrataComboBox#SettingsLanguagePicker /template/ Popup#PART_Popup">
                        <Setter Property="ShouldUseOverlayLayer" Value="True" />
                      </Style>
                      <Style Selector="sc|StrataComboBoxItem">
                        <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
                      </Style>
                    </sc:StrataComboBox.Styles>
                  </sc:StrataComboBox>
                  <TextBlock Text="{loc:Str LanguageRestart}" Classes="supporting" TextWrapping="Wrap"
                             IsVisible="{Binding LanguageRestartRequired}" />
                </StackPanel>
              </Border>
              <TextBlock Classes="section-footnote" Text="{loc:Str LanguageDescription}" />

              <Button x:Name="RestoreDefaultLookButton" Classes="touch open-action"
                      Margin="0,24,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      IsVisible="{Binding IsAppearanceCustomized}"
                      Command="{Binding RestoreDefaultLookCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Retry}" Width="18" Height="18" StrokeThickness="2"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="{loc:Str RestoreDefaultLook}" VerticalAlignment="Center"
                             Foreground="{Binding $parent[Button].Foreground}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- ═══ Connection: the PC this phone talks to ═══ -->
            <StackPanel x:Name="ConnectionSettings" IsVisible="{Binding IsConnectionSectionVisible}">
              <Border x:Name="ConnectionHero" Classes="group-card hero-card" Margin="0,4,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <Border Classes="row-tile hero-tile">
                    <PathIcon Data="{DynamicResource Mobile.Icon.Monitor}" Foreground="{DynamicResource Brush.Hue.Connector}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostName}" Classes="hero-title" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Classes="status-dot" Classes.live="{Binding IsLive}" />
                      <TextBlock Text="{Binding ConnectionStateLabel}" Classes="row-meta" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Classes="section-label" Text="{loc:Str ThisConnection}" />
              <sc:StrataSettingGroup Classes="mobile">
                <sc:StrataSetting Header="{loc:Str ThisDevice}" Classes="mobile" Description="{Binding DeviceName}" />
                <sc:StrataSetting Header="{loc:Str RefreshConnection}" Classes="mobile stacked"
                                  Description="{loc:Str RefreshConnectionHelp}">
                  <Button x:Name="RefreshButton" Classes="touch open-action"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding RefreshCommand}">
                    <TextBlock Text="{loc:Str Refresh}" Foreground="{Binding $parent[Button].Foreground}" />
                  </Button>
                </sc:StrataSetting>
                <sc:StrataSetting x:Name="ConnectionActivitySetting" Header="{loc:Str ConnectionActivity}" Classes="mobile"
                                  IsVisible="{Binding ConnectionDiagnostics, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                  Description="{Binding ConnectionDiagnostics}" />
                <sc:StrataSetting x:Name="ReloadWebAppSetting" Header="{loc:Str BrowserSignIn}" Classes="mobile stacked"
                                  IsVisible="{Binding CanReloadWebApp}"
                                  Description="{loc:Str BrowserSignInHelp}">
                  <Button x:Name="ReloadWebAppButton" Classes="touch open-action"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Content="{loc:Str ReloadWebApp}"
                          Command="{Binding ReloadWebAppCommand}" />
                </sc:StrataSetting>
              </sc:StrataSettingGroup>

              <TextBlock Text="{Binding ConnectionMessage}" Classes="supporting" Margin="6,12,6,0"
                         IsVisible="{Binding ConnectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <StackPanel Spacing="8" Margin="0,24,0,0">
                <Button x:Name="ForgetButton" Classes="touch subtle"
                        Foreground="{DynamicResource Brush.DangerDefault}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenDisconnectConfirmationCommand}">
                  <TextBlock Text="{loc:Str DisconnectPc}" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <TextBlock Text="{loc:Str ChatsStayOnPc}" Classes="muted"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <!-- ═══ About: Lumi itself ═══ -->
            <StackPanel x:Name="AboutSettings" IsVisible="{Binding IsAboutSectionVisible}">
              <Border x:Name="AboutHero" Classes="group-card hero-card" Margin="0,4,0,0" Padding="20,24,20,22">
                <StackPanel Spacing="6">
                  <Image Source="{x:Static views:LumiAppIcon.Image}" Width="72" Height="72" Stretch="Uniform"
                         HorizontalAlignment="Center" />
                  <TextBlock Text="Lumi" Classes="hero-title" HorizontalAlignment="Center" Margin="0,6,0,0" />
                  <TextBlock x:Name="AboutVersionText" Text="{Binding AppVersion, StringFormat={loc:Str VersionNamed}}"
                             Classes="row-meta" HorizontalAlignment="Center" />
                  <TextBlock Text="{loc:Str AboutDescription}" Classes="supporting"
                             TextAlignment="Center" HorizontalAlignment="Center" Margin="4,10,4,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
          </Border>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
  </layout:Island>
  </layout:ListDetailPanel>

  <sc:StrataBottomSheet x:Name="DisconnectSheet" Classes="safe-area"
                        IsOpen="{Binding IsDisconnectConfirmationOpen, Mode=TwoWay}"
                        Title="{loc:Str DisconnectQuestion}"
                        Description="{loc:Str DisconnectDescription}">
    <Border>
      <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,0,16,8" Spacing="10">
          <Border Classes="sheet-card" Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" />
              <TextBlock Grid.Column="1" Text="{Binding HostName}" FontWeight="Medium"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Button x:Name="ConfirmDisconnectButton" Classes="sheet-action destructive"
                  Content="{loc:Str DisconnectRevoke}"
                  Command="{Binding ForgetPcCommand}" />
          <Button x:Name="CancelDisconnectButton" Classes="sheet-action" Content="{loc:Str KeepConnected}"
                  Command="{Binding CancelDisconnectCommand}" />
          <TextBlock Text="{Binding ConnectionMessage}" Classes="sheet-body" Margin="8,4"
                     IsVisible="{Binding ConnectionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Spacing="10" Margin="0,12,0,0">
            <StackPanel Spacing="2" Margin="8,0">
              <TextBlock Text="{loc:Str CantReachPcQuestion}" FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeMeta}" />
              <TextBlock Text="{loc:Str RemoveLocalConnectionHelp}"
                         Classes="sheet-body" FontSize="{DynamicResource Font.SizeMeta}" LineHeight="{DynamicResource Font.LineHeightMeta}" />
            </StackPanel>
            <Button x:Name="ForgetLocalButton" Classes="sheet-action" Content="{loc:Str RemoveLocalConnection}"
                    IsEnabled="{Binding !ForgetPcCommand.IsRunning}"
                    Command="{Binding ForgetPcLocallyCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </sc:StrataBottomSheet>
  </Panel>
</UserControl>
