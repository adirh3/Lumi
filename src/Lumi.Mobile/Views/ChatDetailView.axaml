<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:proto="using:Lumi.Remote.Protocol"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:sa="using:StrataTheme.Animation"
             x:Class="Lumi.Mobile.Views.ChatDetailView"
             x:DataType="vm:MobileShellViewModel"
             sc:StrataTextSelection.IsTouchSelectionEnabled="False"
             Background="{DynamicResource Brush.ChatCanvas}">

  <UserControl.Styles>
    <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_HeaderContainer">
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The floating top bar's scroll-edge glass extends below the bar, so it must not be clipped. -->
    <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_HeaderChrome">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style Selector="sc|StrataChatMessage.mobile-message:user /template/ Border#PART_Bubble">
      <Setter Property="Background" Value="{DynamicResource Brush.ChatUserSurface}" />
      <Setter Property="CornerRadius" Value="20,20,6,20" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
      Comfortable reading column. On an unfolded fold or a tablet the conversation would otherwise
      run the full width of the pane, which reads badly. A max width with the default Stretch
      alignment centres the column, so wide screens gain whitespace instead of longer lines.
    -->
    <Style Selector="sc|StrataChatShell /template/ Border#PART_ScrollContent">
      <Setter Property="MaxWidth" Value="{DynamicResource Chat.ReadingColumnWidth}" />
    </Style>

    <!-- The top bar owns the full width: the hamburger must sit hard left and the new-chat
         button hard right, which a content-sized presenter inside a DockPanel will not do. -->
    <Style Selector="sc|StrataChatShell /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="DockPanel.Dock" Value="Top" />
    </Style>

    <!-- Mobile owns its own top-bar/status chrome. Keeping Strata's desktop header separator as well
         produced two stacked hairlines above the transcript. -->
    <Style Selector="sc|StrataChatShell:has-header /template/ Border#PART_HeaderSeparator">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="0" />
    </Style>

    <!-- The chat shell reports when history is behind its floating bars. -->
    <Style Selector="sc|StrataChatShell:content-under-header Panel#TopEdgeMaterial,
                     sc|StrataChatShell:content-under-composer Panel#BottomEdgeMaterial">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.floating-status">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingControl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="16,0,4,0" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingControl}" />
    </Style>

    <!-- The jump-to-latest control floats over moving history, so it gets its own small frost. -->
    <Style Selector="sc|StrataChatShell.mobile /template/ sc|StrataBackdropBlur#PART_ScrollToBottomBackdrop">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BlurRadius" Value="{DynamicResource Glass.ControlBlurRadius}" />
      <Setter Property="Saturation" Value="{DynamicResource Glass.ControlSaturation}" />
    </Style>
    <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_ScrollToBottomChrome">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingControl}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingControl}" />
    </Style>

    <Style Selector="Button.start-setup">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.start-setup.selected">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button.start-setup:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>

    <Style Selector="Button.starter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Button.starter:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
    </Style>
    <Style Selector="Button.starter:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.transcript-nav">
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.activity-card">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    </Style>
    <Style Selector="Button.activity-card:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Button.activity-card:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>

    <Style Selector="Button.work-disclosure">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="14,0,12,0" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- A 40dp pill inside the full 48dp target. -->
    <Style Selector="Button.work-disclosure /template/ Border#PART_Surface">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Button.work-disclosure /template/ Border#PART_Aurora,
                     Button.answer-action /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.work-disclosure:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.work-disclosure PathIcon.work-glyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.work-disclosure PathIcon.disclosure-chevron">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.work-disclosure.expanded PathIcon.disclosure-chevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <Style Selector="Button.source-card">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    </Style>
    <Style Selector="Button.source-card:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Button.source-card:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>

    <Style Selector="Border.activity-file">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <!-- Inside a glass popup, cards share its translucent fill instead of an opaque block. -->
    <Style Selector="sc|StrataBottomSheet Border.activity-file">
      <Setter Property="Background" Value="{DynamicResource Brush.SheetControl}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Button.answer-action">
      <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.answer-action:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.answer-action:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <Style Selector="Button.answer-action PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.answer-action PathIcon.copied-glyph">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.6)" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
    </Style>
    <Style Selector="Button.answer-action.copied PathIcon.copy-glyph">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.6)" />
    </Style>
    <Style Selector="Button.answer-action.copied PathIcon.copied-glyph">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <Style Selector="sc|StrataAiToolCall.mobile-activity /template/ Border#PART_Root,
                     sc|StrataTerminalPreview.mobile-activity /template/ Border#PART_Root,
                     sc|StrataThink.mobile-activity /template/ Border#PART_Pill">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="sc|StrataFileAttachment.produced-file /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.produced-file /template/ Grid#PART_ContentGrid">
      <Setter Property="Margin" Value="14,10" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.produced-file /template/ Border#PART_IconBox">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.produced-file /template/ TextBlock#PART_FileName">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
      <Setter Property="MaxWidth" Value="Infinity" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.produced-file /template/ StackPanel#PART_MetaRow TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <!-- User turn: accent bubble, right-aligned — exactly ChatGPT's shape. -->
    <DataTemplate DataType="vm:UserTurnItemViewModel">
      <StackPanel Spacing="6" Margin="0,14,0,6">
        <sc:StrataChatMessage Role="User" Classes="mobile-message"
                              IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <sc:StrataChatMessage.Content>
            <SelectableTextBlock Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 FontSize="{DynamicResource Font.SizeBody}"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 behaviors:NativeTextSelection.IsEnabled="True"
                                 behaviors:NativeTextSelection.Text="{Binding Text}" />
          </sc:StrataChatMessage.Content>
        </sc:StrataChatMessage>
        <TextBlock Text="{Binding SteerStatusText}"
                   IsVisible="{Binding HasSteerStatus}"
                   HorizontalAlignment="Right"
                   Margin="0,-2,8,0"
                   FontSize="{DynamicResource Font.SizeCaption}"
                   Foreground="{DynamicResource Brush.TextTertiary}" />
        <sc:StrataAttachmentList ItemsSource="{Binding Attachments}"
                                 ShowAddButton="False"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasAttachments}">
          <sc:StrataAttachmentList.ItemTemplate>
            <DataTemplate x:DataType="proto:RemoteAttachment">
              <sc:StrataFileAttachment FileName="{Binding FileName}"
                                       Status="Completed"
                                       IsCompact="True"
                                       IsRemovable="False"
                                       Margin="0,0,6,4" />
            </DataTemplate>
          </sc:StrataAttachmentList.ItemTemplate>
        </sc:StrataAttachmentList>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:JobWakeItemViewModel">
      <Button x:Name="JobWakeEvent" Classes="activity-card" Margin="0,12,0,8"
              Command="{Binding OpenCommand}"
              AutomationProperties.Name="{Binding Details.JobName, StringFormat='Job wake: {0}'}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Job wake" FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.AccentDefault}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Classes="muted" />
          </Grid>
          <TextBlock Text="{Binding Details.JobName}" FontWeight="SemiBold"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Summary}" Classes="supporting"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="View details" Classes="muted" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!--
      Assistant answer. NO bubble: ChatGPT, Claude and Gemini all render the assistant as plain
      full-width text on the page background, and only the user gets a bubble. On a phone that is
      not a style choice — a bubble around a long answer wastes horizontal room the text needs, and
      the asymmetry is what makes the two speakers instantly distinguishable while scrolling.
    -->
    <DataTemplate DataType="vm:AssistantItemViewModel">
      <StackPanel Margin="0,2,0,4" Spacing="2">
        <StackPanel x:Name="AssistantIdentity" Orientation="Horizontal" Spacing="8" Margin="0,12,0,10">
          <Border Width="24" Height="24" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Foreground="{DynamicResource Brush.AccentDefault}"
                      Data="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z" />
          </Border>
          <TextBlock Text="Lumi" FontSize="{DynamicResource Font.SizeMeta}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>
        <!-- IsInline drops StrataMarkdown's card surface. An answer is the page, not a document
             pinned to it, and a card border here would just be a bubble by another name. -->
        <sc:StrataMarkdown Markdown="{Binding Text}"
                           InteractionStates="{Binding InteractionStates}"
                           InteractionLanguage="{Binding InteractionLanguage}"
                           InteractionTouchMode="True"
                           InteractionPickerHost="{Binding $parent[views:ChatDetailView].InteractivePickerHost}"
                           InteractionsHosted="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.SupportsInteractiveResponses}"
                           CanSubmitInteractions="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.CanSubmitInteractions}"
                           IsInline="True"
                           RetainContentOnDetach="True"
                           behaviors:NativeTextSelection.IsEnabled="True"
                           behaviors:NativeTextSelection.Text="{Binding SelectionText}" />

        <Button Classes="source-card"
                Margin="0,7,0,2"
                IsVisible="{Binding HasSources}"
                Command="{Binding OpenSourcesCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <PathIcon Grid.Column="0"
                      Width="18" Height="18"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource Brush.AccentDefault}"
                      Data="M3.9 12c0-1.71.69-3.26 1.81-4.39L4.29 6.2A7.93 7.93 0 0 0 2 12c0 2.21.9 4.21 2.34 5.66l1.42-1.42A5.96 5.96 0 0 1 3.9 12zm4.2 0c0-1.08.87-1.95 1.95-1.95h3.9V8.1h-3.9a3.9 3.9 0 1 0 0 7.8h3.9v-1.95h-3.9A1.95 1.95 0 0 1 8.1 12zm1.95.98h3.9v-1.96h-3.9v1.96zm9.61-6.64-1.42 1.42A5.96 5.96 0 0 1 20.1 12c0 1.71-.69 3.26-1.81 4.39l1.42 1.41A7.93 7.93 0 0 0 22 12c0-2.21-.9-4.21-2.34-5.66zm-5.71 3.71h-1.95v3.9h1.95a1.95 1.95 0 1 0 0-3.9z" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="Sources" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SourceSummary}"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         Foreground="{DynamicResource Brush.TextTertiary}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding SourceCountText}"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- The everyday actions on a finished answer, one thumb-tap away instead of a selection drag.
             The negative margin keeps each 48dp target while aligning the glyphs with the text edge. -->
        <StackPanel x:Name="AnswerActions" Orientation="Horizontal"
                    Margin="-14,2,0,-8" IsVisible="{Binding ShowAnswerActions}">
          <Button x:Name="CopyAnswerButton" Classes="answer-action"
                  AutomationProperties.Name="Copy answer"
                  Click="OnCopyAnswerClick">
            <Panel>
              <PathIcon x:Name="CopyGlyph" Classes="copy-glyph"
                        Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
              <PathIcon x:Name="CopiedGlyph" Classes="copied-glyph"
                        Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
            </Panel>
          </Button>
          <Button x:Name="ShareAnswerButton" Classes="answer-action"
                  AutomationProperties.Name="Share answer"
                  IsVisible="{Binding CanShare}"
                  Click="OnShareAnswerClick">
            <PathIcon Data="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" />
          </Button>
        </StackPanel>

      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:InputRequestItemViewModel">
      <sc:StrataInteractiveBlock Definition="{Binding Definition}" StateJson="{Binding StateJson}"
                                Language="{Binding Language}" InputStatus="{Binding InputStatus}"
                                CanSubmit="{Binding CanSubmit}" IsHosted="True" TouchMode="True"
                                PickerHost="{Binding $parent[views:ChatDetailView].InteractivePickerHost}" />
    </DataTemplate>

    <DataTemplate DataType="vm:InteractionReceiptItemViewModel">
      <sc:StrataActionReceipt Title="{Binding Receipt.Title}" Summary="{Binding Receipt.Summary}"
                             Detail="{Binding Receipt.Detail}" Status="{Binding Receipt.Status}"
                             Error="{Binding Receipt.Error}" Action="{Binding Receipt.Action}"
                             Language="{Binding Language}" TouchMode="True" />
    </DataTemplate>

    <DataTemplate DataType="vm:WorkSummaryItemViewModel">
      <StackPanel Margin="0,4,0,6">
        <!-- A compact disclosure, not a full-width card: finished work is context, the answer is the
             content. The chevron turns as the steps open beneath it. -->
        <Button Classes="work-disclosure"
                Classes.expanded="{Binding IsExpanded}"
                Command="{Binding ToggleCommand}"
                AutomationProperties.Name="{Binding Label}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Classes="work-glyph"
                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm4.59-12.42L10 14.17l-2.59-2.58L6 13l4 4 8-8z" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            <PathIcon Classes="disclosure-chevron"
                      Data="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6z" />
          </StackPanel>
        </Button>
        <Border IsVisible="{Binding IsExpanded}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="2,0,0,0" Margin="8,6,0,0" Padding="12,0,0,2">
          <ItemsControl x:Name="WorkItems" ItemsSource="{Binding Items}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- One compact activity disclosure per contiguous work segment. Commands and raw output stay off the
         conversation surface; tapping loads them on demand in a bottom sheet. -->
    <DataTemplate DataType="vm:ActivitySummaryItemViewModel">
      <Button Classes="activity-card"
              Margin="0,4,0,6"
              Command="{Binding OpenCommand}">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Text="✓"
                       IsVisible="{Binding IsSucceeded}"
                       Foreground="{DynamicResource Brush.SuccessDefault}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="0"
                       Text="!"
                       IsVisible="{Binding IsFailed}"
                       Foreground="{DynamicResource Brush.DangerDefault}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="0"
                       Text="—"
                       IsVisible="{Binding IsStopped}"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <sc:StrataPulse Grid.Column="0"
                            IsLive="{Binding IsRunning}"
                            IsVisible="{Binding IsRunning}"
                            Width="10" Height="10"
                            VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SummaryText}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </Grid>

          <StackPanel IsVisible="{Binding HasFileChanges}" Spacing="5">
            <TextBlock Text="{Binding FileSummary}"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <ItemsControl ItemsSource="{Binding PreviewFileChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityFileChangeViewModel">
                  <Border Classes="activity-file" Margin="0,2">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <PathIcon Grid.Column="0" Width="15" Height="15"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 18H6V4h7v5h5v11z" />
                      <TextBlock Grid.Column="1" Text="{Binding Path}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource Font.SizeMeta}" />
                      <TextBlock Grid.Column="2" Text="{Binding Operation}"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding AdditionalFileChangesText}"
                       IsVisible="{Binding HasAdditionalFileChanges}"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- Reasoning -->
    <DataTemplate DataType="vm:ReasoningItemViewModel">
      <sc:StrataThink Classes="mobile-activity" Margin="0,4" Label="{Binding Label}" IsActive="{Binding IsStreaming}"
                      Content="{Binding Text}" />
    </DataTemplate>

    <!-- Tool group -->
    <DataTemplate DataType="vm:ToolGroupItemViewModel">
      <StackPanel Spacing="4" Margin="0,4">
        <ItemsControl ItemsSource="{Binding Tools}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolCallViewModel">
              <sc:StrataAiToolCall Classes="mobile-activity" ToolName="{Binding DisplayName}"
                                   Status="{Binding Status}"
                                   InputParameters="{Binding Input}"
                                   MoreInfo="{Binding Output}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Terminal command -->
    <DataTemplate DataType="vm:TerminalItemViewModel">
      <sc:StrataTerminalPreview Classes="mobile-activity" Margin="0,4" ToolName="{Binding ToolName}"
                                Command="{Binding Command}" Output="{Binding Output}"
                                Status="{Binding Status}" />
    </DataTemplate>

    <!-- Question -->
    <DataTemplate DataType="vm:QuestionItemViewModel">
      <sc:StrataQuestionCard x:Name="QuestionCard" Margin="0,6"
                             Question="{Binding Text}"
                             OptionsList="{Binding Options}"
                             AllowFreeText="{Binding AllowFreeText}"
                             AllowMultiSelect="{Binding AllowMultiSelect}"
                             IsAnswered="{Binding IsAnswered}"
                             SelectedAnswer="{Binding Answer}"
                             HasInput="{Binding HasAnswerDraft, Mode=OneWayToSource}"
                             AnswerSubmitted="OnQuestionAnswered" />
    </DataTemplate>

    <!-- Deliverables follow the reply, with a readable full-row target rather than compact input chips. -->
    <DataTemplate DataType="vm:FileItemViewModel">
      <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0" MaxWidth="560"
                    HorizontalAlignment="Stretch">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="proto:RemoteAttachment">
            <sc:StrataFileAttachment Classes="produced-file" FileName="{Binding FileName}"
                                     FileSize="{Binding Extension}"
                                     Status="Completed" IsRemovable="False"
                                     HorizontalAlignment="Stretch" MinHeight="64"
                                     AutomationProperties.Name="{Binding FileName, StringFormat='Open {0}'}"
                                     OpenRequested="OnProducedFileOpenRequested"
                                     Margin="0,0,0,8" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- Error -->
    <DataTemplate DataType="vm:ErrorItemViewModel">
      <Border Classes="mobile-card" Margin="0,6"
              BorderBrush="{DynamicResource Brush.BorderError}"
              Background="{DynamicResource Brush.DangerSubtle}">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.DangerDefault}" />
      </Border>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Panel x:Name="ChatRoot">
    <!--
      Ambient presence field. Sits behind everything and never takes a hit test: Lumi is *in* the
      room, not a control on it. State follows the conversation (dormant / idle / thinking /
      streaming) and it blooms when an answer lands.
    -->

    <sc:StrataChatShell x:Name="ChatShell"
                       Classes="mobile"
                       ExtendsTranscriptBehindChrome="True"
                       IsVisible="{Binding !Chat.IsGitChangesOpen}"
                        IsOnline="{Binding IsLive}"
                        IsStreaming="{Binding Chat.IsStreaming}">

      <sc:StrataChatShell.Header>
        <Panel x:Name="ChatHeaderLayer">
        <!-- Status-bar scrim: appears only while the conversation passes under the floating top bar,
             frosting it most at the screen edge. The bar's controls are glass of their own. -->
        <Panel x:Name="TopEdgeMaterial" Classes="chrome-edge" VerticalAlignment="Top">
          <sc:StrataBackdropBlur x:Name="TopEdgeFrost" Classes="chrome-frost" Fade="Bottom" FadeLength="0" />
          <Border x:Name="TopEdgeTint" Background="{DynamicResource Brush.ChromeEdgeTop}" />
          <Border Padding="{Binding SafeAreaTop}">
            <Panel Height="{DynamicResource Mobile.Chat.EdgeScrimExtent}" />
          </Border>
        </Panel>
        <Border x:Name="ChatHeaderSideInset" Padding="{Binding SafeAreaSides}">
          <StackPanel>
          <Border x:Name="TopBarInset" Padding="{Binding SafeAreaTop}" BorderThickness="0">
            <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                  MinHeight="{DynamicResource Touch.MinTarget}"
                  Margin="{DynamicResource Mobile.Navigation.HeaderMargin}"
                  HorizontalAlignment="Stretch">
          <!-- Hamburger: the single entry point to history, library and settings. -->
          <Button x:Name="MenuButton" Grid.Column="0" Classes="chat-header-action floating-action"
                  AutomationProperties.Name="{Binding NavigationToggleLabel}"
                  IsVisible="{Binding ShowMenuButton}" Command="{Binding ToggleDrawerCommand}">
            <PathIcon Width="{DynamicResource Touch.IconSizeSmall}" Height="{DynamicResource Touch.IconSizeSmall}"
                      Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
          </Button>

          <Button x:Name="HeaderDetailsButton" Grid.Column="1" Classes="chat-controls floating-action"
                  AutomationProperties.Name="{Binding Chat.ModelDisplayName, StringFormat='Chat controls: {0}'}"
                  AutomationProperties.HelpText="Model, reasoning effort, context, plan and workspace details"
                  Command="{Binding Chat.OpenRunSettingsSheetCommand}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock x:Name="HeaderModelText" Text="{Binding Chat.ModelDisplayName}"
                           FontSize="{DynamicResource Font.SizeBody}" FontWeight="Medium"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <PathIcon x:Name="HeaderControlsIcon" Grid.Column="1"
                          Width="{DynamicResource Touch.IconSizeSmall}" Height="{DynamicResource Touch.IconSizeSmall}"
                          VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                          Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
              </Grid>
          </Button>

            <Button x:Name="NewChatButton" Grid.Column="2" Classes="chat-header-action new-conversation floating-action"
                    AutomationProperties.Name="Start a new chat"
                    Command="{Binding ChatList.NewChatCommand}">
              <PathIcon Width="{DynamicResource Touch.IconSizeSmall}" Height="{DynamicResource Touch.IconSizeSmall}"
                        Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" />
            </Button>
          </Grid>
        </Border>

        <views:WebAppUpdateBannerView x:Name="ChatUpdateBanner" Margin="12,0" />

        <!--
          A paired phone must not go silent when the PC disappears. The transcript remains readable,
          while this compact status strip explains why new work is unavailable and disappears
          automatically when the link/host is healthy again.
        -->
        <Border x:Name="ConnectionBanner"
                IsVisible="{Binding ShowConnectionBanner}"
                Background="{DynamicResource Brush.Surface2}"
                BorderThickness="0"
                CornerRadius="14"
                HorizontalAlignment="Center"
                Margin="12,4,12,6"
                Padding="12,6">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <sc:StrataPulse x:Name="ConnectionRetryPulse"
                            IsVisible="{Binding !IsGatewaySignInRequired}"
                            IsLive="False" Width="10" Height="10" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding ConnectionBannerText}" TextWrapping="Wrap"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <Button x:Name="GatewaySignInButton"
                      IsVisible="{Binding ShowGatewaySignInAction}"
                      Content="Sign in again"
                      Classes="accent touch"
                      HorizontalAlignment="Left"
                      Command="{Binding ReloadWebAppCommand}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- A ready assistant is not a busy session. Keep attached work visible and explicitly
             stoppable without driving the composer or the assistant's typing indicator. -->
        <Panel x:Name="BackgroundSessionStatusHost"
               IsVisible="{Binding Chat.HasBackgroundActivity}"
               MaxWidth="{DynamicResource Chat.ReadingColumnWidth}"
               Margin="12,0,12,6">
        <sc:StrataBackdropBlur Classes="control-frost" CornerRadius="24" />
        <Border x:Name="BackgroundSessionStatus" Classes="floating-status">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{x:Static loc:ChatSessionStrings.ReadyWithBackgroundActivity}"
                     FontSize="{DynamicResource Font.SizeCaption}"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button x:Name="StopSessionButton" Grid.Column="1"
                  Classes="subtle touch"
                  Content="{x:Static loc:ChatSessionStrings.StopSession}"
                  Command="{Binding Chat.StopCommand}"
                  IsEnabled="{Binding IsLive}" />
        </Grid>
        </Border>
        </Panel>
        </StackPanel>
        </Border>
        </Panel>
      </sc:StrataChatShell.Header>

      <sc:StrataChatShell.Transcript>
        <Grid>
        <Border x:Name="ChatTranscriptSideInset" Padding="{Binding SafeAreaSides}">
        <StackPanel>
          <ProgressBar x:Name="TranscriptLoading"
                       Height="3"
                       Margin="0,4,0,8"
                       IsIndeterminate="True"
                       IsVisible="{Binding Chat.IsLoading}" />

          <StackPanel Margin="0,4,0,10"
                      Spacing="4"
                      IsVisible="{Binding Chat.HasEarlierMessages}">
            <Button x:Name="EarlierActivityButton"
                    Classes="subtle transcript-nav"
                    Content="Earlier activity"
                    Command="{Binding LoadEarlierActivityCommand}"
                    IsEnabled="{Binding Chat.CanNavigateTranscript}" />
            <TextBlock Text="{Binding Chat.WindowSummary}"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
          </StackPanel>

          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Chat.Turns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TranscriptTurnViewModel">
                <views:TranscriptTurnView Margin="0,0,0,10" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel x:Name="NewerActivityControls"
                      Margin="0,10,0,4"
                      Spacing="6"
                      IsVisible="{Binding Chat.HasLaterMessages}">
            <TextBlock Text="{Binding Chat.WindowSummary}"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
            <Button x:Name="NewerActivityButton"
                    Classes="subtle transcript-nav"
                    Content="{Binding Chat.NewerActivityLabel}"
                    Command="{Binding LoadNewerActivityCommand}"
                    IsEnabled="{Binding Chat.CanNavigateTranscript}" />
            <Button x:Name="ReturnToLatestButton"
                    Classes="subtle transcript-nav"
                    Content="Return to latest"
                    Command="{Binding ReturnToLatestCommand}"
                    IsEnabled="{Binding Chat.CanNavigateTranscript}" />
          </StackPanel>

          <Border x:Name="ChatError" Classes="mobile-card" Margin="0,8"
                  BorderBrush="{DynamicResource Brush.BorderError}"
                  IsVisible="{Binding Chat.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Chat.ErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.DangerDefault}" />
          </Border>

          <Border x:Name="TranscriptError" Classes="mobile-card" Margin="0,8"
                  BorderBrush="{DynamicResource Brush.BorderError}"
                  IsVisible="{Binding Chat.TranscriptErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Chat.TranscriptErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.DangerDefault}" />
          </Border>
        </StackPanel>
        </Border>
        <Border x:Name="ChatLoadingOverlay" IsVisible="False"
                IsHitTestVisible="False" Padding="{Binding SafeAreaSides}"
                Background="{DynamicResource Brush.ChatCanvas}">
          <StackPanel Margin="0,14,0,0" Spacing="24"
                      AutomationProperties.Name="Loading conversation">
            <Border Height="58" Width="210" HorizontalAlignment="Right" CornerRadius="18"
                    Background="{DynamicResource Brush.Surface2}" />
            <StackPanel Spacing="12" Margin="0,8,20,0"
                        sa:LifecycleOpacityPulse.IsActive="True"
                        sa:LifecycleOpacityPulse.FromOpacity="0.45"
                        sa:LifecycleOpacityPulse.ToOpacity="0.85"
                        sa:LifecycleOpacityPulse.Duration="0:0:0.8"
                        sa:LifecycleOpacityPulse.PlaybackDirection="Alternate">
              <Border Height="12" Width="220" HorizontalAlignment="Left" CornerRadius="6"
                      Background="{DynamicResource Brush.Surface2}" />
              <Border Height="10" CornerRadius="5" Background="{DynamicResource Brush.Surface2}" />
              <Border Height="10" Margin="0,0,42,0" CornerRadius="5" Background="{DynamicResource Brush.Surface2}" />
              <Border Height="10" Margin="0,0,90,0" CornerRadius="5" Background="{DynamicResource Brush.Surface2}" />
            </StackPanel>
            <TextBlock Text="Loading conversation..." Classes="muted" />
          </StackPanel>
        </Border>
        </Grid>
      </sc:StrataChatShell.Transcript>

      <sc:StrataChatShell.Composer>
        <Panel x:Name="ComposerLayer">
        <!-- Gesture-area scrim while history passes under the floating composer, which is glass of its
             own. It reaches the screen edges; behind an open keyboard there is nothing to frost. -->
        <Panel x:Name="BottomEdgeMaterial" Classes="chrome-edge" VerticalAlignment="Bottom"
               Margin="{DynamicResource Mobile.Chat.BottomEdgeMargin}">
          <sc:StrataBackdropBlur x:Name="BottomEdgeFrost" Classes="chrome-frost" Fade="Top" FadeLength="0" />
          <Border x:Name="BottomEdgeTint" Background="{DynamicResource Brush.ChromeEdgeBottom}" />
          <StackPanel>
            <Panel Height="{DynamicResource Mobile.Chat.EdgeScrimExtent}" />
            <Border Padding="{Binding SafeAreaBottom}" IsVisible="{Binding !IsKeyboardOpen}" />
          </StackPanel>
        </Panel>
        <!-- Bottom inset lives here: the gesture bar normally, the keyboard while it is open. -->
        <Border x:Name="ComposerInset" Padding="{Binding SafeAreaBottom}">
          <Border x:Name="ComposerSideInset" Padding="{Binding SafeAreaSides}">
          <StackPanel MaxWidth="{DynamicResource Chat.ReadingColumnWidth}">
          <sc:StrataTypingIndicator x:Name="ChatTyping" Classes="mobile-working" Margin="8,0,8,8"
                                    Label="{Binding Chat.WorkingStatusText}"
                                    IsActive="{Binding Chat.IsWorking}"
                                    IsVisible="{Binding Chat.IsWorking}"
                                    AutomationProperties.Name="{Binding Chat.WorkingStatusText}" />
          <sc:StrataChatComposer x:Name="Composer"
                               Classes="mobile"
                               IsCompact="True"
                               MaxWidth="{DynamicResource Chat.ReadingColumnWidth}"
                               PromptText="{Binding Chat.PromptText, Mode=TwoWay}"
                               PreferAutoCompleteAbove="True"
                               IsBusy="{Binding Chat.IsBusy}"
                               SendWithEnter="False"
                               SteerWhileBusy="True"
                               CanAttach="True"
                               AttachCommand="{Binding Chat.PickAttachmentCommand}"
                               CanVoice="False"
                               Placeholder="Message Lumi"
                               SendCommand="{Binding Chat.SendCommand}"
                               StopCommand="{Binding Chat.StopCommand}"
                               StopAndSendCommand="{Binding Chat.StopAndSendCommand}"
                               Models="{Binding Chat.AvailableModels}"
                               SelectedModel="{Binding Chat.Model, Mode=TwoWay}"
                               QualityLevels="{Binding Chat.QualityLevels}"
                               SelectedQuality="{Binding Chat.Quality, Mode=TwoWay}"
                               ContextWindowTiers="{Binding Chat.ContextWindowTiers}"
                               SelectedContextWindowTier="{Binding Chat.ContextWindowTier, Mode=TwoWay}"
                               AgentName="{Binding Chat.AgentName, Mode=TwoWay}"
                               AgentValue="{Binding Chat.AgentValue, Mode=TwoWay}"
                               AgentGlyph="{Binding Chat.AgentGlyph}"
                               ProjectName="{Binding Chat.ProjectName, Mode=TwoWay}"
                               ProjectValue="{Binding Chat.ProjectValue, Mode=TwoWay}"
                               SkillItems="{Binding Chat.SkillChips}"
                               McpItems="{Binding Chat.McpChips}"
                               AvailableAgents="{Binding Chat.AvailableAgents}"
                               AvailableSkills="{Binding Chat.AvailableSkills}"
                               AvailableMcps="{Binding Chat.AvailableMcps}"
                               AvailableProjects="{Binding Chat.AvailableProjects}"
                               AvailableFiles="{Binding Chat.AvailableFiles}"
                               AgentRemovedCommand="{Binding Chat.RemoveAgentCommand}"
                               ProjectRemovedCommand="{Binding Chat.RemoveProjectCommand}"
                               SkillRemovedCommand="{Binding Chat.RemoveSkillCommand}"
                               McpRemovedCommand="{Binding Chat.RemoveMcpCommand}"
                               FileQueryChangedCommand="{Binding Chat.SearchFilesCommand}"
                               FileSelectedCommand="{Binding Chat.SelectFileCommand}">
          <!-- One run-settings affordance. Model, effort and context are one decision surface, not
               three permanent toolbar controls competing with the prompt. -->
          <sc:StrataChatComposer.LeadingContent>
              <Button x:Name="ComposerAttachButton" Classes="composer-toolbar-icon"
                      AutomationProperties.Name="Attach a file"
                      Command="{Binding Chat.PickAttachmentCommand}">
                <PathIcon Width="20" Height="20"
                          Data="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7V4z" />
              </Button>
          </sc:StrataChatComposer.LeadingContent>
          <sc:StrataChatComposer.ToolbarContent>
              <Button x:Name="ComposerRunSettingsButton" Classes="composer-pill"
                      AutomationProperties.Name="Choose model and chat settings"
                      Command="{Binding Chat.OpenRunSettingsSheetCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
                  <TextBlock Text="{Binding Chat.ModelDisplayName}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="140" />
                </StackPanel>
              </Button>
          </sc:StrataChatComposer.ToolbarContent>

          <!-- Files already uploaded to the PC, waiting on the next message. -->
          <sc:StrataChatComposer.AttachmentContent>
            <ItemsControl x:Name="PendingAttachments" ItemsSource="{Binding Chat.Attachments}"
                          IsVisible="{Binding Chat.HasAttachments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingAttachment">
                  <Border Classes="attachment-chip" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 18H6V4h7v5h5v11z" />
                      <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="170" />
                      <Button Classes="chip-remove"
                              AutomationProperties.Name="{Binding FileName, StringFormat='Remove {0}'}"
                              Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Chat.RemoveAttachmentCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Width="11" Height="11"
                                  Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </sc:StrataChatComposer.AttachmentContent>
          </sc:StrataChatComposer>
          </StackPanel>
          </Border>
        </Border>
        </Panel>
      </sc:StrataChatShell.Composer>
    </sc:StrataChatShell>

    <!-- A blank chat stays local until the first send. The welcome yields to the keyboard. -->
    <Border x:Name="WelcomeSideInset"
            Padding="{Binding SafeAreaSides}"
            Margin="0,0,0,110"
            ClipToBounds="True"
            IsVisible="{Binding IsWelcomeVisible}">
      <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden"
                    VerticalAlignment="Center">
      <StackPanel x:Name="NoChatPlaceholder" IsVisible="{Binding IsWelcomeVisible}"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="20" Margin="20,24" MaxWidth="420">
        <StackPanel Spacing="10" Margin="2,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                      Foreground="{DynamicResource Brush.AccentDefault}"
                      Data="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z" />
            <TextBlock Text="New conversation" FontSize="{DynamicResource Font.SizeMeta}"
                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="GreetingText" Text="{Binding Greeting}"
                     FontSize="{DynamicResource Font.SizeHeadline}" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="WelcomeBrief" Text="{Binding NewChatBrief}" Classes="supporting"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasStartSetups}">
          <TextBlock Text="{Binding StartSetupsTitle}" Classes="group-label" Margin="2,0" />
          <ItemsControl x:Name="WelcomeSetups" ItemsSource="{Binding StartSetups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatStartSetup">
                <Button x:Name="StartSetupCard" Classes="start-setup"
                        Classes.selected="{Binding IsSelected}" Margin="0,0,0,8"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).UseStartSetupCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title, StringFormat='Start with {0}'}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="32" Height="32" CornerRadius="10"
                            Background="{DynamicResource Brush.AccentSubtle}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Glyph}" FontSize="{DynamicResource Font.SizeBody}"
                                 Foreground="{DynamicResource Brush.AccentDefault}" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                 TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Description}"
                                 FontSize="{DynamicResource Font.SizeMeta}"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <PathIcon Grid.Column="2" Width="16" Height="16" IsVisible="{Binding IsSelected}"
                              VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentDefault}"
                              Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6">
        <TextBlock Text="Start with an idea" Classes="group-label" Margin="2,0" />
        <ItemsControl x:Name="WelcomeStarters" ItemsSource="{Binding Chat.Starters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatStarter">
              <Button Classes="starter" Margin="0,0,0,2"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Chat.UseSuggestionCommand}"
                      CommandParameter="{Binding EffectivePrompt}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <PathIcon Grid.Column="0" Data="{Binding IconData}" Width="20" Height="20"
                            IsVisible="{Binding !HasGlyph}"
                            Foreground="{DynamicResource Brush.AccentDefault}" />
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" IsVisible="{Binding HasGlyph}"
                             FontSize="{DynamicResource Font.SizeBody}" Width="20" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}"
                             FontSize="{DynamicResource Font.SizeBody}" VerticalAlignment="Center"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        <TextBlock Text="Update Lumi on your computer to sync its chat setups here."
                   IsVisible="{Binding !HasDesktopNewChat}" Classes="muted"
                   TextWrapping="Wrap" Margin="2,0" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <sc:StrataBottomSheet x:Name="JobWakeSheet" Classes="safe-area"
                          IsOpen="{Binding Chat.IsJobWakeSheetOpen, Mode=TwoWay}"
                          Title="Job details">
      <Border x:Name="JobWakeSideInset">
        <ScrollViewer Classes="mobile-scroll" MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding Chat.SelectedJobWake}" Margin="{DynamicResource Mobile.Sheet.ContentMargin}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:JobWakeItemViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Details.JobName}" FontWeight="SemiBold"
                               FontSize="{DynamicResource Font.SizeSubtitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Classes="sheet-body" />
                  </StackPanel>
                  <Border Classes="sheet-card">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="HasStarted" />
                        <Binding Path="HasCompleted" />
                        <Binding Path="HasExitCode" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasStarted}">
                        <TextBlock Text="Started" Classes="sheet-body" />
                        <TextBlock Grid.Column="1" Text="{Binding Details.StartedText}" FontSize="15"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasCompleted}">
                        <TextBlock Text="Completed" Classes="sheet-body" />
                        <TextBlock Grid.Column="1" Text="{Binding Details.CompletedText}" FontSize="15"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasExitCode}">
                        <TextBlock Text="Exit code" Classes="sheet-body" />
                        <TextBlock Grid.Column="1" Text="{Binding Details.ExitCode}" FontSize="15"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="8" IsVisible="{Binding HasInstructions}">
                    <TextBlock Text="Instructions" Classes="sheet-label" Margin="4,0" />
                    <Border Classes="sheet-card">
                      <SelectableTextBlock Text="{Binding Details.Instructions}"
                                           FontSize="15" LineHeight="22" TextWrapping="Wrap"
                                           behaviors:NativeTextSelection.IsEnabled="True"
                                           behaviors:NativeTextSelection.Text="{Binding Details.Instructions}" />
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding HasOutput}">
                    <TextBlock Text="Output" Classes="sheet-label" Margin="4,0" />
                    <Border Classes="sheet-card">
                      <SelectableTextBlock Text="{Binding Details.OutputText}"
                                           FontFamily="{DynamicResource Font.FamilyMono}"
                                           FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                           behaviors:NativeTextSelection.IsEnabled="True"
                                           behaviors:NativeTextSelection.Text="{Binding Details.OutputText}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>

    <!-- The chat is the subject: its title heads the sheet and its project sits beneath it. -->
    <sc:StrataBottomSheet x:Name="RunSettingsSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsRunSettingsSheetOpen, Mode=TwoWay}"
                          Title="{Binding ChatDetailsTitle}"
                          Description="{Binding Chat.ProjectName}">
      <Border x:Name="RunSettingsSideInset">
        <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,8">
          <Button x:Name="PlanButton" Classes="sheet-item"
                  IsVisible="{Binding Chat.HasPlan}"
                  Command="{Binding Chat.OpenPlanFromRunSettingsCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7-.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zM19 19H5V5h14v14zM7 15h7v2H7v-2zm0-4h10v2H7v-2zm0-4h10v2H7V7z" />
              <TextBlock Grid.Column="1" Text="Plan" VerticalAlignment="Center" />
              <PathIcon Grid.Column="2" Classes="sheet-chevron" Data="M9 5 7.6 6.4 13.2 12 7.6 17.6 9 19l7-7-7-7z" />
            </Grid>
          </Button>
          <Button x:Name="GitChangesButton" Classes="sheet-item"
                  IsVisible="{Binding Chat.HasChat}"
                  AutomationProperties.Name="Git changes"
                  Command="{Binding Chat.OpenGitChangesFromRunSettingsCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M7 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm0 2a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm10 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm0 2a1 1 0 1 1 0 2 1 1 0 0 1 0-2zM6 7v9a3 3 0 1 0 2 0v-2h4a6 6 0 0 0 6-6h-2a4 4 0 0 1-4 4H8V7H6zm1 11a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
              <TextBlock Grid.Column="1" Text="Git changes" VerticalAlignment="Center" />
              <PathIcon Grid.Column="2" Classes="sheet-chevron" Data="M9 5 7.6 6.4 13.2 12 7.6 17.6 9 19l7-7-7-7z" />
            </Grid>
          </Button>

          <TextBlock Text="Preferences" Classes="sheet-label" />
          <Button x:Name="RunSettingsModelButton" Classes="sheet-item"
                  Command="{Binding Chat.OpenModelFromRunSettingsCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <PathIcon Classes="sheet-leading"
                        Data="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z" />
              <TextBlock Grid.Column="1" Text="Model" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.ModelDisplayName}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="M9 5 7.6 6.4 13.2 12 7.6 17.6 9 19l7-7-7-7z" />
            </Grid>
          </Button>

          <Button x:Name="RunSettingsEffortButton" Classes="sheet-item"
                  Command="{Binding Chat.OpenEffortFromRunSettingsCommand}"
                  IsEnabled="{Binding Chat.HasQualityLevels}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <PathIcon Classes="sheet-leading"
                        Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
              <TextBlock Grid.Column="1" Text="Reasoning effort" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.EffortLabel}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="M9 5 7.6 6.4 13.2 12 7.6 17.6 9 19l7-7-7-7z" />
            </Grid>
          </Button>

          <Button x:Name="RunSettingsContextButton" Classes="sheet-item"
                  Command="{Binding Chat.OpenContextFromRunSettingsCommand}"
                  IsEnabled="{Binding Chat.HasContextWindowTiers}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <PathIcon Classes="sheet-leading"
                        Data="M4 4h16v16H4V4zm2 2v12h12V6H6zm2 2h8v2H8V8zm0 4h8v2H8v-2z" />
              <TextBlock Grid.Column="1" Text="Context window" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.ContextWindowLabel}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="M9 5 7.6 6.4 13.2 12 7.6 17.6 9 19l7-7-7-7z" />
            </Grid>
          </Button>

          <Border x:Name="ContextMeter" Classes="context-meter"
                  Classes.warn="{Binding Chat.IsContextWarn}"
                  Classes.critical="{Binding Chat.IsContextCritical}"
                  IsVisible="{Binding Chat.HasContextUsage}" Margin="16,12,16,0"
                  Padding="16,14" CornerRadius="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="Context used" FontWeight="Medium" />
                <TextBlock x:Name="ContextText" Grid.Column="1" Text="{Binding Chat.ContextUsageText}"
                           FontWeight="SemiBold" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Chat.ContextPercent}" Height="4" />
              <TextBlock Text="{Binding Chat.ContextDetailText}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border x:Name="RunSettingsWorkspace"
                  Classes="sheet-card"
                  IsVisible="{Binding Chat.CanChooseWorktree}"
                  Margin="16,12,16,0">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="Workspace" FontWeight="SemiBold" />
                <TextBlock Text="Choose where the first coding turn runs."
                           Classes="muted"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="LocalWorkspaceButton"
                        Grid.Column="0"
                        Classes="theme-option"
                        Classes.selected="{Binding Chat.IsLocalWorkspaceSelected}"
                        Command="{Binding Chat.SelectLocalWorkspaceCommand}"
                        Content="Local checkout" />
                <Button x:Name="WorktreeWorkspaceButton"
                        Grid.Column="1"
                        Classes="theme-option"
                        Classes.selected="{Binding Chat.UseWorktree}"
                        Command="{Binding Chat.SelectNewWorktreeCommand}"
                        Content="New worktree" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="ModelSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsModelSheetOpen, Mode=TwoWay}"
                          Title="Model">
      <Border x:Name="ModelSheetSideInset">
        <ScrollViewer Classes="mobile-scroll" MaxHeight="520" Padding="0,0,0,4"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ItemsControl x:Name="ModelSheetList" ItemsSource="{Binding Chat.ModelGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelProviderGroup">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Classes="sheet-label" />
                    <ItemsControl ItemsSource="{Binding Options}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PickerOption">
                          <Button Classes="sheet-item model-option" Classes.selected="{Binding IsSelected}"
                                  AutomationProperties.Name="{Binding Label}"
                                  Command="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.PickModelCommand}"
                                  CommandParameter="{Binding Name}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                              <PathIcon Grid.Column="1" Classes="sheet-check" IsVisible="{Binding IsSelected}"
                                        Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="ContextSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsContextSheetOpen, Mode=TwoWay}"
                          Title="Context window"
                          Description="How much of the conversation the model keeps in view.">
      <Border x:Name="ContextSheetSideInset">
        <ScrollViewer Classes="mobile-scroll" MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Chat.ContextTierOptions}" Margin="0,0,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PickerOption">
              <Button Classes="sheet-item context-option" Classes.selected="{Binding IsSelected}"
                      AutomationProperties.Name="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Chat.PickContextTierCommand}"
                      CommandParameter="{Binding Name}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <PathIcon Grid.Column="1" Classes="sheet-check" IsVisible="{Binding IsSelected}"
                            Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>

    <!--
      Reasoning effort. A slider rather than a list because effort is an ORDERED scale — low through
      high — and stacked rows hide that ordering while costing three taps to explore.
    -->
    <sc:StrataBottomSheet x:Name="EffortSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsEffortSheetOpen, Mode=TwoWay}"
                          Title="Reasoning effort"
                          Description="More effort gives more thorough answers, but takes longer.">
      <Border x:Name="EffortSheetSideInset">
        <StackPanel Margin="{DynamicResource Mobile.Sheet.ContentMargin}" Spacing="4">
          <TextBlock Text="{Binding Chat.EffortLabel}"
                     FontSize="{DynamicResource Font.SizeTitle}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,4,0,8" />

          <Slider x:Name="EffortSlider"
                  MinHeight="{DynamicResource Touch.MinTarget}"
                  AutomationProperties.Name="Reasoning effort"
                  Minimum="0"
                  Maximum="{Binding Chat.EffortMax}"
                  Value="{Binding Chat.EffortIndex, Mode=TwoWay}"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  TickPlacement="Outside" />

          <!-- The ends of the scale, so the slider reads without having to drag it to find out. -->
          <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Faster" Classes="muted"
                       HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="More thorough" Classes="muted"
                       HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>
    </sc:StrataBottomSheet>
    <!-- Plan, on demand. A sheet keeps a long plan scrollable and dismissible instead of wedging a
         full-height card into the conversation. -->
    <sc:StrataBottomSheet x:Name="PlanSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsPlanOpen, Mode=TwoWay}"
                          Title="Plan">
      <ScrollViewer Classes="mobile-scroll" MaxHeight="440"
                    Padding="24,0,24,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
        <!--
          ScrollViewer must measure a layout container, not the markdown control directly. With the
          direct child, the sheet's bottom-aligned measure and markdown's desired-size updates fed
          each other indefinitely when the plan opened. The same StackPanel boundary used by the
          model sheet keeps the scroll extent stable.
        -->
        <Border x:Name="PlanSheetSideInset" Padding="{Binding SafeAreaSides}">
          <StackPanel Margin="0,0,0,12">
            <sc:StrataMarkdown Markdown="{Binding Chat.PlanContent}" IsInline="True" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="SourcesSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsSourcesSheetOpen, Mode=TwoWay}"
                          Title="Sources">
      <Border x:Name="SourcesSheetSideInset">
        <ContentControl Content="{Binding Chat.SelectedSourceAnswer}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:AssistantItemViewModel">
              <ScrollViewer Classes="mobile-scroll" MaxHeight="560"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="proto:RemoteSource">
                      <Button Classes="sheet-item source-option" Padding="16,12"
                              Click="OnSourceClick">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Snippet}"
                                       IsVisible="{Binding Snippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{DynamicResource Font.SizeMeta}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Url}"
                                       IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{DynamicResource Font.SizeCaption}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <PathIcon Grid.Column="1" Classes="sheet-chevron" Width="16" Height="16"
                                    Data="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h5V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5h-2v5H5V5z" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="ActivitySheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsActivitySheetOpen, Mode=TwoWay}"
                          Title="How Lumi worked">
      <Border x:Name="ActivitySheetSideInset">
        <ContentControl Content="{Binding Chat.SelectedActivity}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ActivitySummaryItemViewModel">
              <ScrollViewer Classes="mobile-scroll" MaxHeight="560"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="{DynamicResource Mobile.Sheet.ContentMargin}" Spacing="16">
            <TextBlock Text="{Binding SummaryText}"
                       Classes="sheet-body" />

            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         IsVisible="{Binding IsLoadingDetails}" />

            <TextBlock Text="{Binding DetailsError}"
                       IsVisible="{Binding DetailsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Brush.DangerDefault}"
                       TextWrapping="Wrap" />

            <StackPanel IsVisible="{Binding HasFileChanges}" Spacing="8">
              <TextBlock Text="{Binding FileSummary}" Classes="sheet-label" Margin="4,0" />
              <ItemsControl ItemsSource="{Binding FileChanges}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityFileChangeViewModel">
                    <Border Classes="activity-file" Margin="0,2">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Grid.Column="0" Width="18" Height="18"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource Brush.TextSecondary}"
                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 18H6V4h7v5h5v11z" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding FileName}"
                                     FontWeight="Medium"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Path}"
                                     FontSize="{DynamicResource Font.SizeCaption}"
                                     Foreground="{DynamicResource Brush.TextTertiary}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Operation}"
                                     FontSize="{DynamicResource Font.SizeCaption}"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding StatsText}"
                                     IsVisible="{Binding HasStats}"
                                     FontSize="{DynamicResource Font.SizeCaption}"
                                     Foreground="{DynamicResource Brush.SuccessDefault}"
                                     HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Sections}"
                          IsVisible="{Binding HasSections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivitySectionViewModel">
                  <StackPanel Spacing="8" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="sheet-label" Margin="0" />
                      <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Steps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityStepViewModel">
                          <Border Classes="activity-file" Margin="0,2">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="✓"
                                           IsVisible="{Binding IsSucceeded}"
                                           Foreground="{DynamicResource Brush.SuccessDefault}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="0"
                                           Text="!"
                                           IsVisible="{Binding IsFailed}"
                                           Foreground="{DynamicResource Brush.DangerDefault}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="0"
                                           Text="—"
                                           IsVisible="{Binding IsStopped}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <sc:StrataPulse Grid.Column="0"
                                                IsLive="True"
                                                IsVisible="{Binding IsRunning}"
                                                Width="9" Height="9"
                                                VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                           FontSize="{DynamicResource Font.SizeCaption}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Center" />
                              </Grid>
                              <StackPanel IsVisible="{Binding ShowTechnicalDetails}" Spacing="5">
                                <TextBlock Text="{Binding Input}"
                                           IsVisible="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="{DynamicResource Font.SizeCaption}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Output}"
                                           IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="{DynamicResource Font.SizeCaption}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           TextWrapping="Wrap"
                                           MaxLines="10" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="sheet-action"
                    IsVisible="{Binding CanShowTechnicalDetails}"
                    Command="{Binding ToggleTechnicalDetailsCommand}"
                    Content="{Binding TechnicalDetailsLabel}" />
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </sc:StrataBottomSheet>
    <Border x:Name="GitChangesOverlay" IsVisible="{Binding Chat.IsGitChangesOpen}"
            Background="{DynamicResource Brush.Surface0}" Padding="{Binding SafeArea}">
      <views:GitChangesView DataContext="{Binding Chat}" />
    </Border>
  </Panel>
</UserControl>
