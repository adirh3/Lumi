<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:proto="using:Lumi.Remote.Protocol"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:sa="using:StrataTheme.Animation"
             x:Class="Lumi.Mobile.Views.ChatDetailView"
             x:DataType="vm:MobileShellViewModel"
             FlowDirection="{x:Static loc:ChatSessionStrings.UiFlowDirection}"
             sc:StrataTextSelection.IsTouchSelectionEnabled="False"
             Background="{DynamicResource Brush.ChatCanvas}">

  <UserControl.Styles>
    <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_HeaderContainer">
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The floating top bar's scroll-edge glass extends below the bar, so it must not be clipped. -->
    <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_HeaderChrome">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <!-- The user's bubble: the desktop's, a step larger for the phone's 16dp text. -->
    <Style Selector="sc|StrataChatMessage.mobile-message:user /template/ Border#PART_Bubble">
      <Setter Property="Background" Value="{DynamicResource Brush.ChatUserSurface}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,10,14,11" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="sc|StrataChatMessage.mobile-message:user /template/ Grid#PART_MetaRow">
      <Setter Property="Margin" Value="0,0,4,5" />
    </Style>
    <Style Selector="sc|StrataChatMessage.mobile-message:user /template/ Grid#PART_MetaRow TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <!-- The desktop's hover toolbar beside a message never shows on a phone, so it must not keep its
         room either: it would squeeze every bubble into a narrow column. -->
    <Style Selector="sc|StrataChatMessage.mobile-message /template/ Border#PART_ActionLayer">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--
      Comfortable reading column. On an unfolded fold or a tablet the conversation would otherwise
      run the full width of the pane, which reads badly. A max width with the default Stretch
      alignment centres the column, so wide screens gain whitespace instead of longer lines.
    -->
    <Style Selector="sc|StrataChatShell /template/ Border#PART_ScrollContent">
      <Setter Property="MaxWidth" Value="{DynamicResource Chat.ReadingColumnWidth}" />
    </Style>

    <!-- The top bar owns the full width: the hamburger must sit hard left and the new-chat
         button hard right, which a content-sized presenter inside a DockPanel will not do. -->
    <Style Selector="sc|StrataChatShell /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="DockPanel.Dock" Value="Top" />
    </Style>

    <!-- Mobile owns its own top-bar/status chrome. Keeping Strata's desktop header separator as well
         produced two stacked hairlines above the transcript. -->
    <Style Selector="sc|StrataChatShell:has-header /template/ Border#PART_HeaderSeparator">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="0" />
    </Style>

    <!-- The chat shell reports when history is behind its floating bars. -->
    <Style Selector="sc|StrataChatShell:content-under-header Panel#TopEdgeMaterial,
                     sc|StrataChatShell:content-under-composer Panel#BottomEdgeMaterial">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.floating-status">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="16,0,4,0" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingGlass}" />
    </Style>

    <!-- The jump-to-latest control floats over moving history, so it is the floating glass with its own
         frost, drawn 44 dp inside its 48 dp target as the other glass buttons are, and a press lowers
         it as it does them. -->
    <Style Selector="sc|StrataChatShell.mobile /template/ sc|StrataBackdropBlur#PART_ScrollToBottomBackdrop">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="BlurRadius" Value="{DynamicResource Glass.FloatingBlurRadius}" />
      <Setter Property="Saturation" Value="{DynamicResource Glass.FloatingSaturation}" />
    </Style>
    <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_ScrollToBottomChrome">
      <Setter Property="Margin" Value="2" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingGlass}" />
    </Style>
    <Style Selector="sc|StrataChatShell.mobile /template/ Button#PART_ScrollToBottomButton:pressed Border#PART_ScrollToBottomChrome">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlassPressed}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingGlassPressed}" />
    </Style>

    <!--
      ══ The new chat ══
      The desktop's launchpad at phone scale. Lumi's mark sits in its presence over the greeting, the
      user's name in the accent; the starters for the hour follow as calm glass pills; and the user's
      usual setups sit on the composer they configure, where the thumb already is. The actions are the
      composer's own glass, so everything that can be tapped reads as one material.
    -->
    <Style Selector="Border.welcome-mark">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <!-- The icon's own rounded square, so the soft pool of its colour beneath follows its shape. -->
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,18" />
      <Setter Property="BoxShadow" Value="0 12 30 -12 #B36C5CE7" />
    </Style>
    <Style Selector="TextBlock.welcome-greeting">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeHeadline}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.welcome-brief">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="LineHeight" Value="{DynamicResource Font.LineHeightMeta}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="StackPanel#WelcomeLaunch">
      <Setter Property="Margin" Value="16,24" />
    </Style>
    <!-- Short screens keep the greeting, the starters and the setups in view, and let the mark go. -->
    <Style Selector="Grid#NoChatPlaceholder.compact Border.welcome-mark">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid#NoChatPlaceholder.compact StackPanel#WelcomeLaunch">
      <Setter Property="Margin" Value="16,8" />
    </Style>

    <!-- A starter: a calm glass pill, 42 dp drawn inside its 48 dp target, that fills the composer. -->
    <Style Selector="Button.welcome-starter">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Padding" Value="12,8,14,8" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.welcome-starter /template/ Panel">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.welcome-starter /template/ Border#PART_Surface,
                     Button.welcome-starter:pointerover /template/ Border#PART_Surface">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.welcome-starter /template/ Border#PART_FocusRing">
      <Setter Property="Margin" Value="-2,1" />
    </Style>
    <Style Selector="Button.welcome-starter:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlassPressed}" />
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.welcome-starter /template/ Border#PART_Aurora,
                     Button.welcome-setup /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.welcome-starter TextBlock.welcome-starter-label">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.welcome-starter TextBlock.welcome-starter-glyph">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.welcome-starter sc|StrataLineIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>

    <!-- The setups' heading, as the desktop words it ("Start with"). The row beneath runs to the screen's
         edges, so a card scrolls in from beyond them. -->
    <Style Selector="TextBlock.welcome-label">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Margin" Value="18,0,18,8" />
    </Style>
    <!-- A setup: a glass card on the composer with the desktop tile's mark, its place and how it runs. -->
    <Style Selector="Button.welcome-setup">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="10,8,14,8" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="MinWidth" Value="172" />
      <Setter Property="MaxWidth" Value="248" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.welcome-setup /template/ Border#PART_Surface,
                     Button.welcome-setup:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlass}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.FloatingGlassRim}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingGlass}" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Button.welcome-setup:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.FloatingGlassPressed}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingGlassPressed}" />
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.welcome-setup.selected /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Border.welcome-setup-mark">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Brush.RowTile}" />
    </Style>
    <Style Selector="Border.welcome-setup-mark TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Applied: a small accent check settles on the mark, cut out of the card by a ring of its fill. -->
    <Style Selector="Border.welcome-setup-check">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Margin" Value="0,-5,-5,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ChatCanvas}" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.4)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.welcome-setup.selected Border.welcome-setup-check">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Border.welcome-setup-check sc|StrataLineIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="StrokeThickness" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    </Style>
    <Style Selector="TextBlock.welcome-setup-title">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.welcome-setup-meta">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Button.welcome-setup.selected TextBlock.welcome-setup-meta">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>

    <Style Selector="Button.transcript-nav">
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.answer-action /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.answer-action">
      <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Each glyph sits at the edge its target shares with the next, so the glyphs are a short step
         apart while every target stays 48dp; the footer then follows a short step after the last. -->
    <Style Selector="Button.answer-action.leading">
      <Setter Property="Padding" Value="18,0,0,0" />
    </Style>
    <Style Selector="StackPanel.answer-actions TextBlock.answer-footer">
      <Setter Property="Margin" Value="6.5,0,0,0" />
    </Style>
    <Style Selector="StackPanel.answer-actions.can-share TextBlock.answer-footer">
      <Setter Property="Margin" Value="-11.5,0,0,0" />
    </Style>
    <Style Selector="Button.answer-action /template/ Border#PART_Surface,
                     Button.answer-action:pointerover /template/ Border#PART_Surface,
                     Button.answer-action:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Panel.answer-glyph-host">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <!-- A press lights a small circle around the glyph, not the whole target. -->
    <Style Selector="Border.answer-halo">
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.answer-action:pressed Border.answer-halo">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
    </Style>
    <Style Selector="Button.answer-action:pressed Panel.answer-glyph-host">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <!-- The desktop's message actions: its stroked copy and share glyphs, drawn in their 16-unit box. -->
    <Style Selector="Button.answer-action Viewbox">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.answer-action Path.answer-glyph">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.answer-action Viewbox.copied-glyph">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.6)" />
    </Style>
    <Style Selector="Button.answer-action Viewbox.copied-glyph Path.answer-glyph">
      <Setter Property="Stroke" Value="{DynamicResource Brush.SuccessDefault}" />
    </Style>
    <Style Selector="Button.answer-action.copied Viewbox.copy-glyph">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.6)" />
    </Style>
    <Style Selector="Button.answer-action.copied Viewbox.copied-glyph">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <!--
      ══ Transcript work on glass ══════════════════════════════════════════════════════════════
      The desktop transcript's language at touch size: everything Lumi did sits on Strata's glass
      chips (Brush.Glass*), chips that open something carry a chevron, line icons say what each
      step is, only live work takes the accent and only failures the danger colour. Chips are a
      38dp glass pill inside a 48dp touch band, text a step larger than the desktop's (14 for 12.5).
    -->
    <Style Selector="Button.transcript-chip">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,0,13,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.transcript-chip /template/ Border#PART_Surface">
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="Button.transcript-chip /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.transcript-chip:pointerover /template/ Border#PART_Surface,
                     Button.transcript-chip:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="Button.transcript-chip:pressed /template/ Border#PART_Surface">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <!-- Strata styles every TextBlock as body text, so a chip's words take its size and colour here. -->
    <Style Selector="Button.transcript-chip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="Button.transcript-chip TextBlock.chip-meta">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Button.transcript-chip sc|StrataLineIcon.chip-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button.transcript-chip sc|StrataLineIcon.chip-chevron">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <!-- Live work: the accent on its icon and words, and the Strata line under the chip. -->
    <Style Selector="Button.transcript-chip.live sc|StrataLineIcon.chip-icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button.transcript-chip.live TextBlock.chip-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.transcript-chip.failed sc|StrataLineIcon.chip-icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="Border.single-step-line">
      <Setter Property="Height" Value="1.5" />
      <Setter Property="Margin" Value="14,0,14,5" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource Brush.StratumLine}" />
      <Setter Property="OpacityMask">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="0.15" Color="#FF000000" />
          <GradientStop Offset="0.85" Color="#FF000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.35" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="TextBlock.diff-added, TextBlock.diff-removed">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="TextBlock.diff-added">
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
    </Style>
    <Style Selector="TextBlock.diff-removed">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>

    <!-- Strata's chip-to-card controls (reasoning, the turn summary) at touch size. -->
    <Style Selector="sc|StrataThink.touch /template/ Border#PART_Pill">
      <Setter Property="CornerRadius" Value="19" />
    </Style>
    <Style Selector="sc|StrataThink.touch:expanded /template/ Border#PART_Pill,
                     sc|StrataThink.touch:activity /template/ Border#PART_Pill">
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="sc|StrataThink.touch /template/ Border#PART_Header">
      <Setter Property="Padding" Value="12,10,13,10" />
    </Style>
    <Style Selector="sc|StrataThink.touch:expanded /template/ Border#PART_Header,
                     sc|StrataThink.touch:activity /template/ Border#PART_Header">
      <Setter Property="Padding" Value="14,12,13,12" />
    </Style>
    <Style Selector="sc|StrataThink.touch /template/ TextBlock#PART_LabelText">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="MaxWidth" Value="Infinity" />
    </Style>
    <Style Selector="sc|StrataThink.touch /template/ TextBlock#PART_MetaText">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    </Style>
    <Style Selector="sc|StrataThink.touch /template/ sc|StrataLineIcon#PART_Icon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
    </Style>
    <!-- A full touch target; the summary's negative margins keep the transcript's spacing as it was. -->
    <Style Selector="sc|StrataTurnSummary.touch /template/ Border#PART_Header">
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="CornerRadius" Value="24" />
    </Style>
    <Style Selector="sc|StrataTurnSummary.touch /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    </Style>
    <Style Selector="sc|StrataTurnSummary.touch /template/ sc|StrataLineIcon#PART_Glyph,
                     sc|StrataTurnSummary.touch /template/ sc|StrataLineIcon#PART_FailureGlyph">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
    </Style>
    <Style Selector="sc|StrataTurnSummary.touch /template/ sc|StrataLineIcon#PART_ExpandIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
    </Style>
    <!-- On a phone the folded work hangs nearer the edge: the reading column is narrow. -->
    <Style Selector="sc|StrataTurnSummary.touch /template/ #PART_ContentHost > Border">
      <Setter Property="Margin" Value="17,2,0,0" />
      <Setter Property="Padding" Value="12,4,0,4" />
    </Style>

    <!-- Files Lumi made or used: the glass chip, the file's type on a quiet tile, no status stripe. -->
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ Border#PART_Stratum">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ Grid#PART_ContentGrid">
      <Setter Property="Margin" Value="8,8,14,8" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ Border#PART_IconBox">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ Image#PART_IconImage">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ TextBlock#PART_FileName">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="MaxWidth" Value="240" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ StackPanel#PART_MetaRow TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    </Style>
    <Style Selector="sc|StrataFileAttachment.transcript-file /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- A question at the phone's rungs: Strata sizes its options and reply field for touch; its label,
         and once answered its one line and the answer, take the caption and meta rungs. -->
    <Style Selector="sc|StrataQuestionCard:touch /template/ StackPanel#PART_Body > StackPanel > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    </Style>
    <Style Selector="sc|StrataQuestionCard:touch /template/ DockPanel#PART_AnsweredRow > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    </Style>
    <Style Selector="sc|StrataQuestionCard:touch /template/ TextBlock#PART_AnswerText">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    </Style>
    <!-- Inside the user's bubble the chip sits on the accent, so it keeps to a neutral glass. -->
    <Style Selector="sc|StrataChatMessage:user sc|StrataFileAttachment.transcript-file /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="WrapPanel.transcript-files">
      <Setter Property="ItemSpacing" Value="8" />
      <Setter Property="LineSpacing" Value="8" />
    </Style>

    <!-- A step from a host that sends steps one by one stands as its own glass chip, as a lone step
         does on the desktop; Strata draws steps as rows of a card otherwise. -->
    <Style Selector="sc|StrataAiToolCall.single-step /template/ Border#PART_Root,
                     sc|StrataTerminalPreview.single-step /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="sc|StrataAiToolCall.single-step:expanded /template/ Border#PART_Root,
                     sc|StrataTerminalPreview.single-step:expanded /template/ Border#PART_Root">
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="sc|StrataAiToolCall.single-step /template/ Border#PART_Header,
                     sc|StrataTerminalPreview.single-step /template/ Border#PART_Header">
      <Setter Property="Padding" Value="11,9,13,9" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- An error: the step's glass, the danger colour only on its icon. -->
    <Style Selector="Border.transcript-error">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
      <Setter Property="Padding" Value="13,9,14,10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A job that woke the chat: a glass card that opens what it brought. -->
    <Style Selector="Button.transcript-card">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="13,11,13,12" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.transcript-card /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="Button.transcript-card /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.transcript-card:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>

    <!-- Rows in the work and sources sheets: flat until pressed, a line icon, title and detail. -->
    <Style Selector="Border.transcript-row">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    </Style>
    <Style Selector="sc|StrataLineIcon.row-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="sc|StrataLineIcon.row-icon.live">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="sc|StrataLineIcon.row-icon.failed">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="TextBlock.step-title">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.row-detail">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.step-title.stopped">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <!-- Details and console output, recessed into the sheet. -->
    <Style Selector="Border.transcript-well">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassWell}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassDivider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10,12,11" />
      <Setter Property="Margin" Value="28,4,0,4" />
    </Style>
    <Style Selector="TextBlock.console-text">
      <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <!-- The user's turn: the desktop's bubble with "You · 16:40" over it and what they attached inside. -->
    <DataTemplate DataType="vm:UserTurnItemViewModel">
      <StackPanel Spacing="4" Margin="48,16,0,6">
        <sc:StrataChatMessage Role="User" Classes="mobile-message"
                              HorizontalAlignment="Right"
                              Author="{Binding Author}"
                              Timestamp="{Binding TimestampText}">
          <sc:StrataChatMessage.Content>
            <StackPanel Spacing="8">
              <!-- Spaced as the desktop's bubbles are (Segoe UI's own line height, 1.33 of the text's size). -->
              <SelectableTextBlock x:Name="UserMessageText" Text="{Binding Text, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                   IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource Font.SizeBody}"
                                   LineHeight="{DynamicResource Font.LineHeightBody}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   behaviors:NativeTextSelection.IsEnabled="True"
                                   behaviors:NativeTextSelection.Text="{Binding Text, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" />
              <ItemsControl x:Name="UserAttachments" ItemsSource="{Binding Attachments}"
                            IsVisible="{Binding HasAttachments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Classes="transcript-files" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="proto:RemoteAttachment">
                    <sc:StrataFileAttachment Classes="transcript-file"
                                             FileName="{Binding FileName}"
                                             FileSize="{Binding Extension, Converter={x:Static views:FileTypeLabelConverter.Instance}}"
                                             IconImage="{Binding FileName, Converter={x:Static views:FileTypeIconConverter.Instance}}"
                                             Status="Completed"
                                             IsRemovable="False" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </sc:StrataChatMessage.Content>
        </sc:StrataChatMessage>
        <TextBlock Text="{Binding SteerStatusText}"
                   IsVisible="{Binding HasSteerStatus}"
                   HorizontalAlignment="Right"
                   Margin="0,-2,8,0"
                   FontSize="{DynamicResource Font.SizeCaption}"
                   Foreground="{DynamicResource Brush.TextTertiary}" />
      </StackPanel>
    </DataTemplate>

    <!-- A job that woke this chat, on the desktop's glass card; it opens what the job brought. -->
    <DataTemplate DataType="vm:JobWakeItemViewModel">
      <Button x:Name="JobWakeEvent" Classes="transcript-card" Margin="0,14,0,8"
              Command="{Binding OpenCommand}"
              AutomationProperties.Name="{Binding Details.JobName, StringFormat={loc:Str JobWakeNamed}}">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <sc:StrataLineIcon Width="17" Height="17" Margin="0,2,11,0" VerticalAlignment="Top"
                             Data="{x:Static sc:StrataIcons.Clock}"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{loc:Str JobWokeChat}"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
            <TextBlock Text="{Binding Details.JobName}"
                       FontSize="{DynamicResource Font.SizeMeta}" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="10,0,0,0">
            <TextBlock Text="{Binding TimestampText}"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
            <sc:StrataLineIcon Width="13" Height="13" StrokeThickness="2" VerticalAlignment="Center"
                               Data="{x:Static sc:StrataIcons.ChevronRight}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                     Text="{Binding Summary}"
                     FontSize="{DynamicResource Font.SizeMeta}"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Button>
    </DataTemplate>

    <!--
      Assistant answer. NO bubble: ChatGPT, Claude and Gemini all render the assistant as plain
      full-width text on the page background, and only the user gets a bubble. On a phone that is
      not a style choice — a bubble around a long answer wastes horizontal room the text needs, and
      the asymmetry is what makes the two speakers instantly distinguishable while scrolling.
    -->
    <DataTemplate DataType="vm:AssistantItemViewModel">
      <StackPanel Margin="0,6,0,4" Spacing="6">
        <!-- IsInline drops StrataMarkdown's card surface. An answer is the page, not a document
             pinned to it, and a card border here would just be a bubble by another name. -->
        <sc:StrataMarkdown Markdown="{Binding Text, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                           InteractionStates="{Binding InteractionStates}"
                           InteractionLanguage="{Binding InteractionLanguage}"
                           InteractionTouchMode="True"
                           InteractionPickerHost="{Binding $parent[views:ChatDetailView].InteractivePickerHost}"
                           InteractionsHosted="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.SupportsInteractiveResponses}"
                           CanSubmitInteractions="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.CanSubmitInteractions}"
                           IsInline="True"
                           RetainContentOnDetach="True"
                           behaviors:NativeTextSelection.IsEnabled="True"
                           behaviors:NativeTextSelection.Text="{Binding SelectionText}" />

        <!-- The files this turn made, as the desktop's file chips: tap one to open it. -->
        <ItemsControl x:Name="AnswerFiles" ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}"
                      Margin="0,4,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Classes="transcript-files" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="proto:RemoteAttachment">
              <sc:StrataFileAttachment Classes="transcript-file" FileName="{Binding FileName}"
                                       FileSize="{Binding Extension, Converter={x:Static views:FileTypeLabelConverter.Instance}}"
                                       IconImage="{Binding FileName, Converter={x:Static views:FileTypeIconConverter.Instance}}"
                                       Status="Completed" IsRemovable="False"
                                       AutomationProperties.Name="{Binding FileName, StringFormat={loc:Str OpenNamed}}"
                                       OpenRequested="OnProducedFileOpenRequested" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Where the answer came from: the desktop's sources chip, opening the list. -->
        <Button x:Name="SourcesChip" Classes="transcript-chip"
                IsVisible="{Binding HasSources}"
                Command="{Binding OpenSourcesCommand}"
                AutomationProperties.Name="{Binding SourceCountText}">
          <DockPanel>
            <sc:StrataLineIcon DockPanel.Dock="Left" Classes="chip-icon" Data="{x:Static sc:StrataIcons.Globe}" />
            <sc:StrataLineIcon DockPanel.Dock="Right" Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
            <TextBlock DockPanel.Dock="Left" Classes="chip-label" Text="{Binding SourceCountText}" />
            <TextBlock Classes="chip-meta" Text="{Binding SourceDomains}"
                       IsVisible="{Binding SourceDomains, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </DockPanel>
        </Button>

        <!-- The everyday actions on a finished answer, then which model answered and when, as on the
             desktop: glyphs a short step apart, then the footer. Each action keeps a full 48dp target, so
             each glyph sits at the edge its target shares with its neighbour; the copy target reaches
             into the gutter so its glyph lines up with the text. -->
        <StackPanel x:Name="AnswerActions" Orientation="Horizontal"
                    Classes="answer-actions" Classes.can-share="{Binding CanShare}"
                    Margin="-23.5,-4,0,-10" IsVisible="{Binding ShowAnswerActions}">
          <Button x:Name="CopyAnswerButton" Classes="answer-action leading"
                  AutomationProperties.Name="{loc:Str CopyAnswer}"
                  Click="OnCopyAnswerClick">
            <Panel Classes="answer-glyph-host">
              <Border Classes="answer-halo" />
              <Viewbox x:Name="CopyGlyph" Classes="copy-glyph">
                <Canvas Width="16" Height="16">
                  <Path Classes="answer-glyph" Data="{DynamicResource Icon.MessageCopy}" />
                </Canvas>
              </Viewbox>
              <Viewbox x:Name="CopiedGlyph" Classes="copied-glyph">
                <Canvas Width="16" Height="16">
                  <Path Classes="answer-glyph" Data="{DynamicResource Icon.MessageCopied}" />
                </Canvas>
              </Viewbox>
            </Panel>
          </Button>
          <Button x:Name="ShareAnswerButton" Classes="answer-action trailing"
                  AutomationProperties.Name="{loc:Str ShareAnswer}"
                  IsVisible="{Binding CanShare}"
                  Click="OnShareAnswerClick">
            <Panel Classes="answer-glyph-host">
              <Border Classes="answer-halo" />
              <Viewbox>
                <Canvas Width="16" Height="16">
                  <Path Classes="answer-glyph" Data="{DynamicResource Icon.MessageShare}" />
                </Canvas>
              </Viewbox>
            </Panel>
          </Button>
          <TextBlock x:Name="AnswerFooter" Text="{Binding FooterText}"
                     Classes="answer-footer"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource Font.SizeCaption}"
                     Foreground="{DynamicResource Brush.TextTertiary}"
                     TextTrimming="CharacterEllipsis" MaxLines="1" />
        </StackPanel>

      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:InputRequestItemViewModel">
      <sc:StrataInteractiveBlock Definition="{Binding Definition}" StateJson="{Binding StateJson}"
                                Language="{Binding Language}" InputStatus="{Binding InputStatus}"
                                CanSubmit="{Binding CanSubmit}" IsHosted="True" TouchMode="True"
                                PickerHost="{Binding $parent[views:ChatDetailView].InteractivePickerHost}" />
    </DataTemplate>

    <DataTemplate DataType="vm:InteractionReceiptItemViewModel">
      <sc:StrataActionReceipt Title="{Binding Receipt.Title}" Summary="{Binding Receipt.Summary}"
                             Detail="{Binding Receipt.Detail}" Status="{Binding Receipt.Status}"
                             Error="{Binding Receipt.Error}" Action="{Binding Receipt.Action}"
                             Language="{Binding Language}" TouchMode="True" />
    </DataTemplate>

    <!-- Finished work folds behind Strata's turn summary, as on the desktop: "Worked for 2m · 6 actions".
         Tapping it opens the steps hanging from a hairline; they are built the first time it opens. -->
    <DataTemplate DataType="vm:WorkSummaryItemViewModel">
      <sc:StrataTurnSummary x:Name="WorkSummary" Classes="touch" Margin="-10,-2,0,-2"
                            Label="{Binding Label}"
                            HasFailures="{Binding HasFailures}"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Label}">
        <sc:StrataTurnSummary.Content>
          <ItemsControl x:Name="WorkItems" ItemsSource="{Binding Items}" />
        </sc:StrataTurnSummary.Content>
      </sc:StrataTurnSummary>
    </DataTemplate>

    <!-- A stretch of work: one glass chip that says what Lumi is doing, or how it went, and opens its
         steps. Live work takes the accent and carries the Strata line; a failure, the danger icon. -->
    <DataTemplate DataType="vm:ActivitySummaryItemViewModel">
      <Panel HorizontalAlignment="Left" Margin="0,1">
        <Button x:Name="ActivityChip" Classes="transcript-chip"
                Classes.live="{Binding IsRunning}"
                Classes.failed="{Binding IsFailed}"
                Command="{Binding OpenCommand}"
                AutomationProperties.Name="{Binding SummaryText}">
          <DockPanel>
            <Panel DockPanel.Dock="Left">
              <sc:StrataLineIcon Classes="chip-icon" IsVisible="{Binding !IsFailed}"
                                 Data="{Binding IconKey, Converter={x:Static views:TranscriptIconConverter.Instance}}" />
              <sc:StrataLineIcon Classes="chip-icon" IsVisible="{Binding IsFailed}"
                                 Data="{x:Static sc:StrataIcons.Alert}" />
            </Panel>
            <sc:StrataLineIcon DockPanel.Dock="Right" Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
                        IsVisible="{Binding HasLineStats}">
              <TextBlock Classes="diff-added" Text="{Binding LinesAddedText}" />
              <TextBlock Classes="diff-removed" Text="{Binding LinesRemovedText}" IsVisible="{Binding HasLinesRemoved}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Classes="chip-label" Text="{Binding ChipLabel}" />
            <TextBlock Classes="chip-meta" Text="{Binding ChipMeta}"
                       IsVisible="{Binding ChipMeta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </DockPanel>
        </Button>
        <Border Classes="single-step-line" IsVisible="{Binding IsRunning}" />
      </Panel>
    </DataTemplate>

    <!-- Reasoning, from a host that sends it on its own: Strata's chip that opens into a card. -->
    <DataTemplate DataType="vm:ReasoningItemViewModel">
      <sc:StrataThink Classes="touch" Margin="0,3" Label="{Binding Label}" Meta="{Binding Summary}"
                      Icon="{x:Static sc:StrataIcons.Lightbulb}"
                      IsActive="{Binding IsStreaming}" MaxContentHeight="320">
        <sc:StrataThink.Content>
          <TextBlock Margin="8,0,8,6" Text="{Binding Text, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" TextWrapping="Wrap"
                     FontSize="{DynamicResource Font.SizeMeta}" LineHeight="{DynamicResource Font.LineHeightMeta}"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </sc:StrataThink.Content>
      </sc:StrataThink>
    </DataTemplate>

    <!-- Steps, from a host that sends them one by one: each a glass step with its line icon. -->
    <DataTemplate DataType="vm:ToolGroupItemViewModel">
      <ItemsControl ItemsSource="{Binding Tools}" Margin="0,3">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolCallViewModel">
            <sc:StrataAiToolCall Classes="single-step" HorizontalAlignment="Left"
                                 ToolName="{Binding DisplayName}"
                                 Icon="{Binding IconKey, Converter={x:Static views:TranscriptIconConverter.Instance}}"
                                 Status="{Binding Status}"
                                 InputParameters="{Binding Input, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                 MoreInfo="{Binding Output, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- A command, from a host that sends it on its own. -->
    <DataTemplate DataType="vm:TerminalItemViewModel">
      <sc:StrataTerminalPreview Classes="single-step" Margin="0,3" HorizontalAlignment="Left" ToolName="{Binding ToolName}"
                                Command="{Binding Command, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" Output="{Binding Output, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                Status="{Binding Status}" />
    </DataTemplate>

    <!-- A question Lumi asks: Strata's glass card, folded to one line once answered. -->
    <DataTemplate DataType="vm:QuestionItemViewModel">
      <sc:StrataQuestionCard x:Name="QuestionCard" TouchMode="True" Margin="0,4"
                             FreeTextPlaceholder="{loc:Str AnswerPlaceholder}"
                             Question="{Binding Text}"
                             OptionsList="{Binding Options}"
                             AllowFreeText="{Binding AllowFreeText}"
                             AllowMultiSelect="{Binding AllowMultiSelect}"
                             IsAnswered="{Binding IsAnswered, Mode=TwoWay}"
                             SelectedAnswer="{Binding Answer, Mode=TwoWay}"
                             HasInput="{Binding HasAnswerDraft, Mode=OneWayToSource}"
                             AnswerSubmitted="OnQuestionAnswered" />
    </DataTemplate>

    <!-- Files Lumi makes while a turn is still under way follow its work as the desktop's file chips;
         once an answer closes the turn they move into it. -->
    <DataTemplate DataType="vm:FileItemViewModel">
      <ItemsControl x:Name="ProducedFiles" ItemsSource="{Binding Files}" Margin="0,4,0,2">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Classes="transcript-files" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="proto:RemoteAttachment">
            <sc:StrataFileAttachment Classes="transcript-file" FileName="{Binding FileName}"
                                     FileSize="{Binding Extension, Converter={x:Static views:FileTypeLabelConverter.Instance}}"
                                     IconImage="{Binding FileName, Converter={x:Static views:FileTypeIconConverter.Instance}}"
                                     Status="Completed" IsRemovable="False"
                                     AutomationProperties.Name="{Binding FileName, StringFormat={loc:Str OpenNamed}}"
                                     OpenRequested="OnProducedFileOpenRequested" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- An error: the step's glass, the danger colour only on its icon, as on the desktop. -->
    <DataTemplate DataType="vm:ErrorItemViewModel">
      <Border x:Name="TranscriptError" Classes="transcript-error" Margin="0,4">
        <Grid ColumnDefinitions="Auto,*">
          <sc:StrataLineIcon Width="17" Height="17" Margin="0,2,10,0" VerticalAlignment="Top"
                             Data="{x:Static sc:StrataIcons.Alert}"
                             Foreground="{DynamicResource Brush.DangerDefault}" />
          <TextBlock Grid.Column="1" Text="{Binding Text, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" TextWrapping="Wrap"
                     FontSize="{DynamicResource Font.SizeMeta}" LineHeight="{DynamicResource Font.LineHeightMeta}"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel x:Name="ChatRoot">
    <!--
      Ambient presence field. Sits behind everything and never takes a hit test: Lumi is *in* the
      room, not a control on it. State follows the conversation (dormant / idle / thinking /
      streaming) and it blooms when an answer lands.
    -->

    <sc:StrataChatShell x:Name="ChatShell"
                       Classes="mobile"
                       ExtendsTranscriptBehindChrome="True"
                       Margin="{Binding ChatSidePanelInset}"
                       IsVisible="{Binding !Chat.IsGitChangesOpen}"
                        IsOnline="{Binding IsLive}"
                        IsStreaming="{Binding Chat.IsStreaming}">

      <sc:StrataChatShell.Header>
        <Panel x:Name="ChatHeaderLayer">
        <!-- While the conversation passes under the floating top bar it dissolves into a frosted veil
             that covers the bar and fades out just below it, as on the desktop and the other pages.
             The bar's controls are glass of their own. -->
        <Panel x:Name="TopEdgeMaterial" Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
          <sc:StrataBackdropBlur x:Name="TopEdgeFrost" Classes="chrome-frost" Fade="Bottom"
                                 FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
          <Border x:Name="TopEdgeTint" Background="{DynamicResource Brush.PageEdgeTop}" />
        </Panel>
        <Border x:Name="ChatHeaderSideInset" Padding="{Binding SafeAreaSides}">
          <StackPanel>
          <Border x:Name="TopBarInset" Padding="{Binding SafeAreaTop}" BorderThickness="0">
            <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                  MinHeight="{DynamicResource Touch.MinTarget}"
                  Margin="{DynamicResource Mobile.Navigation.HeaderMargin}"
                  HorizontalAlignment="Stretch">
          <!-- One pane: back to the chat list. Two panes: show or hide the list beside the chat. -->
          <Button x:Name="MenuButton" Grid.Column="0" Classes="chat-header-action floating-action"
                  AutomationProperties.Name="{Binding NavigationToggleLabel}"
                  IsVisible="{Binding ShowMenuButton}" Command="{Binding ToggleDrawerCommand}">
            <Panel>
              <PathIcon x:Name="MenuBackIcon" Width="24" Height="24"
                        IsVisible="{Binding ShowBackToChats}"
                        Data="{DynamicResource Mobile.Icon.Back}" />
              <!-- Two panes: the desktop's sidebar toggle, a frame whose list column empties while
                   the chats are hidden and fills again when they come back. -->
              <Panel x:Name="MenuSidebarIcon" Classes="sidebar-glyph"
                     Classes.collapsed="{Binding IsSidebarCollapsed}"
                     IsVisible="{Binding !ShowBackToChats}">
                <Border Classes="sidebar-glyph-frame" />
                <Border Classes="sidebar-glyph-column" />
              </Panel>
            </Panel>
          </Button>

          <!-- The chat itself, as the desktop's title pill: its mark, its title, and its project in the
               room the title leaves. It opens the chat's details. -->
          <Button x:Name="HeaderDetailsButton" Grid.Column="1" Classes="chat-controls floating-action"
                  Classes.no-mark="{Binding !HasChatHeaderMark}"
                  AutomationProperties.Name="{Binding ChatDetailsTitle, StringFormat={loc:Str ChatDetailsNamed}}"
                  AutomationProperties.HelpText="{loc:Str ChatDetailsHelp}"
                  Command="{Binding Chat.OpenRunSettingsSheetCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border x:Name="HeaderMark" Classes="chat-mark" Margin="0,0,10,0"
                        IsVisible="{Binding HasChatHeaderMark}"
                        Background="{Binding ChatHeaderMark.Background}">
                  <TextBlock Text="{Binding ChatHeaderMark.Glyph}"
                             Foreground="{Binding ChatHeaderMark.Foreground}" />
                </Border>
                <!-- The project takes only the room the title leaves, so it trims away first. -->
                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="HeaderTitleText" DockPanel.Dock="Left" Classes="chat-header-title"
                             Text="{Binding ChatDetailsTitle}" />
                  <TextBlock x:Name="HeaderProjectText" Classes="chat-header-project"
                             Text="{Binding Chat.ProjectName}"
                             IsVisible="{Binding Chat.ProjectName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </DockPanel>
                <PathIcon x:Name="HeaderControlsIcon" Grid.Column="2" Classes="chat-header-chevron"
                          Data="{DynamicResource Mobile.Icon.ChevronDown}" />
              </Grid>
          </Button>

            <Button x:Name="NewChatButton" Grid.Column="2" Classes="chat-header-action new-conversation floating-action"
                    AutomationProperties.Name="{loc:Str StartNewChat}"
                    IsVisible="{Binding ShowHeaderNewChat}"
                    Command="{Binding ChatList.NewChatCommand}">
              <sc:StrataLineIcon Classes="header-glyph accent" Data="{x:Static sc:StrataIcons.Pencil}" />
            </Button>
          </Grid>
        </Border>

        <views:WebAppUpdateBannerView x:Name="ChatUpdateBanner" Margin="12,0" />

        <!--
          A paired phone must not go silent when the PC disappears. The transcript remains readable,
          while this compact status strip explains why new work is unavailable and disappears
          automatically when the link/host is healthy again. It floats in the bar, so it is glass.
        -->
        <Panel x:Name="ConnectionBannerHost"
               IsVisible="{Binding ShowConnectionBanner}"
               HorizontalAlignment="Center"
               Margin="12,4,12,6">
        <sc:StrataBackdropBlur Classes="floating-frost" CornerRadius="{Binding #ConnectionBanner.CornerRadius}" />
        <Border x:Name="ConnectionBanner"
                Classes="floating-banner"
                Padding="14,8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <sc:StrataPulse x:Name="ConnectionRetryPulse"
                            IsVisible="{Binding !IsGatewaySignInRequired}"
                            IsLive="False" Width="10" Height="10"
                            VerticalAlignment="Top" Margin="0,3,0,0" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{Binding ConnectionBannerText}" TextWrapping="Wrap"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <Button x:Name="RetryConnectionButton"
                      IsVisible="{Binding ShowRetryConnectionAction}"
                      Content="{loc:Str Retry}"
                      Classes="accent touch"
                      HorizontalAlignment="Left"
                      Command="{Binding RetryConnectionCommand}" />
              <Button x:Name="GatewaySignInButton"
                      IsVisible="{Binding ShowGatewaySignInAction}"
                      Content="{loc:Str SignInAgain}"
                      Classes="accent touch"
                      HorizontalAlignment="Left"
                      Command="{Binding ReloadWebAppCommand}" />
            </StackPanel>
          </Grid>
        </Border>
        </Panel>
        <!-- A ready assistant is not a busy session. Keep attached work visible and explicitly
             stoppable without driving the composer or the assistant's typing indicator. -->
        <Panel x:Name="BackgroundSessionStatusHost"
               IsVisible="{Binding Chat.HasBackgroundActivity}"
               MaxWidth="{DynamicResource Chat.ReadingColumnWidth}"
               Margin="12,0,12,6">
        <sc:StrataBackdropBlur Classes="floating-frost" CornerRadius="{Binding #BackgroundSessionStatus.CornerRadius}" />
        <Border x:Name="BackgroundSessionStatus" Classes="floating-status">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{x:Static loc:ChatSessionStrings.ReadyWithBackgroundActivity}"
                     FontSize="{DynamicResource Font.SizeCaption}"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button x:Name="StopSessionButton" Grid.Column="1"
                  Classes="subtle touch"
                  Content="{x:Static loc:ChatSessionStrings.StopSession}"
                  Command="{Binding Chat.StopCommand}"
                  IsEnabled="{Binding IsLive}" />
        </Grid>
        </Border>
        </Panel>
        </StackPanel>
        </Border>
        </Panel>
      </sc:StrataChatShell.Header>

      <sc:StrataChatShell.Transcript>
        <Grid>
        <Border x:Name="ChatTranscriptSideInset" Padding="{Binding SafeAreaSides}">
        <StackPanel>
          <ProgressBar x:Name="TranscriptLoading"
                       Height="3"
                       Margin="0,4,0,8"
                       IsIndeterminate="True"
                       IsVisible="{Binding Chat.IsLoading}" />

          <StackPanel Margin="0,4,0,10"
                      Spacing="4"
                      IsVisible="{Binding Chat.HasEarlierMessages}">
            <Button x:Name="EarlierActivityButton"
                    Classes="subtle transcript-nav"
                    Content="{loc:Str EarlierActivity}"
                    Command="{Binding LoadEarlierActivityCommand}"
                    IsEnabled="{Binding Chat.CanNavigateTranscript}" />
            <TextBlock Text="{Binding Chat.WindowSummary}"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
          </StackPanel>

          <ItemsControl x:Name="Transcript" ItemsSource="{Binding Chat.Turns}" FlowDirection="LeftToRight">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TranscriptTurnViewModel">
                <views:TranscriptTurnView Margin="0,0,0,10" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel x:Name="NewerActivityControls"
                      Margin="0,10,0,4"
                      Spacing="6"
                      IsVisible="{Binding Chat.HasLaterMessages}">
            <TextBlock Text="{Binding Chat.WindowSummary}"
                       HorizontalAlignment="Center"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
            <Button x:Name="NewerActivityButton"
                    Classes="subtle transcript-nav"
                    Content="{Binding Chat.NewerActivityLabel}"
                    Command="{Binding LoadNewerActivityCommand}"
                    IsEnabled="{Binding Chat.CanNavigateTranscript}" />
            <Button x:Name="ReturnToLatestButton"
                    Classes="subtle transcript-nav"
                    Content="{loc:Str ReturnToLatest}"
                    Command="{Binding ReturnToLatestCommand}"
                    IsEnabled="{Binding Chat.CanNavigateTranscript}" />
          </StackPanel>

          <Border x:Name="ChatError" Classes="mobile-card" Margin="0,8"
                  BorderBrush="{DynamicResource Brush.BorderError}"
                  IsVisible="{Binding Chat.ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Chat.ErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.DangerDefault}" />
          </Border>

          <Border x:Name="TranscriptError" Classes="mobile-card" Margin="0,8"
                  BorderBrush="{DynamicResource Brush.BorderError}"
                  IsVisible="{Binding Chat.TranscriptErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Chat.TranscriptErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.DangerDefault}" />
          </Border>
        </StackPanel>
        </Border>
        <!-- While a slow chat loads, its outline breathes over the canvas. No backdrop of its own: the
             transcript it replaces has already faded out, and Lumi's presence stays visible behind. -->
        <Border x:Name="ChatLoadingOverlay" IsVisible="False"
                IsHitTestVisible="False" Padding="{Binding SafeAreaSides}">
          <StackPanel Margin="0,14,0,0" Spacing="24"
                      AutomationProperties.Name="{loc:Str LoadingConversation}">
            <Border Height="58" Width="210" HorizontalAlignment="Right" CornerRadius="18"
                    Background="{DynamicResource Brush.Surface2}" />
            <StackPanel Spacing="12" Margin="0,8,20,0"
                        sa:LifecycleOpacityPulse.IsActive="True"
                        sa:LifecycleOpacityPulse.FromOpacity="0.45"
                        sa:LifecycleOpacityPulse.ToOpacity="0.85"
                        sa:LifecycleOpacityPulse.Duration="0:0:0.8"
                        sa:LifecycleOpacityPulse.PlaybackDirection="Alternate">
              <Border Height="12" Width="220" HorizontalAlignment="Left" CornerRadius="6"
                      Background="{DynamicResource Brush.Surface2}" />
              <Border Height="10" CornerRadius="5" Background="{DynamicResource Brush.Surface2}" />
              <Border Height="10" Margin="0,0,42,0" CornerRadius="5" Background="{DynamicResource Brush.Surface2}" />
              <Border Height="10" Margin="0,0,90,0" CornerRadius="5" Background="{DynamicResource Brush.Surface2}" />
            </StackPanel>
            <TextBlock Text="{loc:Str LoadingConversationEllipsis}" Classes="muted" />
          </StackPanel>
        </Border>
        </Grid>
      </sc:StrataChatShell.Transcript>

      <sc:StrataChatShell.Composer>
        <Panel x:Name="ComposerLayer">
        <!-- Gesture-area scrim while history passes under the floating composer, which is glass of its
             own. It reaches the screen edges; behind an open keyboard there is nothing to frost. -->
        <Panel x:Name="BottomEdgeMaterial" Classes="chrome-edge" VerticalAlignment="Bottom"
               Margin="{DynamicResource Mobile.Chat.BottomEdgeMargin}">
          <sc:StrataBackdropBlur x:Name="BottomEdgeFrost" Classes="chrome-frost" Fade="Top" FadeLength="0" />
          <Border x:Name="BottomEdgeTint" Background="{DynamicResource Brush.ChromeEdgeBottom}" />
          <StackPanel>
            <Panel Height="{DynamicResource Mobile.Chat.EdgeScrimExtent}" />
            <Border Padding="{Binding SafeAreaBottom}" IsVisible="{Binding !IsKeyboardOpen}" />
          </StackPanel>
        </Panel>
        <!-- Bottom inset lives here: the gesture bar normally, the keyboard while it is open. -->
        <Border x:Name="ComposerInset" Padding="{Binding SafeAreaBottom}">
          <Border x:Name="ComposerSideInset" Padding="{Binding SafeAreaSides}">
          <StackPanel MaxWidth="{DynamicResource Chat.ReadingColumnWidth}">
          <sc:StrataTypingIndicator x:Name="ChatTyping" Classes="mobile-working" Margin="8,0,8,8"
                                    Label="{Binding Chat.WorkingStatusText}"
                                    IsActive="{Binding Chat.IsWorking}"
                                    IsVisible="{Binding Chat.IsWorking}"
                                    AutomationProperties.Name="{Binding Chat.WorkingStatusText}" />
          <sc:StrataChatComposer x:Name="Composer"
                               FlowDirection="LeftToRight"
                               Classes="mobile"
                               IsCompact="True"
                               MaxWidth="{DynamicResource Chat.ReadingColumnWidth}"
                               PromptText="{Binding Chat.PromptText, Mode=TwoWay}"
                               PreferAutoCompleteAbove="True"
                               IsBusy="{Binding Chat.IsBusy}"
                               SendWithEnter="False"
                               SteerWhileBusy="True"
                               CanAttach="True"
                               AttachCommand="{Binding Chat.PickAttachmentCommand}"
                               CanVoice="False"
                               Placeholder="{loc:Str MessageLumi}"
                               SendCommand="{Binding Chat.SendCommand}"
                               StopCommand="{Binding Chat.StopCommand}"
                               StopAndSendCommand="{Binding Chat.StopAndSendCommand}"
                               Models="{Binding Chat.AvailableModels}"
                               SelectedModel="{Binding Chat.Model, Mode=TwoWay}"
                               QualityLevels="{Binding Chat.QualityLevels}"
                               SelectedQuality="{Binding Chat.Quality, Mode=TwoWay}"
                               ContextWindowTiers="{Binding Chat.ContextWindowTiers}"
                               SelectedContextWindowTier="{Binding Chat.ContextWindowTier, Mode=TwoWay}"
                               AgentName="{Binding Chat.AgentName, Mode=TwoWay}"
                               AgentValue="{Binding Chat.AgentValue, Mode=TwoWay}"
                               AgentGlyph="{Binding Chat.AgentGlyph}"
                               ProjectName="{Binding Chat.ProjectName, Mode=TwoWay}"
                               ProjectValue="{Binding Chat.ProjectValue, Mode=TwoWay}"
                               SkillItems="{Binding Chat.SkillChips}"
                               McpItems="{Binding Chat.McpChips}"
                               AvailableAgents="{Binding Chat.AvailableAgents}"
                               AvailableSkills="{Binding Chat.AvailableSkills}"
                               AvailableMcps="{Binding Chat.AvailableMcps}"
                               McpHeader="{loc:Str ConnectorsHeader}"
                               AddFilesLabel="{loc:Str ComposerFilesPhotos}"
                               AddRecentChatsLabel="{loc:Str RecentChats}"
                               AddAllChatsLabel="{loc:Str AllChats}"
                               AddSkillsLabel="{loc:Str Skills}"
                               AddAgentsLabel="{loc:Str Agents}"
                               AddConnectorsLabel="{loc:Str Connectors}"
                               AddProjectLabel="{loc:Str Project}"
                               McpErrorDetailsLabel="{loc:Str Details}"
                               McpCopyErrorDetailsLabel="{loc:Str CopyDetails}"
                               AvailableProjects="{Binding Chat.AvailableProjects}"
                               AvailableFiles="{Binding Chat.AvailableFiles}"
                               AgentRemovedCommand="{Binding Chat.RemoveAgentCommand}"
                               ProjectRemovedCommand="{Binding Chat.RemoveProjectCommand}"
                               SkillRemovedCommand="{Binding Chat.RemoveSkillCommand}"
                               McpRemovedCommand="{Binding Chat.RemoveMcpCommand}"
                               FileQueryChangedCommand="{Binding Chat.SearchFilesCommand}"
                               FileSelectedCommand="{Binding Chat.SelectFileCommand}">
          <!-- One model affordance, as on the desktop: model, effort and context are one picker, not
               three permanent toolbar controls competing with the prompt. -->
          <sc:StrataChatComposer.LeadingContent>
              <!-- The desktop's +, on a quiet disc that answers the send orb across the composer: files
                   and photos, then an agent, project, skills and connectors. -->
              <Button x:Name="ComposerAttachButton" Classes="composer-add"
                      AutomationProperties.Name="{loc:Str AddFilesAndContext}"
                      Command="{Binding Chat.OpenAddSheetCommand}">
                <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Plus}" />
              </Button>
          </sc:StrataChatComposer.LeadingContent>
          <sc:StrataChatComposer.ToolbarContent>
              <!-- The model, beside send as on the desktop: its name and a chevron that opens the picker. -->
              <Button x:Name="ComposerModelButton" Classes="composer-model"
                      AutomationProperties.Name="{Binding Chat.ModelDisplayName, StringFormat={loc:Str ModelNamed}}"
                      Command="{Binding Chat.OpenModelSheetCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{Binding Chat.ModelDisplayName}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="180" />
                  <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.ChevronDown}" />
                </StackPanel>
              </Button>
          </sc:StrataChatComposer.ToolbarContent>

          <!-- What the message carries, then files already uploaded to the PC for it. -->
          <sc:StrataChatComposer.AttachmentContent>
            <StackPanel>
            <!-- The chat's project, agent and skills, as the desktop's composer shows them; connectors stay
                 behind + as the desktop keeps them behind its Connectors button. A chip opens its picker. -->
            <ScrollViewer x:Name="ComposerContextScroll" Classes="composer-context"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          IsVisible="{Binding Chat.HasComposerContext}">
              <StackPanel x:Name="ComposerContext" Orientation="Horizontal">
                <Button x:Name="ComposerProjectChip" Classes="context-chip project"
                        IsVisible="{Binding Chat.HasProject}"
                        AutomationProperties.Name="{Binding Chat.ProjectName, StringFormat={loc:Str ProjectNamed}}"
                        Command="{Binding Chat.OpenContextPickerCommand}" CommandParameter="Project">
                  <Border Classes="context-chip-surface">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Classes="context-chip-tile">
                        <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Folder}" />
                      </Border>
                      <TextBlock Classes="context-chip-name" Text="{Binding Chat.ProjectName}" />
                    </StackPanel>
                  </Border>
                </Button>
                <Button x:Name="ComposerAgentChip" Classes="context-chip agent"
                        IsVisible="{Binding Chat.HasAgent}"
                        AutomationProperties.Name="{Binding Chat.AgentName, StringFormat={loc:Str AgentNamed}}"
                        Command="{Binding Chat.OpenContextPickerCommand}" CommandParameter="Agent">
                  <Border Classes="context-chip-surface">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Classes="context-chip-tile">
                        <TextBlock Text="{Binding Chat.AgentGlyph}" />
                      </Border>
                      <TextBlock Classes="context-chip-name" Text="{Binding Chat.AgentName}" />
                    </StackPanel>
                  </Border>
                </Button>
                <ItemsControl x:Name="ComposerSkillChips" ItemsSource="{Binding Chat.SkillChips}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sc:StrataComposerChip">
                      <Button Classes="context-chip skill"
                              AutomationProperties.Name="{Binding Name, StringFormat={loc:Str SkillNamed}}"
                              Command="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.OpenContextPickerCommand}"
                              CommandParameter="Skills">
                        <Border Classes="context-chip-surface">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="context-chip-tile">
                              <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Wand}" />
                            </Border>
                            <TextBlock Classes="context-chip-name" Text="{Binding Name}" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <ItemsControl x:Name="PendingAttachments" ItemsSource="{Binding Chat.Attachments}"
                          IsVisible="{Binding Chat.HasAttachments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingAttachment">
                  <Border Classes="attachment-chip" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm2 18H6V4h7v5h5v11z" />
                      <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="170" />
                      <Button Classes="chip-remove"
                              AutomationProperties.Name="{Binding FileName, StringFormat={loc:Str RemoveNamed}}"
                              Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Chat.RemoveAttachmentCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Width="12" Height="12"
                                  Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
          </sc:StrataChatComposer.AttachmentContent>
          </sc:StrataChatComposer>
          </StackPanel>
          </Border>
        </Border>
        </Panel>
      </sc:StrataChatShell.Composer>
    </sc:StrataChatShell>

    <!-- A blank chat stays local until the first send. The welcome yields to the keyboard.
         Lumi's mark, the greeting and the starters gather in the presence; the user's usual setups sit
         on the composer, in the thumb's reach. Its margin tracks the bars (code-behind), and it scrolls
         as one surface when a short screen cannot hold it. -->
    <Border x:Name="WelcomeSideInset"
            Padding="{Binding SafeAreaSides}"
            Margin="0,0,0,110"
            ClipToBounds="True"
            IsVisible="{Binding IsWelcomeVisible}">
      <ScrollViewer x:Name="WelcomeScroll" Classes="mobile-scroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
      <Grid x:Name="NoChatPlaceholder" IsVisible="{Binding IsWelcomeVisible}"
            RowDefinitions="*,Auto"
            MinHeight="{Binding #WelcomeScroll.Bounds.Height}">
        <StackPanel x:Name="WelcomeLaunch" Grid.Row="0"
                    VerticalAlignment="Center" MaxWidth="460">
          <StackPanel x:Name="WelcomeHero">
            <!-- Lumi's own app icon, as the desktop's launchpad and the pairing screen show it. -->
            <Border x:Name="WelcomeMark" Classes="welcome-mark" IsHitTestVisible="False">
              <Image Source="{x:Static views:LumiAppIcon.Image}"
                     Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
            <TextBlock x:Name="GreetingText" Classes="welcome-greeting"><Run Text="{Binding GreetingParts.Lead}" /><Run Text="{Binding GreetingParts.Name}" Foreground="{DynamicResource Brush.AccentText}" /><Run Text="{Binding GreetingParts.Trail}" /></TextBlock>
            <TextBlock x:Name="WelcomeBrief" Classes="welcome-brief" Text="{Binding NewChatBrief}" />
          </StackPanel>

          <!-- Starters for the hour: a tap puts the words in the composer, to send or finish first. -->
          <ItemsControl x:Name="WelcomeStarters" ItemsSource="{Binding Chat.Starters}" Margin="0,22,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemsAlignment="Center" ItemSpacing="8" LineSpacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatStarter">
                <Button Classes="welcome-starter"
                        Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Chat.UseSuggestionCommand}"
                        CommandParameter="{Binding EffectivePrompt}"
                        AutomationProperties.Name="{Binding Text}"
                        AutomationProperties.HelpText="{loc:Str AddsToMessage}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <sc:StrataLineIcon IsVisible="{Binding !HasGlyph}"
                                       Data="{Binding IconKey, Converter={x:Static views:TranscriptIconConverter.Instance}}" />
                    <TextBlock Classes="welcome-starter-glyph" Text="{Binding Glyph}" IsVisible="{Binding HasGlyph}" />
                    <TextBlock Grid.Column="1" Classes="welcome-starter-label" Text="{Binding Text}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- On the composer, as the desktop's setups are, and as wide as its column (760 plus the
             composer host's 12 dp sides), so the first card lines up with the composer's edge. -->
        <StackPanel x:Name="WelcomeDock" Grid.Row="1" MaxWidth="784">
          <StackPanel x:Name="WelcomeSetupsGroup" IsVisible="{Binding HasStartSetups}">
            <TextBlock Classes="welcome-label" Text="{Binding StartSetupsTitle}" />
            <ScrollViewer x:Name="WelcomeSetupsScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
              <!-- The bottom margin keeps each card's shadow inside the scroller's clip. -->
              <ItemsControl x:Name="WelcomeSetups" ItemsSource="{Binding StartSetups}" Margin="12,0,12,10">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatStartSetup">
                    <Button x:Name="StartSetupCard" Classes="welcome-setup"
                            Classes.selected="{Binding IsSelected}"
                            Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).UseStartSetupCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title, StringFormat={loc:Str StartWithNamed}}"
                            AutomationProperties.HelpText="{Binding Description}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Panel Width="36" Height="36" VerticalAlignment="Center">
                          <Border Classes="welcome-setup-mark" IsVisible="{Binding !HasProjectMark}">
                            <TextBlock Text="{Binding MarkGlyph}" />
                          </Border>
                          <Border Classes="welcome-setup-mark" IsVisible="{Binding HasProjectMark}"
                                  Background="{Binding MarkBackground}">
                            <TextBlock Text="{Binding MarkGlyph}" Foreground="{Binding MarkForeground}" />
                          </Border>
                          <Border Classes="welcome-setup-check" RenderTransformOrigin="0.5,0.5">
                            <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Check}" />
                          </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="welcome-setup-title" Text="{Binding Title}" />
                          <TextBlock Classes="welcome-setup-meta" Text="{Binding Description}"
                                     IsVisible="{Binding HasDescription}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <TextBlock x:Name="WelcomeUpdateNote"
                     Text="{loc:Str SetupsRequireUpdate}"
                     IsVisible="{Binding !HasDesktopNewChat}" Classes="muted"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="24,0,24,12" />
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- Plan, sources and activity are declared before the other sheets: with room beside the chat
         they are panels, and a picker or the chat's details must open over them.
         Plan, on demand. A sheet keeps a long plan scrollable and dismissible instead of wedging a
         full-height card into the conversation. -->
    <sc:StrataBottomSheet x:Name="PlanSheet"
                          Classes="safe-area"
                          Classes.side-panel="{Binding Chat.UseSidePanels}"
                          IsOpen="{Binding Chat.IsPlanOpen, Mode=TwoWay}"
                          Title="{loc:Str Plan}">
      <ScrollViewer Classes="mobile-scroll plan-scroll"
                    Padding="24,0,24,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
        <!--
          ScrollViewer must measure a layout container, not the markdown control directly. With the
          direct child, the sheet's bottom-aligned measure and markdown's desired-size updates fed
          each other indefinitely when the plan opened. The same StackPanel boundary used by the
          model sheet keeps the scroll extent stable.
        -->
        <Border x:Name="PlanSheetSideInset" Padding="{Binding SafeAreaSides}">
          <StackPanel Margin="0,0,0,12">
            <sc:StrataMarkdown x:Name="PlanMarkdown"
                               Markdown="{Binding Chat.PlanContent, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                               InteractionLanguage="{x:Static loc:ChatSessionStrings.Language}"
                               IsInline="True" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="SourcesSheet"
                          Classes="safe-area"
                          Classes.side-panel="{Binding Chat.UseSidePanels}"
                          IsOpen="{Binding Chat.IsSourcesSheetOpen, Mode=TwoWay}"
                          Title="{loc:Str Sources}">
      <Border x:Name="SourcesSheetSideInset">
        <ContentControl Content="{Binding Chat.SelectedSourceAnswer}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:AssistantItemViewModel">
              <ScrollViewer Classes="mobile-scroll sheet-scroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="proto:RemoteSource">
                      <Button Classes="sheet-item source-option" Padding="16,12"
                              Click="OnSourceClick">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Snippet, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                       IsVisible="{Binding Snippet, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{DynamicResource Font.SizeMeta}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Url}"
                                       IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{DynamicResource Font.SizeCaption}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <PathIcon Grid.Column="1" Classes="sheet-chevron" Width="16" Height="16"
                                    Data="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h5V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5h-2v5H5V5z" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="ActivitySheet"
                          Classes="safe-area"
                          Classes.side-panel="{Binding Chat.UseSidePanels}"
                          IsOpen="{Binding Chat.IsActivitySheetOpen, Mode=TwoWay}"
                          Title="{loc:Str HowLumiWorked}">
      <Border x:Name="ActivitySheetSideInset">
        <ContentControl Content="{Binding Chat.SelectedActivity}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ActivitySummaryItemViewModel">
              <ScrollViewer Classes="mobile-scroll sheet-scroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="{DynamicResource Mobile.Sheet.ContentMargin}" Spacing="14">
            <TextBlock Text="{Binding SummaryText}"
                       Classes="sheet-body" />

            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         IsVisible="{Binding IsLoadingDetails}" />

            <TextBlock Text="{Binding DetailsError}"
                       IsVisible="{Binding DetailsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Brush.DangerDefault}"
                       TextWrapping="Wrap" />

            <!-- What changed: the desktop's file rows, with the lines each one gained and lost. -->
            <StackPanel IsVisible="{Binding HasFileChanges}" Spacing="2">
              <TextBlock Text="{Binding FileSummary}" Classes="sheet-label" Margin="4,0,4,4" />
              <ItemsControl x:Name="ActivityFileChanges" ItemsSource="{Binding FileChanges}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityFileChangeViewModel">
                    <Border Classes="transcript-row">
                      <DockPanel>
                        <sc:StrataLineIcon DockPanel.Dock="Left" Classes="row-icon"
                                           Data="{Binding IconKey, Converter={x:Static views:TranscriptIconConverter.Instance}}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5"
                                    Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Classes="diff-added" Text="{Binding LinesAddedText}" IsVisible="{Binding HasLinesAdded}" />
                          <TextBlock Classes="diff-removed" Text="{Binding LinesRemovedText}" IsVisible="{Binding HasLinesRemoved}" />
                        </StackPanel>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Classes="step-title" Text="{Binding FileName}" />
                          <TextBlock Classes="row-detail" Text="{Binding Directory}"
                                     IsVisible="{Binding Directory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- The steps, in order under what they were for, each with its line icon and how long it took. -->
            <ItemsControl x:Name="ActivitySections" ItemsSource="{Binding Sections}"
                          IsVisible="{Binding HasSections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivitySectionViewModel">
                  <StackPanel Spacing="2" Margin="0,0,0,12">
                    <DockPanel Margin="4,0,4,4">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 Foreground="{DynamicResource Brush.TextTertiary}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Label}" Classes="sheet-label" Margin="0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Steps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityStepViewModel">
                          <StackPanel>
                            <Border Classes="transcript-row">
                              <DockPanel>
                                <Panel DockPanel.Dock="Left">
                                  <sc:StrataLineIcon Classes="row-icon"
                                                     Classes.live="{Binding IsRunning}"
                                                     IsVisible="{Binding !IsFailed}"
                                                     Data="{Binding IconKey, Converter={x:Static views:TranscriptIconConverter.Instance}}" />
                                  <sc:StrataLineIcon Classes="row-icon failed" IsVisible="{Binding IsFailed}"
                                                     Data="{x:Static sc:StrataIcons.Alert}" />
                                </Panel>
                                <TextBlock DockPanel.Dock="Right" Classes="row-detail" Margin="12,0,0,0"
                                           Text="{Binding DurationText}" />
                                <TextBlock Classes="step-title" Text="{Binding DisplayName}"
                                           Classes.stopped="{Binding IsStopped}" />
                              </DockPanel>
                            </Border>
                            <Border Classes="transcript-well" IsVisible="{Binding ShowTechnicalDetails}">
                              <StackPanel Spacing="8">
                                <TextBlock Classes="console-text" Text="{Binding Input, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                           IsVisible="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Classes="console-text" Text="{Binding Output, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" MaxLines="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           IsVisible="{Binding Output, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="sheet-action"
                    IsVisible="{Binding CanShowTechnicalDetails}"
                    Command="{Binding ToggleTechnicalDetailsCommand}"
                    Content="{Binding TechnicalDetailsLabel}" />
                </StackPanel>
              </ScrollViewer>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="JobWakeSheet" Classes="safe-area"
                          IsOpen="{Binding Chat.IsJobWakeSheetOpen, Mode=TwoWay}"
                          Title="{loc:Str JobDetails}">
      <Border x:Name="JobWakeSideInset">
        <ScrollViewer Classes="mobile-scroll" MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding Chat.SelectedJobWake}" Margin="{DynamicResource Mobile.Sheet.ContentMargin}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:JobWakeItemViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Details.JobName}" FontWeight="SemiBold"
                               FontSize="{DynamicResource Font.SizeSubtitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Classes="sheet-body" />
                  </StackPanel>
                  <Border Classes="sheet-card">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="HasStarted" />
                        <Binding Path="HasCompleted" />
                        <Binding Path="HasExitCode" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasStarted}">
                        <TextBlock Text="{loc:Str Started}" Classes="sheet-body" />
                        <TextBlock Grid.Column="1" Text="{Binding Details.StartedText}" FontSize="{DynamicResource Font.SizeMeta}"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasCompleted}">
                        <TextBlock Text="{loc:Str Completed}" Classes="sheet-body" />
                        <TextBlock Grid.Column="1" Text="{Binding Details.CompletedText}" FontSize="{DynamicResource Font.SizeMeta}"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasExitCode}">
                        <TextBlock Text="{loc:Str ExitCode}" Classes="sheet-body" />
                        <TextBlock Grid.Column="1" Text="{Binding Details.ExitCode}" FontSize="{DynamicResource Font.SizeMeta}"
                                   TextAlignment="Right" TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="8" IsVisible="{Binding HasInstructions}">
                    <TextBlock Text="{loc:Str Instructions}" Classes="sheet-label" Margin="4,0" />
                    <Border Classes="sheet-card">
                      <SelectableTextBlock Text="{Binding Details.Instructions, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                           FontSize="{DynamicResource Font.SizeMeta}" LineHeight="{DynamicResource Font.LineHeightMeta}" TextWrapping="Wrap"
                                           behaviors:NativeTextSelection.IsEnabled="True"
                                           behaviors:NativeTextSelection.Text="{Binding Details.Instructions, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" />
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding HasOutput}">
                    <TextBlock Text="{loc:Str Output}" Classes="sheet-label" Margin="4,0" />
                    <Border Classes="sheet-card">
                      <SelectableTextBlock Text="{Binding Details.OutputText, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}"
                                           FontFamily="{DynamicResource Font.FamilyMono}"
                                           FontSize="13.5" LineHeight="20" TextWrapping="Wrap"
                                           behaviors:NativeTextSelection.IsEnabled="True"
                                           behaviors:NativeTextSelection.Text="{Binding Details.OutputText, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>



    <!--
      The composer's +, as the desktop's + menu and its Skills and Connectors buttons: files and photos,
      then what the chat carries. Each row says what is chosen now and opens its picker.
    -->
    <sc:StrataBottomSheet x:Name="AddSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsAddSheetOpen, Mode=TwoWay}"
                          Title="{loc:Str AddToChat}">
      <Border x:Name="AddSheetSideInset">
        <StackPanel Margin="0,0,0,8">
          <Button x:Name="AddFilesButton" Classes="sheet-item"
                  Command="{Binding Chat.AttachFromAddSheetCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="row-tile">
                <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Paperclip}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{loc:Str FilesAndPhotos}" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <TextBlock Text="{loc:Str ForThisChat}" Classes="sheet-label" />
          <Button x:Name="AddAgentButton" Classes="sheet-item"
                  Command="{Binding Chat.OpenContextPickerCommand}" CommandParameter="Agent">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="row-tile agent">
                <PathIcon Data="{DynamicResource Mobile.Icon.Sparkle}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{loc:Str Agent}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.AgentSummary}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
            </Grid>
          </Button>
          <Button x:Name="AddProjectButton" Classes="sheet-item"
                  IsEnabled="{Binding Chat.CanPickProject}"
                  Command="{Binding Chat.OpenContextPickerCommand}" CommandParameter="Project">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="row-tile project">
                <PathIcon Data="{DynamicResource Mobile.Icon.Folder}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{loc:Str Project}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.ProjectSummary}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
            </Grid>
          </Button>
          <Button x:Name="AddSkillsButton" Classes="sheet-item"
                  Command="{Binding Chat.OpenContextPickerCommand}" CommandParameter="Skills">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="row-tile skill">
                <PathIcon Data="{DynamicResource Mobile.Icon.Bolt}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{loc:Str Skills}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.SkillsSummary}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
            </Grid>
          </Button>
          <Button x:Name="AddConnectorsButton" Classes="sheet-item"
                  Command="{Binding Chat.OpenContextPickerCommand}" CommandParameter="Connectors">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="row-tile connector">
                <PathIcon Data="{DynamicResource Mobile.Icon.Plug}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{loc:Str Connectors}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="sheet-value" Text="{Binding Chat.ConnectorsSummary}" />
              <PathIcon Grid.Column="3" Classes="sheet-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </sc:StrataBottomSheet>

    <!--
      One picker for the agent, project, skills and connectors. An agent or project is one choice and
      closes the sheet; skills and connectors switch on and off in place, as on the desktop.
    -->
    <sc:StrataBottomSheet x:Name="ContextPickerSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsContextPickerOpen, Mode=TwoWay}"
                          Title="{Binding Chat.ContextPickerTitle}"
                          Description="{Binding Chat.ContextPickerDescription}">
      <Border x:Name="ContextPickerSideInset">
        <ScrollViewer Classes="mobile-scroll sheet-scroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,0,8">
            <ItemsControl x:Name="ContextPickerList" ItemsSource="{Binding Chat.ContextOptions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContextOption">
                  <Button Classes="sheet-item context-option" Classes.selected="{Binding IsHighlighted}"
                          Classes.checked="{Binding IsSelected}"
                          IsEnabled="{Binding IsEnabled}"
                          AutomationProperties.Name="{Binding Label}"
                          Command="{Binding $parent[views:ChatDetailView].((vm:MobileShellViewModel)DataContext).Chat.PickContextOptionCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Classes="row-tile" Classes.project="{Binding IsProject}"
                              Classes.connector="{Binding IsConnector}">
                        <Panel>
                          <TextBlock Text="{Binding Glyph}" IsVisible="{Binding UsesGlyph}" />
                          <PathIcon IsVisible="{Binding IsProject}" Data="{DynamicResource Mobile.Icon.Folder}" />
                          <PathIcon IsVisible="{Binding IsConnector}" Data="{DynamicResource Mobile.Icon.Plug}" />
                          <sc:StrataLineIcon IsVisible="{Binding IsNone}" Data="{x:Static sc:StrataIcons.Cross}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="sheet-detail" Text="{Binding Description}"
                                   IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                      <PathIcon Grid.Column="2" Classes="sheet-check" IsVisible="{Binding IsSelected}"
                                Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ContextPickerEmpty" Classes="sheet-body" Margin="24,4,24,8"
                       Text="{Binding Chat.ContextPickerEmptyText}"
                       IsVisible="{Binding Chat.IsContextPickerEmpty}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>



    <sc:StrataBottomSheet x:Name="ContextSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsContextSheetOpen, Mode=TwoWay}"
                          Title="{loc:Str ContextWindow}"
                          Description="{loc:Str ContextDescription}">
      <Border x:Name="ContextSheetSideInset">
        <ScrollViewer Classes="mobile-scroll" MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Chat.ContextTierOptions}" Margin="0,0,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PickerOption">
              <Button Classes="sheet-item context-option" Classes.selected="{Binding IsSelected}"
                      AutomationProperties.Name="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].((vm:MobileShellViewModel)DataContext).Chat.PickContextTierCommand}"
                      CommandParameter="{Binding Name}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <PathIcon Grid.Column="1" Classes="sheet-check" IsVisible="{Binding IsSelected}"
                            Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>

    <!--
      Reasoning effort. A slider rather than a list because effort is an ORDERED scale — low through
      high — and stacked rows hide that ordering while costing three taps to explore.
    -->
    <sc:StrataBottomSheet x:Name="EffortSheet"
                          Classes="safe-area"
                          IsOpen="{Binding Chat.IsEffortSheetOpen, Mode=TwoWay}"
                          Title="{loc:Str ReasoningEffort}"
                          Description="{loc:Str EffortDescription}">
      <Border x:Name="EffortSheetSideInset">
        <StackPanel Margin="{DynamicResource Mobile.Sheet.ContentMargin}" Spacing="4">
          <TextBlock Text="{Binding Chat.EffortLabel}"
                     FontSize="{DynamicResource Font.SizeTitle}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,4,0,8" />

          <Slider x:Name="EffortSlider"
                  MinHeight="{DynamicResource Touch.MinTarget}"
                  AutomationProperties.Name="{loc:Str ReasoningEffort}"
                  Minimum="0"
                  Maximum="{Binding Chat.EffortMax}"
                  Value="{Binding Chat.EffortIndex, Mode=TwoWay}"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  TickPlacement="Outside" />

          <!-- The ends of the scale, so the slider reads without having to drag it to find out. -->
          <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{loc:Str Faster}" Classes="muted"
                       HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="{loc:Str MoreThorough}" Classes="muted"
                       HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>
    </sc:StrataBottomSheet>
    <Border x:Name="GitChangesOverlay" IsVisible="{Binding Chat.IsGitChangesOpen}"
            Background="{DynamicResource Brush.Surface0}" Padding="{Binding SafeArea}">
      <views:GitChangesView DataContext="{Binding Chat}" />
    </Border>
  </Panel>
</UserControl>
