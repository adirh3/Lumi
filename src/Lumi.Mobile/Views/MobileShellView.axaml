<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:textInput="using:Avalonia.Input.TextInput"
             x:Class="Lumi.Mobile.Views.MobileShellView"
             x:DataType="vm:MobileShellViewModel"
             Background="{DynamicResource Brush.Surface0}">

  <UserControl.Styles>
    <Style Selector="sc|StrataBottomSheet.safe-area">
      <Setter Property="SheetMargin"
              Value="{Binding #SheetMarginProxy.Padding}" />
    </Style>
    <!-- A side panel floats beside the chat, clear of the bars, instead of rising from the bottom. -->
    <Style Selector="sc|StrataBottomSheet.safe-area.side-panel">
      <Setter Property="SheetMargin"
              Value="{Binding #SidePanelMarginProxy.Padding}" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="Root">

    <!-- Styles share a null-safe source even before the shell receives its ViewModel. -->
    <Border x:Name="SheetMarginProxy" Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
            Padding="{Binding SafeAreaSheetMargin}" />
    <Border x:Name="SidePanelMarginProxy" Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
            Padding="{Binding SidePanelSheetMargin}" />

    <!-- ═══ Onboarding: not paired with any PC yet ═══ -->
    <Grid x:Name="ConnectLayout"
          ColumnDefinitions="Auto,Auto,*"
          Height="{Binding UsableContentHeight}"
          VerticalAlignment="Top"
          IsVisible="{Binding !IsPaired}">
      <Border x:Name="ConnectHingeLead"
              Width="{Binding Layout.HingePosition}"
              Background="{DynamicResource Brush.Surface0}" />
      <Border x:Name="ConnectHingeGap"
              Grid.Column="1"
              Width="{Binding HingeGapWidth}"
              Background="{DynamicResource Brush.Surface0}" />
      <ContentControl x:Name="ConnectHost"
                      Grid.Column="2"
                      IsVisible="{Binding !IsPaired}">
        <views:ConnectView x:Name="ConnectPage" DataContext="{Binding Connect}" />
      </ContentControl>
    </Grid>

    <!-- ═══ Main shell ═══ -->
    <!--
      One measured navigation surface and one gesture recognizer serve both modal and docked layouts.
      The view keeps the conversation's leading edge attached to the drawer's live progress.
      Its trailing edge stays at the window edge, including during drag and button settling.
    -->
    <sc:StrataNavigationDrawer x:Name="NavDrawer"
                               IsVisible="{Binding IsPaired}"
                               IsOpen="{Binding IsNavigationOpen, Mode=TwoWay}"
                               IsModal="{Binding !CanDockDrawer}"
                               PanelWidth="{Binding DrawerWidth}"
                               IsDragEnabled="{Binding CanDragDrawer}"
                               CanOpenFromAnywhere="True">
      <sc:StrataNavigationDrawer.Panel>
        <Border x:Name="DrawerPane" Classes="navigation-pane"
                Background="{DynamicResource Brush.NavigationSurface}"
                ClipToBounds="True">
          <views:MobileDrawerView x:Name="DrawerContent" />
        </Border>
      </sc:StrataNavigationDrawer.Panel>

      <Grid x:Name="ShellRoot" ColumnDefinitions="Auto,Auto,*"
            Height="{Binding UsableContentHeight}"
            VerticalAlignment="Top">

        <Border x:Name="NavigationSpacer" Grid.Column="0"
                Width="0"
                IsHitTestVisible="False"
                Background="{DynamicResource Brush.Surface0}" />

        <!-- Physical hinge gap on a book-posture foldable: never paint underneath it. -->
        <Border x:Name="HingeGap" Grid.Column="1" IsVisible="{Binding HasHingeGap}"
                Width="{Binding HingeGapWidth}"
                Background="{DynamicResource Brush.Surface0}" />

        <!-- ═══ The conversation. Always mounted: this app IS the chat. ═══ -->
        <Border x:Name="ConversationFrame" Grid.Column="2" Classes="conversation-frame"
                Background="{DynamicResource Brush.ChatCanvas}"
                ClipToBounds="True">
        <Panel>
          <views:ChatDetailView x:Name="ChatSurface" IsVisible="{Binding IsChatPage}" />
          <!-- Pages stack OVER the chat rather than replacing it, so coming back never costs a
               transcript rebuild. -->
          <Panel x:Name="LibraryHost" IsVisible="{Binding IsLibraryPage}"
                 Background="{DynamicResource Brush.Surface0}">
            <views:LibraryView x:Name="LibraryPage" DataContext="{Binding Library}" />
          </Panel>

          <views:MobileSettingsView x:Name="SettingsPage" IsVisible="{Binding IsSettingsPage}"
                                    Background="{DynamicResource Brush.Surface0}" />

          <views:MobileSearchView x:Name="SearchPage" IsVisible="{Binding IsSearchPage}" />
        </Panel>
        </Border>

        <!-- An overlay follows the live pane edge without remeasuring the conversation. -->
        <Border x:Name="ConversationSeparation" Grid.Column="2"
                Width="1" HorizontalAlignment="Left" IsHitTestVisible="False"
                Background="{DynamicResource Brush.ChatPaneSeparation}"
                BoxShadow="{DynamicResource Shadow.ChatPaneSeparation}">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="CanDockDrawer" />
              <Binding Path="IsDrawerPresented" />
              <Binding Path="!HasHingeGap" />
            </MultiBinding>
          </Border.IsVisible>
        </Border>
      </Grid>
    </sc:StrataNavigationDrawer>

    <sc:StrataBottomSheet x:Name="ProjectPickerSheet"
                          Classes="safe-area"
                          SheetMargin="{Binding ProjectPickerSheetMargin}"
                          IsOpen="{Binding IsProjectPickerOpen, Mode=TwoWay}"
                          Title="Projects">
      <Grid RowDefinitions="Auto,*" MaxHeight="440" Margin="0,0,0,4"
            IsEnabled="{Binding CanChangeProjectScope}">
        <Button x:Name="AllProjectsButton" Classes="sheet-item"
                Classes.selected="{Binding !HasActiveProject}"
                Command="{Binding ClearProjectCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <PathIcon Classes="sheet-leading"
                      Data="M4 4h7v7H4V4zm2 2v3h3V6H6zm7-2h7v7h-7V4zm2 2v3h3V6h-3zM4 13h7v7H4v-7zm2 2v3h3v-3H6zm7-2h7v7h-7v-7zm2 2v3h3v-3h-3z" />
            <TextBlock Grid.Column="1" Text="All projects" VerticalAlignment="Center" />
            <PathIcon Grid.Column="2" Classes="sheet-check" IsVisible="{Binding !HasActiveProject}"
                      Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
          </Grid>
        </Button>
        <ScrollViewer Grid.Row="1" Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="ProjectPickerList" ItemsSource="{Binding Projects}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectPickViewModel">
                <Button Classes="sheet-item project-scope-option"
                        Classes.selected="{Binding IsActive}"
                        AutomationProperties.Name="{Binding Name}"
                        Command="{Binding $parent[views:MobileShellView].((vm:MobileShellViewModel)DataContext).SelectProjectCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <PathIcon Classes="sheet-leading"
                              Data="M10.6 5H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-7.4l-2-2zM4 9h16v9H4V9z" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <PathIcon Grid.Column="2" Classes="sheet-check" IsVisible="{Binding IsActive}"
                              Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </sc:StrataBottomSheet>

    <!-- ═══ Chat actions, opened by long-pressing a drawer row ═══ -->
    <sc:StrataBottomSheet x:Name="ChatActionsSheet"
                          Classes="safe-area"
                          IsOpen="{Binding IsChatActionsOpen, Mode=TwoWay}"
                          Title="{Binding ChatActionsTitle}"
                          Description="{Binding ActionChatTitle}">
      <Border x:Name="ChatActionsSideInset">
        <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,4">
          <StackPanel IsVisible="{Binding ShowChatActionList}">
          <Button x:Name="SheetPinButton" Classes="sheet-item"
                  Command="{Binding PinActionChatCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2zm-7.17 2L10 12.83V4h4v8.83L15.17 14H8.83z" />
              <TextBlock Grid.Column="1" Text="{Binding PinActionLabel}" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="SheetRenameButton" Classes="sheet-item"
                  Command="{Binding RenameActionChatCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM5.92 19H5v-.92l9.06-9.06.92.92L5.92 19zM20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83a1 1 0 0 0 0-1.41z" />
              <TextBlock Grid.Column="1" Text="Rename chat" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="SheetDeleteButton" Classes="sheet-item destructive"
                  Command="{Binding DeleteActionChatCommand}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <PathIcon Classes="sheet-leading"
                        Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z" />
              <TextBlock Grid.Column="1" Text="Delete chat" VerticalAlignment="Center" />
            </Grid>
          </Button>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsRenamingChat}" Margin="16,0,16,8" Spacing="16">
            <TextBox x:Name="RenameChatBox" Classes="mobile" Text="{Binding ChatNameDraft}"
                     IsVisible="{Binding IsRenamingChat}"
                     PlaceholderText="Chat name"
                     AutomationProperties.Name="Chat name"
                     textInput:TextInputOptions.ReturnKeyType="Done"
                     IsEnabled="{Binding !IsChatActionBusy}"
                     KeyDown="OnChatRenameKeyDown" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="sheet-action" Content="Cancel"
                      Command="{Binding CancelChatActionCommand}" />
              <Button x:Name="SaveChatNameButton" Grid.Column="1" Classes="sheet-action primary" Content="Save"
                      Command="{Binding SaveChatNameCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsConfirmingChatDelete}" Margin="16,0,16,8" Spacing="18">
            <TextBlock Text="This conversation will be deleted from your phone and computer. This can't be undone."
                       Classes="sheet-body" Margin="8,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button x:Name="CancelChatDeleteButton" Classes="sheet-action" Content="Cancel"
                      Command="{Binding CancelChatActionCommand}" />
              <Button x:Name="ConfirmChatDeleteButton" Grid.Column="1" Classes="sheet-action destructive" Content="Delete"
                      Command="{Binding ConfirmDeleteActionChatCommand}" />
            </Grid>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChatActionBusy}" Height="3" Margin="24,4,24,8" />
          <TextBlock Text="{Binding ChatActionError}" Classes="sheet-body" Margin="24,4,24,8"
                     Foreground="{DynamicResource Brush.DangerDefault}"
                     IsVisible="{Binding ChatActionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        </ScrollViewer>
      </Border>
    </sc:StrataBottomSheet>
  </Panel>
</UserControl>
