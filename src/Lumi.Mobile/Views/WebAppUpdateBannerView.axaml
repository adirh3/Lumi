<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:sc="using:StrataTheme.Controls"
             x:Class="Lumi.Mobile.Views.WebAppUpdateBannerView"
             x:DataType="vm:MobileShellViewModel"
             IsVisible="{Binding ShowWebAppUpdateBanner}">
  <!-- It shows in a page's floating header, so it is glass. -->
  <Panel Margin="0,8,0,6">
    <sc:StrataBackdropBlur Classes="floating-frost" CornerRadius="{Binding #WebAppUpdateBanner.CornerRadius}" />
    <Border x:Name="WebAppUpdateBanner" Classes="floating-banner" Padding="16,14">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding WebAppUpdateTitle}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding WebAppUpdateMessage}" TextWrapping="Wrap"
                   FontSize="{DynamicResource Font.SizeCaption}"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsWebAppUpdating}" />
        <Button x:Name="ApplyWebAppUpdateButton" Content="{loc:Str UpdateNow}" Classes="accent touch"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowApplyWebAppUpdateAction}"
                Command="{Binding ApplyWebAppUpdateCommand}" />
        <StackPanel IsVisible="{Binding IsWebAppUpdateConfirmationOpen}" Spacing="10">
          <TextBlock Text="{loc:Str UpdateDiscardHelp}" TextWrapping="Wrap"
                     FontSize="{DynamicResource Font.SizeCaption}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="ConfirmWebAppUpdateButton" Classes="touch destructive"
                    Command="{Binding ConfirmWebAppUpdateCommand}">
              <TextBlock Text="{loc:Str UpdateAndDiscard}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button x:Name="CancelWebAppUpdateButton" Grid.Column="1" Classes="touch"
                    Command="{Binding CancelWebAppUpdateCommand}">
              <TextBlock Text="{loc:Str KeepEditing}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
          </Grid>
        </StackPanel>
        <Button x:Name="CheckWebAppUpdateButton" Content="{loc:Str TryAgain}" Classes="touch"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowCheckWebAppUpdateAction}"
                Command="{Binding CheckWebAppUpdateCommand}" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
