<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:sa="using:StrataTheme.Animation"
             xmlns:input="using:Avalonia.Input"
             x:Class="Lumi.Mobile.Views.MobileDrawerView"
             x:DataType="vm:MobileShellViewModel"
             Background="{DynamicResource Brush.NavigationSurface}">

  <!--
    Search and the project scope stay reachable while the conversation list scrolls.
    Everything editable is behind one Library row.
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!--
      Safe-area insets are applied here, not on the shell: the drawer's surface has to run edge to
      edge (under the status bar and the gesture bar) the way every native drawer does, while its
      rows stay clear of both.
    -->

    <!-- A compact identity bar keeps search and pane navigation reachable while the list scrolls. -->
    <Border Grid.Row="0" Padding="{Binding SafeAreaTop}">
      <Border x:Name="DrawerHeaderSideInset" Padding="{Binding SafeAreaSides}">
        <Grid x:Name="DrawerBrandHeader" ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8" MinHeight="{DynamicResource Touch.MinTarget}"
              Margin="{DynamicResource Mobile.Navigation.HeaderMargin}">
          <TextBlock x:Name="DrawerBrandTitle" Text="Lumi" FontSize="{DynamicResource Font.SizeTitle}"
                     FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="DrawerSearchButton" Grid.Column="1" Classes="navigation-icon-button floating-action"
                  AutomationProperties.Name="Search chats" Command="{Binding OpenSearchCommand}">
            <PathIcon Width="20" Height="20"
                      Data="M15.5 14h-.79l-.28-.27a6.5 6.5 0 0 0 1.48-5.34c-.47-2.78-2.79-5-5.59-5.34a6.505 6.505 0 0 0-7.27 7.27c.34 2.8 2.56 5.12 5.34 5.59a6.5 6.5 0 0 0 5.34-1.48l.27.28v.79l4.25 4.25c.41.41 1.08.41 1.49 0 .41-.41.41-1.08 0-1.49L15.5 14zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
          </Button>
          <Button x:Name="DrawerCloseButton" Grid.Column="2" Classes="navigation-icon-button floating-action"
                  IsVisible="{Binding !CanDockDrawer}" AutomationProperties.Name="Close navigation"
                  Command="{Binding CloseDrawerCommand}">
            <PathIcon Width="18" Height="18"
                      Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </Grid>
      </Border>
    </Border>

    <!--
      ═══ Everything else scrolls as ONE surface ═══

      Library and history share the scrolling surface. Project selection lives in the footer
      rather than consuming conversation rows.
    -->
    <Border x:Name="DrawerContentSideInset" Grid.Row="1" Padding="{Binding SafeAreaSides}">
      <ScrollViewer Classes="mobile-scroll" Padding="0,0,0,8"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="2">

    <!-- ═══ Library: everything editable behind one row ═══ -->
    <Button x:Name="DrawerLibraryButton" Classes="drawer-row"
            Classes.selected="{Binding IsLibraryPage}"
            Command="{Binding ShowPageCommand}" CommandParameter="Library">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Border Classes="navigation-icon-tile">
        <PathIcon Width="18" Height="18"
                  Foreground="{DynamicResource Brush.TextSecondary}"
                  Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" />
        </Border>
        <TextBlock Grid.Column="1" Text="Library" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Button>

    <!-- ═══ History ═══ -->
    <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="2" Margin="14,4"
                     IsVisible="{Binding ChatList.IsRefreshing}" />
        <Border Classes="mobile-card" Margin="12,8"
                IsVisible="{Binding ChatList.LoadErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ChatList.LoadErrorText}" Classes="supporting" />
            <Button Classes="touch" Content="Try again" Command="{Binding ChatList.RetryLoadCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel x:Name="DrawerEmpty" IsVisible="{Binding ChatList.ShowEmptyState}"
                    Spacing="6" Margin="14,24" HorizontalAlignment="Center">
          <TextBlock Text="{Binding ChatList.EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChatList.EmptyDescription}" Classes="supporting" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <ItemsControl x:Name="DrawerChatGroups" ItemsSource="{Binding ChatList.Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatGroupViewModel">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Classes="group-label drawer-group-label" />
                <ItemsControl ItemsSource="{Binding Chats}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatListItemViewModel">
                      <Button Classes="drawer-chat drawer-conversation" Classes.selected="{Binding IsSelected}"
                              Classes.unread="{Binding HasUnreadMessages}" Classes.running="{Binding IsRunning}"
                              AutomationProperties.Name="{Binding AccessibilityName}"
                              AutomationProperties.HelpText="Long press for chat actions"
                              input:InputElement.IsHoldingEnabled="True"
                              input:InputElement.IsHoldWithMouseEnabled="True"
                              Holding="OnChatRowHolding"
                              KeyDown="OnChatRowKeyDown"
                              Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).ChatList.OpenChatCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Classes="chat-list-status" IsHitTestVisible="False"
                                    sa:LifecycleOpacityPulse.IsActive="{Binding IsRunning}">
                              <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                  <Binding Path="IsRunning" />
                                  <Binding Path="HasUnreadMessages" />
                                </MultiBinding>
                              </Border.IsVisible>
                            </Border>
                            <PathIcon x:Name="BackgroundActivityIndicator" Classes="chat-list-background"
                                      IsVisible="{Binding HasBackgroundActivity}"
                                      ToolTip.Tip="{x:Static loc:ChatSessionStrings.ReadyWithBackgroundActivity}"
                                      AutomationProperties.Name="{x:Static loc:ChatSessionStrings.ReadyWithBackgroundActivity}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="conversation-title"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="DrawerLoadMoreButton" Classes="drawer-row"
                Margin="12,8,12,10"
                IsVisible="{Binding ChatList.HasMoreChats}"
                Command="{Binding ChatList.LoadMoreChatsCommand}">
          <TextBlock Text="Load more chats" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Button>
      </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Project scope and settings remain available while history scrolls. -->
    <Border Grid.Row="2" Padding="{Binding SafeAreaBottom}">
      <Border x:Name="DrawerAccountSideInset" Padding="{Binding SafeAreaSides}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="16,12,12,12">
            <Button x:Name="DrawerProjectButton" Classes="floating-action"
                    Height="48" MaxWidth="240" Padding="14,0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding ProjectScopeLabel, StringFormat='Select project: {0}'}"
                    Command="{Binding OpenProjectPickerCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <PathIcon Width="18" Height="18" VerticalAlignment="Center"
                          Foreground="{DynamicResource Brush.TextSecondary}"
                          Data="M2 6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6z" />
                <TextBlock x:Name="DrawerProjectLabel" Grid.Column="1" Text="{Binding ProjectScopeLabel}"
                           FontSize="{DynamicResource Font.SizeMeta}" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button x:Name="DrawerAccountButton" Grid.Column="1" Classes="navigation-icon-button floating-action"
                    AutomationProperties.Name="Settings" Command="{Binding ShowPageCommand}" CommandParameter="Settings">
            <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}" VerticalAlignment="Center"
                      Data="M12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7zm7.43-2.53c.04-.32.07-.64.07-.97s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65A.488.488 0 0 0 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.65.07.97l-2.11 1.66c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1.01c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z" />
            </Button>
          </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
