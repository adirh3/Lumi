<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:sa="using:StrataTheme.Animation"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             xmlns:input="using:Avalonia.Input"
             x:Class="Lumi.Mobile.Views.MobileDrawerView"
             x:DataType="vm:MobileShellViewModel"
             Background="{DynamicResource Brush.NavigationSurface}">

  <!--
    The chat list: home on a phone, the sidebar beside the chat when there is room for both. Its title
    bar's glass buttons and the project lens float above it and the glass places pill sits centred in the
    thumb zone, while the conversations scroll underneath them as one surface.
  -->
  <Panel x:Name="DrawerLayout">

    <!--
      Safe-area insets are applied here, not on the shell: the list's surface runs edge to edge
      (under the status bar and the gesture bar) while its rows stay clear of both.
    -->
    <Panel x:Name="DrawerHeaderChrome" VerticalAlignment="Top" ZIndex="1" Background="Transparent">
    <!-- As in the chat, rows passing under the floating header dissolve into a veil that covers it and
         fades out just below; the controls are glass of their own. -->
    <Panel x:Name="DrawerTopEdgeMaterial" Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
      <sc:StrataBackdropBlur x:Name="DrawerTopEdgeFrost" Classes="chrome-frost" Fade="Bottom"
                             FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
      <Border Background="{DynamicResource Brush.NavigationEdgeTop}" />
    </Panel>
    <Border Padding="{Binding SafeAreaTop}">
      <Border x:Name="DrawerHeaderSideInset" Padding="{Binding SafeAreaSides}">
        <Grid x:Name="DrawerBrandHeader" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto"
              RowSpacing="8"
              Margin="{DynamicResource Mobile.Navigation.HeaderMargin}">
          <!-- Home is Lumi's, titled as every place is, with the title bar's glass buttons beside it. -->
          <TextBlock x:Name="DrawerTitle" Text="Lumi" Classes="place-title" />
          <!-- Search opens full screen, where the keyboard has room. -->
          <Button x:Name="DrawerSearchButton" Grid.Column="1" Classes="chat-header-action floating-action"
                  AutomationProperties.Name="Search chats" Command="{Binding OpenSearchCommand}">
            <sc:StrataLineIcon Classes="header-glyph" Data="{x:Static sc:StrataIcons.Search}" />
          </Button>
          <!-- New chat in the accent, at the top right of the screen: here when the list is a screen of its
               own, in the chat's title bar when the list is docked beside it. -->
          <Button x:Name="DrawerNewChatButton" Grid.Column="2" Classes="chat-header-action new-conversation floating-action"
                  Margin="6,0,0,0"
                  IsVisible="{Binding ShowListNewChat}"
                  AutomationProperties.Name="Start a new chat"
                  Command="{Binding ChatList.NewChatCommand}">
            <sc:StrataLineIcon Classes="header-glyph accent" Data="{x:Static sc:StrataIcons.Pencil}" />
          </Button>

          <!-- The project lens: the desktop's switcher in the title bar's glass, built as the chat's title
               pill is: the project's mark, its name, how many projects there are and the chevron that
               opens them. -->
          <Button x:Name="DrawerProjectButton" Grid.Row="1" Grid.ColumnSpan="3"
                  Classes="project-switcher floating-action"
                  AutomationProperties.Name="{Binding ProjectSwitcherTitle, StringFormat='Select project: {0}'}"
                  Command="{Binding OpenProjectPickerCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Panel VerticalAlignment="Center" Margin="0,0,10,0">
                <Border x:Name="DrawerAllChatsBadge" Classes="chat-mark project-switcher-all"
                        IsVisible="{Binding !HasActiveProject}">
                  <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Chats}" />
                </Border>
                <Border x:Name="DrawerProjectBadge" Classes="chat-mark"
                        IsVisible="{Binding HasActiveProject}"
                        Background="{Binding ProjectSwitcherMark.Background}">
                  <TextBlock Text="{Binding ProjectSwitcherMark.Glyph}"
                             Foreground="{Binding ProjectSwitcherMark.Foreground}" />
                </Border>
              </Panel>
              <TextBlock x:Name="DrawerProjectLabel" Grid.Column="1" Classes="project-switcher-title"
                         Text="{Binding ProjectSwitcherTitle}" />
              <TextBlock x:Name="DrawerProjectMeta" Grid.Column="2" Classes="project-switcher-meta"
                         Text="{Binding ProjectSwitcherMeta}"
                         IsVisible="{Binding ProjectSwitcherMeta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <PathIcon x:Name="DrawerProjectChevron" Grid.Column="3" Classes="chat-header-chevron"
                        Data="{DynamicResource Mobile.Icon.ChevronDown}" />
            </Grid>
          </Button>

          <!-- Home must say when the PC can't be reached, as the chat's own status strip does;
               beside a docked list the chat's strip already says it. -->
          <Border x:Name="DrawerConnectionBanner" Grid.Row="2" Grid.ColumnSpan="3"
                  Background="{DynamicResource Brush.Surface2}"
                  CornerRadius="14" Padding="12,8">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowConnectionBanner" />
                <Binding Path="!CanDockDrawer" />
              </MultiBinding>
            </Border.IsVisible>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <sc:StrataPulse IsVisible="{Binding !IsGatewaySignInRequired}"
                              IsLive="False" Width="10" Height="10"
                              VerticalAlignment="Top" Margin="0,4,0,0" />
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConnectionBannerText}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Font.SizeMeta}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <Button x:Name="DrawerRetryConnectionButton"
                        IsVisible="{Binding ShowRetryConnectionAction}"
                        Content="Retry" Classes="accent touch" HorizontalAlignment="Left"
                        Command="{Binding RetryConnectionCommand}" />
                <Button x:Name="DrawerGatewaySignInButton"
                        IsVisible="{Binding ShowGatewaySignInAction}"
                        Content="Sign in again" Classes="accent touch" HorizontalAlignment="Left"
                        Command="{Binding ReloadWebAppCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Border>
    </Panel>

    <!-- ═══ The conversations, as ONE surface under the floating header and footer ═══ -->
    <Border x:Name="DrawerContentSideInset" Padding="{Binding SafeAreaSides}">
      <ScrollViewer x:Name="DrawerScroll" Classes="mobile-scroll" Padding="0,0,0,8"
                    HorizontalScrollBarVisibility="Disabled"
                    behaviors:ScrollEdgeChrome.Header="{Binding #DrawerHeaderChrome}"
                    behaviors:ScrollEdgeChrome.Footer="{Binding #DrawerFooterChrome}">
        <StackPanel x:Name="DrawerHistory">
        <ProgressBar IsIndeterminate="True" Height="2" Margin="14,4"
                     IsVisible="{Binding ChatList.IsRefreshing}" />
        <Border Classes="mobile-card" Margin="12,8"
                IsVisible="{Binding ChatList.LoadErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ChatList.LoadErrorText}" Classes="supporting" />
            <Button Classes="touch" Content="Try again" Command="{Binding ChatList.RetryLoadCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel x:Name="DrawerEmpty" IsVisible="{Binding ChatList.ShowEmptyState}"
                    Spacing="6" Margin="14,24" HorizontalAlignment="Center">
          <TextBlock Text="{Binding ChatList.EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChatList.EmptyDescription}" Classes="supporting" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <!-- One virtualizing list of headers and rows, so row controls are recycled across date groups. -->
        <ItemsControl x:Name="DrawerChatGroups" ItemsSource="{Binding ChatList.Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:ChatGroupViewModel">
              <TextBlock Text="{Binding Label}" Classes="group-label drawer-group-label" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:ChatListItemViewModel">
              <Button Classes="drawer-chat drawer-conversation" Classes.selected="{Binding IsSelected}"
                      Classes.unread="{Binding HasUnreadMessages}" Classes.running="{Binding IsRunning}"
                      AutomationProperties.Name="{Binding AccessibilityName}"
                      AutomationProperties.HelpText="Long press for chat actions"
                      input:InputElement.IsHoldingEnabled="True"
                      input:InputElement.IsHoldWithMouseEnabled="True"
                      Holding="OnChatRowHolding"
                      ContextRequested="OnChatRowContextRequested"
                      KeyDown="OnChatRowKeyDown"
                      Command="{Binding $parent[UserControl].((vm:MobileShellViewModel)DataContext).ChatList.OpenChatCommand}"
                      CommandParameter="{Binding}">
                <!-- The desktop's row: a dot while Lumi works (pulsing) or a reply waits, the title, and a
                     quiet pin. When a chat last moved is the date group's job, not the row's. -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <!-- The open chat: the desktop's slim accent pipe at the row's leading edge. -->
                  <Border x:Name="ChatRowMarker" Grid.ColumnSpan="3" Classes="row-marker chat-pipe" Margin="-11,0,0,0"
                          IsVisible="{Binding IsSelected}" />
                  <Border x:Name="ChatRowDot" Classes="chat-row-dot" IsHitTestVisible="False"
                          sa:LifecycleOpacityPulse.IsActive="{Binding IsRunning}">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="IsRunning" />
                        <Binding Path="HasUnreadMessages" />
                      </MultiBinding>
                    </Border.IsVisible>
                  </Border>
                  <TextBlock x:Name="ChatRowTitle" Grid.Column="1" Text="{Binding Title}" Classes="conversation-title"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel x:Name="ChatRowState" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                              Margin="10,0,0,0" VerticalAlignment="Center">
                    <Border x:Name="BackgroundActivityIndicator" Classes="chat-row-background"
                            IsVisible="{Binding HasBackgroundActivity}"
                            AutomationProperties.Name="{x:Static loc:ChatSessionStrings.ReadyWithBackgroundActivity}" />
                    <PathIcon x:Name="ChatRowPin" Classes="chat-row-pin"
                              IsVisible="{Binding IsPinned}"
                              Data="{DynamicResource Mobile.Icon.Pin}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>

        <Button x:Name="DrawerLoadMoreButton" Classes="drawer-row"
                Margin="10,8,10,10"
                IsVisible="{Binding ChatList.HasMoreChats}"
                Command="{Binding ChatList.LoadMoreChatsCommand}">
          <TextBlock Text="Load more chats" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The places stay centred in the thumb zone while history scrolls underneath. -->
    <Panel x:Name="DrawerFooterChrome" VerticalAlignment="Bottom" ZIndex="1" Background="Transparent">
    <Border Padding="{Binding SafeAreaBottom}">
      <Border x:Name="DrawerAccountSideInset" Padding="{Binding SafeAreaSides}">
          <Panel x:Name="DrawerFooterLayout" Margin="12,8,12,12">
            <views:PlacesBarView x:Name="DrawerPlaces" />
          </Panel>
      </Border>
    </Border>
    </Panel>
  </Panel>
</UserControl>
