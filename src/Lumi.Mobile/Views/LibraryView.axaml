<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lumi.Mobile.Localization"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:textInput="using:Avalonia.Input.TextInput"
             xmlns:layout="using:Lumi.Mobile.Layout"
             xmlns:behaviors="using:Lumi.Mobile.Behaviors"
             x:Class="Lumi.Mobile.Views.LibraryView"
             FlowDirection="{x:Static loc:ChatSessionStrings.UiFlowDirection}"
             x:DataType="vm:LibraryViewModel"
             Background="{DynamicResource Brush.Surface0}">

  <UserControl.Styles>
    <!-- Customize's sections are rows on one card; the listed section wears the open-row tint. -->
    <Style Selector="ListBox#SectionPicker ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem /template/ Border#LayoutRoot">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem:pointerover /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem:selected /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.NavigationSelected}" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem:selected:pointerover /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.NavigationSelected}" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Each section's hue on its tile lives in the shared styles (Border.row-tile.agent and the rest). -->

    <!-- A switch on the row keeps the row's text clear of it, on one line as a setting reads. -->
    <Style Selector="Button.list-row.with-switch">
      <Setter Property="Padding" Value="14,10,68,10" />
    </Style>
    <Style Selector="TextBlock.entry-subtitle">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
      <Setter Property="LineHeight" Value="{DynamicResource Font.LineHeightMeta}" />
    </Style>
    <Style Selector="Button.list-row.with-switch TextBlock.entry-subtitle">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="MaxLines" Value="1" />
    </Style>

    <!--
      Rows that switch (jobs, connectors) join into one card per group, as settings do: the
      group's first row rounds the top, its last the bottom, and hairlines divide the rest.
    -->
    <Style Selector="Border.row-segment">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.row-segment Border#LibraryRowDivider">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.row-segment.card">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Brush.GroupSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GroupBorder}" />
      <Setter Property="BorderThickness" Value="1,0,1,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.row-segment.card Border#LibraryRowDivider">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.row-segment.card.start">
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="14,14,0,0" />
    </Style>
    <Style Selector="Border.row-segment.card.start Border#LibraryRowDivider">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.row-segment.card.end">
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,14,14" />
    </Style>
    <Style Selector="Border.row-segment.card.start.end">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- Editor fields sit on the card's surface as quiet wells. -->
    <Style Selector="Border.group-card TextBox.mobile">
      <Setter Property="Background" Value="{DynamicResource Brush.QuietField}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.QuietFieldBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- An item's icon: agents and skills wear their own emoji, the rest their section's line icon. -->
    <DataTemplate x:Key="LibraryEntryTile" x:DataType="vm:LibraryEntryViewModel">
      <Border Classes="row-tile"
              Classes.project="{Binding IsProject}" Classes.memory="{Binding IsMemory}"
              Classes.connector="{Binding IsConnector}" Classes.job="{Binding IsJob}">
        <Panel>
          <TextBlock Text="{Binding Glyph}" IsVisible="{Binding UsesGlyph}" />
          <PathIcon IsVisible="{Binding IsProject}" Data="{DynamicResource Mobile.Icon.Folder}" />
          <PathIcon IsVisible="{Binding IsMemory}" Data="{DynamicResource Mobile.Icon.Memory}" />
          <PathIcon IsVisible="{Binding IsConnector}" Data="{DynamicResource Mobile.Icon.Plug}" />
          <PathIcon IsVisible="{Binding IsJob}" Data="{DynamicResource Mobile.Icon.Clock}" />
        </Panel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LibraryRowContent" x:DataType="vm:LibraryEntryViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LibraryEntryTile}"
                        VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock x:Name="LibraryEntryName" Text="{Binding Name}" Classes="row-title" />
          <TextBlock Text="{Binding Subtitle, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" Classes="row-meta entry-subtitle"
                     IsVisible="{Binding HasSubtitle}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Badge}" Classes="row-value" MaxWidth="84"
                   IsVisible="{Binding ShowBadge}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Panel x:Name="LibraryRoot">

    <!--
      Library owns a LibraryViewModel DataContext, unlike the other overlays. These zero-size
      proxies inherit the shell DataContext without casting through a temporarily-null ancestor,
      then expose the already-split insets as ordinary control properties for the page below.
    -->
    <Border x:Name="LibrarySafeAreaTopProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaTop}" />
    <Border x:Name="LibrarySafeAreaBottomProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaBottom}" />
    <Border x:Name="LibrarySafeAreaSidesProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaSides}" />

    <!--
      The place's list and its open item: side by side when there is room, one at a time on a
      phone. The view sets the pane geometry from the shell's layout.
    -->
    <layout:ListDetailPanel x:Name="LibraryPanes" IsDetailOpen="{Binding IsDetailOpen}">

      <!-- ═══ The list ═══ -->
      <Grid x:Name="LibraryListPane" RowDefinitions="Auto,*,Auto"
            Background="{DynamicResource Brush.NavigationSurface}">
        <!-- The title floats over the list, frosting it only while rows pass beneath, as on Chats. -->
        <Panel x:Name="LibraryHeaderChrome" Grid.Row="0" ZIndex="1" Background="Transparent">
        <Panel Classes="chrome-edge" Margin="{DynamicResource Mobile.Chat.TopEdgeMargin}">
          <sc:StrataBackdropBlur Classes="chrome-frost" Fade="Bottom"
                                 FadeLength="{DynamicResource Mobile.Chat.EdgeFadeLength}" />
          <Border Background="{DynamicResource Brush.PageEdgeTop}" />
        </Panel>
        <Border x:Name="LibraryTopInset"
                Padding="{Binding #LibrarySafeAreaTopProxy.Padding}">
          <Border x:Name="LibraryHeaderSideInset"
                  Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
            <Grid x:Name="LibraryHeaderLayout"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  MinHeight="{DynamicResource Touch.MinTarget}"
                  MaxWidth="720"
                  HorizontalAlignment="Stretch"
                  Margin="16,8,16,4">
              <Button x:Name="LibraryBackButton" Grid.Column="0" Classes="chat-header-action floating-action" Margin="-4,0,8,0"
                      IsVisible="{Binding ShowBackButton}"
                      AutomationProperties.Name="{loc:Str Back}"
                      Command="{Binding CloseCommand}">
                <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                          Data="{DynamicResource Mobile.Icon.Back}" />
              </Button>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="LibraryListTitle" Text="{Binding ScopeTitle}"
                           Classes="place-title" />
                <TextBlock x:Name="LibraryListSummary" Text="{Binding ScopeSummary}" Classes="row-meta"
                           IsVisible="{Binding ScopeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <!-- A place's own action, the title bar's glass button as New chat is beside the chat list's search. -->
              <Button x:Name="LibraryNewButton" Grid.Column="2" Classes="chat-header-action new-conversation floating-action"
                      IsVisible="{Binding ShowCreateButton}"
                      AutomationProperties.Name="{Binding SectionTitle, StringFormat={loc:Str NewInSection}}"
                      Command="{Binding BeginCreateCommand}">
                <sc:StrataLineIcon Classes="header-glyph accent" Data="{x:Static sc:StrataIcons.Plus}" />
              </Button>
              <views:WebAppUpdateBannerView x:Name="LibraryUpdateBanner"
                                            Grid.Row="1" Grid.ColumnSpan="3"
                                            DataContext="{Binding $parent[views:MobileShellView].DataContext}" />
            </Grid>
          </Border>
        </Border>
        </Panel>

        <!-- The list runs under the floating title and places; ScrollEdgeChrome keeps it clear of both at rest. -->
        <Border x:Name="LibraryListSideInset" Grid.Row="0" Grid.RowSpan="3"
                Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
          <ScrollViewer x:Name="LibraryListScroll" Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled"
                        behaviors:ScrollEdgeChrome.Header="{Binding #LibraryHeaderChrome}"
                        behaviors:ScrollEdgeChrome.Footer="{Binding #LibraryFooterChrome}">
            <Border x:Name="LibraryScrollInset">
            <StackPanel x:Name="LibraryListContent"
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Margin="16,4,16,16">

              <!-- Customize's sections, each with how many it holds, on one card. -->
              <Border x:Name="LibrarySectionsSideInset" Classes="group-card" Margin="0,4,0,12"
                      IsVisible="{Binding ShowSectionChips}">
                <ListBox x:Name="SectionPicker" SelectedIndex="{Binding ScopeSectionIndex}"
                         ItemsSource="{Binding ScopeSections}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibrarySectionOption">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="14,9,16,9">
                        <Border Classes="row-tile"
                                Classes.agent="{Binding IsAgents}" Classes.skill="{Binding IsSkills}"
                                Classes.connector="{Binding IsConnectors}" Classes.project="{Binding IsProjects}">
                          <Panel>
                            <PathIcon IsVisible="{Binding IsAgents}" Data="{DynamicResource Mobile.Icon.Sparkle}" />
                            <PathIcon IsVisible="{Binding IsSkills}" Data="{DynamicResource Mobile.Icon.Bolt}" />
                            <PathIcon IsVisible="{Binding IsConnectors}" Data="{DynamicResource Mobile.Icon.Plug}" />
                            <PathIcon IsVisible="{Binding IsProjects}" Data="{DynamicResource Mobile.Icon.Folder}" />
                          </Panel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="row-title" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="row-value" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Border x:Name="LibrarySearchSideInset" Margin="0,0,0,4">
                <TextBox x:Name="LibrarySearchBox"
                         Classes="mobile list-filter"
                         AutomationProperties.Name="{Binding SearchPlaceholder}"
                         HorizontalAlignment="Stretch"
                         textInput:TextInputOptions.ContentType="Search"
                         textInput:TextInputOptions.ReturnKeyType="Search"
                         PlaceholderText="{Binding SearchPlaceholder}" Text="{Binding SearchText}">
                  <TextBox.InnerLeftContent>
                    <sc:StrataLineIcon Classes="list-filter-icon" Data="{x:Static sc:StrataIcons.Search}" />
                  </TextBox.InnerLeftContent>
                </TextBox>
              </Border>

              <Border Classes="mobile-card" Margin="0,12,0,0" IsVisible="{Binding IsEmpty}">
                <StackPanel x:Name="LibraryEmpty" Spacing="10" Margin="6,0" IsVisible="{Binding IsEmpty}">
                  <TextBlock x:Name="LibraryEmptyTitle" Text="{Binding EmptyTitle}"
                             FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeBody}"
                             TextWrapping="Wrap" />
                  <TextBlock x:Name="LibraryEmptyDescription" Text="{Binding EmptyDescription}"
                             Classes="supporting" />
                  <Button x:Name="LibraryClearSearchButton" Classes="touch subtle"
                          HorizontalAlignment="Left" IsVisible="{Binding IsNoResults}"
                          Content="{loc:Str ClearSearch}" Command="{Binding ClearSearchCommand}" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="LibraryStatus" Text="{Binding StatusMessage}" Classes="muted"
                         TextWrapping="Wrap" Margin="6,10,6,0"
                         IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <ItemsControl x:Name="LibraryEntries" ItemsSource="{Binding Entries}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryEntryViewModel">
                    <StackPanel>
                      <TextBlock Classes="section-label" Text="{Binding GroupLabel}"
                                 IsVisible="{Binding HasGroupLabel}" />
                      <!-- What is switched on and off (jobs, connectors) sits on a card like settings; what is opened is a plain row. -->
                      <Border x:Name="LibraryRowSegment" Classes="row-segment"
                              Classes.card="{Binding HasSwitch}"
                              Classes.start="{Binding IsGroupStart}"
                              Classes.end="{Binding IsGroupEnd}">
                        <Grid ColumnDefinitions="*,Auto">
                          <!-- Every row opens: the editor for what can be edited here, its page otherwise. -->
                          <Button x:Name="LibraryEntryButton" Grid.ColumnSpan="2" Classes="list-row"
                                  Classes.free="{Binding !HasSwitch}"
                                  Classes.selected="{Binding IsOpen}"
                                  Classes.with-switch="{Binding HasSwitch}"
                                  Holding="OnLibraryRowHolding"
                                  ContextRequested="OnLibraryRowContextRequested"
                                  AutomationProperties.Name="{Binding Name}"
                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenEntryCommand}"
                                  CommandParameter="{Binding}"
                                  Content="{Binding}" ContentTemplate="{StaticResource LibraryRowContent}" />
                          <Border x:Name="LibraryRowDivider" Grid.ColumnSpan="2" Classes="row-divider" />
                          <Border x:Name="LibraryRowMarker" Classes="row-marker" Margin="3,14"
                                  IsVisible="{Binding IsOpen}" />
                          <ToggleSwitch x:Name="LibraryEntrySwitch" Grid.Column="1"
                                        IsVisible="{Binding HasSwitch}"
                                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                        IsEnabled="{Binding !IsSwitchBusy}"
                                        AutomationProperties.Name="{Binding SwitchLabel}"
                                        Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleEntryCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </Border>
          </ScrollViewer>
        </Border>

        <!-- The places, centred in the thumb zone with the list scrolling under them, as on the chat list.
             Memories is a Settings page and steps back instead. -->
        <Panel x:Name="LibraryFooterChrome" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom"
               ZIndex="1" Background="Transparent" IsVisible="{Binding ShowPlaces}">
          <Border x:Name="LibraryListBottomInset"
                  Padding="{Binding #LibrarySafeAreaBottomProxy.Padding}">
            <Border x:Name="LibraryPlacesSideInset"
                    Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
              <views:PlacesBarView x:Name="LibraryPlaces"
                                   x:DataType="vm:MobileShellViewModel"
                                   DataContext="{Binding $parent[views:MobileShellView].DataContext}"
                                   IsVisible="{Binding !IsKeyboardOpen}"
                                   Margin="12,8,12,12" />
            </Border>
          </Border>
        </Panel>
      </Grid>

      <!-- ═══ The open item ═══ -->
      <Grid x:Name="LibraryDetailPane" RowDefinitions="Auto,*"
            Background="{DynamicResource Brush.ChatCanvas}">

        <!-- The editor's pinned header keeps the title readable and Save above the IME. -->
        <Border x:Name="LibraryEditorTopInset" Grid.Row="0"
                IsVisible="{Binding IsEditing}"
                Padding="{Binding #LibrarySafeAreaTopProxy.Padding}">
          <Border x:Name="LibraryEditorHeaderSideInset"
                  Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
            <Grid x:Name="LibraryEditorHeader"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  MaxWidth="720"
                  HorizontalAlignment="Stretch"
                  Margin="8,8,12,4">
              <Button x:Name="EditCancelButton" Grid.Column="0" Classes="header-action"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      Content="{loc:Str Cancel}" Command="{Binding CancelEditCommand}" />
              <TextBlock x:Name="LibraryTitle" Grid.Column="1" Text="{Binding PageTitle}"
                         FontSize="{DynamicResource Font.SizeBody}" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <Button x:Name="EditSaveButton" Grid.Column="2" Classes="header-action primary"
                      Command="{Binding SaveCommand}">
                <TextBlock Text="{Binding SaveButtonText}" Foreground="{Binding $parent[Button].Foreground}" />
              </Button>
              <TextBlock x:Name="LibraryEditorStatus" Grid.Row="1" Grid.ColumnSpan="3"
                         Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,8,8,0"
                         IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
          </Border>
        </Border>

        <!-- Editor -->
        <Border x:Name="LibraryEditorBottomInset" Grid.Row="1"
                Padding="{Binding #LibrarySafeAreaBottomProxy.Padding}"
                IsVisible="{Binding IsEditing}">
          <Border x:Name="LibraryEditorSideInset"
                  Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
            <ScrollViewer x:Name="LibraryEditorScrollViewer" Classes="mobile-scroll">
              <StackPanel Spacing="12" x:Name="LibraryEditor" MaxWidth="720"
                          HorizontalAlignment="Stretch"
                          Margin="{DynamicResource Mobile.Page.FormContentMargin}">
                <Button x:Name="LibraryRetryEditorButton" Classes="touch subtle"
                        IsVisible="{Binding HasEditorLoadFailed}" HorizontalAlignment="Left"
                        Command="{Binding RetryEditorCommand}" Content="{loc:Str TryLoadingAgain}" />
                <Border Classes="group-card" Padding="16">
                  <StackPanel Spacing="16" IsEnabled="{Binding CanEditFields}">
                    <StackPanel Spacing="6">
                      <TextBlock x:Name="EditNameLabel" Text="{loc:Str Name}" Classes="field-label" />
                      <TextBox x:Name="EditNameBox" Classes="mobile" PlaceholderText="{loc:Str Name}"
                               AutomationProperties.Name="{loc:Str Name}" Text="{Binding EditName}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding ShowDescriptionEditor}">
                      <TextBlock x:Name="EditDescriptionLabel" Text="{loc:Str Description}" Classes="field-label" />
                      <TextBox x:Name="EditDescriptionBox" Classes="mobile" PlaceholderText="{loc:Str ShortSummary}"
                               AutomationProperties.Name="{loc:Str Description}" Text="{Binding EditDescription}"
                               TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding ShowGlyphEditor}">
                      <TextBlock x:Name="EditGlyphLabel" Text="{loc:Str Icon}" Classes="field-label" />
                      <TextBox x:Name="EditGlyphBox" Classes="mobile" PlaceholderText="{loc:Str EmojiOrSymbol}"
                               AutomationProperties.Name="{loc:Str Icon}" Text="{Binding EditGlyph}" MaxLength="4" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding ShowProjectWorkingDirectory}">
                      <TextBlock x:Name="EditWorkingDirectoryLabel" Text="{loc:Str PcWorkspace}" Classes="field-label" />
                      <TextBox x:Name="EditWorkingDirectoryBox" Classes="mobile" PlaceholderText="{loc:Str PcFolder}"
                               AutomationProperties.Name="{loc:Str PcWorkspace}" Text="{Binding EditWorkingDirectory}"
                               FlowDirection="LeftToRight"
                               textInput:TextInputOptions.ShowSuggestions="False" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                      <TextBlock x:Name="EditBodyLabel" Text="{Binding BodyLabel}" Classes="field-label" />
                      <TextBox x:Name="EditBodyBox" Classes="mobile" AcceptsReturn="True" TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding BodyLabel}"
                               MinHeight="180" Text="{Binding EditBody}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="{loc:Str LibrarySavedOnPc}"
                           Classes="muted" Margin="6,0" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Border>

        <!-- An item's own page: built-in agents and skills, connectors and jobs open read-only. -->
        <Border x:Name="LibraryViewerTopInset" Grid.Row="0"
                IsVisible="{Binding IsViewing}"
                Padding="{Binding #LibrarySafeAreaTopProxy.Padding}">
          <Border Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
            <ContentControl x:Name="LibraryViewerHeaderHost" Content="{Binding ViewedEntry}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:LibraryEntryViewModel">
                  <Grid x:Name="LibraryViewerHeader" ColumnDefinitions="Auto,Auto,*,Auto"
                        MaxWidth="720" HorizontalAlignment="Stretch" Margin="8,8,12,8">
                    <Button x:Name="LibraryViewerBackButton" Classes="chat-header-action floating-action" Margin="0,0,4,0"
                            IsVisible="{Binding !$parent[layout:ListDetailPanel].IsTwoPane}"
                            AutomationProperties.Name="{loc:Str Back}"
                            Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CloseViewCommand}">
                      <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                                Data="{DynamicResource Mobile.Icon.Back}" />
                    </Button>
                    <ContentControl Grid.Column="1" Content="{Binding}"
                                    ContentTemplate="{StaticResource LibraryEntryTile}"
                                    VerticalAlignment="Center" Margin="8,0,12,0" />
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock x:Name="LibraryViewerTitle" Text="{Binding Name}"
                                 FontSize="{DynamicResource Font.SizeSubtitle}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Kind}" Classes="row-meta" />
                    </StackPanel>
                    <Button x:Name="LibraryViewerActionsButton" Grid.Column="3"
                            Classes="navigation-icon-button floating-action"
                            IsVisible="{Binding HasActions}"
                            AutomationProperties.Name="{Binding ActionsLabel}"
                            Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenRowActionsCommand}" CommandParameter="{Binding}">
                      <PathIcon Width="20" Height="20" Foreground="{DynamicResource Brush.TextSecondary}"
                                Data="{DynamicResource Mobile.Icon.More}" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Border>

        <Border x:Name="LibraryViewerBottomInset" Grid.Row="1"
                IsVisible="{Binding IsViewing}"
                Padding="{Binding #LibrarySafeAreaBottomProxy.Padding}">
          <Border Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
            <ContentControl x:Name="LibraryViewerContentHost" Content="{Binding ViewedEntry}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:LibraryEntryViewModel">
                  <ScrollViewer x:Name="LibraryViewerScroll" Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LibraryViewer" Spacing="12" MaxWidth="720"
                                HorizontalAlignment="Stretch" Margin="16,4,16,24">
                      <TextBlock Text="{Binding Description, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" Classes="supporting"
                                 IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                      <!-- On or off, right where the item is described. -->
                      <Border Classes="group-card" IsVisible="{Binding HasSwitch}">
                        <Grid ColumnDefinitions="*,Auto" Margin="16,8,8,8" MinHeight="44">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EnabledStateText}" Classes="row-title" />
                            <TextBlock Text="{loc:Str AppliesOnPc}" Classes="row-meta" />
                          </StackPanel>
                          <ToggleSwitch x:Name="LibraryViewerSwitch" Grid.Column="1"
                                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                        IsEnabled="{Binding !IsSwitchBusy}"
                                        AutomationProperties.Name="{Binding SwitchLabel}"
                                        Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ToggleEntryCommand}" CommandParameter="{Binding}"
                                        VerticalAlignment="Center" />
                        </Grid>
                      </Border>

                      <Border Classes="group-card" IsVisible="{Binding CanOpenChat}">
                        <Button x:Name="LibraryViewerOpenChatButton" Classes="list-row"
                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenViewedChatCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Classes="row-tile">
                              <PathIcon Data="{DynamicResource Mobile.Icon.Chat}" Foreground="{DynamicResource Brush.AccentText}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="{loc:Str OpenJobChat}" Classes="row-title" />
                              <TextBlock Text="{loc:Str OpenJobChatHelp}" Classes="row-meta" />
                            </StackPanel>
                            <PathIcon Grid.Column="2" Classes="row-chevron" Data="{DynamicResource Mobile.Icon.ChevronRight}" />
                          </Grid>
                        </Button>
                      </Border>

                      <Border Classes="group-card" IsVisible="{Binding HasFacts}">
                        <ItemsControl x:Name="LibraryViewerFacts" ItemsSource="{Binding Facts}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryFact">
                              <Panel>
                                <Border Classes="row-divider" IsVisible="{Binding !IsFirst}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="16,13">
                                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font.SizeBody}"
                                             Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="row-value"
                                             HorizontalAlignment="Right" TextAlignment="Right"
                                             TextWrapping="Wrap" TextTrimming="None" />
                                </Grid>
                              </Panel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>

                      <TextBlock Text="{Binding BodyLabel}" Classes="section-label" Margin="6,8,6,0"
                                 IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).HasViewBody}" />
                      <Border Classes="group-card" Padding="16,14"
                              IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).HasViewBody}">
                        <SelectableTextBlock x:Name="LibraryViewerBody" Classes="detail-body"
                                             Text="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ViewBody, Converter={x:Static loc:ChatSessionStrings.MobileTextConverter}}" />
                      </Border>
                      <TextBlock Text="{loc:Str LoadingDetails}" Classes="muted"
                                 IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).IsViewLoading}" />
                      <TextBlock Text="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ViewStatus}"
                                 Classes="muted" TextWrapping="Wrap"
                                 IsVisible="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ViewStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding ReadOnlyNote}" Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap"
                                 IsVisible="{Binding ReadOnlyNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </ScrollViewer>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Border>
        </Border>

        <!-- Beside the list, before anything is open. -->
        <StackPanel x:Name="LibraryDetailPlaceholder" Grid.RowSpan="2"
                    Classes="detail-placeholder"
                    IsVisible="{Binding !IsDetailOpen}"
                    Spacing="8" MaxWidth="340" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding SectionTitle}" FontWeight="SemiBold"
                     FontSize="{DynamicResource Font.SizeSubtitle}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding DetailPlaceholder}" Classes="supporting" TextAlignment="Center" />
        </StackPanel>

        <!-- The same quiet edge the chat keeps beside its list. -->
        <Border x:Name="LibraryPaneSeparation" Grid.RowSpan="2"
                Width="1" HorizontalAlignment="Left" IsHitTestVisible="False"
                IsVisible="{Binding #LibraryPanes.IsTwoPane}"
                Background="{DynamicResource Brush.ChatPaneSeparation}"
                BoxShadow="{DynamicResource Shadow.ChatPaneSeparation}" />
      </Grid>
    </layout:ListDetailPanel>

    <!-- Row actions cover the whole page so the header/search cannot be used through the scrim. -->
    <sc:StrataBottomSheet x:Name="LibraryActionsSheet"
                          Classes="safe-area"
                          IsOpen="{Binding IsRowActionsOpen, Mode=TwoWay}"
                          IsDismissable="{Binding !IsActionBusy}"
                          Title="{Binding ActionSheetTitle}">
      <Border x:Name="LibraryActionsSideInset">
        <StackPanel Margin="0,0,0,4">
          <TextBlock x:Name="LibraryActionStatus" Text="{Binding StatusMessage}"
                     Classes="sheet-body" Margin="24,0,24,8"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{loc:Str WorkingOnPc}" Classes="sheet-body" Margin="24,0,24,8"
                     IsVisible="{Binding IsActionBusy}" />
          <StackPanel x:Name="LibraryActionOptions" IsVisible="{Binding !IsConfirmingDelete}"
                      IsEnabled="{Binding !IsActionBusy}">
            <Button x:Name="LibraryEditButton" Classes="sheet-item"
                    IsVisible="{Binding CanEditActionEntry}" Command="{Binding EditActionEntryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Classes="sheet-leading"
                          Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM5.92 19H5v-.92l9.06-9.06.92.92L5.92 19zM20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83a1 1 0 0 0 0-1.41z" />
                <TextBlock Grid.Column="1" Text="{loc:Str Edit}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LibraryToggleButton" Classes="sheet-item"
                    IsVisible="{Binding CanToggleActionEntry}" Command="{Binding ToggleActionEntryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Classes="sheet-leading"
                          Data="M13 3h-2v10h2V3zm4.83 2.17-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7a6.995 6.995 0 0 1-4.42-12.42L6.17 5.17A8.932 8.932 0 0 0 3 12a9 9 0 0 0 18 0c0-2.74-1.23-5.18-3.17-6.83z" />
                <TextBlock Grid.Column="1" Text="{Binding ToggleActionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LibraryDeleteButton" Classes="sheet-item destructive"
                    IsVisible="{Binding CanDeleteActionEntry}" Command="{Binding DeleteActionEntryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Classes="sheet-leading"
                          Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z" />
                <TextBlock Grid.Column="1" Text="{loc:Str DeleteEllipsis}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel x:Name="LibraryDeleteConfirmation" Spacing="18" Margin="16,0,16,8"
                      IsVisible="{Binding IsConfirmingDelete}" IsEnabled="{Binding !IsActionBusy}">
            <TextBlock Text="{Binding DeleteConfirmationDescription}" Classes="sheet-body" Margin="8,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button x:Name="LibraryKeepItemButton" Classes="sheet-action" Content="{loc:Str Cancel}"
                      Command="{Binding CancelDeleteConfirmationCommand}" />
              <Button x:Name="LibraryConfirmDeleteButton" Grid.Column="1" Classes="sheet-action destructive"
                      Content="{loc:Str Delete}" Command="{Binding ConfirmDeleteActionEntryCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="LibraryDiscardSheet" Classes="safe-area"
                          IsOpen="{Binding IsDiscardConfirmationOpen, Mode=TwoWay}"
                          Title="{loc:Str DiscardQuestion}"
                          Description="{Binding DiscardDescription}">
      <Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="16,4,16,8">
          <Button x:Name="LibraryKeepEditingButton" Classes="sheet-action" Content="{loc:Str KeepEditing}"
                  Command="{Binding KeepEditingCommand}" />
          <Button x:Name="LibraryDiscardChangesButton" Grid.Column="1" Classes="sheet-action destructive"
                  Content="{loc:Str Discard}" IsEnabled="{Binding !IsSaving}" Command="{Binding DiscardChangesCommand}" />
        </Grid>
      </Border>
    </sc:StrataBottomSheet>
  </Panel>
</UserControl>
