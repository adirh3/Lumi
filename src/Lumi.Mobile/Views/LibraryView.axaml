<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:textInput="using:Avalonia.Input.TextInput"
             x:Class="Lumi.Mobile.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="{DynamicResource Brush.Surface0}">

  <UserControl.Styles>
    <!-- Only the selected section needs a surface; the other labels stay on the canvas. -->
    <Style Selector="ListBox#SectionPicker ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Selection belongs to the ONE outer pill. Painting the ContentPresenter too produced a
         second accent rectangle behind the chip with a different visible radius. -->
    <Style Selector="ListBox#SectionPicker ListBoxItem /template/ Border#LayoutRoot">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem:selected /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="ListBox#SectionPicker ListBoxItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="LibraryRowContent" x:DataType="vm:LibraryEntryViewModel">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Width="32" Height="32" VerticalAlignment="Top">
          <TextBlock Text="{Binding Glyph}" FontSize="{DynamicResource Font.SizeSubtitle}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock x:Name="LibraryEntryName" Text="{Binding Name}"
                     FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeBody}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Description}" Classes="muted" MaxLines="2"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Badge}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding HasBadge}" />
          <TextBlock Text="{Binding EnabledStateText}" Classes="muted"
                     IsVisible="{Binding HasEnabledState}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!--
      Library owns a LibraryViewModel DataContext, unlike the other overlays. These zero-size
      proxies inherit the shell DataContext without casting through a temporarily-null ancestor,
      then expose the already-split insets as ordinary control properties for the page below.
    -->
    <Border x:Name="LibrarySafeAreaTopProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaTop}" />
    <Border x:Name="LibrarySafeAreaBottomProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaBottom}" />
    <Border x:Name="LibrarySafeAreaSidesProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaSides}" />
    <Border x:Name="LibraryTopInset" Grid.Row="0"
            Padding="{Binding #LibrarySafeAreaTopProxy.Padding}">
      <Border x:Name="LibraryHeaderSideInset"
              Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
        <Grid x:Name="LibraryHeaderLayout"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="4"
              MaxWidth="720"
              HorizontalAlignment="Stretch"
              Margin="{DynamicResource Mobile.Page.HeaderMargin}">
          <Button x:Name="LibraryBackButton" Grid.Column="0" Classes="page-back"
                  AutomationProperties.Name="Back"
                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CloseCommand}">
            <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          </Button>
          <TextBlock x:Name="LibraryTitle" Grid.Column="1" Text="{Binding PageTitle}"
                     Classes="section-title" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="LibraryNewButton" Grid.Column="2" Classes="touch open-action"
                  CornerRadius="16" Padding="16,10"
                  IsVisible="{Binding ShowCreateButton}"
                  Command="{Binding BeginCreateCommand}">
            <TextBlock Text="New" Foreground="{Binding $parent[Button].Foreground}" />
          </Button>

          <!-- A dedicated, pinned action row keeps the title readable and Save above the IME. -->
          <Grid x:Name="LibraryEditorActions" Grid.Row="1" Grid.ColumnSpan="3"
                ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0"
                IsVisible="{Binding IsEditing}">
            <Button x:Name="EditCancelButton" Grid.Column="0" Classes="touch subtle"
                    Content="Cancel" Command="{Binding CancelEditCommand}" />
            <Button x:Name="EditSaveButton" Grid.Column="2" Classes="touch open-action"
                    Command="{Binding SaveCommand}">
              <TextBlock Text="{Binding SaveButtonText}" Foreground="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>
          <TextBlock x:Name="LibraryEditorStatus" Grid.Row="2" Grid.ColumnSpan="3"
                     Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsEditing" />
                <Binding Path="StatusMessage" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
          <views:WebAppUpdateBannerView x:Name="LibraryUpdateBanner"
                                        Grid.Row="3" Grid.ColumnSpan="3"
                                        DataContext="{Binding $parent[views:MobileShellView].DataContext}" />
        </Grid>
      </Border>
    </Border>

    <!-- Section picker: horizontally scrollable so it survives a 320 dp cover display -->
    <Border x:Name="LibrarySectionsSideInset" Grid.Row="1"
            IsVisible="{Binding !IsEditing}"
            Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    Margin="{DynamicResource Mobile.Page.ControlMargin}">
        <ListBox x:Name="SectionPicker" SelectedIndex="{Binding SectionIndex}"
                 ItemsSource="{Binding SectionNames}"
                 Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Margin="14,9" FontSize="{DynamicResource Font.SizeBody}" FontWeight="Medium" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Border>

    <Border x:Name="LibrarySearchSideInset" Grid.Row="2"
            IsVisible="{Binding !IsEditing}"
            Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
      <TextBox x:Name="LibrarySearchBox"
               Classes="mobile"
               AutomationProperties.Name="Search this Library category"
               MaxWidth="720"
               HorizontalAlignment="Stretch"
               Margin="{DynamicResource Mobile.Page.ControlMargin}"
               textInput:TextInputOptions.ContentType="Search"
               textInput:TextInputOptions.ReturnKeyType="Search"
               PlaceholderText="Search" Text="{Binding SearchText}" />
    </Border>

    <Panel Grid.Row="3">

      <!-- List -->
      <Border x:Name="LibraryListBottomInset"
              Padding="{Binding #LibrarySafeAreaBottomProxy.Padding}"
              IsVisible="{Binding !IsEditing}">
        <Border x:Name="LibraryListSideInset"
                Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
          <ScrollViewer Classes="mobile-scroll">
            <StackPanel x:Name="LibraryListContent"
                        Spacing="12"
                        MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Margin="{DynamicResource Mobile.Page.ContentMargin}">
              <TextBlock x:Name="LibrarySectionDescription" Text="{Binding SectionDescription}"
                         Classes="supporting" />

              <Border Classes="mobile-card" IsVisible="{Binding IsEmpty}">
                <StackPanel x:Name="LibraryEmpty" Spacing="12" IsVisible="{Binding IsEmpty}">
                  <TextBlock x:Name="LibraryEmptyTitle" Text="{Binding EmptyTitle}"
                             FontWeight="SemiBold" FontSize="{DynamicResource Font.SizeSubtitle}"
                             TextWrapping="Wrap" />
                  <TextBlock x:Name="LibraryEmptyDescription" Text="{Binding EmptyDescription}"
                             Classes="supporting" />
                  <Button x:Name="LibraryClearSearchButton" Classes="touch subtle"
                          HorizontalAlignment="Left" IsVisible="{Binding IsNoResults}"
                          Content="Clear search" Command="{Binding ClearSearchCommand}" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="LibraryStatus" Text="{Binding StatusMessage}" Classes="muted"
                         TextWrapping="Wrap" Margin="0,4"
                         IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <ItemsControl x:Name="LibraryEntries" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LibraryEntryViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,0,0,6">
                      <Button x:Name="LibraryEntryButton" Classes="chat-row"
                              IsVisible="{Binding CanEdit}"
                              Holding="OnLibraryRowHolding"
                              AutomationProperties.Name="{Binding Name}"
                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).BeginEditCommand}"
                              CommandParameter="{Binding}"
                              Content="{Binding}" ContentTemplate="{StaticResource LibraryRowContent}" />
                      <ContentControl x:Name="LibraryReadOnlyRow"
                                      IsVisible="{Binding !CanEdit}" Padding="14,12"
                                      MinHeight="64" HorizontalContentAlignment="Stretch"
                                      Holding="OnLibraryRowHolding"
                                      Content="{Binding}" ContentTemplate="{StaticResource LibraryRowContent}" />
                      <Button x:Name="LibraryRowActionsButton" Grid.Column="1" Classes="touch icon subtle"
                              VerticalAlignment="Center" IsVisible="{Binding HasActions}"
                              AutomationProperties.Name="{Binding ActionsLabel}"
                              Holding="OnLibraryRowHolding"
                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenRowActionsCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Width="{DynamicResource Touch.IconSize}" Height="{DynamicResource Touch.IconSize}"
                                  Data="M5,10 A2,2 0 1 1 5,14 A2,2 0 1 1 5,10 Z M12,10 A2,2 0 1 1 12,14 A2,2 0 1 1 12,10 Z M19,10 A2,2 0 1 1 19,14 A2,2 0 1 1 19,10 Z" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>

      <!-- Editor -->
      <Border x:Name="LibraryEditorBottomInset"
              Padding="{Binding #LibrarySafeAreaBottomProxy.Padding}"
              IsVisible="{Binding IsEditing}">
        <Border x:Name="LibraryEditorSideInset"
                Padding="{Binding #LibrarySafeAreaSidesProxy.Padding}">
          <ScrollViewer x:Name="LibraryEditorScrollViewer" Classes="mobile-scroll">
            <StackPanel Spacing="16" x:Name="LibraryEditor" MaxWidth="720"
                        HorizontalAlignment="Stretch"
                        Margin="{DynamicResource Mobile.Page.FormContentMargin}">
              <TextBlock Text="Changes are saved to your shared Library on your computer."
                         Classes="supporting" />
              <Button x:Name="LibraryRetryEditorButton" Classes="touch subtle"
                      IsVisible="{Binding HasEditorLoadFailed}" HorizontalAlignment="Left"
                      Command="{Binding RetryEditorCommand}" Content="Try loading again" />
              <Border Classes="mobile-card">
                <StackPanel Spacing="16" IsEnabled="{Binding CanEditFields}">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="EditNameLabel" Text="Name" Classes="field-label" />
                    <TextBox x:Name="EditNameBox" Classes="mobile" PlaceholderText="Name"
                             AutomationProperties.Name="Name" Text="{Binding EditName}" />
                    <TextBlock Text="Required. Choose a name you will recognize."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding ShowDescriptionEditor}">
                    <TextBlock x:Name="EditDescriptionLabel" Text="Description" Classes="field-label" />
                    <TextBox x:Name="EditDescriptionBox" Classes="mobile" PlaceholderText="Description"
                             AutomationProperties.Name="Description" Text="{Binding EditDescription}"
                             TextWrapping="Wrap" />
                    <TextBlock Text="Optional. A short summary to help you find this item."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding ShowGlyphEditor}">
                    <TextBlock x:Name="EditGlyphLabel" Text="Icon" Classes="field-label" />
                    <TextBox x:Name="EditGlyphBox" Classes="mobile" PlaceholderText="Icon"
                             AutomationProperties.Name="Icon" Text="{Binding EditGlyph}" MaxLength="4" />
                    <TextBlock Text="Use a single emoji or symbol."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding ShowProjectWorkingDirectory}">
                    <TextBlock x:Name="EditWorkingDirectoryLabel" Text="Computer workspace" Classes="field-label" />
                    <TextBox x:Name="EditWorkingDirectoryBox" Classes="mobile" PlaceholderText="Working directory"
                             AutomationProperties.Name="Computer workspace" Text="{Binding EditWorkingDirectory}"
                             textInput:TextInputOptions.ShowSuggestions="False" />
                    <TextBlock Text="Optional. A folder path on your computer, not this phone."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock x:Name="EditBodyLabel" Text="{Binding BodyLabel}" Classes="field-label" />
                    <TextBox x:Name="EditBodyBox" Classes="mobile" AcceptsReturn="True" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding BodyLabel}"
                             MinHeight="180" Text="{Binding EditBody}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>
    </Panel>

    <!-- Row actions cover the whole page so the header/search cannot be used through the scrim. -->
    <sc:StrataBottomSheet x:Name="LibraryActionsSheet"
                          Grid.RowSpan="4"
                          Classes="safe-area"
                          IsOpen="{Binding IsRowActionsOpen, Mode=TwoWay}"
                          IsDismissable="{Binding !IsActionBusy}"
                          Title="{Binding ActionSheetTitle}">
      <Border x:Name="LibraryActionsSideInset">
        <StackPanel Margin="0,0,0,4">
          <TextBlock x:Name="LibraryActionStatus" Text="{Binding StatusMessage}"
                     Classes="sheet-body" Margin="24,0,24,8"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="Working on your computer…" Classes="sheet-body" Margin="24,0,24,8"
                     IsVisible="{Binding IsActionBusy}" />
          <StackPanel x:Name="LibraryActionOptions" IsVisible="{Binding !IsConfirmingDelete}"
                      IsEnabled="{Binding !IsActionBusy}">
            <Button x:Name="LibraryEditButton" Classes="sheet-item"
                    IsVisible="{Binding CanEditActionEntry}" Command="{Binding EditActionEntryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Classes="sheet-leading"
                          Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM5.92 19H5v-.92l9.06-9.06.92.92L5.92 19zM20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83a1 1 0 0 0 0-1.41z" />
                <TextBlock Grid.Column="1" Text="Edit" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LibraryToggleButton" Classes="sheet-item"
                    IsVisible="{Binding CanToggleActionEntry}" Command="{Binding ToggleActionEntryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Classes="sheet-leading"
                          Data="M13 3h-2v10h2V3zm4.83 2.17-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7a6.995 6.995 0 0 1-4.42-12.42L6.17 5.17A8.932 8.932 0 0 0 3 12a9 9 0 0 0 18 0c0-2.74-1.23-5.18-3.17-6.83z" />
                <TextBlock Grid.Column="1" Text="{Binding ToggleActionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="LibraryDeleteButton" Classes="sheet-item destructive"
                    IsVisible="{Binding CanDeleteActionEntry}" Command="{Binding DeleteActionEntryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <PathIcon Classes="sheet-leading"
                          Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z" />
                <TextBlock Grid.Column="1" Text="Delete…" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel x:Name="LibraryDeleteConfirmation" Spacing="18" Margin="16,0,16,8"
                      IsVisible="{Binding IsConfirmingDelete}" IsEnabled="{Binding !IsActionBusy}">
            <TextBlock Text="{Binding DeleteConfirmationDescription}" Classes="sheet-body" Margin="8,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button x:Name="LibraryKeepItemButton" Classes="sheet-action" Content="Cancel"
                      Command="{Binding CancelDeleteConfirmationCommand}" />
              <Button x:Name="LibraryConfirmDeleteButton" Grid.Column="1" Classes="sheet-action destructive"
                      Content="Delete" Command="{Binding ConfirmDeleteActionEntryCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </sc:StrataBottomSheet>

    <sc:StrataBottomSheet x:Name="LibraryDiscardSheet" Grid.RowSpan="4" Classes="safe-area"
                          IsOpen="{Binding IsDiscardConfirmationOpen, Mode=TwoWay}"
                          Title="Discard changes?"
                          Description="{Binding DiscardDescription}">
      <Border>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="16,4,16,8">
          <Button x:Name="LibraryKeepEditingButton" Classes="sheet-action" Content="Keep editing"
                  Command="{Binding KeepEditingCommand}" />
          <Button x:Name="LibraryDiscardChangesButton" Grid.Column="1" Classes="sheet-action destructive"
                  Content="Discard" IsEnabled="{Binding !IsSaving}" Command="{Binding DiscardChangesCommand}" />
        </Grid>
      </Border>
    </sc:StrataBottomSheet>
  </Grid>
</UserControl>
