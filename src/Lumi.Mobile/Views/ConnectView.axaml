<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.Mobile.ViewModels"
             xmlns:views="using:Lumi.Mobile.Views"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:textInput="using:Avalonia.Input.TextInput"
             x:Class="Lumi.Mobile.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

  <Grid>
    <Border x:Name="ConnectSafeAreaSidesProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaSides}" />
    <Border x:Name="ConnectSafeAreaTopProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaTop}" />
    <Border x:Name="ConnectSafeAreaBottomProxy"
            Width="0" Height="0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False"
            x:DataType="vm:MobileShellViewModel"
            DataContext="{Binding $parent[views:MobileShellView].DataContext}"
            Padding="{Binding SafeAreaBottom}" />

    <Border x:Name="ConnectTopInset" Padding="{Binding #ConnectSafeAreaTopProxy.Padding}">
      <Border x:Name="ConnectBottomInset" Padding="{Binding #ConnectSafeAreaBottomProxy.Padding}">
        <Border x:Name="ConnectSideInset" Padding="{Binding #ConnectSafeAreaSidesProxy.Padding}">
          <ScrollViewer Classes="mobile-scroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ConnectContent"
                        MaxWidth="480"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Margin="{DynamicResource Mobile.Setup.ContentMargin}"
                        Spacing="24">

              <!-- Compact brand lockup: the product mark is real, immediate, and equally legible in
                   both theme variants. -->
              <Grid x:Name="ConnectHero" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Width="64" Height="64"
                        Padding="4"
                        CornerRadius="18">
                  <Image x:Name="ConnectOrb"
                         Source="avares://Lumi.Mobile/Assets/lumi-icon.png"
                         Width="56" Height="56"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Lumi"
                             FontSize="{DynamicResource Font.SizeTitle}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="A little closer to everything."
                             Classes="supporting"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Grid x:Name="SetupProgress" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Classes="setup-step" Classes.current="{Binding IsFindStep}">
                  <TextBlock Text="1  Find your PC" FontSize="{DynamicResource Font.SizeMeta}" FontWeight="Medium" />
                </Border>
                <Border Grid.Column="1" Classes="setup-step" Classes.current="{Binding !IsFindStep}">
                  <TextBlock Text="2  Pair your phone" FontSize="{DynamicResource Font.SizeMeta}" FontWeight="Medium" />
                </Border>
              </Grid>

              <!-- ═══ Step 1: find the PC ═══ -->
              <StackPanel x:Name="FindStep" Spacing="20" IsVisible="{Binding IsFindStep}">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="FindStepTitle"
                             Text="Your Lumi, on the go."
                             FontSize="{DynamicResource Font.SizeHeadline}"
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="Pick up your conversations and get things done on your PC, from your phone."
                             Classes="supporting"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="mobile-card">
                  <StackPanel Spacing="6">
                    <TextBlock Text="First, open Lumi on your PC"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Go to Settings → Mobile and turn on phone access. Open its setup link, or enter the address below."
                               Classes="supporting"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border x:Name="ManualAddressPath"
                        Margin="0,2,0,0">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="PC address"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Use the address shown by Lumi Desktop."
                                 Classes="supporting"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="ManualAddressBox"
                             Classes="mobile"
                             textInput:TextInputOptions.ContentType="Url"
                             textInput:TextInputOptions.ReturnKeyType="Go"
                             textInput:TextInputOptions.AutoCapitalization="False"
                             textInput:TextInputOptions.ShowSuggestions="False"
                             PlaceholderText="e.g. 100.100.20.10"
                             AutomationProperties.Name="PC address"
                             Text="{Binding ManualAddress}"
                             KeyDown="OnManualAddressKeyDown" />
                    <Border x:Name="ConnectError" Classes="mobile-card"
                            Padding="14"
                            BorderBrush="{DynamicResource Brush.BorderError}"
                            Background="{DynamicResource Brush.DangerSubtle}"
                            IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding ErrorText}" Classes="supporting"
                                 Foreground="{DynamicResource Brush.DangerDefault}" />
                    </Border>
                    <Button x:Name="ManualConnectButton"
                            Classes="touch accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="Continue"
                            IsDefault="True"
                            Command="{Binding ConnectManuallyCommand}" />
                    <TextBlock Text="For a private connection from anywhere, keep Tailscale connected on both devices."
                               Classes="supporting" />
                  </StackPanel>
                </Border>

                <Border Margin="0,2,0,0" Padding="0,12,0,0">
                  <StackPanel Spacing="8">
                    <ToggleSwitch Content="Use local Wi-Fi instead"
                                  IsChecked="{Binding AllowInsecureLanDiscovery}" />
                    <TextBlock Text="Local Wi-Fi traffic is unencrypted. Only use a network you trust."
                               Classes="supporting" Foreground="{DynamicResource Brush.WarningDefault}"
                               IsVisible="{Binding AllowInsecureLanDiscovery}" />
                    <Button x:Name="SearchButton"
                            Classes="touch subtle"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding SearchCommand}"
                            IsVisible="{Binding AllowInsecureLanDiscovery}"
                            IsEnabled="{Binding !IsSearching}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <sc:StrataPulse IsLive="{Binding IsSearching}"
                                        Width="{DynamicResource Touch.IconSize}"
                                        Height="{DynamicResource Touch.IconSize}"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="Find Lumi nearby" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>

                <StackPanel x:Name="DiscoveredHosts"
                            Spacing="6"
                            IsVisible="{Binding HasHosts}">
                  <TextBlock Text="Nearby"
                             FontSize="{DynamicResource Font.SizeCaption}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                  <ItemsControl x:Name="HostList" ItemsSource="{Binding Hosts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiscoveredHostViewModel">
                        <Button Classes="setup-host-row"
                                Command="{Binding $parent[ItemsControl].((vm:ConnectViewModel)DataContext).ChooseHostCommand}"
                                CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    VerticalAlignment="Center">
                              <PathIcon Width="20" Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Brush.AccentDefault}"
                                        Data="M3 4h18v12H3V4zm2 2v8h14V6H5zm3 12h8v2H8v-2z" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding HostName}"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Subtitle}"
                                         Classes="muted"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- ═══ Step 2: pairing code ═══ -->
              <StackPanel x:Name="PairingStep" Spacing="20" IsVisible="{Binding IsCodeStep}">
                <StackPanel Spacing="8">
                  <TextBlock Text="One last step."
                             FontSize="{DynamicResource Font.SizeHeadline}"
                             FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="Enter the 6-digit code from Settings → Mobile on your PC to pair this phone."
                             Classes="supporting"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="setup-pairing-panel">
                  <StackPanel Spacing="12">
                    <Border HorizontalAlignment="Left"
                            Padding="10,5"
                            CornerRadius="{DynamicResource Radius.Full}"
                            Background="{DynamicResource Brush.AccentSubtle}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <sc:StrataPulse Width="9" Height="9" VerticalAlignment="Center" IsLive="True" />
                        <TextBlock Text="{Binding TargetHostName}"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource Font.SizeMeta}"
                                   Foreground="{DynamicResource Brush.AccentDefault}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>

                    <TextBox x:Name="PairingCodeBox"
                             Classes="mobile pairing-code"
                             AutomationProperties.Name="Six-digit pairing code"
                             PlaceholderText="000000"
                             Text="{Binding PairingCode}"
                             textInput:TextInputOptions.ContentType="Number"
                             textInput:TextInputOptions.ReturnKeyType="Done"
                             textInput:TextInputOptions.IsSensitive="True"
                             textInput:TextInputOptions.ShowSuggestions="False"
                             FontSize="{DynamicResource Font.SizeHeadline}"
                             LetterSpacing="6"
                             TextAlignment="Center"
                             MaxLength="6"
                             KeyDown="OnPairingCodeKeyDown" />
                    <Border x:Name="PairingError" Classes="mobile-card"
                            Padding="14"
                            BorderBrush="{DynamicResource Brush.BorderError}"
                            Background="{DynamicResource Brush.DangerSubtle}"
                            IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding ErrorText}" Classes="supporting"
                                 Foreground="{DynamicResource Brush.DangerDefault}" />
                    </Border>
                    <Button x:Name="PairButton"
                            Classes="touch accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{Binding PairActionText}"
                            Command="{Binding SubmitCodeCommand}"
                            IsEnabled="{Binding CanSubmitCode}" />
                  </StackPanel>
                </Border>

                <Button x:Name="PairBackButton"
                        Classes="touch subtle"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="Use a different PC"
                        IsVisible="{Binding CanChooseDifferentPc}"
                        Command="{Binding BackCommand}" />
              </StackPanel>

              <!-- ═══ Busy ═══ -->
              <StackPanel Spacing="10" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center">
                <sc:StrataTypingIndicator IsActive="True" HorizontalAlignment="Center" />
              </StackPanel>

              <TextBlock x:Name="ConnectStatus"
                         Text="{Binding StatusText}"
                         Classes="muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            </StackPanel>
          </ScrollViewer>
        </Border>
      </Border>
    </Border>
  </Grid>
</UserControl>
