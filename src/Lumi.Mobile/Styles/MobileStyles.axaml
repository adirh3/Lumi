<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:Lumi.Mobile.Behaviors"
        xmlns:views="using:Lumi.Mobile.Views"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:textInput="using:Avalonia.Input.TextInput"
        xmlns:sc="using:StrataTheme.Controls">

  <!--
    Touch ergonomics. Strata reveals several affordances on :pointerover, which a finger never
    produces, so on mobile those rails are always visible instead of hover-gated.
  -->
  <Style Selector="Button">
    <Setter Property="behaviors:TouchScrollClickGuard.IsEnabled" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="behaviors:NativeTextInputOverlay.IsEnabled" Value="True" />
  </Style>

  <Style Selector="sc|StrataChatMessage /template/ TextBox#PART_EditBox">
    <Setter Property="behaviors:NativeTextInputOverlay.ForwardEnterKey" Value="True" />
  </Style>

  <Style Selector="Button.touch">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="Button.nav-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.nav-item:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>

  <Style Selector="Button.nav-item.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>

  <Style Selector="Border.mobile-card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- Chat rows are the primary touch target of the whole app: big, obvious, and press-animated. -->
  <Style Selector="Button.chat-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.chat-row:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="RenderTransform" Value="scale(0.985)" />
  </Style>

  <Style Selector="Button.chat-row.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <Style Selector="Button.setup-host-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.setup-host-row:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="RenderTransform" Value="scale(0.99)" />
  </Style>

  <Style Selector="TextBox.mobile">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
  </Style>

  <Style Selector="TextBox.native-input-focused /template/ Border#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFocus}" />
    <Setter Property="BoxShadow" Value="0 0 0 2 #1A4F46E5" />
  </Style>

  <Style Selector="TextBox.native-input-focused /template/ Border#FocusAccentBar">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBox.native-input-overlay.native-input-focused /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="TextBox.native-input-overlay.native-input-focused /template/ TextBlock#PART_Watermark">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="TextBox.native-input-overlay.native-input-focused /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="TextBox.pairing-code">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="Border.setup-pairing-panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.setup-step">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,8" />
  </Style>

  <Style Selector="Border.setup-step TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="Border.setup-step.current TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.group-label">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="Margin" Value="0,14,0,4" />
  </Style>

  <Style Selector="TextBlock.group-label.drawer-group-label">
    <Setter Property="Margin" Value="{DynamicResource Mobile.Drawer.GroupLabelMargin}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
  </Style>

  <Style Selector="TextBlock.supporting">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>

  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ══ Icon-only buttons: square, centred, no text padding ══ -->
  <Style Selector="Button.touch.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    ══ Context window meter ══
    A capsule holding a slim bar and the percentage. The bar recolours as the window fills so the
    user notices pressure before a compaction surprises them mid-conversation.
  -->
  <Style Selector="Border.context-meter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.context-meter ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Border.context-meter TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector="Border.context-meter.warn ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
  </Style>

  <Style Selector="Border.context-meter.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
  </Style>

  <Style Selector="Border.context-meter.critical ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>

  <Style Selector="Border.context-meter.critical TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>

  <Style Selector="Border.context-meter.critical">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
  </Style>

  <!-- ══ Navigation drawer ══ -->

  <!--
    Search field on the full-screen page. ClipToBounds keeps the selection highlight inside the
    rounded capsule — without it the highlight paints square corners over the rounding, which is
    what made the old inline field look broken.
  -->
  <Style Selector="TextBox.search-field">
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeSubtitle}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.search-field /template/ Border#PART_Border">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>

  <!-- Result rows are generous: search is a reading task, and the row is the only target. -->
  <Style Selector="Button.search-result">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,11" />
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.search-result:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>

  <!-- Drawer rows are the full-width list items Material specifies: 48dp+ tall, pill-highlighted. -->
  <Style Selector="Button.drawer-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="{DynamicResource Mobile.Drawer.RowMargin}" />
    <Setter Property="Padding" Value="{DynamicResource Mobile.Drawer.RowPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.RowHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.drawer-row:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>

  <Style Selector="Button.drawer-row.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.NavigationSelected}" />
  </Style>

  <!-- History rows: dense enough to show many chats, but never below a comfortable thumb target. -->
  <Style Selector="Button.drawer-chat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Margin" Value="{DynamicResource Mobile.Drawer.RowMargin}" />
    <Setter Property="Padding" Value="{DynamicResource Mobile.Drawer.ChatRowPadding}" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.drawer-chat:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>

  <!-- One status position: pulsing while running, steady for an unread reply, hidden once read. -->
  <Style Selector="Button.drawer-chat.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.NavigationSelected}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.drawer-conversation">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="12,12" />
  </Style>
  <Style Selector="TextBlock.conversation-title">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.drawer-conversation.selected TextBlock.conversation-title,
                   Button.drawer-conversation.unread TextBlock.conversation-title,
                   Button.search-result.unread TextBlock.conversation-title">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.chat-list-status">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Margin" Value="0,0,7,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
    <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.3" />
    <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.2" />
    <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
  </Style>
  <Style Selector="PathIcon.chat-list-background">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,7,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="Data" Value="M4 4h16v12H4V4zm2 2v8h12V6H6zm2 12h8v2H8v-2z" />
  </Style>
  <Style Selector="Border.navigation-icon-tile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.navigation-icon-button, Button.chat-header-action">
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Button.navigation-icon-button:pressed, Button.chat-header-action:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.NavigationControl}" />
  </Style>
  <Style Selector="Button.chat-header-action.new-conversation">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>

  <!-- Experience chips: the library, one tap away, without spending a permanent tab on it. -->
  <Style Selector="Button.experience">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.experience:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <Style Selector="Button.chat-controls">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MaxWidth" Value="260" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Page headers on the pushed Library / Settings pages. -->
  <Style Selector="Button.page-back">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.page-back:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>

  <!--
    ══ Touch minimums for controls the app does not own ══

    Strata's ToggleSwitch is a 40x20 desktop track and the chat shell's scroll-to-bottom button is
    36dp; both are comfortably under a fingertip. Restyled here rather than in Strata because the
    desktop metrics are correct for a mouse — this is the mobile head asserting its own density.
  -->
  <!--
    The switch GRAPHIC stays 40x20 — its knob travel is computed in code against those numbers, and
    Material keeps the visual small anyway. What has to grow is the TARGET: the template's root grid
    is hit-testable, so a taller control gives a full-height target around an unchanged switch.
  -->
  <Style Selector="ToggleSwitch">
    <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Hidden keeps scrolling enabled without reserving or drawing a rail. -->
  <Style Selector="ScrollViewer.mobile-scroll">
    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
  </Style>
  <Style Selector="sc|StrataChatShell.mobile">
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
  </Style>

  <Style Selector="sc|StrataChatShell.mobile /template/ Button#PART_ScrollToBottomButton">
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_ComposerHost">
    <Setter Property="Padding" Value="{DynamicResource Mobile.Chat.ComposerHostPadding}" />
  </Style>

  <Style Selector="sc|StrataChatShell.mobile /template/ Border#PART_ScrollContent">
    <Setter Property="Padding" Value="{DynamicResource Mobile.Chat.TranscriptPadding}" />
  </Style>

  <!-- The native editor remains transparent above a glass surface and the presence light. -->

  <Style Selector="sc|StrataChatComposer.mobile">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerGlass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Composer}" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ Border#PART_Root:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorderStrong}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Composer}" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile:focus-within /template/ Border#PART_Root,
                   sc|StrataChatComposer.mobile /template/ Border#PART_Root:focus-within,
                   sc|StrataChatComposer.mobile:editing /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorderStrong}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Composer}" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ TextBox#PART_Input">
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MaxHeight" Value="176" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="behaviors:NativeTextInputOverlay.ForwardEnterKey" Value="True" />
    <Setter Property="textInput:TextInputOptions.ContentType" Value="Normal" />
    <Setter Property="textInput:TextInputOptions.ReturnKeyType" Value="Return" />
    <Setter Property="textInput:TextInputOptions.Multiline" Value="True" />
    <Setter Property="textInput:TextInputOptions.AutoCapitalization" Value="True" />
    <Setter Property="textInput:TextInputOptions.ShowSuggestions" Value="True" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile:external-editor /template/ Panel#PART_InputPanel">
    <Setter Property="MinHeight" Value="{Binding ((views:NativeComposerEditorHost)EditorContent).Height, RelativeSource={RelativeSource TemplatedParent}}" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile:external-editor /template/ TextBox#PART_Input">
    <Setter Property="behaviors:NativeTextInputOverlay.IsEnabled" Value="False" />
  </Style>

  <Style Selector="sc|StrataTypingIndicator.mobile-working /template/ TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ WrapPanel#PART_ChipsRow">
    <Setter Property="Margin" Value="12,7,12,0" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ Border#PART_ProjectChip,
                   sc|StrataChatComposer.mobile /template/ Border#PART_AgentChip,
                   sc|StrataChatComposer.mobile Border.composer-skill-chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="MaxWidth" Value="268" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ Border#PART_ProjectChipSurface,
                   sc|StrataChatComposer.mobile /template/ Border#PART_AgentChipSurface,
                   sc|StrataChatComposer.mobile Border.composer-chip-surface">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Height" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="-10,0,0,0" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ TextBlock#PART_ProjectName,
                   sc|StrataChatComposer.mobile /template/ TextBlock#PART_AgentName,
                   sc|StrataChatComposer.mobile /template/ TextBlock#PART_AgentGlyph,
                   sc|StrataChatComposer.mobile Border.composer-skill-chip TextBlock.chip-name,
                   sc|StrataChatComposer.mobile Border.composer-skill-chip TextBlock.chip-glyph">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ Button#PART_AgentRemoveButton,
                   sc|StrataChatComposer.mobile /template/ Button#PART_ProjectRemoveButton,
                   sc|StrataChatComposer.mobile Button.chip-remove">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="sc|StrataChatComposer.mobile /template/ TextBlock#PART_AgentRemoveGlyph,
                   sc|StrataChatComposer.mobile TextBlock.chip-remove-icon">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="sc|StrataChatComposer.mobile Border.composer-skill-chip TextBlock.chip-error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>

  <!-- The picker pill: a control ON the composer, so one step further up and fully rounded. -->
  <Style Selector="Button.composer-pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.composer-pill:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <Style Selector="Button.composer-toolbar-icon">
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.composer-toolbar-icon:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>

  <Style Selector="sc|StrataBottomSheet.safe-area /template/ Border#PART_SheetMotion">
    <Setter Property="MaxWidth" Value="640" />
  </Style>

  <Style Selector="sc|StrataBottomSheet.safe-area /template/ Border#PART_Sheet">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Level2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <Style Selector="sc|StrataBottomSheet.safe-area /template/ TextBlock#PART_Title">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeSubtitle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="sc|StrataBottomSheet.safe-area /template/ Border#PART_Scrim">
    <Setter Property="Background" Value="{DynamicResource Brush.OverlayScrim}" />
  </Style>

  <Style Selector="sc|StrataBottomSheet Button.sheet-item">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="sc|StrataBottomSheet Button.sheet-item.model-option">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,14" />
  </Style>

  <Style Selector="sc|StrataBottomSheet Button.sheet-item.model-option.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="sc|StrataSettingGroup.mobile /template/ Border#PART_Card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="sc|StrataSetting.mobile /template/ Border#PART_RowBorder">
    <Setter Property="Padding" Value="0,10" />
  </Style>

  <Style Selector="sc|StrataSetting.mobile /template/ Border#PART_Separator">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Height" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="sc|StrataSetting.mobile /template/ Border#PART_HighlightBar">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="sc|StrataSetting.mobile /template/ TextBlock#PART_Description">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="LineHeight" Value="21" />
  </Style>

  <!-- Suggestions and headings belong to the canvas rather than another stack of cards. -->
  <Style Selector="Button.starter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.starter /template/ Border#PART_Surface">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="Border#TopBarInset">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Attachment chips: a file staged for the next message, with its own removal target. -->
  <Style Selector="Border.attachment-chip">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceOverlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="12,0,4,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
  </Style>

  <Style Selector="Button.chip-remove">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Height" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="Button.chip-remove:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
  </Style>

  <!-- The effort slider is a primary control in its sheet, so it gets a finger-sized thumb. -->
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>

  <!-- Theme choice is a three-way, so it reads as segments rather than a switch. -->
  <Style Selector="Button.theme-option">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Button.theme-option.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.open-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>
  <Style Selector="Button.open-action:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <Style Selector="Button.floating-action">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{DynamicResource Brush.FloatingControl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="MinHeight" Value="{DynamicResource Touch.MinTarget}" />
    <Setter Property="MinWidth" Value="{DynamicResource Touch.MinTarget}" />
  </Style>
  <Style Selector="Button.floating-action /template/ Panel">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.floating-action /template/ Border#PART_FocusRing">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.floating-action /template/ Border#PART_Surface">
    <Setter Property="Margin" Value="2" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingControl}" />
  </Style>
  <Style Selector="Button.floating-action:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.FloatingControl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.FloatingControl}" />
  </Style>
  <Style Selector="Button.floating-action:pressed /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.FloatingControlPressed}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Level1}" />
  </Style>
  <Style Selector="Button.floating-action:pointerover /template/ Border#PART_Aurora">
    <Setter Property="Opacity" Value="0" />
  </Style>
</Styles>