<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    ══ Lumi mobile — LIGHT surfaces ══════════════════════════════════════════════════════════════

    The mirror of the dark set: a soft neutral canvas with white cards that lift by a hairline and a
    faint shadow. Colour belongs to the accent (selection, the primary action, live work) and to the
    small hue marks on icons — never to the surfaces themselves.
  -->

  <!-- Level 0 — the canvas. -->
  <Color x:Key="Color.Background">#F5F5F7</Color>
  <Color x:Key="Color.Surface0">#F5F5F7</Color>

  <!-- Level 1 — cards. -->
  <Color x:Key="Color.Surface1">#FFFFFF</Color>

  <!-- Level 2 — grouped rows, raised controls, chips. -->
  <Color x:Key="Color.Surface2">#FFFFFF</Color>

  <!-- Level 3 — sheets and popups. -->
  <Color x:Key="Color.SurfaceOverlay">#FFFFFF</Color>

  <Color x:Key="Color.ControlDefault">#FFFFFF</Color>
  <Color x:Key="Color.ControlHover">#F0F0F3</Color>
  <Color x:Key="Color.ControlPressed">#E6E6EB</Color>
  <Color x:Key="Color.ControlDisabled">#F0F0F3</Color>

  <Color x:Key="Color.BorderSubtle">#E7E7EC</Color>
  <Color x:Key="Color.BorderDefault">#DCDCE2</Color>
  <Color x:Key="Color.BorderStrong">#BEBEC8</Color>

  <!-- Not pure black: full-contrast body text on white is harsh at phone reading distance. -->
  <Color x:Key="Color.TextPrimary">#18181C</Color>
  <Color x:Key="Color.TextSecondary">#55555F</Color>
  <Color x:Key="Color.TextTertiary">#6B6B75</Color>

  <Color x:Key="Color.SubtleHover">#0A18181C</Color>
  <Color x:Key="Color.SubtlePressed">#1418181C</Color>

  <Color x:Key="Color.OverlayScrim">#59000000</Color>

  <Color x:Key="Color.AccentSubtle">#124F46E5</Color>
  <Color x:Key="Color.AccentSubtleHover">#1F4F46E5</Color>

  <!-- Softer and wider than the dark set: on white, a shadow IS the elevation cue. -->
  <BoxShadows x:Key="Shadow.Level1">0 1 3 0 #14000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Level2">0 2 12 0 #1F000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Level3">0 -2 28 0 #24000000</BoxShadows>

  <!--
    ══ Brushes, not just colours ═══════════════════════════════════════════════════════════════

    Strata's brushes are declared once as `<SolidColorBrush Color="{DynamicResource Color.X}" />`.
    Overriding only `Color.X` here left the switch HALF applied: cards picked up the new palette
    while the page background and the group headers stayed on the old one, because the brush object
    resolves its inner DynamicResource against the dictionary that declared it — not against this
    one — and whether that lands before or after the variant swap is not something to rely on.

    Declaring the brushes outright removes the indirection: `Brush.X` maps straight to a value in
    the active variant, so every surface flips together.
  -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface0" Color="{StaticResource Color.Surface0}" />
  <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}" />
  <SolidColorBrush x:Key="Brush.Surface1Translucent" Color="{StaticResource Color.Surface1}" Opacity="0.78" />
  <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{StaticResource Color.Surface1}" Opacity="0.52" />
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
  <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.SurfaceOverlay}" />
  <SolidColorBrush x:Key="Brush.SurfaceCard" Color="{StaticResource Color.Surface1}" />
  <SolidColorBrush x:Key="Brush.SurfaceOverlay" Color="{StaticResource Color.SurfaceOverlay}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.BorderDefault" Color="{StaticResource Color.BorderDefault}" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.ControlDefault" Color="{StaticResource Color.ControlDefault}" />
  <SolidColorBrush x:Key="Brush.ControlHover" Color="{StaticResource Color.ControlHover}" />
  <SolidColorBrush x:Key="Brush.ControlPressed" Color="{StaticResource Color.ControlPressed}" />
  <SolidColorBrush x:Key="Brush.ControlDisabled" Color="{StaticResource Color.ControlDisabled}" />
  <SolidColorBrush x:Key="Brush.SubtleHover" Color="{StaticResource Color.SubtleHover}" />
  <SolidColorBrush x:Key="Brush.SubtlePressed" Color="{StaticResource Color.SubtlePressed}" />
  <SolidColorBrush x:Key="Brush.OverlayScrim" Color="{StaticResource Color.OverlayScrim}" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
  <SolidColorBrush x:Key="Brush.AccentSubtleHover" Color="{StaticResource Color.AccentSubtleHover}" />

  <SolidColorBrush x:Key="Brush.NavigationSurface" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.NavigationControl" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.NavigationSelected" Color="#124F46E5" />
  <SolidColorBrush x:Key="Brush.ChatRowSelected" Color="#1218181C" />
  <SolidColorBrush x:Key="Brush.ChatCanvas" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.ChatPaneSeparation" Color="#1418181C" />
  <BoxShadows x:Key="Shadow.ChatPaneSeparation">0 0 0 0 #00000000</BoxShadows>
  <SolidColorBrush x:Key="Brush.ChatUserSurface" Color="#E6E1FF" />

  <SolidColorBrush x:Key="Brush.GroupSurface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.GroupBorder" Color="#1418181C" />
  <BoxShadows x:Key="Shadow.Group">0 1 2 0 #0D1E1E3C</BoxShadows>
  <SolidColorBrush x:Key="Brush.RowDivider" Color="#1218181C" />
  <SolidColorBrush x:Key="Brush.RowTile" Color="#0D18181C" />
  <SolidColorBrush x:Key="Brush.QuietField" Color="#0818181C" />
  <SolidColorBrush x:Key="Brush.QuietFieldBorder" Color="#1218181C" />
  <SolidColorBrush x:Key="Brush.ListSearchField" Color="#0D18181C" />
  <SolidColorBrush x:Key="Brush.AccentSelection" Color="#1F4F46E5" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#4F46E5" />
  <SolidColorBrush x:Key="Brush.AccentSolid" Color="#4F46E5" />

  <SolidColorBrush x:Key="Brush.Hue.Agent" Color="#5E50B5" />
  <SolidColorBrush x:Key="Brush.Hue.Skill" Color="#94701F" />
  <SolidColorBrush x:Key="Brush.Hue.Connector" Color="#2F7D70" />
  <SolidColorBrush x:Key="Brush.Hue.Project" Color="#3D6F99" />
  <SolidColorBrush x:Key="Brush.Hue.Memory" Color="#98506F" />
  <SolidColorBrush x:Key="Brush.Hue.Job" Color="#6B6455" />
  <SolidColorBrush x:Key="Brush.Hue.Appearance" Color="#7B4A9C" />
  <SolidColorBrush x:Key="Brush.Hue.About" Color="#8F6A22" />
  <SolidColorBrush x:Key="Brush.Status.Ok" Color="#0F9F6E" />

  <!--
    Floating glass: ONE material for everything that floats over moving content (see the dark set). It
    is the composer's: white at about two-thirds over the frost, a shade denser at the top. On a light
    canvas the rim does the opposite of the dark one, a hairline that deepens toward the bottom where
    the surface turns from the light, under a white highlight inside the top edge.

    Elevation is the same quiet stack as the dark set, in the desktop's cool ink: a tight contact
    shadow, a soft pool just below, and the highlight. A press lowers the surface and greys its tint.
  -->
  <LinearGradientBrush x:Key="Brush.FloatingGlass" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#A6FFFFFF" />
    <GradientStop Offset="1" Color="#99FFFFFF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.FloatingGlassPressed" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#D9F3F3F6" />
    <GradientStop Offset="1" Color="#D1EEEEF2" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.FloatingGlassRim" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#0F18181C" />
    <GradientStop Offset="1" Color="#2418181C" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.FloatingGlassRimStrong" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#1F18181C" />
    <GradientStop Offset="1" Color="#3818181C" />
  </LinearGradientBrush>
  <BoxShadows x:Key="Shadow.FloatingGlass">0 1 2 0 #0F101828, 0 8 20 -8 #2E101828, inset 0 1 0 0 #FFFFFFFF</BoxShadows>
  <BoxShadows x:Key="Shadow.FloatingGlassPressed">0 1 1 0 #0F101828, 0 3 8 -4 #24101828, inset 0 1 0 0 #B3FFFFFF</BoxShadows>
  <!-- Stop, while Lumi works: the composer's quiet disc a shade deeper, its square in this theme's ink. -->
  <SolidColorBrush x:Key="Brush.ComposerOrbStop" Color="#1A18181C" />

  <!-- Popup glass, as the desktop's menus: white at about two-thirds over a deep frost of the page, so
       the page stays present behind the sheet. -->
  <LinearGradientBrush x:Key="Brush.SheetSurface" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#B3FFFFFF" />
    <GradientStop Offset="1" Color="#BFFAFAFB" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.SheetBorder" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#FFFFFFFF" />
    <GradientStop Offset="1" Color="#1418181C" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.SheetScrim" Color="#1A18181C" />
  <SolidColorBrush x:Key="Brush.SheetControl" Color="#0A18181C" />
  <SolidColorBrush x:Key="Brush.SheetRowHover" Color="#0818181C" />
  <SolidColorBrush x:Key="Brush.SheetRowPressed" Color="#1218181C" />
  <SolidColorBrush x:Key="Brush.SheetRowSelected" Color="#1018181C" />
  <SolidColorBrush x:Key="Brush.SheetGrip" Color="#3318181C" />
  <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#FFFFFF" />
  <BoxShadows x:Key="Shadow.Segment">0 1 3 0 #241E1E3C</BoxShadows>
  <BoxShadows x:Key="Shadow.Sheet">0 18 40 -22 #4D1E1E3C, 0 1 3 0 #0F18181C</BoxShadows>

  <LinearGradientBrush x:Key="Brush.ChromeEdgeBottom" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#00F5F5F7" />
    <GradientStop Offset="0.5" Color="#33F5F5F7" />
    <GradientStop Offset="1" Color="#BFF5F5F7" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.NavigationEdgeTop" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#BFF5F5F7" />
    <GradientStop Offset="0.5" Color="#7AF5F5F7" />
    <GradientStop Offset="1" Color="#00F5F5F7" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.PageEdgeTop" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#BFF5F5F7" />
    <GradientStop Offset="0.5" Color="#7AF5F5F7" />
    <GradientStop Offset="1" Color="#00F5F5F7" />
  </LinearGradientBrush>
</ResourceDictionary>