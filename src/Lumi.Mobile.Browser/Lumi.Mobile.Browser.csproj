<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Lumi.Mobile.Browser</RootNamespace>
    <AssemblyName>Lumi.Mobile.Browser</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
    <WasmEnableThreads>false</WasmEnableThreads>
    <WasmBuildNative>true</WasmBuildNative>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <EnableDefaultCompressionFormats Condition="'$(Configuration)' == 'Release'">false</EnableDefaultCompressionFormats>
    <PublishCompressionFormats Condition="'$(Configuration)' == 'Release'">brotli</PublishCompressionFormats>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumi.Mobile\Lumi.Mobile.csproj" />
    <Content Include="..\..\LICENSE" Link="wwwroot\LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="..\Lumi.Mobile\Localization\ChatSessionStrings.resx"
             Link="wwwroot\localization\en.xml" TargetPath="wwwroot\localization\en.xml"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Lumi.Mobile\Localization\ChatSessionStrings.he.resx"
             Link="wwwroot\localization\he.xml" TargetPath="wwwroot\localization\he.xml"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateHebrewPwaManifest" BeforeTargets="GeneratePwaAssetManifest">
    <XmlPeek XmlInputPath="..\Lumi.Mobile\Localization\ChatSessionStrings.resx"
             Query="/root/data[@name='WebManifestDescription']/value/text()">
      <Output TaskParameter="Result" PropertyName="_PwaManifestDescriptionEn" />
    </XmlPeek>
    <XmlPeek XmlInputPath="..\Lumi.Mobile\Localization\ChatSessionStrings.he.resx"
             Query="/root/data[@name='WebManifestDescription']/value/text()">
      <Output TaskParameter="Result" PropertyName="_PwaManifestDescriptionHe" />
    </XmlPeek>
    <PropertyGroup>
      <_HebrewPwaManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/wwwroot/manifest.webmanifest').Replace('$(_PwaManifestDescriptionEn)', '$(_PwaManifestDescriptionHe)'))</_HebrewPwaManifest>
      <_HebrewPwaManifest>$(_HebrewPwaManifest.Replace('&quot;description&quot;', '&quot;lang&quot;: &quot;he&quot;, &quot;dir&quot;: &quot;rtl&quot;, &quot;description&quot;'))</_HebrewPwaManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(PublishDir)wwwroot\manifest.he.webmanifest"
                      Lines="$(_HebrewPwaManifest)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <Target Name="GeneratePwaAssetManifest" AfterTargets="Publish">
    <PropertyGroup>
      <_PwaWebRoot>$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot'))</_PwaWebRoot>
      <_PwaAssetManifest>$(_PwaWebRoot)\service-worker-assets.js</_PwaAssetManifest>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PwaWebRoot)\index.html')"
           Text="The PWA publish is missing its app shell." />
    <ItemGroup>
      <_PwaAsset Include="$(_PwaWebRoot)\**\*"
                 Exclude="$(_PwaWebRoot)\**\*.br;$(_PwaWebRoot)\**\*.gz;$(_PwaWebRoot)\**\*.map;$(_PwaAssetManifest);$(_PwaWebRoot)\cache-recovery.html;$(_PwaWebRoot)\cache-recovery.js" />
    </ItemGroup>
    <GetFileHash Files="@(_PwaAsset)" Algorithm="SHA256" HashEncoding="base64">
      <Output TaskParameter="Items" ItemName="_HashedPwaAsset" />
    </GetFileHash>
    <ItemGroup>
      <_PwaAssetEntry Include="@(_HashedPwaAsset)">
        <Url>$([MSBuild]::MakeRelative('$(_PwaWebRoot)', '%(FullPath)').Replace('\', '/'))</Url>
      </_PwaAssetEntry>
    </ItemGroup>
    <PropertyGroup>
      <_PwaManifestContent>self.lumiAssets = [@(_PwaAssetEntry->'{ &quot;url&quot;: &quot;%(Url)&quot;, &quot;hash&quot;: &quot;sha256-%(FileHash)&quot; }', ',')]%3B</_PwaManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_PwaAssetManifest)"
                      Lines="$(_PwaManifestContent)"
                      Overwrite="true" Encoding="UTF-8" />
    <GetFileHash Files="$(_PwaAssetManifest)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_PwaAssetVersion" />
    </GetFileHash>
    <WriteLinesToFile File="$(_PwaAssetManifest)"
                      Lines="self.lumiAssetVersion = &quot;$(_PwaAssetVersion)&quot;%3B"
                      Overwrite="false" Encoding="UTF-8" />
  </Target>

  <!-- Mobile browsers support Brotli; gzip duplicates and source maps only inflate desktop installers. -->
  <Target Name="RemoveRedundantReleaseAssets"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <RedundantReleaseAsset Include="$(PublishDir)wwwroot\**\*.gz" />
      <RedundantReleaseAsset Include="$(PublishDir)wwwroot\**\*.map" />
      <RedundantReleaseAsset Include="$(PublishDir)wwwroot\**\*.map.br" />
    </ItemGroup>
    <Delete Files="@(RedundantReleaseAsset)" />
  </Target>

</Project>
