<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\lumi-icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>

    <!-- Publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>

    <!-- .NET 11 Runtime Async -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Features>$(Features);runtime-async=on</Features>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lumi.Tests" />
  </ItemGroup>

  <!-- Windows: target Windows TFM so WinRT toast types are available in-process -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\lumi-icon.png" />
    <EmbeddedResource Include="Assets\EmbeddedApps\*.js" />
    <Content Include="Assets\EmbeddedApps\LICENSES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Resources\Strings\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.27-preview.3" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <!-- Override the transitive SQLitePCLRaw.bundle_e_sqlite3 2.1.10 (vulnerable SQLite < 3.50.2, CVE-2025-6965 / GHSA-2m69-gcr7-jv3q).
         3.0.x ships the patched native binary via SourceGear.sqlite3. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <!-- GPU speech recognition on Windows and Linux x64 through Vulkan; Apple silicon already gets Metal from
         Whisper.net.Runtime. Whisper.net falls back to the CPU runtime when no Vulkan driver is present. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="AvaloniaMcp.Diagnostics" Version="0.4.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- Windows-only packages: native UI automation (FlaUI), the embedded WebView2 browser,
       and WinRT toast notifications. These either force the Windows target platform or only
       ship Windows assets, so they are excluded on Linux/macOS. The matching source code is
       gated behind `#if WINDOWS` (defined automatically by the net*-windows TFM).
       Keyed off the TARGET platform of the TFM (not the host $(OS)) so it stays correct even
       if the Windows TFM is ever built from a non-Windows host. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <!-- Keep the native backend out of the Windows dependency graph and implementation. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'windows'">
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumi.Generators\Lumi.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Lumi.Remote.Protocol\Lumi.Remote.Protocol.csproj" />
    <ProjectReference Include="..\..\Strata\src\StrataSearch\StrataSearch.csproj" />
    <ProjectReference Include="..\..\Strata\src\StrataTheme\StrataTheme.csproj" />
  </ItemGroup>

  <!-- Exclude test harness from Release builds -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="OnboardingAgentTest.cs" />
    <Compile Remove="DebugAgentHarness.cs" />
    <Compile Remove="Services\LumiDebugBridge.cs" />
    <Compile Remove="ViewModels\ChatViewModel.Debug.cs" />
    <Compile Remove="UiPerf\UiResponsivenessProbe.cs" />
    <Compile Remove="UiPerf\UiWorkloadScenarios.cs" />
    <Compile Remove="UiPerf\UiResponsivenessHarness.cs" />
    <Compile Remove="UiPerf\UiStreamingLoad.cs" />
    <Compile Remove="MemoryDiagnostics\MemoryStressHarness.cs" />
    <Compile Remove="MemoryDiagnostics\HistoryScaleHarness.cs" />
    <Compile Remove="Services\AppIconAssets.cs" />
    <!-- UiHarnessOptions/UiResponsivenessMetrics/UiResponsivenessReport are intentionally NOT removed:
         they are pure-logic, side-effect-free types that the Lumi.Tests project references, and
         pr-validation.yml builds AND runs the whole solution in Release config. Removing them would
         break the Release test compile. They are unreachable from production code (every caller in
         Program.cs/App is #if DEBUG), so they are inert dead code in the shipped app. -->
  </ItemGroup>

  <Import Project="..\..\build\Copilot\CopilotCli.targets" />

  <!-- Whisper.net's Vulkan runtime adds both its Windows and its Linux GPU library (each about 57 MB) to every build.
       Keep only the one this build can load: win-x64 for Windows, linux-x64 for Linux, none for macOS. -->
  <PropertyGroup>
    <_LumiVulkanRid Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">win-x64</_LumiVulkanRid>
    <_LumiVulkanRid Condition="'$(_LumiVulkanRid)' == '' and ($(RuntimeIdentifier.StartsWith('linux-x64')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'))">linux-x64</_LumiVulkanRid>
  </PropertyGroup>
  <Target Name="LumiKeepOwnVulkanRuntime" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_LumiVulkanRuntime Include="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').Replace('\', '/').StartsWith('runtimes/vulkan/'))" />
      <_LumiForeignVulkanRuntime Include="@(_LumiVulkanRuntime)" Condition="'$(_LumiVulkanRid)' == '' or !$([System.String]::Copy('%(_LumiVulkanRuntime.TargetPath)').Replace('\', '/').StartsWith('runtimes/vulkan/$(_LumiVulkanRid)/'))" />
      <None Remove="@(_LumiForeignVulkanRuntime)" />
    </ItemGroup>
  </Target>

</Project>
