<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.Views.FilePreviewView"
             x:DataType="vm:ChatViewModel"
             x:CompileBindings="True">
  <!-- The Workspace header names the file and carries refresh / open / back / close. -->
  <Grid RowDefinitions="Auto,*">
    <Border x:Name="PreviewTruncationNotice" Grid.Row="0" IsVisible="False" Padding="16,8"
            Background="{DynamicResource Brush.AccentSubtle}">
      <TextBlock Text="{loc:Str Preview_Truncated}" FontSize="11" TextWrapping="Wrap" />
    </Border>
    <ContentControl x:Name="FilePreviewContentHost" Grid.Row="1"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
