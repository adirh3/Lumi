<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:views="using:Lumi.Views"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.Views.ChatWorkspaceView"
             x:DataType="vm:ChatViewModel"
             x:CompileBindings="True"
             IsPresenceEnabled="{Binding ShowAmbientPresence}">

  <UserControl.Resources>
    <x:Double x:Key="ChatWorkspace.SplitPaneMinWidth">220</x:Double>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border#ChatIsland.workspace-island">
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Overlay}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface1Glass}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 18 44 0 #14000000, 0 3 12 0 #0A000000" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border#ChatIsland.workspace-flat">
      <Setter Property="CornerRadius" Value="0" />
      <!-- Same translucent glass surface as the docked island (just without the island chrome:
           no radius/border/shadow). The ambient presence field is injected at the bottom of the
           workspace grid, so this surface sits OVER it and muffles the glow exactly like the docked
           chat island does — without it (a bare Transparent flat island) the detached ChatWindow let
           the field bloom at full strength, reading far brighter than the main window. Matching the
           Surface1Glass token keeps the muffling (and the App.axaml opacity override) in lock-step. -->
      <Setter Property="Background" Value="{DynamicResource Brush.Surface1Glass}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <!-- Workspace header buttons: quiet icons that light up on hover -->
    <Style Selector="Button.ws-header-button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Base}" />
    </Style>
    <Style Selector="Button.ws-header-button PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.ws-header-button:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- The gutter between chat and workspace is the resize handle: invisible at rest, a soft
         accent hairline while hovered or dragged. -->
    <Style Selector="GridSplitter#WorkspaceSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Name="PART_Grip" Width="2" Height="44" CornerRadius="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.AccentDefault}" Opacity="0">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
              </Border.Transitions>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter#WorkspaceSplitter:pointerover /template/ Border#PART_Grip">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="WorkspaceGrid" ColumnDefinitions="1*,0,0">
    <Border x:Name="ChatIsland"
            Grid.Column="0"
            Classes="workspace-island"
            MinWidth="{StaticResource ChatWorkspace.SplitPaneMinWidth}"
            MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Grid}}"
            FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType=Window}}">
      <Border.BorderBrush>
        <SolidColorBrush Color="{DynamicResource Color.TextPrimary}" Opacity="0.08" />
      </Border.BorderBrush>
      <Grid>
        <Border x:Name="ChatIslandHighlight"
                IsHitTestVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                BorderThickness="0,1,0,0"
                Opacity="0.75">
          <Border.BorderBrush>
            <SolidColorBrush Color="White" Opacity="0.12" />
          </Border.BorderBrush>
        </Border>
        <views:ChatView x:Name="PageChat"
                        ShowInternalTitle="{Binding ShowInternalTitle, RelativeSource={RelativeSource AncestorType=views:ChatWorkspaceView}}"
                        UseShellChrome="{Binding UseChatIslandChrome, RelativeSource={RelativeSource AncestorType=views:ChatWorkspaceView}}"
                        DataContext="{Binding}" />
      </Grid>
    </Border>

    <GridSplitter x:Name="WorkspaceSplitter"
                  Grid.Column="1"
                  IsVisible="False"
                  Width="8"
                  ResizeDirection="Columns" />

    <!-- ===== Workspace =====
         The one panel beside the chat: an at-a-glance overview of everything Lumi did, and every
         focused page (plan, agents, git changes, diffs, skills, file previews, the browser) with a
         shared header and back history. Pages, sizing and motion are driven by WorkspacePanelController. -->
    <Border x:Name="WorkspacePanel"
            Grid.Column="2"
            IsVisible="False"
            Margin="{Binding WorkspacePanelMargin, RelativeSource={RelativeSource AncestorType=views:ChatWorkspaceView}}"
            CornerRadius="{DynamicResource Radius.Overlay}"
            Background="{DynamicResource Brush.Surface1Glass}"
            BorderThickness="1"
            BoxShadow="0 18 44 0 #14000000, 0 3 12 0 #0A000000"
            ClipToBounds="True">
      <Border.BorderBrush>
        <SolidColorBrush Color="{DynamicResource Color.TextPrimary}" Opacity="0.08" />
      </Border.BorderBrush>
      <DockPanel>
        <!-- Header: back · page · actions · close. Bound to this view's own WorkspaceHeader (set from
             code), so two windows showing the same chat keep their own page headers. -->
        <StackPanel x:Name="WorkspaceHeaderBar" DockPanel.Dock="Top"
                    x:DataType="vm:WorkspaceHeader" DataContext="{x:Null}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                MinHeight="36" Margin="10,10,8,9">
            <Button x:Name="WorkspaceBackButton" Grid.Column="0"
                    Classes="subtle ws-header-button" Margin="0,0,4,0"
                    IsVisible="{Binding !IsOverview}"
                    Click="OnWorkspaceBackClick"
                    ToolTip.Tip="{loc:Str Workspace_Back}"
                    AutomationProperties.Name="{loc:Str Workspace_Back}">
              <PathIcon Width="16" Height="16" Data="{x:Static vm:WorkspaceIcons.Back}" />
            </Button>
            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="8" VerticalAlignment="Center"
                    Background="{DynamicResource Brush.AccentSubtle}">
              <PathIcon Width="16" Height="16" Foreground="{DynamicResource Brush.AccentDefault}"
                        Data="{Binding Icon}" />
            </Border>
            <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="WorkspaceTitleText"
                         Text="{Binding Title}"
                         ToolTip.Tip="{Binding Title}"
                         FontSize="13" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
              <TextBlock x:Name="WorkspaceSubtitleText"
                         Text="{Binding Subtitle}"
                         IsVisible="{Binding HasSubtitle}"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Brush.TextTertiary}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                        IsVisible="{Binding IsFilePreview}">
              <Button x:Name="WorkspaceRefreshPreviewButton" Classes="subtle ws-header-button"
                      Click="OnRefreshFilePreviewClick"
                      ToolTip.Tip="{loc:Str Preview_Refresh}"
                      AutomationProperties.Name="{loc:Str Preview_Refresh}">
                <PathIcon Width="16" Height="16" Data="{x:Static vm:WorkspaceIcons.Refresh}" />
              </Button>
              <Button x:Name="WorkspaceOpenPreviewButton" Classes="subtle ws-header-button"
                      Click="OnOpenFilePreviewClick"
                      ToolTip.Tip="{loc:Str FileMenu_Open}"
                      AutomationProperties.Name="{loc:Str FileMenu_Open}">
                <PathIcon Width="16" Height="16" Data="{x:Static vm:WorkspaceIcons.OpenExternal}" />
              </Button>
            </StackPanel>
            <Button x:Name="WorkspaceCloseButton" Grid.Column="4"
                    Classes="subtle ws-header-button" Margin="2,0,0,0"
                    Click="OnWorkspaceCloseClick"
                    ToolTip.Tip="{loc:Str Workspace_Close}"
                    AutomationProperties.Name="{loc:Str Workspace_Close}">
              <PathIcon Width="16" Height="16" Data="{x:Static vm:WorkspaceIcons.Dismiss}" />
            </Button>
          </Grid>

          <!-- Pages get a hairline under the header; the overview flows straight into its search. -->
          <Border Height="1" Opacity="0.7"
                  Background="{DynamicResource Brush.BorderSubtle}"
                  IsVisible="{Binding !IsOverview}" />
        </StackPanel>

        <Panel x:Name="WorkspaceBody">
          <views:WorkspaceOverview x:Name="WorkspaceOverview" />
          <ContentControl x:Name="WorkspacePageHost"
                          IsVisible="False"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch" />
        </Panel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
