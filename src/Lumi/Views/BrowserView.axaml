<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:loc="using:Lumi.Localization"
             xmlns:sa="using:StrataTheme.Animation"
             x:Class="Lumi.Views.BrowserView">

  <UserControl.Resources>
    <!-- A tab's click target: chromeless, because the tab itself (Border.browser-tab) draws the
         surface so hovering its close button never drops the tab's highlight. -->
    <ControlTheme x:Key="BrowserTabHitTheme" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <!-- The page below is a native view that covers in-window popups, so tips open upward. -->
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_FocusRing" Margin="1" CornerRadius="9"
                    BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent"
                    IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- ── Tabs: calm until hovered; the open tab is the accent-tinted glass the nav bar uses
         for the place you're on. ── -->
    <Style Selector="Border.browser-tab">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="MaxWidth" Value="200" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <sa:PremultipliedBrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.browser-tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <Style Selector="Border.browser-tab.active">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGlowStrong}" />
    </Style>

    <Style Selector="TextBlock.browser-tab-title">
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.browser-tab:pointerover TextBlock.browser-tab-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Border.browser-tab.active TextBlock.browser-tab-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The site's mark: the same initial and colour its source chips use. -->
    <Style Selector="Border.browser-tab-badge">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.browser-tab-badge > TextBlock">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.browser-tab-glyph">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Border.browser-tab.active PathIcon.browser-tab-glyph">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>

    <!-- Close shows on the open tab and on the tab under the pointer, so the strip stays quiet. -->
    <Style Selector="Button.browser-tab-close">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.browser-tab:pointerover Button.browser-tab-close, Border.browser-tab.active Button.browser-tab-close, Border.browser-tab:focus-within Button.browser-tab-close">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <!-- Titles only give way to the close button where it shows, so narrow tabs keep their words. -->
    <Style Selector="Border.browser-tab:pointerover Button.browser-tab-hit, Border.browser-tab.active Button.browser-tab-hit, Border.browser-tab:focus-within Button.browser-tab-hit">
      <Setter Property="Padding" Value="8,0,28,0" />
    </Style>
    <!-- Too narrow for words: a tab is just its badge, and the open tab keeps its close button. -->
    <Style Selector="Border.browser-tab.compact TextBlock.browser-tab-title">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.browser-tab.compact:not(.active) Button.browser-tab-hit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.browser-tab.compact:not(.active) Button.browser-tab-close">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.browser-tab-close PathIcon">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button.browser-tab-close:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- ── New tab, back and refresh: quiet icons that light up on hover. ── -->
    <Style Selector="Button.browser-chrome-button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-6" />
    </Style>
    <Style Selector="Button.browser-chrome-button PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.browser-chrome-button:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Border#UrlBar:not(.motion-disabled) Button#NewBrowserTab:pointerover PathIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="BrowserPanel">
    <!-- Loading overlay shown before WebView2 initializes -->
    <Border x:Name="LoadingOverlay" IsVisible="True"
            Background="{DynamicResource Brush.SurfaceCard}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="120" />
        <TextBlock Text="{loc:Str Browser_Initializing}" Classes="caption"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Cookie import onboarding overlay -->
    <Border x:Name="CookieOnboardingOverlay" IsVisible="False"
            Background="{DynamicResource Brush.SurfaceCard}"
            ZIndex="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Margin="0,76,0,0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="420" Spacing="16" Margin="32">

          <!-- Icon -->
          <Border Width="56" Height="56" CornerRadius="28"
                  Background="{DynamicResource Brush.AccentSubtle}"
                  HorizontalAlignment="Center">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource Brush.AccentDefault}">
              <PathIcon.Data>
                <StreamGeometry>M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z</StreamGeometry>
              </PathIcon.Data>
            </PathIcon>
          </Border>

          <!-- Title + description -->
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Str Browser_ImportTitle}" Classes="subtitle"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="caption"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{loc:Str Browser_ImportDescription}" />
          </StackPanel>

          <!-- Browser/profile picker -->
          <StackPanel x:Name="ProfilePicker" Spacing="4" />

          <!-- Warning box -->
          <Border Background="{DynamicResource Brush.SurfaceSubtle}"
                  CornerRadius="{DynamicResource Radius.Base}"
                  Padding="12" BorderThickness="1"
                  BorderBrush="{DynamicResource Brush.BorderSubtle}">
            <StackPanel Spacing="6">
              <TextBlock Classes="caption" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         Text="{loc:Str Browser_ImportWhatHappens}" />
              <StackPanel Spacing="4">
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="{OnPlatform Windows={loc:Str Browser_ImportBrowserClosedHint}, Default={loc:Str Browser_ImportCloseBrowserHint}}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="{OnPlatform Windows={loc:Str Browser_ImportAuthorizeHint}, Default={loc:Str Browser_ImportCredentialHint}}" />
                <TextBlock x:Name="CookieCopiedHint" Classes="caption" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="{loc:Str Browser_ImportCopiedHint}" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="{loc:Str Browser_ImportOriginalDataHint}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Progress status (hidden until import starts) -->
          <StackPanel x:Name="ImportProgressPanel" IsVisible="False" Spacing="8">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock x:Name="ImportStatusText" Classes="caption"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" Text="{loc:Str Browser_ImportPreparing}" />
          </StackPanel>

          <!-- Actions -->
          <StackPanel x:Name="OnboardingActions" Spacing="8">
            <Button x:Name="ImportButton" Classes="accent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnImportOnboardingClick"
                    Content="{loc:Str Browser_ImportCookies}" />
            <Button x:Name="SkipButton" Classes="subtle"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnSkipOnboardingClick"
                    Content="{loc:Str Browser_ImportSkip}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Browser chrome (ZIndex above onboarding overlay): the tab strip, then back · refresh ·
         location. It sits on the Workspace's own surface; the native page starts at its bottom edge. -->
    <Border x:Name="UrlBar" VerticalAlignment="Top"
            Background="Transparent"
            Padding="10,6,10,6"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            ZIndex="20">
      <StackPanel Spacing="4">
        <!-- Tabs share the row like a desktop browser's; past their minimum width the strip scrolls. -->
        <Grid x:Name="TabStripRow" ColumnDefinitions="Auto,Auto,*" Height="30">
          <ScrollViewer x:Name="BrowserTabsScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BrowserTabs" Orientation="Horizontal" Spacing="4" />
          </ScrollViewer>
          <Button x:Name="NewBrowserTab" Grid.Column="1"
                  Classes="subtle browser-chrome-button" Margin="4,0,0,0"
                  ToolTip.Tip="{loc:Str Browser_NewTab}"
                  AutomationProperties.Name="{loc:Str Browser_NewTab}"
                  Click="OnNewTabClick">
            <PathIcon Data="{x:Static vm:WorkspaceIcons.Add}" />
          </Button>
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,*" Height="28">
          <Button x:Name="BackButton"
                  Classes="subtle browser-chrome-button"
                  ToolTip.Tip="{loc:Str Browser_Back}"
                  AutomationProperties.Name="{loc:Str Browser_Back}"
                  Click="OnBackClick">
            <PathIcon Data="{x:Static vm:WorkspaceIcons.ChevronBack}" />
          </Button>
          <Button x:Name="RefreshButton" Grid.Column="1"
                  Classes="subtle browser-chrome-button" Margin="2,0,0,0"
                  ToolTip.Tip="{loc:Str Browser_Refresh}"
                  AutomationProperties.Name="{loc:Str Browser_Refresh}"
                  Click="OnRefreshClick">
            <PathIcon Data="{x:Static vm:WorkspaceIcons.Refresh}" />
          </Button>
          <!-- Where the page is: the site in full colour, the rest of the address quieter. -->
          <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="8,0,4,0" VerticalAlignment="Center">
            <PathIcon x:Name="UrlIcon" Width="14" Height="14" VerticalAlignment="Center"
                      Foreground="{DynamicResource Brush.TextTertiary}"
                      Data="{x:Static vm:WorkspaceIcons.Browser}" />
            <TextBlock x:Name="UrlText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip.Placement="Top" ToolTip.VerticalOffset="-6"><Run Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Medium" /><Run Text="about:blank" /></TextBlock>
          </Grid>
        </Grid>
        <TextBlock x:Name="BrowserErrorText" IsVisible="False" TextWrapping="Wrap" Margin="4,0"
                   Classes="caption" Foreground="{DynamicResource Brush.TextSecondary}" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
