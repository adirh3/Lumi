<Window xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumi.ViewModels"
        xmlns:views="using:Lumi.Views"
        xmlns:sc="using:StrataTheme.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:models="using:Lumi.Models"
        xmlns:services="using:Lumi.Services"
        xmlns:loc="using:Lumi.Localization"
        xmlns:conv="using:Lumi.Converters"
        xmlns:ctrl="using:Lumi.Views.Controls"
        x:Class="Lumi.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="Lumi"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="{OnPlatform Default='AcrylicBlur,Mica,Blur', macOS='Blur'}"
        UseLayoutRounding="True"
        Background="Transparent">

  <Window.Resources>
    <Thickness x:Key="MainLayout.IslandOuterMargin">0,38,6,6</Thickness>
    <!-- The open project switcher's glass: the overlay surface, translucent over its frost. -->
    <SolidColorBrush x:Key="ProjectSwitcher.GlassFill" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.72" />
    <SolidColorBrush x:Key="Navigation.PillFill" Color="{DynamicResource Color.Surface1}" Opacity="0.4" />
    <SolidColorBrush x:Key="Navigation.PillBorder" Color="{DynamicResource Color.TextPrimary}" Opacity="0.06" />
    <!-- A plugin's (or the Copilot folder's) parts fold under one row so a large plugin never buries
         the user's own items; rows open the read-only page. No tooltips: searches replace these rows,
         and Avalonia 12 crashes closing a tooltip whose control has left the tree. -->
    <DataTemplate x:Key="ExternalSidebarGroupTemplate" x:DataType="vm:ExternalCapabilityGroup">
      <StackPanel Spacing="1">
        <Button Classes="library-facet" Command="{Binding ToggleExpandedCommand}"
                AutomationProperties.Name="{Binding Title}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <PathIcon Grid.Column="0" Classes="mg-side-chevron" Classes.open="{Binding IsExpanded}"
                      Data="{StaticResource Icon.ChevronRight}" Width="8" Height="8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Classes="facet-label" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="mg-side-subtitle" Text="{Binding SourceCaption}" />
            </StackPanel>
            <TextBlock Grid.Column="3" Classes="facet-count" Text="{Binding CountText}" />
          </Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" Margin="16,0,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ExternalCapabilityItem">
              <Button Classes="library-facet mg-side-row" Classes.selected="{Binding IsSelected}" Classes.muted="{Binding !IsEnabled}"
                      Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                  <PathIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Lock}" Width="9" Height="9" Margin="8,0,0,0"
                            Foreground="{DynamicResource Brush.TextTertiary}" Opacity="0.7" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Classes="facet-label" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <x:Double x:Key="MainLayout.SplitIslandMinWidth">220</x:Double>
    <conv:ChatTagBrushConverter x:Key="ChatTagBrush" />
    <!-- ── SVG Icon Paths ── -->
