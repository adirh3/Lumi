    <!-- Customize: two sliders, in layers so the knobs can slide along their tracks. Icons are scaled
         to their geometry's bounds, so each layer carries two invisible marks at the corners of one
         shared frame; that keeps the stacked layers registered with each other. -->
    <StreamGeometry x:Key="Icon.CustomizeTracks">M3 4h.01v.01h-.01z M20.99 19.99h.01v.01h-.01z M4 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z M4 16h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z</StreamGeometry>
    <StreamGeometry x:Key="Icon.CustomizeKnobTop">M3 4h.01v.01h-.01z M20.99 19.99h.01v.01h-.01z M13.2 6a2.6 2.6 0 0 1 5 0v2a2.6 2.6 0 0 1-5 0z</StreamGeometry>
    <StreamGeometry x:Key="Icon.CustomizeKnobBottom">M3 4h.01v.01h-.01z M20.99 19.99h.01v.01h-.01z M5.8 16a2.6 2.6 0 0 1 5 0v2a2.6 2.6 0 0 1-5 0z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Compass">F1 M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm0 1.9a8.1 8.1 0 1 0 0 16.2 8.1 8.1 0 0 0 0-16.2zm4.3 3.8-2.1 6.1a.9.9 0 0 1-.5.5l-6.1 2.1 2.1-6.1a.9.9 0 0 1 .5-.5l6.1-2.1zM12 10.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Lock">M12 2a5 5 0 0 1 5 5v3h.5A2.5 2.5 0 0 1 20 12.5v7a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 19.5v-7A2.5 2.5 0 0 1 6.5 10H7V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v3h6V7a3 3 0 0 0-3-3zm0 9.5a1.6 1.6 0 0 0-.8 3v1.5h1.6v-1.5a1.6 1.6 0 0 0-.8-3z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Duplicate">M9 3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-1v-2h1a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v1H6V6a3 3 0 0 1 3-3zM6 8h9a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3zm0 2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1H6zm4.5 1.5h1.5v2.5h2.5v1.5H12v2.5h-1.5v-2.5H8V14h2.5v-2.5z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Puzzle">M10 2.5a2.5 2.5 0 0 1 2.45 3H16a2 2 0 0 1 2 2v3.05a2.5 2.5 0 1 1 0 4.9V19a2 2 0 0 1-2 2h-3.55a2.5 2.5 0 1 0-4.9 0H4a2 2 0 0 1-2-2v-3.55a2.5 2.5 0 1 0 0-4.9V7.5a2 2 0 0 1 2-2h3.55A2.5 2.5 0 0 1 10 2.5z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Star">M12 2.6l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8L12 2.6z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Shield">M12 2l8 3v6.2c0 5-3.4 9.4-8 10.8-4.6-1.4-8-5.8-8-10.8V5l8-3zm0 2.1L6 6.4v4.8c0 3.9 2.5 7.4 6 8.7 3.5-1.3 6-4.8 6-8.7V6.4l-6-2.3zm-1 4.4h2v5h-2v-5zm0 6.5h2v2h-2v-2z</StreamGeometry>
    <StreamGeometry x:Key="Icon.External">M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42L17.59 5H14V3zM5 5h6v2H6v11h11v-5h2v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <!-- ── Customize section rows: the Library facet row, with the section's hue on its glyph ── -->
    <Style Selector="Button.customize-section PathIcon.section-icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.Hue}" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.customize-section:pointerover PathIcon.section-icon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.customize-section.selected PathIcon.section-icon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.customize-divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="8,8,8,2" />
      <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
    </Style>
    <!-- ── Read-only groups in the Skills, Lumis and MCP sidebars ── -->
    <Style Selector="Button.library-facet.mg-side-row">
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style Selector="Button.library-facet.mg-side-row.muted">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="PathIcon.mg-side-chevron">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon.mg-side-chevron.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <!-- Sidebar ListBox: transparent, borderless, blends in -->
    <Style Selector="ListBox.sidebar-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBox.sidebar-list ListBoxItem">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- ── Settings sidebar: facet rows like Customize's, each with its page's hue ── -->
    <Style Selector="ListBox.settings-nav ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem.group-start">
      <Setter Property="Margin" Value="0,11,0,1" />
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem /template/ Border#LayoutRoot">
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem:pointerover /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="RenderTransform" Value="translateX(0)" />
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem:selected /template/ Border#LayoutRoot, ListBox.settings-nav ListBoxItem:selected:pointerover /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.settings-nav PathIcon.settings-nav-icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem:pointerover PathIcon.settings-nav-icon, ListBox.settings-nav ListBoxItem:selected PathIcon.settings-nav-icon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.settings-nav TextBlock.settings-nav-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="ListBox.settings-nav ListBoxItem:selected TextBlock.settings-nav-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The profile row: who Lumi is talking to, wearing the accent. -->
    <Style Selector="ListBox.settings-nav ListBoxItem.settings-profile">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.settings-nav Border.settings-nav-avatar">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    </Style>
    <Style Selector="ListBox.settings-nav Border.settings-nav-avatar TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.settings-nav Border.settings-nav-avatar PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    </Style>
    <Style Selector="ListBox.settings-nav TextBlock.settings-nav-name">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.settings-nav TextBlock.settings-nav-caption">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- ── Chat list ──
         A neutral hover wash and a firmer neutral selection leave the accent to the slim marker and
         project colours. Project and tag chips keep their solid control surface for readability over
         the sidebar glass. Rows keep the switcher's edges, 14px in from either side, with a hairline
         gap so neighbouring washes never merge. -->
    <Style Selector="ListBox.chat-list ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.chat-list ListBoxItem /template/ Border#LayoutRoot">
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="0.2,0 0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.chat-list ListBoxItem:pointerover /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <Style Selector="ListBox.chat-list ListBoxItem:pressed /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
    </Style>
    <Style Selector="ListBox.chat-list ListBoxItem:selected /template/ Border#LayoutRoot, ListBox.chat-list ListBoxItem:selected:pointerover /template/ Border#LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
    </Style>
    <Style Selector="ListBox.chat-list ListBoxItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="1.5" />
    </Style>
    <Style Selector="ListBox.chat-list TextBlock.chat-row-title.unread">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.chat-list Border.chat-row-chip">
      <Setter Property="Background" Value="{DynamicResource Brush.ControlDefault}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
      <Setter Property="Padding" Value="6,1,8,1" />
    </Style>
    <Style Selector="ListBox.chat-list Border.chat-row-chip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DockPanel.chat-row-meta.tagged > Border#ProjectBadge">
      <Setter Property="MaxWidth" Value="150" />
    </Style>
    <!-- The "Pinned" heading already says why these rows lead, so their pin stays quiet. -->
    <Style Selector="ListBox.chat-list PathIcon.chat-row-pin">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="ListBox.chat-list ListBoxItem:pointerover PathIcon.chat-row-pin, ListBox.chat-list ListBoxItem:selected PathIcon.chat-row-pin">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Only the pill frosts the chats beneath it; the surrounding sidebar stays clear. -->
    <Style Selector="Border.nav-pill">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource Navigation.PillFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource Navigation.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 1 6 0 #16000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.nav-pill:pointerover">
      <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
    </Style>

    <!-- ── Search: the sidebar's field for the palette, a quiet row like New Chat below it: no fill or border
         until hovered. Hovering washes it and tips the glass, unless animations are off. ── -->
    <Style Selector="Button.sidebar-search">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0,5,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleDefault}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.sidebar-search /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sidebar-search /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.sidebar-search:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.sidebar-search:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="Button.sidebar-search sc|StrataLineIcon.sidebar-search-glyph">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sidebar-search:pointerover sc|StrataLineIcon.sidebar-search-glyph">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.sidebar-search:not(.motion-disabled):pointerover sc|StrataLineIcon.sidebar-search-glyph">
      <Setter Property="RenderTransform" Value="rotate(-14deg)" />
    </Style>
    <Style Selector="Button.sidebar-search TextBlock.sidebar-search-label">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button.sidebar-search:pointerover TextBlock.sidebar-search-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Border.sidebar-search-key">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource Navigation.PillBorder}" />
    </Style>
    <Style Selector="Border.sidebar-search-key > TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Places in the pill. Only the place you're on shows its name (see UpdateNavLabels); the label
         grows out of the icon, so a switch reads as the highlight travelling to the new place.
         The 1px border is always there (transparent until active) so the selection ring never nudges
         the icon; 7 + 1 keeps each place 31px wide, which NavIconButtonWidth relies on. -->
    <Style Selector="Button.nav-icon">
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <!-- Names sit above the bar, centred on their place: never under the cursor, and they travel
           with their place while the labels resize instead of re-anchoring to the pointer. -->
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-10" />
    </Style>
    <Style Selector="Button.nav-icon /template/ Border#PART_Surface">
      <!-- The button template's resting drop shadow drew a faint ring around every transparent place. -->
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <sa:PremultipliedBrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav-icon /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.nav-icon:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.nav-icon.hovered /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <Style Selector="Button.nav-icon:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <!-- The place you're on: accent-tinted glass with a hairline ring, distinct from the neutral
         hover wash. -->
    <Style Selector="Button.nav-icon.active /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGlowStrong}" />
    </Style>
    <Style Selector="Button.nav-icon PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav-icon:pointerover PathIcon">
      <Setter Property="Opacity" Value="0.95" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.nav-icon.hovered PathIcon">
      <Setter Property="Opacity" Value="0.95" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.nav-icon:pressed PathIcon">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Button.nav-icon.active PathIcon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <!-- Each place's hover motion lives with the rail's at the end of these styles ("Signs of life"). -->
    <Style Selector="Button.nav-icon TextBlock.nav-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="MaxWidth" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(-3px)" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Delay="0:0:0.05" Easing="CubicEaseOut" />
          <DoubleTransition Property="MaxWidth" Duration="0:0:0.24" Easing="CubicEaseOut" />
          <ThicknessTransition Property="Margin" Duration="0:0:0.24" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Delay="0:0:0.05" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav-icon.labeled TextBlock.nav-label">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Margin" Value="6,0,3,0" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
    </Style>

    <!-- Something is happening behind this place: a job running, an update waiting. -->
    <Style Selector="Border.nav-live-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-2,-3,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.project-pill">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ── Project switcher: one surface naming where the chat list is. Closed, it is only its header;
         open, the same surface grows over the chat list into the list of places, so the list comes out
         of the switcher instead of appearing under it. Open, it is glass, like the chat header's menus:
         the chats beneath show through its tint, frosted. ── -->
    <Style Selector="Border.project-switcher-surface">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="Background" Value="{DynamicResource Brush.ControlDefault}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000, 0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.24" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.project-switcher:pointerover:not(.open) Border.project-switcher-surface">
      <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
    </Style>
    <!-- Open, it lifts off the chat list like a menu. The shadow stays tight enough that the sidebar's
         edges never cut it. -->
    <Style Selector="Panel.project-switcher.open Border.project-switcher-surface">
      <Setter Property="Background" Value="{StaticResource ProjectSwitcher.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
      <Setter Property="BoxShadow" Value="0 10 24 -6 #38000000, 0 2 6 0 #1A000000" />
    </Style>
    <!-- At rest there is nothing beneath it to frost; the frost gathers as it opens. -->
    <Style Selector="sc|StrataBackdropBlur.project-switcher-frost">
      <Setter Property="BlurRadius" Value="0" />
      <Setter Property="Saturation" Value="1.5" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="BlurRadius" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.project-switcher.open sc|StrataBackdropBlur.project-switcher-frost">
      <Setter Property="BlurRadius" Value="28" />
    </Style>
    <!-- The header is the switcher's face: its surface answers the pointer, so the button itself stays
         flat. Its badge, title and chevron line up with the rows' badges, titles and trailing edge. -->
    <Style Selector="Button.project-switcher-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0,11,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.project-switcher-toggle /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.project-switcher-toggle:pointerover /template/ Border#PART_Surface, Button.project-switcher-toggle:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.project-switcher-toggle:pointerover /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(0)" />
    </Style>
    <!-- Open, the header closes it, and a tip about opening it would only cover the list. -->
    <Style Selector="Panel.project-switcher.open Button.project-switcher-toggle">
      <Setter Property="ToolTip.ServiceEnabled" Value="False" />
    </Style>
    <!-- Every chat, or one project's initial on its own hue: the same identity the launchpad and the
         chat header give it. -->
    <Style Selector="Border.project-switcher-badge">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
    </Style>
    <Style Selector="Border.project-switcher-badge PathIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Border.project-switcher-badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.project-switcher-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.project-switcher-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Up and down: it switches between places rather than dropping a menu, so it doesn't turn over. -->
    <Style Selector="PathIcon.project-switcher-chevron">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.project-switcher-toggle:pointerover PathIcon.project-switcher-chevron">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Panel.project-switcher.open PathIcon.project-switcher-chevron">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>

    <!-- ── Library sidebar facet rows ── -->
    <Style Selector="Button.library-facet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.library-facet:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.library-facet:pointerover /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(0)" />
    </Style>
    <Style Selector="Button.library-facet.selected /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Button.library-facet TextBlock.facet-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.library-facet.selected TextBlock.facet-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.library-facet TextBlock.facet-count">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.library-facet.selected TextBlock.facet-count">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Kind facets carry their collection hue; the rest fall back to a neutral glyph. -->
    <Style Selector="Button.library-facet PathIcon.facet-icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.library-facet:pointerover PathIcon.facet-icon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.library-facet.empty">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="Border.library-section-head">
      <Setter Property="Margin" Value="20,18,16,6" />
    </Style>
    <Style Selector="Border.library-section-head TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.9" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- ── Management sidebars (Projects, Skills, Lumis, MCP) ──
         Neutral rows, like the chat list: only the item glyphs take their page's muted hue, from the
         Hue.*.axaml each sidebar merges. Projects' "All projects" row reuses the Library facet row and
         goes back to the page's overview. -->
    <Style Selector="Button.mg-side-overview">
      <Setter Property="Margin" Value="10,8,10,2" />
    </Style>
    <Style Selector="ListBox.mg-side-list ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.mg-side-tile">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.mg-side-tile.round">
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.mg-side-tile > TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.Hue}" />
    </Style>
    <Style Selector="Border.mg-side-tile > PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Mg.Hue}" />
    </Style>
    <Style Selector="TextBlock.mg-side-subtitle">
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.mg-side-count">
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
      <Setter Property="Padding" Value="7,1,7,2" />
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.mg-side-count > TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button.mg-side-clear">
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="Button.mg-side-clear PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Panel.mg-side-muted">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Import and New, beside a section's search. -->
    <Style Selector="Button.mg-side-action">
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Base}" />
    </Style>
    <Style Selector="Button.mg-side-action PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.mg-side-action:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <!-- The chevron before "Projects": the page is opened from the chat list's project switcher, so
         the way back sits where its title starts, as in Windows Settings. -->
    <Style Selector="Button.sidebar-back">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Base}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sidebar-back PathIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="RenderTransform" Value="translateX(0)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sidebar-back:pointerover PathIcon">
      <Setter Property="RenderTransform" Value="translateX(-2px)" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- Under the header: the find field, its icon centred on the rows' badges and its text on their
         titles, then the places. -->
    <Style Selector="Border.project-switcher-find">
      <Setter Property="Padding" Value="15,9,11,9" />
      <Setter Property="BorderThickness" Value="0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    </Style>
    <!-- The faded scrollbar overlays the rows' edge instead of reserving a column, so the rows sit evenly
         inside the switcher, and the chat list keeps the switcher's edges whether or not it scrolls. -->
    <Style Selector="ScrollViewer.project-switcher-scroll /template/ ScrollContentPresenter#PART_ContentPresenter, ScrollViewer.hover-scroll#ChatListScroller /template/ ScrollContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <!-- Every project in the drawer can be set up from it. The open project keeps its gear in view;
         the others show theirs while hovered, so the list stays calm. Until a row is first hovered its
         gear is only an empty slot of the same size (see CreateProjectFilterRow). -->
    <Style Selector="Border.project-switcher-row-edit, Button.project-switcher-row-edit">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.project-switcher-row-edit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.project-switcher-row:pointerover Button.project-switcher-row-edit, Button.project-switcher-row.selected Button.project-switcher-row-edit">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.project-switcher-row-edit PathIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button.project-switcher-row-edit:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Border.project-switcher-footer">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="Padding" Value="5,4,5,5" />
    </Style>
    <Style Selector="Button.project-switcher-action">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.project-switcher-action PathIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button.project-switcher-action TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.project-switcher-action:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style Selector="Border.project-switcher-search">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{DynamicResource Brush.ControlDefault}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.project-switcher-search:focus-within">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
    </Style>

    <Style Selector="TextBox.project-switcher-search-box">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    </Style>

    <Style Selector="TextBox.project-switcher-search-box /template/ Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.project-switcher-search-box:focus-within /template/ Border#PART_Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="TextBox.project-switcher-search-box:focus-within /template/ Border#FocusAccentBar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ComboBox.jobs-filter">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.job-activation-toggle">
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10.5" />
    </Style>
    <Style Selector="Button.job-activation-toggle.enabled">
      <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
    </Style>
    <Style Selector="Button.job-activation-toggle.paused">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style Selector="Border.job-lifecycle-pill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.progress">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.progress TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.completed">
      <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.completed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.skipped">
      <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.skipped TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.failed">
      <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.failed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.idle">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Border.job-lifecycle-pill.idle TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style Selector="Button.project-switcher-row">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.project-switcher-row:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.project-switcher-row:pointerover /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- The place the chat list shows: Lumi's accent tint, the same as the lit place in the bar. -->
    <Style Selector="Button.project-switcher-row.selected /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.project-switcher-row TextBlock.project-switcher-row-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button.project-switcher-row:pointerover TextBlock.project-switcher-row-title, Button.project-switcher-row.selected TextBlock.project-switcher-row-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.project-switcher-row TextBlock.project-switcher-row-count">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Border#PillBusyDot">
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.3" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.2" />
      <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>

    <!-- ── Unread inbox ──────────────────────────────────
         Chats stream in several projects at once, so a reply can land in a project the sidebar is
         filtered away from. This pill sits directly above the chat list as the one filter-independent
         "you have new replies" surface, and opens into a card that jumps straight to any of them. -->
    <Style Selector="Border.unread-panel">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface0}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.unread-toggle">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Interactive}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.unread-toggle:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="BoxShadow" Value="0 4 14 0 #14000000" />
    </Style>
    <Style Selector="Button.unread-toggle:pointerover /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateX(0)" />
    </Style>
    <Style Selector="Button.unread-toggle PathIcon#UnreadChevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.unread-toggle.open PathIcon#UnreadChevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <!-- The dot breathes so a reply arriving while the user is elsewhere draws the eye. -->
    <Style Selector="Border.unread-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.32" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.5" />
      <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="Border.unread-nav-badge">
      <Setter Property="MinWidth" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.unread-nav-badge TextBlock">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.unread-row">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.unread-row:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.unread-mark-all">
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <Style Selector="ScrollViewer.hover-scroll ScrollBar">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ScrollViewer.hover-scroll:pointerover ScrollBar">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="primitives|Thumb.sidebar-resize">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- ── Sidebar collapse / expand toggle ── -->
    <Style Selector="Button.sidebar-toggle">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sidebar-toggle Panel#SidebarToggleGlyph">
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sidebar-toggle:pointerover Panel#SidebarToggleGlyph">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Button.sidebar-toggle:pressed Panel#SidebarToggleGlyph">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="Button.sidebar-toggle Border#SidebarToggleFrame">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.sidebar-toggle Border#SidebarTogglePanel">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseOut" />
          <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseOut" />
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Collapsed: the little sidebar column inside the glyph empties out -->
    <Style Selector="Button.sidebar-toggle.collapsed Border#SidebarTogglePanel">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Width" Value="2" />
    </Style>
    <Style Selector="Button.sidebar-toggle:pointerover Border#SidebarToggleFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.sidebar-toggle:pointerover Border#SidebarTogglePanel">
      <Setter Property="Background" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- ── Collapsed icon rail: compact nav shortcuts shown when the sidebar is collapsed ── -->
    <Style Selector="Button.rail-nav-icon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Names to the right of the rail, level with their place (the default offset drops a tip
           20px, beside the next place down). -->
      <Setter Property="ToolTip.Placement" Value="Right" />
      <Setter Property="ToolTip.HorizontalOffset" Value="8" />
      <Setter Property="ToolTip.VerticalOffset" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.rail-nav-icon /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.16" />
          <sa:PremultipliedBrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.rail-nav-icon PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.rail-nav-icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Button.rail-nav-icon:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Same selection as the pill. Set on the surface so a hover can't wash it out. -->
    <Style Selector="Button.rail-nav-icon.active /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGlowStrong}" />
    </Style>
    <Style Selector="Button.rail-nav-icon.active PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>

    <!-- ── Signs of life on the places (bar and rail) ──
         Hovering a place moves its icon the way the thing itself moves: a message pops up from
         its tail, the books tip off their spines, the clock's hands sweep round, the knobs slide,
         the gear turns. Physical motions overshoot slightly (BackEaseOut); mechanical ones glide.
         The clock and gear end where they began, so a hovered icon still reads at rest. Off when
         animations are off in Settings. Declared last so these transitions replace the colour-only
         ones above. -->
    <Style Selector="PathIcon.nav-chat">
      <Setter Property="RenderTransformOrigin" Value="15%,95%" />
      <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon.nav-books">
      <Setter Property="RenderTransformOrigin" Value="50%,88%" />
      <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon.nav-clock">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.7" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon.nav-knob-left, PathIcon.nav-knob-right">
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon.nav-gear">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.nav-pill:not(.motion-disabled) Button:pointerover PathIcon.nav-chat, Border.nav-pill:not(.motion-disabled) Button.hovered PathIcon.nav-chat, StackPanel#SidebarRail:not(.motion-disabled) Button:pointerover PathIcon.nav-chat">
      <Setter Property="RenderTransform" Value="rotate(-8deg) scale(1.12)" />
    </Style>
    <Style Selector="Border.nav-pill:not(.motion-disabled) Button:pointerover PathIcon.nav-books, Border.nav-pill:not(.motion-disabled) Button.hovered PathIcon.nav-books, StackPanel#SidebarRail:not(.motion-disabled) Button:pointerover PathIcon.nav-books">
      <Setter Property="RenderTransform" Value="rotate(-8deg) scale(1.12)" />
    </Style>
    <Style Selector="Border.nav-pill:not(.motion-disabled) Button:pointerover PathIcon.nav-clock, Border.nav-pill:not(.motion-disabled) Button.hovered PathIcon.nav-clock, StackPanel#SidebarRail:not(.motion-disabled) Button:pointerover PathIcon.nav-clock">
      <Setter Property="RenderTransform" Value="rotate(360deg)" />
    </Style>
    <Style Selector="Border.nav-pill:not(.motion-disabled) Button:pointerover PathIcon.nav-knob-left, Border.nav-pill:not(.motion-disabled) Button.hovered PathIcon.nav-knob-left, StackPanel#SidebarRail:not(.motion-disabled) Button:pointerover PathIcon.nav-knob-left">
      <Setter Property="RenderTransform" Value="translateX(-3.3px)" />
    </Style>
    <Style Selector="Border.nav-pill:not(.motion-disabled) Button:pointerover PathIcon.nav-knob-right, Border.nav-pill:not(.motion-disabled) Button.hovered PathIcon.nav-knob-right, StackPanel#SidebarRail:not(.motion-disabled) Button:pointerover PathIcon.nav-knob-right">
      <Setter Property="RenderTransform" Value="translateX(3.3px)" />
    </Style>
    <Style Selector="Border.nav-pill:not(.motion-disabled) Button:pointerover PathIcon.nav-gear, Border.nav-pill:not(.motion-disabled) Button.hovered PathIcon.nav-gear, StackPanel#SidebarRail:not(.motion-disabled) Button:pointerover PathIcon.nav-gear">
      <Setter Property="RenderTransform" Value="rotate(60deg)" />
    </Style>

    <!-- The Customize glyph is three layers (tracks and two knobs). In the bar the dimming goes on
         the group: layers dimmed one by one would show darker where a knob overlaps its track. -->
    <Style Selector="Button.nav-icon Panel.nav-tune">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav-icon:pointerover Panel.nav-tune, Button.nav-icon.hovered Panel.nav-tune">
      <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="Button.nav-icon.active Panel.nav-tune">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel.nav-tune > PathIcon">
      <Setter Property="Opacity" Value="1" />
    </Style>

  </Window.Styles>

  <LayoutTransformControl x:Name="UiScaleHost">
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{DynamicResource Lumi.UiScale}"
                      ScaleY="{DynamicResource Lumi.UiScale}" />
    </LayoutTransformControl.LayoutTransform>
  <Border x:Name="WindowContentRoot">
  <Panel>
    <!-- Semi-transparent background that lets Mica/Acrylic show through -->
    <Border x:Name="AcrylicFallback" IsHitTestVisible="False">
      <Border.Background>
        <SolidColorBrush Color="{DynamicResource Color.Background}" Opacity="0.8" />
      </Border.Background>
    </Border>

    <!-- ═══ Main App ═══ -->
    <DockPanel x:Name="MainPanel" IsVisible="False">

      <!-- ═══ ALWAYS-VISIBLE LEFT SIDEBAR ═══ -->
      <Border x:Name="SidebarBorder" DockPanel.Dock="Left" Width="280" ClipToBounds="True"
              TextOptions.TextRenderingMode="Antialias">
        <Panel>
        <DockPanel>

          <!-- ── Top: Title bar inset (respects window chrome) ── -->
          <Border DockPanel.Dock="Top" IsHitTestVisible="False" Height="38" />

          <!-- ── Search: a glass field that opens the palette (Ctrl+K). Left margin leaves room for the sidebar toggle. ── -->
          <Border DockPanel.Dock="Top" Margin="54,3,14,5">
            <Button x:Name="SidebarSearchButton"
                    Classes="sidebar-search"
                    Classes.motion-disabled="{Binding !SettingsVM.ShowAnimations}"
                    AutomationProperties.Name="{loc:Str Sidebar_Search}"
                    Click="SearchButton_Click">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="sidebar-search-key">
                  <TextBlock x:Name="SearchButtonShortcut" Text="Ctrl+K" />
                </Border>
                <sc:StrataLineIcon Classes="sidebar-search-glyph" Data="{StaticResource Icon.SearchLine}" />
                <TextBlock Classes="sidebar-search-label" Text="{loc:Str Sidebar_Search_Short}" />
              </DockPanel>
            </Button>
          </Border>

          <!-- Other pages keep their docked layout; chats use an inset inside their scroll extent. -->
          <Border x:Name="SidebarNavSpacer" DockPanel.Dock="Bottom"
                  Height="{Binding #SidebarNav.Bounds.Height}"
                  IsVisible="{Binding !#SidebarChat.IsVisible}"
                  IsHitTestVisible="False" />
          <!-- ── Customize: where Lumi is set up. Agents, skills and connectors (exactly what plugins
               bring) are picked in a chat and set up here; projects are switched in the chat list and
               set up here; Discover finds more. Its sections are rows, like every other list in the
               sidebar; each keeps its own hue on the glyph and the selection uses Lumi's accent. The
               section's own list follows below the divider. ── -->
          <Border x:Name="CustomizeSwitcher" DockPanel.Dock="Top" Margin="10,4,10,0"
                  IsVisible="{Binding IsCustomizeOpen}">
            <StackPanel Spacing="1">
              <Button x:Name="CustomizeDiscoverTab" Classes="library-facet customize-section" Classes.selected="{Binding IsDiscoverSection}"
                      Command="{Binding OpenCustomizeSectionCommand}" CommandParameter="9"
                      AutomationProperties.Name="{loc:Str Customize_Discover}">
                <Button.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Discover.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                  </ResourceDictionary>
                </Button.Resources>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <PathIcon Grid.Column="0" Classes="section-icon" Data="{StaticResource Icon.Compass}" />
                  <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Customize_Discover}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button x:Name="CustomizeLumisTab" Classes="library-facet customize-section" Classes.selected="{Binding IsLumisSection}"
                      Command="{Binding OpenCustomizeSectionCommand}" CommandParameter="4"
                      AutomationProperties.Name="{loc:Str Customize_Lumis}">
                <Button.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Lumi.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                  </ResourceDictionary>
                </Button.Resources>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <PathIcon Grid.Column="0" Classes="section-icon" Data="{StaticResource Icon.Sparkle}" />
                  <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Customize_Lumis}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding AgentsVM.SectionCountText}" />
                </Grid>
              </Button>
              <Button x:Name="CustomizeSkillsTab" Classes="library-facet customize-section" Classes.selected="{Binding IsSkillsSection}"
                      Command="{Binding OpenCustomizeSectionCommand}" CommandParameter="3"
                      AutomationProperties.Name="{loc:Str Customize_Skills}">
                <Button.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Skill.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                  </ResourceDictionary>
                </Button.Resources>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <PathIcon Grid.Column="0" Classes="section-icon" Data="{StaticResource Icon.Bolt}" />
                  <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Customize_Skills}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding SkillsVM.SectionCountText}" />
                </Grid>
              </Button>
              <Button x:Name="CustomizeMcpTab" Classes="library-facet customize-section" Classes.selected="{Binding IsMcpSection}"
                      Command="{Binding OpenCustomizeSectionCommand}" CommandParameter="6"
                      AutomationProperties.Name="{loc:Str Customize_McpServers}">
                <Button.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Mcp.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                  </ResourceDictionary>
                </Button.Resources>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <PathIcon Grid.Column="0" Classes="section-icon" Data="{StaticResource Icon.Plug}" />
                  <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Customize_McpServers}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding McpServersVM.SectionCountText}" />
                </Grid>
              </Button>
              <Button x:Name="CustomizeProjectsTab" Classes="library-facet customize-section" Classes.selected="{Binding IsProjectsSection}"
                      Command="{Binding OpenCustomizeSectionCommand}" CommandParameter="2"
                      AutomationProperties.Name="{loc:Str Customize_Projects}">
                <Button.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                      <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Project.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                  </ResourceDictionary>
                </Button.Resources>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <PathIcon Grid.Column="0" Classes="section-icon" Data="{StaticResource Icon.Folder}" />
                  <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Customize_Projects}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding ProjectsVM.TotalCountText}" />
                </Grid>
              </Button>
              <Border Classes="customize-divider" />
            </StackPanel>
          </Border>
          <!-- ═══ SIDEBAR CONTENT PANELS (one per tab, wrapped for DockPanel fill) ═══ -->
          <Panel>

          <!-- ── 0: Chat sidebar ── -->
          <Panel x:Name="SidebarChat">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="14,10,14,0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        x:Name="ChatActionsButton"
                        Classes="subtle"
                        Padding="8"
                        MinHeight="0"
                        MinWidth="0"
                        CornerRadius="{DynamicResource Radius.Base}"
                        ToolTip.Tip="{loc:Str Chat_Actions}"
                        AutomationProperties.Name="{loc:Str Chat_Actions}">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem x:Name="ShareCurrentPromptMenuItem"
                                Header="{loc:Str Prompt_ShareCurrentChat}"
                                IsVisible="{Binding ChatVM.IsChatVisible}"
                                Command="{Binding ChatVM.ShareLatestPromptCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="{x:Static sc:StrataChatMessage.ShareIconGeometry}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{loc:Str Sidebar_NewChatInNewWindow}"
                                Command="{Binding OpenNewChatInNewWindowCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="{StaticResource Icon.Window}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator IsVisible="{Binding HasChatActivity}" />
                      <MenuItem x:Name="PauseAllChatsMenuItem"
                                Header="{loc:Str Chat_PauseAll}"
                                IsVisible="{Binding CanPauseAllChats}"
                                Command="{Binding PauseAllChatsCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem x:Name="ResumeAllChatsMenuItem"
                                Header="{loc:Str Chat_ResumeAll}"
                                IsVisible="{Binding CanResumeAllChats}"
                                Command="{Binding ResumeAllChatsCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                  <PathIcon Data="M4 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z" Width="14" Height="14"
                            Foreground="{DynamicResource Brush.TextSecondary}" />
                </Button>
                <Button Classes="subtle" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        CornerRadius="{DynamicResource Radius.Base}"
                        Padding="10,8" MinHeight="0"
                        Margin="0,0,6,0"
                        ToolTip.Tip="{loc:Str Sidebar_NewChatTooltip}"
                        Command="{Binding NewChatCommand}"
                        Click="NewChatButton_Click">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{loc:Str Sidebar_NewChatInNewWindow}"
                                Command="{Binding OpenNewChatInNewWindowCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="{StaticResource Icon.Browse}" Width="14" Height="14" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Compose}" Width="13" Height="13"
                              Foreground="{DynamicResource Brush.AccentDefault}" />
                    <TextBlock Text="{loc:Str Sidebar_NewChat}" FontWeight="Medium"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DockPanel>
              <!-- ── Project lens: one full-width control naming where the chat list is (every chat, or one
                       project on its own hue) that switches in a click and scales to many projects. Open, it
                       grows out of itself over the chat list, which stays put, into a list that finds and
                       switches projects; they are set up in Customize → Projects, which the list's gears and
                       actions open. Shown even before the first project. ── -->
              <Panel>
                <Panel x:Name="ProjectSwitcherRoot"
                       Classes="project-switcher"
                       VerticalAlignment="Top"
                       Margin="14,6,14,0"
                       ZIndex="1">
                  <sc:StrataBackdropBlur Classes="project-switcher-frost" CornerRadius="12" />
                  <Border Classes="project-switcher-surface">
                    <StackPanel>
                      <Button x:Name="ProjectSwitchButton"
                              Classes="project-switcher-toggle"
                              ToolTip.Tip="{loc:Str ProjectSwitcher_OpenTooltip}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <Border x:Name="ProjectSwitchBadge" Classes="project-switcher-badge">
                            <Panel>
                              <PathIcon x:Name="ProjectSwitchAllIcon" Data="{StaticResource Icon.Chat}" />
                              <TextBlock x:Name="ProjectSwitchInitial" IsVisible="False" />
                            </Panel>
                          </Border>
                          <TextBlock x:Name="ProjectSwitchTitleText" Grid.Column="1" Classes="project-switcher-title" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="ProjectSwitchMetaText" Classes="project-switcher-meta" IsVisible="False" />
                            <PathIcon Classes="project-switcher-chevron" Data="{StaticResource Icon.ChevronsUpDown}" />
                          </StackPanel>
                        </Grid>
                      </Button>

                      <Border x:Name="ProjectSwitchRevealHost"
                              Height="0"
                              Opacity="0"
                              IsVisible="False"
                              ClipToBounds="True">
                        <StackPanel x:Name="ProjectSwitchPanel">
                          <Border Classes="project-switcher-find">
                            <DockPanel>
                              <PathIcon DockPanel.Dock="Left"
                                        Data="{StaticResource Icon.Search}"
                                        Width="12" Height="12"
                                        Foreground="{DynamicResource Brush.TextTertiary}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,13,0" />
                              <TextBox x:Name="ProjectFilterSearchBox"
                                       Classes="project-switcher-search-box"
                                       PlaceholderText="{loc:Str ProjectSwitcher_SearchPlaceholder}" />
                            </DockPanel>
                          </Border>

                          <!-- Seven and a half 31px rows, so a longer list visibly continues below. -->
                          <ScrollViewer MaxHeight="237"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        Classes="hover-scroll project-switcher-scroll">
                            <StackPanel x:Name="ProjectFilterResults" Spacing="1" Margin="5,5,5,4" />
                          </ScrollViewer>

                          <TextBlock x:Name="ProjectFilterMoreText"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource Brush.TextTertiary}"
                                     HorizontalAlignment="Center"
                                     Margin="6,0,6,6"
                                     IsVisible="False" />

                          <Border Classes="project-switcher-footer">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                              <Button x:Name="ProjectSwitcherNewButton"
                                      Classes="subtle project-switcher-action"
                                      Command="{Binding NewProjectFromSwitcherCommand}"
                                      Click="OnProjectSwitcherActionClick"
                                      AutomationProperties.Name="{loc:Str Projects_New}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Data="{StaticResource Icon.Plus}" />
                                  <TextBlock Text="{loc:Str Projects_New}" />
                                </StackPanel>
                              </Button>
                              <Button Grid.Column="1"
                                      x:Name="ProjectSwitcherManageButton"
                                      Classes="subtle project-switcher-action"
                                      Command="{Binding ManageProjectsCommand}"
                                      Click="OnProjectSwitcherActionClick"
                                      AutomationProperties.Name="{loc:Str ProjectSwitcher_Manage}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Data="{StaticResource Icon.FolderOpen}" />
                                  <TextBlock Text="{loc:Str ProjectSwitcher_Manage}" />
                                </StackPanel>
                              </Button>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </Panel>

                <!-- Everything else starts under the closed switcher (6 above it, 36 tall), which opens over it. -->
                <DockPanel Margin="0,42,0,0">
                  <!-- ── Unread inbox: the one place unread replies stay visible regardless of the
                           active project filter, and the fastest route back to them. ── -->
                  <Border x:Name="UnreadInboxRoot"
                          DockPanel.Dock="Top"
                          Margin="14,6,14,0"
                          IsVisible="{Binding HasUnreadChats}">
                    <StackPanel>
                      <Button x:Name="UnreadInboxToggle"
                              Classes="unread-toggle"
                              Command="{Binding ToggleUnreadPanelCommand}"
                              ToolTip.Tip="{Binding UnreadTooltipText}"
                              AutomationProperties.Name="{Binding UnreadSummaryText}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                          <Border Grid.Column="0" Classes="unread-dot" />
                          <TextBlock Grid.Column="1"
                                     x:Name="UnreadSummaryLabel"
                                     Text="{Binding UnreadSummaryText}"
                                     FontSize="11.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.AccentDefault}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <PathIcon Grid.Column="2"
                                    x:Name="UnreadChevron"
                                    Data="{StaticResource Icon.ChevronDown}"
                                    Width="11" Height="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.AccentDefault}" />
                        </Grid>
                      </Button>

                      <Border x:Name="UnreadRevealHost"
                              Height="0"
                              Opacity="0"
                              IsVisible="False"
                              ClipToBounds="True"
                              Margin="0,4,0,0">
                        <Border x:Name="UnreadPanel" Classes="unread-panel" ClipToBounds="True">
                          <StackPanel Spacing="3" Margin="6">
                            <ScrollViewer MaxHeight="212"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Classes="hover-scroll">
                              <ItemsControl ItemsSource="{Binding UnreadChats}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:UnreadChatEntry">
                                    <Button Classes="unread-row"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenUnreadChatCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding TooltipText}">
                                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                        <Border Grid.Column="0"
                                                Width="6" Height="6" CornerRadius="3"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.AccentDefault}" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding Title}"
                                                     FontSize="11.5"
                                                     FontWeight="Medium"
                                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                                     TextTrimming="CharacterEllipsis" />
                                          <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource Icon.Folder}"
                                                      Width="9" Height="9"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding HasProject}"
                                                      Foreground="{Binding ProjectColor, Converter={StaticResource ChatTagBrush}}" />
                                            <TextBlock Text="{Binding ProjectName}"
                                                       IsVisible="{Binding HasProject}"
                                                       FontSize="10"
                                                       MaxWidth="118"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{loc:Str Unread_NoProject}"
                                                       IsVisible="{Binding !HasProject}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                                          </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeLabel}"
                                                   FontSize="9.8"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                      </Grid>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="{Binding UnreadOverflowText}"
                                       IsVisible="{Binding HasUnreadOverflow}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,1"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />

                            <Border Height="1" Margin="2,2"
                                    Background="{DynamicResource Brush.BorderSubtle}" />

                            <Button Classes="subtle unread-mark-all"
                                    Command="{Binding MarkAllChatsReadCommand}"
                                    Content="{loc:Str Unread_MarkAllRead}" />
                          </StackPanel>
                        </Border>
                      </Border>
                    </StackPanel>
                  </Border>

                  <ScrollViewer x:Name="ChatListScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                Classes="hover-scroll" Margin="0,4,0,0">
                    <StackPanel>
                    <ItemsControl x:Name="ChatGroupsHost" ItemsSource="{Binding ChatGroups}" Margin="14,0,14,8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel x:DataType="vm:ChatGroup" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font.SizeCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       Margin="10,12,10,4" />
                            <ListBox Classes="sidebar-list chat-list"
                                     ItemsSource="{Binding Chats}"
                                     SelectionMode="Single"
                                     SelectedItem="{x:Null}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Chat">
                                  <Panel Background="Transparent" DataContextChanged="OnChatRowDataContextChanged">
                                     <Panel.ContextMenu>
                                       <ContextMenu x:CompileBindings="False" Opening="OnChatContextMenuOpening">
                                         <MenuItem x:Name="PauseChatMenuItem"
                                                   Header="{loc:Str Chat_PauseMenu}"
                                                   IsVisible="{Binding CanPause}"
                                                   Command="{Binding $parent[Window].DataContext.ToggleChatPauseCommand}"
                                                   CommandParameter="{Binding}"
                                                   AutomationProperties.Name="{loc:Str Chat_PauseMenu}"
                                                   ToolTip.Tip="{loc:Str Chat_PauseTooltip}">
                                           <MenuItem.Icon>
                                             <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" />
                                           </MenuItem.Icon>
                                         </MenuItem>
                                         <MenuItem x:Name="ResumeChatMenuItem"
                                                   Header="{loc:Str Chat_ResumeMenu}"
                                                   IsVisible="{Binding IsPaused}"
                                                   Command="{Binding $parent[Window].DataContext.ToggleChatPauseCommand}"
                                                   CommandParameter="{Binding}"
                                                   AutomationProperties.Name="{loc:Str Chat_ResumeMenu}"
                                                   ToolTip.Tip="{loc:Str Chat_ResumeTooltip}">
                                           <MenuItem.Icon>
                                             <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" />
                                           </MenuItem.Icon>
                                         </MenuItem>
                                         <MenuItem x:Name="TogglePinChatMenuItem"
                                                   Header="{loc:Str Menu_Pin}"
                                                   Command="{Binding $parent[Window].DataContext.ToggleChatPinCommand}"
                                                   CommandParameter="{Binding}">
                                           <MenuItem.Icon>
                                             <PathIcon Data="{StaticResource Icon.Pin}" Width="14" Height="14" />
                                           </MenuItem.Icon>
                                         </MenuItem>
                                         <MenuItem x:Name="MarkChatUnreadMenuItem"
                                                   Header="{loc:Str Menu_MarkAsUnread}"
                                                   IsVisible="{Binding !HasUnreadMessages}"
                                                   Command="{Binding $parent[Window].DataContext.MarkChatUnreadCommand}"
                                                   CommandParameter="{Binding}">
                                           <MenuItem.Icon>
                                             <PathIcon x:Name="MarkChatUnreadIcon" Data="{StaticResource Icon.MailClosed}" Width="14" Height="14" />
                                           </MenuItem.Icon>
                                         </MenuItem>
                                         <MenuItem x:Name="MarkChatReadMenuItem"
                                                   Header="{loc:Str Menu_MarkAsRead}"
                                                   IsVisible="{Binding HasUnreadMessages}"
                                                   Command="{Binding $parent[Window].DataContext.MarkChatReadCommand}"
                                                   CommandParameter="{Binding}">
                                           <MenuItem.Icon>
                                             <PathIcon x:Name="MarkChatReadIcon" Data="{StaticResource Icon.MailOpen}" Width="14" Height="14" />
                                           </MenuItem.Icon>
                                         </MenuItem>
                                         <MenuItem Header="{loc:Str Menu_Rename}"
                                                   Command="{Binding $parent[Window].DataContext.StartRenameChatCommand}"
                                                   CommandParameter="{Binding}">
                                           <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource Icon.Rename}" Width="14" Height="14" />
                                          </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{loc:Str Menu_Fork}"
                                                  Command="{Binding $parent[Window].DataContext.DuplicateChatCommand}"
                                                  CommandParameter="{Binding}">
                                          <MenuItem.Icon>
                                            <PathIcon Data="{x:Static sc:StrataChatMessage.ForkIconGeometry}" Width="14" Height="14" />
                                          </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="OpenChatInNewWindowMenuItem"
                                                  Header="{loc:Str Menu_OpenInNewWindow}"
                                                  Command="{Binding $parent[Window].DataContext.OpenChatInNewWindowCommand}"
                                                  CommandParameter="{Binding}">
                                          <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource Icon.Window}" Width="14" Height="14" />
                                          </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ChatTagMenu" Header="{loc:Str Menu_ChatTag}">
                                          <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource Icon.Tag}" Width="14" Height="14" />
                                          </MenuItem.Icon>
                                          <MenuItem IsVisible="False" IsEnabled="False" />
                                        </MenuItem>
                                        <MenuItem x:Name="MoveToProjectMenu" Header="{loc:Str Menu_MoveToProject}">
                                           <MenuItem.Icon>
                                             <PathIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                                           </MenuItem.Icon>
                                           <MenuItem IsVisible="False" IsEnabled="False" />
                                         </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{loc:Str Menu_Delete}"
                                                  Command="{Binding $parent[Window].DataContext.DeleteChatCommand}"
                                                  CommandParameter="{Binding}">
                                          <MenuItem.Icon>
                                            <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                          </MenuItem.Icon>
                                        </MenuItem>
                                      </ContextMenu>
                                    </Panel.ContextMenu>
                                    <DockPanel>
                                      <!-- Where the chat lives, then how it is labelled, as quiet chips on the switcher's
                                           solid control surface so they stay readable over whatever shows through the
                                           sidebar. The folder wears the project's own hue, the one the project switcher,
                                           the chat header and the launchpad give it. The project leads so its folder lines
                                           up from row to row; with a tag beside it the name is capped
                                           (chat-row-meta.tagged) and the tag trims into what is left. -->
                                      <DockPanel DockPanel.Dock="Bottom"
                                                 Classes="chat-row-meta"
                                                 Classes.tagged="{Binding HasTag}">
                                        <Border x:Name="ProjectBadge"
                                                Classes="chat-row-chip"
                                                DockPanel.Dock="Left"
                                                IsVisible="{Binding ShowProjectBadge}"
                                                ToolTip.Tip="{Binding ProjectBadgeText}"
                                                Margin="0,4,6,0">
                                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                            <PathIcon Grid.Column="0"
                                                      Data="{StaticResource Icon.Folder}"
                                                      Width="10" Height="10"
                                                      VerticalAlignment="Center"
                                                      Foreground="{Binding ProjectBadgeColor, Converter={StaticResource ChatTagBrush}}" />
                                            <TextBlock x:Name="ProjectLabel"
                                                       Grid.Column="1"
                                                       Text="{Binding ProjectBadgeText}"
                                                       TextTrimming="CharacterEllipsis" />
                                          </Grid>
                                        </Border>
                                        <Border x:Name="ChatTagBadge"
                                                Classes="chat-row-chip"
                                                IsVisible="{Binding HasTag}"
                                                ToolTip.Tip="{Binding TagName}"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,0,0">
                                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TagColor, Converter={StaticResource ChatTagBrush}}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TagName}"
                                                       TextTrimming="CharacterEllipsis" />
                                          </Grid>
                                        </Border>
                                      </DockPanel>
                                      <Border x:Name="UnreadIndicator" DockPanel.Dock="Left"
                                              Width="6" Height="6" CornerRadius="3"
                                              Background="{DynamicResource Brush.AccentDefault}"
                                              VerticalAlignment="Center" Margin="0,0,7,0"
                                              IsVisible="{Binding HasUnreadMessages}" />
                                      <Border x:Name="BusyIndicator" DockPanel.Dock="Left"
                                              Width="6" Height="6" CornerRadius="3"
                                              Background="{DynamicResource Brush.AccentDefault}"
                                              VerticalAlignment="Center" Margin="0,0,7,0"
                                              IsVisible="{Binding ShowRunningIndicator}">
                                        <Border.Styles>
                                          <Style Selector="Border#BusyIndicator">
                                            <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
                                            <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.3" />
                                            <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.2" />
                                            <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
                                            <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
                                          </Style>
                                        </Border.Styles>
                                      </Border>
                                      <PathIcon x:Name="PausedChatIndicator"
                                                DockPanel.Dock="Left"
                                                Data="{StaticResource Icon.Pause}"
                                                Width="8" Height="9"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                IsVisible="{Binding IsPaused}"
                                                AutomationProperties.Name="{loc:Str Chat_Paused}"
                                                ToolTip.Tip="{loc:Str Chat_PausedIndicatorTooltip}" />
                                      <!-- An action in this chat waits for the user's approval. -->
                                      <sc:StrataLineIcon x:Name="ApprovalNeededIndicator"
                                                         DockPanel.Dock="Left"
                                                         Data="{x:Static sc:StrataIcons.Shield}"
                                                         Width="12" Height="12" StrokeThickness="2"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Brush.WarningDefault}"
                                                         IsVisible="{Binding IsAwaitingApproval}"
                                                         AutomationProperties.Name="{loc:Str Approval_WaitingOne}" />
                                      <PathIcon x:Name="PinnedChatIndicator"
                                                DockPanel.Dock="Right"
                                                Classes="chat-row-pin"
                                                Data="{StaticResource Icon.Pin}"
                                                Width="11" Height="11"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsPinned}"
                                                ToolTip.Tip="{loc:Str Chat_PinnedTooltip}" />
                                      <Border x:Name="BackgroundChatIndicator" DockPanel.Dock="Right"
                                              Width="7" Height="7" CornerRadius="3.5"
                                              Margin="7,0,0,0" BorderThickness="1.5"
                                              BorderBrush="{DynamicResource Brush.TextTertiary}"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding HasBackgroundActivity}"
                                              ToolTip.Tip="{loc:Str Chat_BackgroundActivityTooltip}" />
                                      <TextBlock x:Name="ChatTitleText"
                                                 Classes="chat-row-title"
                                                 Classes.unread="{Binding HasUnreadMessages}"
                                                 Text="{Binding Title}"
                                                 ToolTip.Tip="{Binding Title}"
                                                 TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" />
                                    </DockPanel>
                                  </Panel>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="{Binding #SidebarNav.Bounds.Height}" IsHitTestVisible="False" />
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Panel>
            </DockPanel>
          </Panel>

          <!-- ── 1: Jobs sidebar ── -->
          <Panel x:Name="SidebarJobs" IsVisible="False" DataContext="{Binding JobsVM}" x:DataType="vm:BackgroundJobsViewModel">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="16,8,16,0">
                <Button DockPanel.Dock="Right" Classes="subtle" Padding="7,5" MinHeight="0"
                        CornerRadius="{DynamicResource Radius.Base}"
                        Command="{Binding NewJobCommand}"
                        ToolTip.Tip="{loc:Str Sidebar_NewJobTooltip}"
                        AutomationProperties.Name="{loc:Str Sidebar_NewJobTooltip}">
                  <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14"
                            Foreground="{DynamicResource Brush.TextSecondary}" />
                </Button>
                <TextBlock Text="{loc:Str Sidebar_Jobs}" FontSize="{DynamicResource Font.SizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
              </DockPanel>
              <Border DockPanel.Dock="Top"
                      Classes="project-switcher-search"
                      Margin="16,8,16,0">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon
                            Data="{StaticResource Icon.Search}"
                            Width="12" Height="12"
                            Foreground="{DynamicResource Brush.TextTertiary}"
                            VerticalAlignment="Center"
                            Margin="0,0,7,0" />
                  <TextBox x:Name="JobsSearchBox"
                           Grid.Column="1"
                           Classes="project-switcher-search-box"
                           Text="{Binding SearchQuery}"
                           Padding="0,0,24,0"
                           PlaceholderText="{loc:Str Sidebar_Search_Short}"
                           AutomationProperties.Name="{loc:Str Sidebar_Search_Short}" />
                  <Button Grid.Column="1"
                          HorizontalAlignment="Right"
                          Classes="subtle"
                          Padding="4"
                          MinWidth="0"
                          MinHeight="0"
                          Command="{Binding ClearSearchCommand}"
                          IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          ToolTip.Tip="{loc:Str Common_Clear}"
                          AutomationProperties.Name="{loc:Str Common_Clear}">
                    <PathIcon Data="{StaticResource Icon.Dismiss}" Width="11" Height="11"
                              Foreground="{DynamicResource Brush.TextTertiary}" />
                  </Button>
                </Grid>
              </Border>
              <Grid DockPanel.Dock="Top"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="6"
                    Margin="16,8,16,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Str Jobs_FilterActivation}"
                             FontSize="10"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                  <ComboBox x:Name="JobsActivationFilter"
                            Classes="jobs-filter"
                            SelectedIndex="{Binding ActivationFilterIndex}"
                            AutomationProperties.Name="{loc:Str Jobs_FilterActivation}">
                    <ComboBoxItem Content="{loc:Str Jobs_FilterAllActivation}" />
                    <ComboBoxItem Content="{loc:Str Jobs_FilterEnabled}" />
                    <ComboBoxItem Content="{loc:Str Jobs_FilterPaused}" />
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{loc:Str Jobs_FilterLifecycle}"
                             FontSize="10"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                  <ComboBox x:Name="JobsLifecycleFilter"
                            Classes="jobs-filter"
                            SelectedIndex="{Binding LifecycleFilterIndex}"
                            AutomationProperties.Name="{loc:Str Jobs_FilterLifecycle}">
                    <ComboBoxItem Content="{loc:Str Jobs_FilterAnyLifecycle}" />
                    <ComboBoxItem Content="{loc:Str Jobs_FilterInProgress}" />
                    <ComboBoxItem Content="{loc:Str Jobs_FilterFinished}" />
                    <ComboBoxItem Content="{loc:Str Jobs_FilterFailed}" />
                    <ComboBoxItem Content="{loc:Str Jobs_FilterNotRun}" />
                  </ComboBox>
                </StackPanel>
              </Grid>
              <DockPanel DockPanel.Dock="Top" Margin="16,7,16,0">
                <Button x:Name="JobsResetFiltersButton"
                        DockPanel.Dock="Right"
                        Classes="subtle"
                        Content="{loc:Str Jobs_ClearFilters}"
                        Command="{Binding ResetFiltersCommand}"
                        IsVisible="{Binding HasActiveFilters}"
                        Padding="7,3"
                        MinHeight="0"
                        FontSize="10.5" />
                <TextBlock Text="{Binding JobCountDisplay}"
                           FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" />
              </DockPanel>
              <Grid>
                <ListBox x:Name="JobsList"
                         Classes="sidebar-list"
                         Margin="8,6,8,8"
                         ItemsSource="{Binding Jobs}"
                         SelectedItem="{Binding SelectedVisibleJob, Mode=TwoWay}"
                         SelectionMode="Single"
                         IsVisible="{Binding HasVisibleJobs}">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="models:BackgroundJob">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:BackgroundJob">
                      <Panel Background="Transparent"
                             PointerPressed="OnJobRowPointerPressed"
                             AutomationProperties.Name="{Binding Name}">
                        <Panel.ContextMenu>
                          <ContextMenu x:CompileBindings="False">
                            <MenuItem Header="{loc:Str Jobs_RunNow}"
                                      Command="{Binding $parent[Window].DataContext.JobsVM.RunNowCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Jobs_PauseAction}"
                                      Command="{Binding $parent[Window].DataContext.JobsVM.ToggleJobCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding IsEnabled}">
                              <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Jobs_EnableAction}"
                                      Command="{Binding $parent[Window].DataContext.JobsVM.ToggleJobCommand}"
                                      CommandParameter="{Binding}"
                                      IsVisible="{Binding !IsEnabled}">
                              <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Check}" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{loc:Str Menu_Delete}"
                                      Command="{Binding $parent[Window].DataContext.JobsVM.DeleteJobCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Panel.ContextMenu>
                        <StackPanel Spacing="4">
                          <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Classes="job-activation-toggle enabled"
                                    Command="{Binding $parent[Window].DataContext.JobsVM.ToggleJobCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding IsEnabled}"
                                    x:CompileBindings="False"
                                    ToolTip.Tip="{loc:Str Jobs_PauseAction}"
                                    AutomationProperties.Name="{Binding ActivationActionAutomationName}">
                              <StackPanel Orientation="Horizontal" Spacing="3">
                                <PathIcon Data="{StaticResource Icon.Check}" Width="10" Height="10"
                                          Foreground="{DynamicResource Brush.SuccessDefault}" />
                                <TextBlock Text="{loc:Str Jobs_StateEnabled}"
                                           Foreground="{DynamicResource Brush.SuccessDefault}" />
                              </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right"
                                    Classes="job-activation-toggle paused"
                                    Command="{Binding $parent[Window].DataContext.JobsVM.ToggleJobCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding !IsEnabled}"
                                    x:CompileBindings="False"
                                    ToolTip.Tip="{loc:Str Jobs_EnableAction}"
                                    AutomationProperties.Name="{Binding ActivationActionAutomationName}">
                              <StackPanel Orientation="Horizontal" Spacing="3">
                                <PathIcon Data="{StaticResource Icon.Pause}" Width="10" Height="10"
                                          Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Text="{loc:Str Jobs_StatePaused}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                              </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{DynamicResource Font.SizeBody}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </DockPanel>
                          <TextBlock Text="{Binding Description}"
                                     FontSize="{DynamicResource Font.SizeCaption}"
                                     Foreground="{DynamicResource Brush.TextTertiary}"
                                     TextTrimming="CharacterEllipsis"
                                     TextWrapping="NoWrap" />
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Border Classes="job-lifecycle-pill progress"
                                    IsVisible="{Binding IsLifecycleInProgress}">
                              <TextBlock Text="{Binding LifecycleDisplay}" />
                            </Border>
                            <Border Classes="job-lifecycle-pill completed"
                                    IsVisible="{Binding IsLifecycleCompleted}">
                              <TextBlock Text="{Binding LifecycleDisplay}" />
                            </Border>
                            <Border Classes="job-lifecycle-pill skipped"
                                    IsVisible="{Binding IsLifecycleSkipped}">
                              <TextBlock Text="{Binding LifecycleDisplay}" />
                            </Border>
                            <Border Classes="job-lifecycle-pill failed"
                                    IsVisible="{Binding IsLifecycleFailed}">
                              <TextBlock Text="{Binding LifecycleDisplay}" />
                            </Border>
                            <Border Classes="job-lifecycle-pill idle"
                                    IsVisible="{Binding IsLifecycleIdle}">
                              <TextBlock Text="{Binding LifecycleDisplay}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TriggerDisplay}"
                                       FontSize="{DynamicResource Font.SizeCaption}"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </Grid>
                          <TextBlock Text="{Binding UpcomingRunDisplay}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource Brush.TextTertiary}"
                                     TextTrimming="CharacterEllipsis"
                                     TextWrapping="NoWrap" />
                        </StackPanel>
                      </Panel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="20"
                            IsVisible="{Binding HasNoFilterResults}">
                  <TextBlock Text="{loc:Str Jobs_NoFilterResults}"
                             Classes="caption tertiary"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />
                  <Button Content="{loc:Str Jobs_ClearFilters}"
                          Classes="subtle"
                          Command="{Binding ResetFiltersCommand}"
                          Padding="10,5"
                          MinHeight="0" />
                </StackPanel>
              </Grid>
            </DockPanel>
          </Panel>

          <!-- ── 2: Projects sidebar (Customize → Projects) ── -->
          <Panel x:Name="SidebarProjects" IsVisible="False" DataContext="{Binding ProjectsVM}" x:DataType="vm:ProjectsViewModel">
            <Panel.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Project.axaml" />
                </ResourceDictionary.MergedDictionaries>
              </ResourceDictionary>
            </Panel.Resources>
            <DockPanel>
              <!-- Search and the section's action share one row; the Customize rows above already name the section. -->
              <DockPanel DockPanel.Dock="Top" Margin="16,6,12,4">
                <Button DockPanel.Dock="Right" Classes="subtle mg-side-action" Margin="4,0,0,0" VerticalAlignment="Center"
                        Command="{Binding NewProjectCommand}" ToolTip.Tip="{loc:Str Sidebar_NewProjectTooltip}">
                  <PathIcon Data="{StaticResource Icon.Plus}" />
                </Button>
                <Border Classes="project-switcher-search">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                              Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <Button DockPanel.Dock="Right" Classes="subtle mg-side-clear" Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearching}" ToolTip.Tip="{loc:Str Mg_ClearSearch}">
                      <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                    </Button>
                    <TextBox x:Name="ProjectsSidebarSearchBox" Classes="project-switcher-search-box"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="{loc:Str Projects_SearchPlaceholder}" />
                  </DockPanel>
                </Border>
              </DockPanel>
              <ListBox x:Name="ProjectsListBox" Classes="sidebar-list mg-side-list" Margin="8,4,8,8"
                       ItemsSource="{Binding Projects}"
                       SelectedItem="{Binding SelectedProject, Mode=OneWay}"
                       SelectionChanged="OnManagementListSelectionChanged"
                       SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Project">
                    <Panel Background="Transparent">
                      <Panel.ContextMenu>
                        <ContextMenu x:CompileBindings="False">
                          <MenuItem Header="{loc:Str Menu_Delete}"
                                    Command="{Binding $parent[Window].DataContext.ProjectsVM.DeleteProjectCommand}"
                                    CommandParameter="{Binding}">
                            <MenuItem.Icon>
                              <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Panel.ContextMenu>
                      <DockPanel>
                        <Border x:Name="ProjectChatCountBadge" DockPanel.Dock="Right" Classes="mg-side-count"
                                IsVisible="{Binding ChatCount}">
                          <TextBlock x:Name="ProjectChatCount" Text="{Binding ChatCount}" />
                        </Border>
                        <Panel DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                          <Border Classes="mg-side-tile">
                            <PathIcon Data="{StaticResource Icon.Folder}" />
                          </Border>
                          <Border x:Name="ProjectBusyIndicator"
                                  Width="8" Height="8" CornerRadius="4"
                                  Background="{DynamicResource Brush.AccentDefault}"
                                  BorderBrush="{DynamicResource Brush.Background}" BorderThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                  IsVisible="{Binding IsRunning}">
                            <Border.Styles>
                              <Style Selector="ListBoxItem:selected Border#ProjectBusyIndicator">
                                <Setter Property="IsVisible" Value="False" />
                              </Style>
                              <Style Selector="Border#ProjectBusyIndicator">
                                <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
                                <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.3" />
                                <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.2" />
                                <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
                                <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
                              </Style>
                            </Border.Styles>
                          </Border>
                        </Panel>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.SizeBody}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="mg-side-subtitle" Text="{Binding WorkingDirectory, FallbackValue=''}"
                                     IsVisible="{Binding WorkingDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Classes="mg-side-subtitle" Text="{loc:Str Projects_NoFolder}"
                                     IsVisible="{Binding WorkingDirectory, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </StackPanel>
                      </DockPanel>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Panel>

          <!-- ── 3: Skills sidebar ── -->
          <Panel x:Name="SidebarSkills" IsVisible="False" DataContext="{Binding SkillsVM}" x:DataType="vm:SkillsViewModel">
            <Panel.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Skill.axaml" />
                </ResourceDictionary.MergedDictionaries>
              </ResourceDictionary>
            </Panel.Resources>
            <DockPanel>
              <!-- Search and the section's actions share one row; the Customize rows above already name the section. -->
              <DockPanel DockPanel.Dock="Top" Margin="16,6,12,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1" Margin="4,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="ImportSkillsButton" Classes="subtle mg-side-action" AutomationProperties.Name="{loc:Str Import_Tooltip}"
                          Command="{Binding ImportCommand}" ToolTip.Tip="{loc:Str Import_Tooltip}">
                    <PathIcon Data="{StaticResource Icon.Import}" />
                  </Button>
                  <Button Classes="subtle mg-side-action"
                          Command="{Binding NewSkillCommand}" ToolTip.Tip="{loc:Str Sidebar_NewSkillTooltip}">
                    <PathIcon Data="{StaticResource Icon.Plus}" />
                  </Button>
                </StackPanel>
                <Border Classes="project-switcher-search">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                              Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <Button DockPanel.Dock="Right" Classes="subtle mg-side-clear" Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearching}" ToolTip.Tip="{loc:Str Mg_ClearSearch}">
                      <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                    </Button>
                    <TextBox x:Name="SkillsSidebarSearchBox" Classes="project-switcher-search-box"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="{loc:Str Skills_SearchPlaceholder}" />
                  </DockPanel>
                </Border>
              </DockPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,10">
                  <ListBox x:Name="SkillsListBox" Classes="sidebar-list mg-side-list" Margin="8,4,8,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ItemsSource="{Binding Skills}"
                           SelectedItem="{Binding SelectedSkill, Mode=OneWay}"
                           SelectionChanged="OnManagementListSelectionChanged"
                           SelectionMode="Single">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:Skill">
                        <Panel Background="Transparent">
                          <Panel.ContextMenu>
                            <ContextMenu x:CompileBindings="False">
                              <MenuItem Header="{loc:Str Menu_CopyForChat}"
                                        Command="{Binding $parent[Window].DataContext.SkillsVM.CopySkillForChatCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.CopyForChat}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="{loc:Str Menu_Share}"
                                        Command="{Binding $parent[Window].DataContext.SkillsVM.ShareSkillCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.Share}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="{loc:Str Menu_Delete}"
                                        Command="{Binding $parent[Window].DataContext.SkillsVM.DeleteSkillCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                            </ContextMenu>
                          </Panel.ContextMenu>
                          <DockPanel>
                            <Border DockPanel.Dock="Left" Classes="mg-side-tile" Margin="0,0,10,0">
                              <TextBlock Text="{Binding IconGlyph}" />
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.SizeBody}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="mg-side-subtitle" Text="{Binding Description}"
                                         IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </DockPanel>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Classes="library-section-head" IsVisible="{Binding External.HasGroups}">
                    <TextBlock Text="{loc:Str External_SidebarHeading}" />
                  </Border>
                  <ItemsControl x:Name="SkillsListBoxExternal" ItemsSource="{Binding External.Groups}" Margin="10,0"
                                ItemTemplate="{StaticResource ExternalSidebarGroupTemplate}" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>

          <!-- ── 4: Lumis sidebar ── -->
          <Panel x:Name="SidebarAgents" IsVisible="False" DataContext="{Binding AgentsVM}" x:DataType="vm:AgentsViewModel">
            <Panel.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Lumi.axaml" />
                </ResourceDictionary.MergedDictionaries>
              </ResourceDictionary>
            </Panel.Resources>
            <DockPanel>
              <!-- Search and the section's actions share one row; the Customize rows above already name the section. -->
              <DockPanel DockPanel.Dock="Top" Margin="16,6,12,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1" Margin="4,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="ImportLumisButton" Classes="subtle mg-side-action" AutomationProperties.Name="{loc:Str Import_Tooltip}"
                          Command="{Binding ImportCommand}" ToolTip.Tip="{loc:Str Import_Tooltip}">
                    <PathIcon Data="{StaticResource Icon.Import}" />
                  </Button>
                  <Button Classes="subtle mg-side-action"
                          Command="{Binding NewAgentCommand}" ToolTip.Tip="{loc:Str Sidebar_NewLumiTooltip}">
                    <PathIcon Data="{StaticResource Icon.Plus}" />
                  </Button>
                </StackPanel>
                <Border Classes="project-switcher-search">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                              Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <Button DockPanel.Dock="Right" Classes="subtle mg-side-clear" Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearching}" ToolTip.Tip="{loc:Str Mg_ClearSearch}">
                      <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                    </Button>
                    <TextBox x:Name="LumisSidebarSearchBox" Classes="project-switcher-search-box"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="{loc:Str Lumis_SearchPlaceholder}" />
                  </DockPanel>
                </Border>
              </DockPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,10">
                  <ListBox x:Name="LumisListBox" Classes="sidebar-list mg-side-list" Margin="8,4,8,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ItemsSource="{Binding Agents}"
                           SelectedItem="{Binding SelectedAgent, Mode=OneWay}"
                           SelectionChanged="OnManagementListSelectionChanged"
                           SelectionMode="Single">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:LumiAgent">
                        <Panel Background="Transparent">
                          <Panel.ContextMenu>
                            <ContextMenu x:CompileBindings="False">
                              <MenuItem Header="{loc:Str Menu_CopyForChat}"
                                        Command="{Binding $parent[Window].DataContext.AgentsVM.CopyAgentForChatCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.CopyForChat}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="{loc:Str Menu_Share}"
                                        Command="{Binding $parent[Window].DataContext.AgentsVM.ShareAgentCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.Share}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="{loc:Str Menu_Delete}"
                                        Command="{Binding $parent[Window].DataContext.AgentsVM.DeleteAgentCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                            </ContextMenu>
                          </Panel.ContextMenu>
                          <DockPanel>
                            <Border DockPanel.Dock="Left" Classes="mg-side-tile round" Margin="0,0,10,0">
                              <TextBlock Text="{Binding IconGlyph}" />
                            </Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.SizeBody}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="mg-side-subtitle" Text="{Binding Description}"
                                         IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </DockPanel>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Classes="library-section-head" IsVisible="{Binding External.HasGroups}">
                    <TextBlock Text="{loc:Str External_SidebarHeading}" />
                  </Border>
                  <ItemsControl x:Name="LumisListBoxExternal" ItemsSource="{Binding External.Groups}" Margin="10,0"
                                ItemTemplate="{StaticResource ExternalSidebarGroupTemplate}" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>

          <!-- ── 6: MCP Servers sidebar ── -->
          <Panel x:Name="SidebarMcpServers" IsVisible="False" DataContext="{Binding McpServersVM}" x:DataType="vm:McpServersViewModel">
            <Panel.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Mcp.axaml" />
                </ResourceDictionary.MergedDictionaries>
              </ResourceDictionary>
            </Panel.Resources>
            <DockPanel>
              <!-- Search and the section's actions share one row; the Customize rows above already name the section. -->
              <DockPanel DockPanel.Dock="Top" Margin="16,6,12,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1" Margin="4,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="ImportMcpServersButton" Classes="subtle mg-side-action" AutomationProperties.Name="{loc:Str Import_Tooltip}"
                          Command="{Binding ImportCommand}" ToolTip.Tip="{loc:Str Import_Tooltip}">
                    <PathIcon Data="{StaticResource Icon.Import}" />
                  </Button>
                  <Button Classes="subtle mg-side-action"
                          Command="{Binding NewServerCommand}" ToolTip.Tip="{loc:Str Sidebar_NewMcpServerTooltip}">
                    <PathIcon Data="{StaticResource Icon.Plus}" />
                  </Button>
                </StackPanel>
                <Border Classes="project-switcher-search">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                              Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <Button DockPanel.Dock="Right" Classes="subtle mg-side-clear" Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearching}" ToolTip.Tip="{loc:Str Mg_ClearSearch}">
                      <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                    </Button>
                    <TextBox x:Name="McpSidebarSearchBox" Classes="project-switcher-search-box"
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="{loc:Str Mcp_SearchPlaceholder}" />
                  </DockPanel>
                </Border>
              </DockPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,10">
                  <ListBox x:Name="McpServersListBox" Classes="sidebar-list mg-side-list" Margin="8,4,8,0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ItemsSource="{Binding Servers}"
                           SelectedItem="{Binding SelectedServer, Mode=OneWay}"
                           SelectionChanged="OnManagementListSelectionChanged"
                           SelectionMode="Single">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:McpServer">
                        <Panel Background="Transparent" Classes.mg-side-muted="{Binding !IsEnabled}">
                          <Panel.ContextMenu>
                            <ContextMenu x:CompileBindings="False">
                              <MenuItem Header="{loc:Str Menu_CopyForChat}"
                                        Command="{Binding $parent[Window].DataContext.McpServersVM.CopyServerForChatCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.CopyForChat}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="{loc:Str Menu_Share}"
                                        Command="{Binding $parent[Window].DataContext.McpServersVM.ShareServerCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.Share}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                              <MenuItem Header="{loc:Str Menu_Delete}"
                                        Command="{Binding $parent[Window].DataContext.McpServersVM.DeleteServerCommand}"
                                        CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                  <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                </MenuItem.Icon>
                              </MenuItem>
                            </ContextMenu>
                          </Panel.ContextMenu>
                          <DockPanel>
                            <Panel DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                              <Border Classes="mg-side-tile">
                                <PathIcon Data="{StaticResource Icon.Plug}" />
                              </Border>
                              <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                       Fill="{DynamicResource Brush.SuccessDefault}" Stroke="{DynamicResource Brush.Background}"
                                       StrokeThickness="1.5" IsVisible="{Binding IsEnabled}" />
                            </Panel>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font.SizeBody}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="mg-side-subtitle" Text="{Binding Description}"
                                         IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </DockPanel>
                        </Panel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Classes="library-section-head" IsVisible="{Binding External.HasGroups}">
                    <TextBlock Text="{loc:Str External_SidebarHeading}" />
                  </Border>
                  <ItemsControl x:Name="McpServersListBoxExternal" ItemsSource="{Binding External.Groups}" Margin="10,0"
                                ItemTemplate="{StaticResource ExternalSidebarGroupTemplate}" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>

          <!-- ── 9: Discover sidebar: what to browse, and where it comes from ── -->
          <Panel x:Name="SidebarDiscover" IsVisible="False" DataContext="{Binding DiscoverVM}" x:DataType="vm:DiscoverViewModel">
            <Panel.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Discover.axaml" />
                </ResourceDictionary.MergedDictionaries>
              </ResourceDictionary>
            </Panel.Resources>
            <DockPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,14">
                  <Border Classes="library-section-head" Margin="20,10,16,6">
                    <TextBlock Text="{loc:Str Discover_BrowseHeading}" />
                  </Border>
                  <StackPanel Margin="10,0" Spacing="1">
                    <Button x:Name="DiscoverFacetAll" AutomationProperties.Name="{loc:Str Discover_FacetAll}" Classes="library-facet" Classes.selected="{Binding IsAll}" Command="{Binding ShowAllCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <PathIcon Grid.Column="0" Classes="facet-icon" Data="{StaticResource Icon.Compass}" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Discover_FacetAll}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                    <Button x:Name="DiscoverFacetPlugins" AutomationProperties.Name="{loc:Str Discover_FacetPlugins}" Classes="library-facet" Classes.selected="{Binding IsPluginsFacet}" Command="{Binding ShowPluginsCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <PathIcon Grid.Column="0" Classes="facet-icon" Data="{StaticResource Icon.Puzzle}" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Discover_FacetPlugins}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding PluginCountText}" />
                      </Grid>
                    </Button>
                    <Button x:Name="DiscoverFacetServers" AutomationProperties.Name="{loc:Str Discover_FacetServers}" Classes="library-facet" Classes.selected="{Binding IsServersFacet}" Command="{Binding ShowServersCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <PathIcon Grid.Column="0" Classes="facet-icon" Data="{StaticResource Icon.Plug}" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Discover_FacetServers}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding ServerCountText}" />
                      </Grid>
                    </Button>
                    <Button x:Name="DiscoverFacetInstalled" AutomationProperties.Name="{loc:Str Discover_FacetInstalled}" Classes="library-facet" Classes.selected="{Binding IsInstalled}" Command="{Binding ShowInstalledCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <PathIcon Grid.Column="0" Classes="facet-icon" Data="{StaticResource Icon.Check}" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Discover_FacetInstalled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding InstalledCountText}" />
                      </Grid>
                    </Button>
                  </StackPanel>

                  <Border Classes="library-section-head">
                    <TextBlock Text="{loc:Str Discover_SourcesHeading}" />
                  </Border>
                  <ItemsControl x:Name="DiscoverSourceList" ItemsSource="{Binding SourceRows}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiscoverSourceRow">
                        <!-- No tooltip: rows are replaced when sources arrive, and Avalonia 12 crashes closing
                             a tooltip whose control has left the tree. Sources lists each one in full. -->
                        <Button Classes="library-facet" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}"
                                AutomationProperties.Name="{Binding Title}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Panel Grid.Column="0" VerticalAlignment="Center">
                              <PathIcon Classes="facet-icon" Data="{StaticResource Icon.Puzzle}" Width="13" Height="13" IsVisible="{Binding IsPluginSource}" />
                              <PathIcon Classes="facet-icon" Data="{StaticResource Icon.Plug}" Width="13" Height="13" IsVisible="{Binding !IsPluginSource}" />
                            </Panel>
                            <TextBlock Grid.Column="1" Classes="facet-label" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding CountText}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button x:Name="DiscoverFacetSources" AutomationProperties.Name="{loc:Str Discover_ManageSources}" Classes="library-facet" Margin="10,1,10,0"
                          Classes.selected="{Binding IsSources}" Command="{Binding ShowSourcesCommand}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <PathIcon Grid.Column="0" Classes="facet-icon" Data="{StaticResource Icon.Layers}" Width="13" Height="13" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="facet-label" Text="{loc:Str Discover_ManageSources}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>

          <!-- ── 6: Settings sidebar ── -->
          <!-- Search first, then you (profile, memories), the app, intelligence and connections, and
               data and Lumi itself, with a little air between the groups. Each row wears its page's
               hue, as Customize's rows do; the selection uses Lumi's accent. -->
          <Panel x:Name="SidebarSettings" IsVisible="False" DataContext="{Binding SettingsVM}" x:DataType="vm:SettingsViewModel">
            <Panel.Resources>
              <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                  <ResourceInclude Source="avares://Lumi/Views/Settings/SettingsResources.axaml" />
                </ResourceDictionary.MergedDictionaries>
              </ResourceDictionary>
            </Panel.Resources>
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="project-switcher-search" Margin="16,6,16,4">
                <DockPanel>
                  <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                            Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                  <Button DockPanel.Dock="Right" Classes="subtle mg-side-clear" Command="{Binding ClearSearchCommand}"
                          IsVisible="{Binding IsSearching}" ToolTip.Tip="{loc:Str Mg_ClearSearch}">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
                  </Button>
                  <TextBox x:Name="SettingsSearchBox" Classes="project-switcher-search-box"
                           Text="{Binding SearchQuery, Mode=TwoWay}"
                           PlaceholderText="{loc:Str Sidebar_SearchSettings}" />
                </DockPanel>
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <!-- Rows map to pages through SettingsSidebarPositionConverter: Memories sits under Profile
                     but is shown by its own page (nav 5), which keeps this sidebar. -->
                <ListBox x:Name="SettingsPagesList" Classes="sidebar-list settings-nav" Margin="10,6,10,8"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay, Converter={x:Static conv:SettingsSidebarPositionConverter.Instance}}"
                         SelectionMode="Single">
                  <ListBoxItem x:Name="SettingsProfileItem" Classes="settings-profile" AutomationProperties.Name="{loc:Str Settings_Profile}">
                    <!-- The page's name comes first in the tree, so the row reads as "Profile"; it draws under the user's name. -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="settings-nav-caption" Text="{loc:Str Settings_Profile}" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="settings-nav-name" Text="{Binding ProfileDisplayName}" />
                      <Border Grid.RowSpan="2" Classes="settings-nav-avatar">
                        <Panel>
                          <TextBlock Text="{Binding ProfileInitial}" IsVisible="{Binding HasProfileInitial}" />
                          <PathIcon Data="{StaticResource St.Icon.Profile}" IsVisible="{Binding !HasProfileInitial}" />
                        </Panel>
                      </Border>
                    </Grid>
                  </ListBoxItem>
                  <ListBoxItem x:Name="SettingsMemoriesItem">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.Memories}" Foreground="{DynamicResource St.Hue.Memories}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_Memories}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Classes="group-start">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.General}" Foreground="{DynamicResource St.Hue.General}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_General}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.Appearance}" Foreground="{DynamicResource St.Hue.Appearance}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_Appearance}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.Chat}" Foreground="{DynamicResource St.Hue.Chat}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_Chat}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem x:Name="SettingsPermissionsItem">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.Permissions}" Foreground="{DynamicResource St.Hue.Permissions}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_Permissions}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Classes="group-start">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.AI}" Foreground="{DynamicResource St.Hue.AI}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_AIModels}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.Mobile}" Foreground="{DynamicResource St.Hue.Mobile}" />
                      <TextBlock Grid.Column="1" Classes="settings-nav-label" Text="{loc:Str Settings_Mobile}" />
                      <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center"
                               Fill="{DynamicResource Brush.SuccessDefault}"
                               IsVisible="{Binding RemoteAccessEnabled}" />
                    </Grid>
                  </ListBoxItem>
                  <ListBoxItem Classes="group-start">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.Privacy}" Foreground="{DynamicResource St.Hue.Privacy}" />
                      <TextBlock Classes="settings-nav-label" Text="{loc:Str Settings_PrivacyData}" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <PathIcon Classes="settings-nav-icon" Data="{StaticResource St.Icon.About}" Foreground="{DynamicResource St.Hue.About}" />
                      <TextBlock Grid.Column="1" Classes="settings-nav-label" Text="{loc:Str Settings_About}" />
                      <Border Grid.Column="2"
                              IsVisible="{Binding ShouldShowUpdateBadge}"
                              Background="{DynamicResource Brush.AccentSubtle}"
                              CornerRadius="999"
                              Padding="8,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateSidebarBadgeText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.AccentDefault}" />
                      </Border>
                    </Grid>
                  </ListBoxItem>
                </ListBox>
              </ScrollViewer>
            </DockPanel>
          </Panel>

          <!-- ── 8: Library sidebar ── -->
          <Panel x:Name="SidebarLibrary" IsVisible="False" DataContext="{Binding LibraryVM}" x:DataType="vm:LibraryViewModel">
            <DockPanel>
              <!-- Named for what the column does, not for the page it belongs to: every control
                   below narrows the results, and the page header already says "Library". Undo
                   lives on the chips above the results, not here, so there is one place to look. -->
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                          Margin="20,10,16,4" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Filter}" Width="13" Height="13"
                          Foreground="{DynamicResource Brush.AccentDefault}" />
                <TextBlock Text="{loc:Str Library_FiltersHeading}" FontSize="{DynamicResource Font.SizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" />
              </StackPanel>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,14">
                  <Border Classes="library-section-head">
                    <TextBlock Text="{loc:Str Library_Filter_Collections}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Kinds}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LibraryFilterOption">
                        <Button Classes="library-facet"
                                Classes.selected="{Binding IsSelected}"
                                Classes.empty="{Binding !HasItems}"
                                Command="{Binding SelectCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <PathIcon Grid.Column="0" Classes="facet-icon" Data="{Binding Icon}"
                                      Width="14" Height="14"
                                      VerticalAlignment="Center" IsVisible="{Binding HasIcon}"
                                      Foreground="{Binding Accent}" />
                            <TextBlock Grid.Column="1" Classes="facet-label" Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding Count}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Classes="library-section-head">
                    <TextBlock Text="{loc:Str Library_Filter_Source}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Origins}" Margin="10,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LibraryFilterOption">
                        <Button Classes="library-facet"
                                Classes.selected="{Binding IsSelected}"
                                Classes.empty="{Binding !HasItems}"
                                Command="{Binding SelectCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <PathIcon Grid.Column="0" Classes="facet-icon" Data="{Binding Icon}"
                                      Width="14" Height="14"
                                      VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                            <TextBlock Grid.Column="1" Classes="facet-label" Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding Count}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Classes="library-section-head" IsVisible="{Binding HasProjectFilters}">
                    <TextBlock Text="{loc:Str Library_Filter_Projects}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Projects}" Margin="10,0"
                                IsVisible="{Binding HasProjectFilters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LibraryFilterOption">
                        <Button Classes="library-facet"
                                Classes.selected="{Binding IsSelected}"
                                Command="{Binding SelectCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <PathIcon Grid.Column="0" Classes="facet-icon"
                                      Data="{StaticResource Icon.Folder}" Width="13" Height="13"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="facet-label" Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Classes="facet-count" Text="{Binding Count}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Panel>

          </Panel><!-- end sidebar content wrapper -->
        </DockPanel>

        <Panel x:Name="SidebarNav" VerticalAlignment="Bottom">
          <!-- The active place wears its name; moving between places slides the label across. -->
          <Border x:Name="NavPillHost" Margin="12,4,12,12" ClipToBounds="False">
            <Panel x:Name="NavPillMaterial" HorizontalAlignment="Center">
              <sc:StrataBackdropBlur x:Name="NavPillFrost"
                                    CornerRadius="{Binding #NavPill.CornerRadius}"
                                    BlurRadius="10" Saturation="1.15" SamplesBeyondEdges="True" />
              <Border Classes="nav-pill" x:Name="NavPill"
                      Classes.motion-disabled="{Binding !SettingsVM.ShowAnimations}"
                      ClipToBounds="False">
                <StackPanel x:Name="NavRow" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                  <Button Classes="subtle nav-icon" x:Name="NavChat"
                          Command="{Binding SetNavCommand}" CommandParameter="0"
                          ToolTip.Tip="{loc:Str NavTip_Chats}">
                    <StackPanel Orientation="Horizontal">
                      <Panel>
                        <PathIcon Classes="nav-chat" Data="{StaticResource Icon.Chat}" />
                        <Border x:Name="NavChatUnreadBadge"
                                Classes="unread-nav-badge"
                                Margin="0,-5,-8,0"
                                IsVisible="{Binding HasUnreadChats}">
                          <TextBlock Text="{Binding UnreadBadgeText}" />
                        </Border>
                      </Panel>
                      <TextBlock Classes="nav-label" Text="{loc:Str NavLabel_Chats}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="subtle nav-icon" x:Name="NavLibrary"
                          Command="{Binding OpenLibraryCommand}"
                          ToolTip.Tip="{loc:Str NavTip_Library}">
                    <StackPanel Orientation="Horizontal">
                      <PathIcon Classes="nav-books" Data="{StaticResource Icon.Library}" />
                      <TextBlock Classes="nav-label" Text="{loc:Str NavLabel_Library}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="subtle nav-icon" x:Name="NavJobs"
                          Command="{Binding SetNavCommand}" CommandParameter="1"
                          ToolTip.Tip="{Binding JobsNavTip}">
                    <StackPanel Orientation="Horizontal">
                      <Panel>
                        <PathIcon Classes="nav-clock" Data="{StaticResource Icon.Clock}" />
                        <Border x:Name="NavJobsRunningDot" Classes="nav-live-dot" IsVisible="{Binding HasRunningJobs}" />
                      </Panel>
                      <TextBlock Classes="nav-label" Text="{loc:Str NavLabel_Jobs}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="subtle nav-icon" x:Name="NavCustomize"
                          Command="{Binding OpenCustomizeCommand}"
                          ToolTip.Tip="{loc:Str Customize_NavTip}">
                    <StackPanel Orientation="Horizontal">
                      <Panel Classes="nav-tune">
                        <PathIcon Data="{StaticResource Icon.CustomizeTracks}" />
                        <PathIcon Classes="nav-knob-left" Data="{StaticResource Icon.CustomizeKnobTop}" />
                        <PathIcon Classes="nav-knob-right" Data="{StaticResource Icon.CustomizeKnobBottom}" />
                      </Panel>
                      <TextBlock Classes="nav-label" Text="{loc:Str NavLabel_Customize}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="subtle nav-icon" x:Name="NavSettings"
                          Command="{Binding OpenSettingsCommand}"
                          ToolTip.Tip="{loc:Str NavTip_Settings}">
                    <StackPanel Orientation="Horizontal">
                      <Panel>
                        <PathIcon Classes="nav-gear" Data="{StaticResource Icon.Gear}" />
                        <Border x:Name="UpdateBadge" Classes="nav-live-dot"
                                IsVisible="{Binding SettingsVM.ShouldShowUpdateBadge}" />
                      </Panel>
                      <TextBlock Classes="nav-label" Text="{loc:Str NavLabel_Settings}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Panel>
          </Border>
        </Panel>
        </Panel>
      </Border>

      <primitives:Thumb x:Name="SidebarResizeThumb"
                        Classes="sidebar-resize"
                        DockPanel.Dock="Left"
                        Width="8"
                        Margin="0,0,-8,0"
                        Background="Transparent"
                        ZIndex="10"
                        IsTabStop="False" />

      <!-- ═══ CONTENT AREA (full height, inset for title bar) ═══ -->
      <Border x:Name="ContentArea" Margin="0,0,6,6" Padding="{StaticResource MainLayout.IslandOuterMargin}">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsGlobalUpdateBannerVisible}"
                Margin="0,0,0,12"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.AccentSubtle}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1"
                Padding="16,14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="8">
              <Border HorizontalAlignment="Left"
                      Background="{DynamicResource Brush.SurfaceCard}"
                      BorderBrush="{DynamicResource Brush.BorderSubtle}"
                      BorderThickness="1"
                      CornerRadius="999"
                      Padding="8,2">
                <TextBlock Text="{Binding SettingsVM.UpdateStatusBadgeText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.AccentDefault}" />
              </Border>
              <TextBlock Text="{Binding SettingsVM.UpdateHeroTitle}"
                         FontSize="{DynamicResource Font.SizeBody}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
              <TextBlock Text="{Binding SettingsVM.UpdateHeroDescription}"
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         Foreground="{DynamicResource Brush.TextSecondary}" />
              <StackPanel IsVisible="{Binding SettingsVM.IsUpdateDownloading}" Spacing="6">
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding SettingsVM.UpdateDownloadProgress}" />
                <TextBlock Text="{Binding SettingsVM.UpdateStatusText}"
                           FontSize="{DynamicResource Font.SizeCaption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
              <Button Classes="subtle"
                      Content="{loc:Str Update_ViewDetails}"
                      Padding="14,6"
                      MinHeight="0"
                      Command="{Binding OpenUpdateCenterCommand}" />
              <Button Classes="subtle"
                      Content="{loc:Str Update_DismissBanner}"
                      Padding="14,6"
                      MinHeight="0"
                      Command="{Binding SettingsVM.DismissUpdateBannerCommand}" />
              <Button Classes="accent"
                      Content="{loc:Str Update_Download}"
                      Padding="14,6"
                      MinHeight="0"
                      Command="{Binding SettingsVM.DownloadUpdateCommand}"
                      IsVisible="{Binding SettingsVM.IsUpdateAvailable}" />
              <Button Classes="accent"
                      Content="{loc:Str Update_Restart}"
                      Padding="14,6"
                      MinHeight="0"
                      Command="{Binding SettingsVM.ApplyUpdateAndRestartCommand}"
                      IsVisible="{Binding SettingsVM.IsUpdateReadyToRestart}" />
            </StackPanel>
          </Grid>
        </Border>

      <Grid>
        <views:ChatWorkspaceView x:Name="ChatContentGrid"
                                 DataContext="{Binding ChatVM}"
                                 ShowInternalTitle="True"
                                 UseChatIslandChrome="True" />

        <!-- ── Full-width pages with island treatment (visible when not on Chat tab) ── -->
        <Border x:Name="PageJobs" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageJobsHost" />
        </Border>
        <Border x:Name="PageProjects" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageProjectsHost" />
        </Border>
        <Border x:Name="PageSkills" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageSkillsHost" />
        </Border>
        <Border x:Name="PageAgents" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageAgentsHost" />
        </Border>
        <Border x:Name="PageMemories" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageMemoriesHost" />
        </Border>
        <Border x:Name="PageMcpServers" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageMcpServersHost" />
        </Border>
        <Border x:Name="PageSettings" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageSettingsHost" />
        </Border>
        <Border x:Name="PageLibrary" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageLibraryHost" />
        </Border>
        <Border x:Name="PageDiscover" IsVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.SurfaceCard}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000" ClipToBounds="True">
          <ContentControl x:Name="PageDiscoverHost" />
        </Border>

        <!-- "Copied for chat", and "a Lumi code is on your clipboard": centred over the page, just
             below its header row so the buttons that triggered it stay visible. -->
        <views:CapabilityNoticeView x:Name="CapabilityNotice"
                                    DataContext="{Binding NoticeVM}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="16,62,16,0"
                                    ZIndex="60" />

        <!-- Shown while a capability file is dragged over the Skills, Lumis or MCP pages. -->
        <Border x:Name="CapabilityDropOverlay"
                IsVisible="False"
                IsHitTestVisible="False"
                CornerRadius="{DynamicResource Radius.Overlay}"
                Background="{DynamicResource Brush.OverlayScrim}"
                ZIndex="50">
          <Border HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="22,16"
                  CornerRadius="16"
                  Background="{DynamicResource Brush.SurfaceOverlay}"
                  BorderBrush="{DynamicResource Brush.AccentDefault}"
                  BorderThickness="1.5">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{StaticResource Icon.Import}" Width="20" Height="20"
                        Foreground="{DynamicResource Brush.AccentDefault}" />
              <TextBlock Text="{loc:Str Import_DropOverlay}" FontSize="15" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
      </DockPanel>
      </Border>
    </DockPanel>

    <!-- ═══ Sidebar collapse / expand toggle (fixed top-left, below the title bar) ═══ -->
    <Button x:Name="SidebarToggleButton"
            Classes="subtle sidebar-toggle"
            Classes.collapsed="{Binding IsSidebarCollapsed}"
            Command="{Binding ToggleSidebarCommand}"
            IsVisible="{Binding IsOnboarded}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="14,42,0,0"
            Width="32" Height="30"
            MinWidth="0" MinHeight="0"
            Padding="0"
            CornerRadius="8"
            ZIndex="30"
            ToolTip.Tip="{Binding SidebarToggleTooltip}">
      <Panel x:Name="SidebarToggleGlyph" Width="18" Height="15">
        <Border x:Name="SidebarToggleFrame"
                BorderBrush="{DynamicResource Brush.TextSecondary}"
                BorderThickness="1.6"
                CornerRadius="4.5" />
        <Border x:Name="SidebarTogglePanel"
                Width="5"
                HorizontalAlignment="Left"
                Margin="1.6"
                CornerRadius="2.5,0,0,2.5"
                Background="{DynamicResource Brush.TextSecondary}" />
      </Panel>
    </Button>

    <!-- ═══ Collapsed icon rail: quick nav shown in place of the hidden sidebar ═══ -->
    <StackPanel x:Name="SidebarRail"
                TextOptions.TextRenderingMode="Antialias"
                Classes.motion-disabled="{Binding !SettingsVM.ShowAnimations}"
                Orientation="Vertical"
                Spacing="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="13,84,0,0"
                IsVisible="{Binding ShowSidebarRail}"
                ZIndex="29">
      <Button Classes="subtle rail-nav-icon" x:Name="RailChat"
              Command="{Binding SetNavCommand}" CommandParameter="0"
              ToolTip.Tip="{loc:Str NavTip_Chats}">
        <Panel>
          <PathIcon Classes="nav-chat" Data="{StaticResource Icon.Chat}" Width="17" Height="17" />
          <Border x:Name="RailChatUnreadBadge"
                  Classes="unread-nav-badge"
                  Margin="0,-4,-6,0"
                  IsVisible="{Binding HasUnreadChats}">
            <TextBlock Text="{Binding UnreadBadgeText}" />
          </Border>
        </Panel>
      </Button>
      <Button Classes="subtle rail-nav-icon" x:Name="RailLibrary"
              Command="{Binding OpenLibraryCommand}"
              ToolTip.Tip="{loc:Str NavTip_Library}">
        <PathIcon Classes="nav-books" Data="{StaticResource Icon.Library}" Width="17" Height="17" />
      </Button>
      <Button Classes="subtle rail-nav-icon" x:Name="RailJobs"
              Command="{Binding SetNavCommand}" CommandParameter="1"
              ToolTip.Tip="{Binding JobsNavTip}">
        <Panel>
          <PathIcon Classes="nav-clock" Data="{StaticResource Icon.Clock}" Width="17" Height="17" />
          <Border Classes="nav-live-dot" IsVisible="{Binding HasRunningJobs}" />
        </Panel>
      </Button>
      <Button Classes="subtle rail-nav-icon" x:Name="RailCustomize"
              Command="{Binding OpenCustomizeCommand}"
              ToolTip.Tip="{loc:Str Customize_NavTip}">
        <Panel Classes="nav-tune">
          <PathIcon Data="{StaticResource Icon.CustomizeTracks}" Width="17" Height="17" />
          <PathIcon Classes="nav-knob-left" Data="{StaticResource Icon.CustomizeKnobTop}" Width="17" Height="17" />
          <PathIcon Classes="nav-knob-right" Data="{StaticResource Icon.CustomizeKnobBottom}" Width="17" Height="17" />
        </Panel>
      </Button>
      <Button Classes="subtle rail-nav-icon" x:Name="RailSettings"
              Command="{Binding OpenSettingsCommand}"
              ToolTip.Tip="{loc:Str NavTip_Settings}">
        <Panel>
          <PathIcon Classes="nav-gear" Data="{StaticResource Icon.Gear}" Width="17" Height="17" />
          <Border Classes="nav-live-dot" IsVisible="{Binding SettingsVM.ShouldShowUpdateBadge}" />
        </Panel>
      </Button>
    </StackPanel>
    <Border x:Name="AgentDebugMap"
            IsVisible="{Binding IsAgentDebugMapVisible}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,42,16,0"
            MaxWidth="430"
            Padding="10,8"
            CornerRadius="12"
            Background="#E8111726"
            BorderBrush="#46546E"
            BorderThickness="1"
            ZIndex="20">
      <StackPanel Spacing="6">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="4">
            <Button x:Name="AgentDebugDismissButton"
                    Classes="subtle"
                    Command="{Binding DismissAgentDebugMapCommand}"
                    ToolTip.Tip="Dismiss debug map"
                    AutomationProperties.Name="Dismiss debug map"
                    AutomationProperties.HelpText="Hides the debug-only agent map for this window."
                    Padding="5"
                    MinHeight="0"
                    MinWidth="0">
              <PathIcon Data="{StaticResource Icon.Dismiss}"
                        Width="12"
                        Height="12"
                        Foreground="#FFFFFFFF" />
            </Button>
            <Button Classes="accent"
                    Content="Open fixture"
                    Command="{Binding OpenAgentDebugHarnessCommand}"
                    Padding="8,4"
                    MinHeight="0"
                    FontSize="11" />
            <Button Name="BgShellFixtureButton"
                    Content="Bg shell"
                    Command="{Binding OpenBackgroundShellHarnessCommand}"
                    ToolTip.Tip="Reproduce the honest 'running in background' state"
                    Padding="8,4"
                    MinHeight="0"
                    FontSize="11" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Agent debug map"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" />
            <TextBlock Text="{Binding AgentDebugCurrentPage}"
                       FontFamily="Consolas, Cascadia Code, monospace"
                       FontSize="10.5"
                       Foreground="#FFBFD0EA" />
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding AgentDebugMapText}"
                   TextWrapping="Wrap"
                   FontFamily="Consolas, Cascadia Code, monospace"
                   FontSize="10"
                   Foreground="#FFDDE7F7" />
      </StackPanel>
    </Border>

    <!-- ═══ Onboarding Overlay ═══ -->
    <Panel x:Name="OnboardingPanel" IsVisible="True">
      <Grid RowDefinitions="38,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,144">
          <Border x:Name="OnboardingDragStrip"
                  Grid.Column="0"
                  Background="Transparent"
                  PointerPressed="OnOnboardingDragStripPointerPressed" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceCard}" />
        <ContentControl Grid.Row="1"
                        x:Name="OnboardingHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        DataContext="{Binding OnboardingVM}" />
      </Grid>
    </Panel>

    <!-- ═══ Search Overlay (Command Palette) ═══ -->
    <views:SearchOverlay x:Name="SearchOverlay"
                         DataContext="{Binding SearchOverlayVM}" />

    <!-- ═══ Chat Tags Dialog ═══ -->
    <sc:StrataDialog x:Name="ChatTagsDialog"
                     Title="{loc:Str ChatTags_DialogTitle}"
                     IsDialogOpen="{Binding ChatTagsVM.IsDialogOpen}"
                     CloseCommand="{Binding ChatTagsVM.CloseManagerCommand}"
                     MaxDialogWidth="700"
                     ZIndex="200">
      <sc:StrataDialog.DialogContent>
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="200,1,*" ColumnSpacing="18" MinHeight="280">
            <StackPanel Grid.Column="0" Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Str ChatTags_ListTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="AddChatTagButton"
                        Grid.Column="1"
                        Classes="subtle motion-action"
                        Command="{Binding ChatTagsVM.NewTagCommand}"
                        Padding="9,5"
                        MinHeight="0"
                        ToolTip.Tip="{loc:Str ChatTags_Add}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource Icon.Plus}" Width="11" Height="11" />
                    <TextBlock Text="{loc:Str ChatTags_Add}" FontSize="11" FontWeight="Medium" />
                  </StackPanel>
                </Button>
              </Grid>

              <Border Background="{DynamicResource Brush.Surface1}"
                      BorderBrush="{DynamicResource Brush.BorderSubtle}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource Radius.Base}"
                      MinHeight="230">
                <Grid>
                  <ListBox x:Name="ChatTagsList"
                           Classes="sidebar-list"
                           ItemsSource="{Binding ChatTagsVM.Tags}"
                           SelectedItem="{Binding ChatTagsVM.SelectedTag, Mode=TwoWay}"
                           Background="Transparent"
                           BorderThickness="0"
                           Margin="4">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ChatTag">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="9" Height="9" CornerRadius="4.5"
                                  VerticalAlignment="Center"
                                  Background="{Binding Color, Converter={StaticResource ChatTagBrush}}" />
                          <TextBlock Text="{Binding Name}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{loc:Str ChatTags_Empty}"
                             IsVisible="{Binding ChatTagsVM.HasNoTags}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                </Grid>
              </Border>
            </StackPanel>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.BorderSubtle}" />

            <StackPanel Grid.Column="2"
                        Spacing="12"
                        IsVisible="{Binding ChatTagsVM.IsEditorVisible}">
              <TextBlock Text="{Binding ChatTagsVM.EditorTitle}"
                         FontSize="{DynamicResource Font.SizeBody}"
                         FontWeight="SemiBold" />

              <StackPanel Spacing="5">
                <TextBlock Text="{loc:Str ChatTags_Name}"
                           FontSize="{DynamicResource Font.SizeCaption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBox x:Name="ChatTagNameTextBox"
                         Text="{Binding ChatTagsVM.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="32" />
              </StackPanel>

              <StackPanel Spacing="5">
                <TextBlock Text="{loc:Str ChatTags_Color}"
                           FontSize="{DynamicResource Font.SizeCaption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ListBox x:Name="ChatTagColorPicker"
                         ItemsSource="{Binding ChatTagsVM.ColorOptions}"
                         SelectedItem="{Binding ChatTagsVM.SelectedColorOption, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         HorizontalAlignment="Left">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatTagColorOption">
                      <Border Width="26" Height="26"
                              CornerRadius="13"
                              Background="{Binding Hex, Converter={StaticResource ChatTagBrush}}"
                              ToolTip.Tip="{Binding Hex}"
                              AutomationProperties.Name="{Binding Hex}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <StackPanel Spacing="5">
                <TextBlock Text="{loc:Str ChatTags_Preview}"
                           FontSize="{DynamicResource Font.SizeCaption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <Border HorizontalAlignment="Left"
                        MaxWidth="180"
                        Padding="9,4,11,4"
                        CornerRadius="{DynamicResource Radius.Full}"
                        Background="{Binding ChatTagsVM.SelectedColorOption.Hex, Converter={StaticResource ChatTagBrush}, ConverterParameter=subtle}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Width="7" Height="7" CornerRadius="3.5"
                            VerticalAlignment="Center"
                            Background="{Binding ChatTagsVM.SelectedColorOption.Hex, Converter={StaticResource ChatTagBrush}}" />
                    <TextBlock Text="{Binding ChatTagsVM.EditName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <TextBlock Text="{Binding ChatTagsVM.ValidationMessage}"
                         IsVisible="{Binding ChatTagsVM.ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource Brush.DangerDefault}"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         TextWrapping="Wrap" />

              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                <Button x:Name="DeleteChatTagButton"
                        Classes="subtle motion-action"
                        Content="{loc:Str ChatTags_Delete}"
                        Command="{Binding ChatTagsVM.DeleteTagCommand}"
                        IsVisible="{Binding ChatTagsVM.CanDeleteSelectedTag}"
                        Padding="12,7"
                        MinHeight="0" />
                <Button x:Name="SaveChatTagButton"
                        Grid.Column="2"
                        Classes="accent motion-action"
                        Content="{loc:Str Common_Save}"
                        Command="{Binding ChatTagsVM.SaveTagCommand}"
                        Padding="16,7"
                        MinHeight="0" />
              </Grid>
            </StackPanel>
          </Grid>

          <Button x:Name="CloseChatTagsButton"
                  Classes="subtle motion-action"
                  Content="{loc:Str ChatTags_Done}"
                  Command="{Binding ChatTagsVM.CloseManagerCommand}"
                  HorizontalAlignment="Right"
                  Padding="16,7"
                  MinHeight="0" />
        </StackPanel>
      </sc:StrataDialog.DialogContent>
    </sc:StrataDialog>

    <!-- ═══ Capability sharing: share and import sheets ═══ -->
    <views:ShareSheetView x:Name="ShareSheet"
                          DataContext="{Binding ShareVM}"
                          ZIndex="200" />
    <views:ImportSheetView x:Name="ImportSheet"
                           DataContext="{Binding ImportVM}"
                           ZIndex="200" />

    <!-- ═══ Rename Dialog Overlay ═══ -->
    <Panel x:Name="RenameOverlay" IsVisible="False">
      <Border Background="#40000000" />
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              Classes="strata-dialog" Padding="24,20" MinWidth="320" MaxWidth="400">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Str Dialog_RenameChat}" FontSize="{DynamicResource Font.SizeBody}" FontWeight="SemiBold" />
          <TextBox x:Name="RenameTextBox"
                   Text="{Binding RenamingTitle, Mode=TwoWay}"
                   PlaceholderText="{loc:Str Dialog_ChatTitle}" FontSize="{DynamicResource Font.SizeBody}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="subtle" Content="{loc:Str Common_Cancel}" Padding="14,6" MinHeight="0"
                    Command="{Binding CancelRenameChatCommand}" />
            <Button Classes="accent" Content="{loc:Str Common_Rename}" Padding="14,6" MinHeight="0"
                    Command="{Binding CommitRenameChatCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- ═══ Worktree Delete Confirmation Dialog ═══ -->
    <Panel IsVisible="{Binding IsWorktreeDeleteDialogOpen}">
      <Border Background="#40000000" />
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              Classes="strata-dialog" Padding="24,20" MinWidth="320" MaxWidth="420">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:Str Dialog_DeleteWorktreeTitle}" FontSize="{DynamicResource Font.SizeBody}" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Str Dialog_DeleteWorktreeMessage}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{DynamicResource Font.SizeCaption}" />
          <StackPanel Spacing="8">
            <Button Classes="accent motion-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{loc:Str Dialog_DeleteWithWorktree}" Padding="14,8" MinHeight="0"
                    Command="{Binding ConfirmDeleteWithWorktreeCommand}" />
            <Button Classes="subtle motion-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{loc:Str Dialog_DeleteKeepWorktree}" Padding="14,8" MinHeight="0"
                    Command="{Binding ConfirmDeleteWithoutWorktreeCommand}" />
            <Button Classes="subtle motion-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{loc:Str Common_Cancel}" Padding="14,8" MinHeight="0"
                    Command="{Binding CancelDeleteWorktreeDialogCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <sc:StrataDialog x:Name="DevTunnelInstallDialog"
                     Title="{loc:Str Remote_DevTunnelInstallTitle}"
                     IsDialogOpen="{Binding SettingsVM.IsDevTunnelInstallDialogOpen}"
                     CloseCommand="{Binding SettingsVM.CancelDevTunnelInstallCommand}"
                     PropertyChanged="OnDevTunnelInstallDialogPropertyChanged"
                     MaxDialogWidth="500"
                     ZIndex="210">
      <sc:StrataDialog.DialogContent>
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:Str Remote_DevTunnelInstallDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
          <Border Background="{DynamicResource Brush.Surface2}"
                  CornerRadius="{DynamicResource Radius.Interactive}" Padding="12">
            <TextBlock Text="{loc:Str Remote_DevTunnelInstallLocation}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button x:Name="DevTunnelInstallCancelButton"
                    Classes="subtle"
                    Content="{loc:Str Common_Cancel}"
                    Command="{Binding SettingsVM.CancelDevTunnelInstallCommand}"
                    IsCancel="True"
                    MinHeight="48" HorizontalContentAlignment="Center" />
            <Button x:Name="DevTunnelInstallContinueButton" Grid.Column="1"
                    Classes="accent"
                    Content="{loc:Str Remote_DevTunnelInstallContinue}"
                    Command="{Binding SettingsVM.ApproveDevTunnelInstallCommand}"
                    MinHeight="48" HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
      </sc:StrataDialog.DialogContent>
    </sc:StrataDialog>

    <!-- ═══ Update Blocker Dialog ═══ -->
    <sc:StrataDialog x:Name="UpdateBlockerDialog"
                     Title="{loc:Str Update_BlockersTitle}"
                     IsDialogOpen="{Binding SettingsVM.IsUpdateBlockerDialogOpen}"
                     CloseCommand="{Binding SettingsVM.CancelUpdateRestartCommand}"
                     MaxDialogWidth="540"
                     ZIndex="200">
      <sc:StrataDialog.DialogContent>
        <StackPanel Spacing="16">
          <Border Width="48"
                  Height="48"
                  CornerRadius="24"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource Brush.AccentSubtle}">
            <TextBlock Text="!"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.AccentDefault}" />
          </Border>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SettingsVM.UpdateBlockerDialogDescription}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="{DynamicResource Font.SizeBody}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />
            <TextBlock Text="{loc:Str Update_BlockersWarning}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
          </StackPanel>

          <ScrollViewer MaxHeight="220"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SettingsVM.UpdateBlockingProcesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:UpdateBlockingProcess">
                  <Border Margin="0,0,0,6"
                          Padding="12,10"
                          CornerRadius="{DynamicResource Radius.Base}"
                          Background="{DynamicResource Brush.SurfaceSubtle}"
                          BorderBrush="{DynamicResource Brush.BorderSubtle}"
                          BorderThickness="1"
                          ToolTip.Tip="{Binding ExecutablePath}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding DisplayName}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.TextPrimary}" />
                      <TextBlock Text="{Binding ProcessDetails}"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 Foreground="{DynamicResource Brush.TextTertiary}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border IsVisible="{Binding SettingsVM.UpdateBlockerErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Padding="12"
                  CornerRadius="{DynamicResource Radius.Base}"
                  Background="{DynamicResource Brush.DangerSubtle}">
            <TextBlock Text="{Binding SettingsVM.UpdateBlockerErrorText}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource Font.SizeCaption}"
                       Foreground="{DynamicResource Brush.DangerDefault}" />
          </Border>

          <StackPanel Spacing="8">
            <Button Classes="accent motion-action"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{loc:Str Update_CloseAppsAndRestart}"
                    Command="{Binding SettingsVM.CloseUpdateBlockersAndRestartCommand}"
                    IsEnabled="{Binding SettingsVM.CanCloseAnyUpdateBlocker}"
                    Padding="14,8"
                    MinHeight="0" />
            <Button Classes="subtle motion-action"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{loc:Str Update_RetryRestart}"
                    Command="{Binding SettingsVM.RetryUpdateRestartCommand}"
                    Padding="14,8"
                    MinHeight="0" />
            <Button Classes="subtle motion-action"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{loc:Str Update_CancelRestart}"
                    Command="{Binding SettingsVM.CancelUpdateRestartCommand}"
                    Padding="14,8"
                    MinHeight="0" />
          </StackPanel>
        </StackPanel>
      </sc:StrataDialog.DialogContent>
    </sc:StrataDialog>

    <!-- ═══ Add or manage an AI account (shared by Settings and onboarding) ═══ -->
    <sc:StrataDialog x:Name="EasyConnectDialog"
                     Title="{Binding SettingsVM.EasyConnect.DialogTitle}"
                     IsDialogOpen="{Binding SettingsVM.EasyConnect.IsDialogOpen, Mode=TwoWay}"
                     CloseCommand="{Binding SettingsVM.EasyConnect.CloseDialogCommand}"
                     MaxDialogWidth="680"
                     ZIndex="205">
      <sc:StrataDialog.DialogContent>
        <ctrl:EasyConnectDialogView DataContext="{Binding SettingsVM.EasyConnect}" />
      </sc:StrataDialog.DialogContent>
      <sc:StrataDialog.DialogFooter>
        <ctrl:EasyConnectDialogFooter DataContext="{Binding SettingsVM.EasyConnect}" />
      </sc:StrataDialog.DialogFooter>
    </sc:StrataDialog>
    <!-- ═══ Duplicating-chat status pill ═══
         Duplicating is usually fast enough to feel instant, so MainViewModel only raises
         IsDuplicatingChat after a short delay: below that threshold this never appears (a pill that
         flashes for 200ms reads as a glitch), above it the app visibly says it is working instead of
         looking frozen. Non-modal and hit-invisible — it reports progress, it does not block.
         StrataTypingIndicator is already a labelled pill, so it is used directly rather than wrapped
         in a second one; a shadow host floats it above the content it overlays. -->
    <Border x:Name="DuplicatingChatPill"
            IsVisible="{Binding IsDuplicatingChat}"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,52,0,0"
            CornerRadius="999"
            BoxShadow="0 0 24 0 #1A000000, 0 0 4 0 #08000000">
      <sc:StrataTypingIndicator IsActive="True"
                                Margin="0"
                                Label="{loc:Str Chat_Duplicating}" />
    </Border>
  </Panel>
  </Border>
  </LayoutTransformControl>
</Window>
