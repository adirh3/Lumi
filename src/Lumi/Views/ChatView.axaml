<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:sa="using:StrataTheme.Animation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:Lumi.Models"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:views="using:Lumi.Views"
             xmlns:services="using:Lumi.Services"
             xmlns:conv="using:Lumi.Converters"
             xmlns:lc="using:Lumi.Views.Controls"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:st="using:StrataTheme"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             x:CompileBindings="True">

  <UserControl.Resources>
    <conv:ModelDisplayConverter x:Key="ModelDisplayConverter" />
    <conv:ChartBrushConverter x:Key="ChartBrush" />
    <!-- Shared reading-column width: the transcript and composer both cap at this
         and center, so on large/maximized windows content stays a balanced column
         instead of clinging to the edges. On narrow windows it grows to full width. -->
    <x:Double x:Key="Chat.ReadingColumnWidth">900</x:Double>
    <x:Double x:Key="Chat.ToolGroupContentMaxHeight">420</x:Double>
    <!-- Pause and play, filled and rounded like the composer's stop mark: two capsules, a soft triangle. -->
    <StreamGeometry x:Key="Chat.Icon.Pause">M6.75 7.25a1.75 1.75 0 0 1 3.5 0v9.5a1.75 1.75 0 0 1-3.5 0zM13.75 7.25a1.75 1.75 0 0 1 3.5 0v9.5a1.75 1.75 0 0 1-3.5 0z</StreamGeometry>
    <StreamGeometry x:Key="Chat.Icon.Play">M8 6.6v10.8a1.2 1.2 0 0 0 1.82 1.03l8.9-5.4a1.2 1.2 0 0 0 0-2.06l-8.9-5.4A1.2 1.2 0 0 0 8 6.6z</StreamGeometry>
    <!-- Code: angle brackets around a slash, in the line icons' family. -->
    <StreamGeometry x:Key="Chat.Icon.Code">M8.5 7.5 4 12l4.5 4.5 M15.5 7.5 20 12l-4.5 4.5 M13.5 5.5l-3 13</StreamGeometry>

    <!-- Launchpad glass: a lift of the island's own surface, translucent so Lumi's presence glows through -->
    <SolidColorBrush x:Key="Launchpad.CardFill" Color="{DynamicResource Color.Surface2}" Opacity="0.46" />
    <SolidColorBrush x:Key="Launchpad.CardFillHover" Color="{DynamicResource Color.Surface2}" Opacity="0.86" />

    <!-- Floating header glass. Pills lift the overlay surface over their own frost; the edge veil
         takes the island's colour so scrolled history fades out beneath the header. -->
    <SolidColorBrush x:Key="ChatHeader.PillFill" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.66" />
    <SolidColorBrush x:Key="ChatHeader.PillFillHover" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.88" />
    <SolidColorBrush x:Key="ChatHeader.PillFillPressed" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.96" />
    <SolidColorBrush x:Key="ChatHeader.PillBorder" Color="{DynamicResource Color.TextPrimary}" Opacity="0.10" />
    <SolidColorBrush x:Key="ChatHeader.EdgeVeil" Color="{DynamicResource Color.Surface1}" Opacity="0.9" />
    <SolidColorBrush x:Key="ChatHeader.MenuFill" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.8" />
    <SolidColorBrush x:Key="ChatHeader.MenuDivider" Color="{DynamicResource Color.TextPrimary}" Opacity="0.08" />
    <SolidColorBrush x:Key="ChatHeader.MenuChipFill" Color="{DynamicResource Color.TextPrimary}" Opacity="0.07" />
    <SolidColorBrush x:Key="ChatHeader.MenuItemHover" Color="{DynamicResource Color.TextPrimary}" Opacity="0.07" />
    <SolidColorBrush x:Key="ChatHeader.MenuItemPressed" Color="{DynamicResource Color.TextPrimary}" Opacity="0.11" />
    <SolidColorBrush x:Key="ChatHeader.MenuDangerHover" Color="{DynamicResource Color.DangerDefault}" Opacity="0.12" />
    <!-- Voice typing cards sit a shade off the composer's glass. -->
    <SolidColorBrush x:Key="Voice.CardFill" Color="{DynamicResource Color.TextPrimary}" Opacity="0.04" />

    <!-- Follow-up chips wear the header pills' glass; hovering tints the rim with the accent. The glyph
         is a turn-down-right arrow on a 14px grid, stroked rather than filled. -->
    <SolidColorBrush x:Key="FollowUp.RimHover" Color="{DynamicResource Color.AccentDefault}" Opacity="0.5" />
    <StreamGeometry x:Key="FollowUp.Glyph">M3 1.5V5.5A3.5 3.5 0 0 0 6.5 9H12M9 6L12 9L9 12</StreamGeometry>

    <!-- The title menu: who the chat is and what it holds, above its actions, on the header's glass. -->
    <ControlTheme x:Key="ChatTitleMenuPresenter" TargetType="MenuFlyoutPresenter"
                  BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
      <!-- Widths include the 16px shadow margin on each side: the card itself is 332–360 wide. -->
      <Setter Property="MinWidth" Value="364" />
      <Setter Property="MaxWidth" Value="392" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Margin="16" TextOptions.TextRenderingMode="Antialias">
            <sc:StrataBackdropBlur CornerRadius="{TemplateBinding CornerRadius}" BlurRadius="28" Saturation="1.5" />
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    BoxShadow="0 18 44 -10 #59000000, 0 6 16 0 #24000000, inset 0 1 0 0 #0FFFFFFF">
              <DockPanel>
                <StackPanel x:Name="ChatTitleMenuFacts" DockPanel.Dock="Top" x:DataType="vm:ChatViewModel"
                            Margin="10,10,10,12">
                  <StackPanel.Styles>
                    <Style Selector="Border.title-menu-chip">
                      <Setter Property="Height" Value="24" />
                      <Setter Property="Padding" Value="7,0,9,0" />
                      <Setter Property="CornerRadius" Value="12" />
                      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuChipFill}" />
                    </Style>
                    <Style Selector="Border.title-menu-chip TextBlock">
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="MaxWidth" Value="220" />
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                    <Style Selector="Border.title-menu-chip PathIcon">
                      <Setter Property="Width" Value="12" />
                      <Setter Property="Height" Value="12" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </StackPanel.Styles>
                  <TextBlock Text="{Binding CurrentChatTitle}" FontSize="14.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,10,0,0">
                    <Border Classes="title-menu-chip"
                            IsVisible="{Binding ProjectBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- A chat with a project takes its mark's hue from the project. -->
                        <PathIcon x:DataType="vm:ChatHeaderMark" DataContext="{Binding HeaderMark}"
                                  Foreground="{Binding Foreground}" Data="{DynamicResource Icon.Folder}" />
                        <TextBlock Text="{Binding ProjectBadgeText}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="title-menu-chip"
                            IsVisible="{Binding AgentBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedAgentGlyph}" FontSize="11" />
                        <TextBlock Text="{Binding AgentBadgeText}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="title-menu-chip"
                            IsVisible="{Binding HeaderModelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="10" Height="10" Foreground="{DynamicResource Brush.AccentDefault}"
                                  Data="M8,1 L10,6 L15,8 L10,10 L8,15 L6,10 L1,8 L6,6 Z" />
                        <TextBlock Text="{Binding HeaderModelText}" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding HeaderDetailsText}" Margin="0,9,0,0" FontSize="11.5"
                             Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HeaderDetailsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,6"
                        Background="{StaticResource ChatHeader.MenuDivider}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              MaxHeight="420">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- Title menu rows: airy, with quiet icons, a check for the current choice and glass submenus. -->
    <ControlTheme x:Key="ChatTitleMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="PART_LayoutRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    MinHeight="{TemplateBinding MinHeight}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Name="PART_IconPresenter"
                                  Content="{TemplateBinding Icon}"
                                  Width="16"
                                  Margin="0,0,12,0"
                                  Foreground="{DynamicResource Brush.TextSecondary}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ContentPresenter Name="PART_HeaderPresenter"
                                  Grid.Column="1"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <PathIcon Name="PART_Chevron"
                          Grid.Column="2"
                          Width="10"
                          Height="10"
                          Margin="12,0,0,0"
                          IsVisible="False"
                          Foreground="{DynamicResource Brush.TextTertiary}"
                          Data="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6z" />
                <PathIcon Name="PART_Check"
                          Grid.Column="2"
                          Width="12"
                          Height="12"
                          Margin="12,0,0,0"
                          IsVisible="False"
                          Foreground="{DynamicResource Brush.AccentDefault}"
                          Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </Grid>
            </Border>

            <!-- The popup already places its child's card, margin aside, at these offsets: just past
                 the menu's edge, with the first row level with this one. -->
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   Placement="RightEdgeAlignedTop"
                   HorizontalOffset="10"
                   VerticalOffset="-7"
                   IsLightDismissEnabled="False"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   st:PopupAnimationHelper.EnableOverlayAnimation="True">
              <Panel Margin="16" MinWidth="200" MaxWidth="300" TextOptions.TextRenderingMode="Antialias">
                <sc:StrataBackdropBlur CornerRadius="14" BlurRadius="28" Saturation="1.5" />
                <Border Background="{StaticResource ChatHeader.MenuFill}"
                        BorderBrush="{StaticResource ChatHeader.PillBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="6"
                        BoxShadow="0 18 44 -10 #59000000, 0 6 16 0 #24000000, inset 0 1 0 0 #0FFFFFFF">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                MaxHeight="420">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                </Border>
              </Panel>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:not(:empty) /template/ PathIcon#PART_Chevron">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked /template/ PathIcon#PART_Check">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemHover}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemHover}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemPressed}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
      <Style Selector="^.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
      </Style>
      <Style Selector="^.danger /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
      </Style>
      <Style Selector="^.danger:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource ChatHeader.MenuDangerHover}" />
      </Style>
    </ControlTheme>

    <!-- The header's other cards (the context window, what still runs) on the title menu's glass. -->
    <ControlTheme x:Key="ChatHeaderCardPresenter" TargetType="FlyoutPresenter"
                  BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MaxWidth" Value="440" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Margin="16" TextOptions.TextRenderingMode="Antialias">
            <sc:StrataBackdropBlur CornerRadius="{TemplateBinding CornerRadius}" BlurRadius="28" Saturation="1.5" />
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    BoxShadow="0 18 44 -10 #59000000, 0 6 16 0 #24000000, inset 0 1 0 0 #0FFFFFFF">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- The git card: where the chat works and what changed, above the ways to open its folder. A new
         chat's card leads with the choice of checkout instead of what changed. -->
    <ControlTheme x:Key="ChatGitCardPresenter" TargetType="MenuFlyoutPresenter"
                  BasedOn="{StaticResource ChatTitleMenuPresenter}">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Margin="16" TextOptions.TextRenderingMode="Antialias">
            <sc:StrataBackdropBlur CornerRadius="{TemplateBinding CornerRadius}" BlurRadius="28" Saturation="1.5" />
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    BoxShadow="0 18 44 -10 #59000000, 0 6 16 0 #24000000, inset 0 1 0 0 #0FFFFFFF">
              <DockPanel>
                <StackPanel x:Name="ChatGitCardFacts" DockPanel.Dock="Top" x:DataType="vm:ChatViewModel"
                            Margin="10,10,10,12">
                  <StackPanel.Styles>
                    <Style Selector="Border.title-menu-chip">
                      <Setter Property="Height" Value="24" />
                      <Setter Property="Padding" Value="7,0,9,0" />
                      <Setter Property="CornerRadius" Value="12" />
                      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuChipFill}" />
                    </Style>
                    <Style Selector="Border.title-menu-chip TextBlock">
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="MaxWidth" Value="220" />
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                    <Style Selector="Border.title-menu-chip sc|StrataLineIcon">
                      <Setter Property="Width" Value="12" />
                      <Setter Property="Height" Value="12" />
                      <Setter Property="StrokeThickness" Value="2" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    </Style>
                  </StackPanel.Styles>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="git-tile card">
                      <sc:StrataLineIcon Classes="git-icon" Data="{x:Static sc:StrataIcons.Branch}" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="git-branch card" Text="{Binding GitBranchLabel}" />
                  </Grid>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,11,0,0">
                    <Border Classes="title-menu-chip"
                            IsVisible="{Binding GitFolderName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Folder}"
                                           Foreground="{DynamicResource Brush.ComposerProjectHue}" />
                        <TextBlock Text="{Binding GitFolderName}" />
                      </StackPanel>
                    </Border>
                    <Border Classes="title-menu-chip">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel>
                          <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Monitor}" IsVisible="{Binding !IsWorktreeMode}" />
                          <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Layers}" IsVisible="{Binding IsWorktreeMode}" />
                        </Panel>
                        <TextBlock Text="{Binding GitCheckoutModeLabel}" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                  <!-- What changed, once the chat has started: a new chat's checkout choices say it. -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,9,0,0"
                              IsVisible="{Binding IsChatVisible}">
                    <TextBlock Classes="git-card-line" Text="{Binding GitChangesLabel}" />
                    <StackPanel x:DataType="vm:GitChangesViewModel" DataContext="{Binding WorkspaceGit}"
                                Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasTotalStats, FallbackValue=False}">
                      <TextBlock Classes="git-card-line" Text="·" />
                      <TextBlock Classes="diff-added git-card-stat" Text="{Binding TotalAddedLabel}" />
                      <TextBlock Classes="diff-removed git-card-stat" Text="{Binding TotalRemovedLabel}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Margin="0,0,0,6"
                        Background="{StaticResource ChatHeader.MenuDivider}" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              MaxHeight="420">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- Shared chip for files Lumi produced/announced. Right-click exposes file actions
         (open, reveal in folder, copy the file, copy path/name). Used by both the user and
         assistant attachment lists so the context menu stays consistent across the transcript. -->
    <DataTemplate x:Key="SharedFileAttachmentTemplate" DataType="vm:FileAttachmentItem">
      <sc:StrataFileAttachment Classes="transcript-file"
                               FileName="{Binding FileName}"
                               FileSize="{Binding FileSize}"
                               IconImage="{Binding IconImage}"
                               Status="Completed"
                               CanPreview="{Binding IsPreviewable}"
                               IsEdited="{Binding IsEdited}"
                               PreviewLabel="{loc:Str Preview_Open}"
                               EditedLabel="{loc:Str Preview_Edited}"
                               views:FileDrag.FilePath="{Binding FilePath}"
                               IsRemovable="False">
        <sc:StrataFileAttachment.ContextMenu>
          <ContextMenu x:CompileBindings="False">
            <MenuItem Header="{loc:Str FileMenu_Open}" Command="{Binding OpenCommand}">
              <MenuItem.Icon>
                <PathIcon Width="14" Height="14" Data="M14 3h7v7h-2V6.41l-8.29 8.3-1.42-1.42L17.59 5H14V3zM5 5h5v2H5v12h12v-5h2v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Str FileMenu_ShowInFolder}" Command="{Binding ShowInFolderCommand}">
              <MenuItem.Icon>
                <PathIcon Width="14" Height="14" Data="M2 6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6z" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Str FileMenu_Copy}" Command="{Binding CopyCommand}">
              <MenuItem.Icon>
                <PathIcon Width="14" Height="14" Data="M16 1H4a2 2 0 0 0-2 2v12a1 1 0 0 0 2 0V3h12a1 1 0 0 0 0-2zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Str FileMenu_CopyPath}" Command="{Binding CopyPathCommand}">
              <MenuItem.Icon>
                <PathIcon Width="14" Height="14" Data="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7A3.1 3.1 0 0 1 3.9 12zM8 13h8v-2H8v2zm5-6h4a5 5 0 0 1 0 10h-4v-1.9h4a3.1 3.1 0 0 0 0-6.2h-4V7z" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Str FileMenu_CopyName}" Command="{Binding CopyNameCommand}">
              <MenuItem.Icon>
                <PathIcon Width="14" Height="14" Data="M21.41 11.58l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .59 1.42l9 9a2 2 0 0 0 2.82 0l7-7a2 2 0 0 0 0-2.84zM6.5 8A1.5 1.5 0 1 1 8 6.5 1.5 1.5 0 0 1 6.5 8z" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </sc:StrataFileAttachment.ContextMenu>
      </sc:StrataFileAttachment>
    </DataTemplate>

    <!-- ── Skill and chat chips: a skill used or a chat linked, opened from the transcript ── -->
    <DataTemplate x:Key="SkillChipTemplate" x:DataType="vm:SkillChipItem">
      <Button Classes="transcript-chip"
              Name="SkillChip"
              Command="{Binding OpenCommand}"
              ToolTip.Tip="{Binding Description}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <sc:StrataLineIcon Classes="chip-icon" Data="{x:Static sc:StrataIcons.Wand}" />
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          <sc:StrataLineIcon Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="LinkedChatChipTemplate" x:DataType="vm:LinkedChatChipItem">
      <Button Classes="transcript-chip"
              Name="LinkedChatChip"
              Command="{Binding OpenCommand}"
              ToolTip.Tip="{loc:Str OpenChat}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <sc:StrataLineIcon Classes="chip-icon" Data="{x:Static sc:StrataIcons.Chat}" />
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" MaxWidth="220" />
          <sc:StrataLineIcon Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- ── Launchpad buttons: a quiet surface of their own, free of Strata's control chrome ── -->
    <ControlTheme x:Key="LaunchpadRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5"
                  RenderTransform="scale(1)">
            <Border.Transitions>
              <Transitions>
                <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Root">
        <Setter Property="RenderTransform" Value="scale(0.985)" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="LaunchpadTileButton" TargetType="Button" BasedOn="{StaticResource LaunchpadRowButton}">
      <Setter Property="Background" Value="{DynamicResource Launchpad.CardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="10,8" />

      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Launchpad.CardFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Root">
        <Setter Property="RenderTransform" Value="scale(0.975)" />
      </Style>
      <Style Selector="^.active /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
      </Style>
      <Style Selector="^.active:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtleHover}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Helper rules belong to their surface, not every candidate control in the chat. Named-part
         gates retain class priority and respect the derived transcript's base ItemsControl style key.
         Popup-presenter styles stay reachable outside the main surface's ancestry. -->
    <!-- Show Retry on user messages (theme hides it) -->
    <Style Selector="sc|StrataChatMessage:user /template/ Button#PART_RegenerateButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="sc|StrataThink">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="760" />
      <Setter Property="MaxContentHeight" Value="Infinity" />
    </Style>
    <Style Selector="sc|StrataThink#ToolGroupCard.activity-group">
      <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- ── Transcript work on glass ──
         Everything Lumi did sits on the header pills' glass (Strata's Brush.Glass* tokens): steps and
         groups are chips that open into cards, their rows tint on hover, and details sit in a recessed
         well. Line icons say what each step is; only live work takes the accent, and failures the
         danger colour. -->
    <!-- The steps at work in a live card: icon, what it is doing, and on what. -->
    <Style Selector="#Transcript DockPanel.activity-preview-row">
      <Setter Property="Margin" Value="7,0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="#Transcript DockPanel.activity-preview-row > sc|StrataLineIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="#Transcript TextBlock.activity-preview-label">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="#Transcript TextBlock.activity-preview-detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="#Transcript TextBlock.activity-preview-detail.command">
      <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <!-- How long each step has been running, in the accent, right-aligned like a row's time. -->
    <Style Selector="#Transcript TextBlock.activity-preview-elapsed">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="12,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <!-- A plan at work lists its steps in the card, on the rows' icon column. -->
    <Style Selector="ItemsControl.plan-glance">
      <Setter Property="Margin" Value="0,2,0,3" />
    </Style>
    <Style Selector="ItemsControl.plan-glance DockPanel.plan-step">
      <Setter Property="Margin" Value="7,0" />
    </Style>

    <!-- A lone step outside a card wears the chip's glass instead of a row's. -->
    <Style Selector="#Transcript Panel.single-step">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="#Transcript Panel.single-step sc|StrataAiToolCall /template/ Border#PART_Root, #Transcript Panel.single-step sc|StrataTerminalPreview /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="#Transcript Panel.single-step sc|StrataAiToolCall:pointerover /template/ Border#PART_Root, #Transcript Panel.single-step sc|StrataTerminalPreview:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
    </Style>
    <Style Selector="#Transcript Panel.single-step sc|StrataAiToolCall /template/ Border#PART_Header:pointerover, #Transcript Panel.single-step sc|StrataTerminalPreview /template/ Border#PART_Header:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="#Transcript Panel.single-step sc|StrataAiToolCall /template/ Border#PART_Header, #Transcript Panel.single-step sc|StrataTerminalPreview /template/ Border#PART_Header">
      <Setter Property="Padding" Value="10,6,12,6" />
    </Style>
    <Style Selector="#Transcript Border.single-step-line">
      <Setter Property="Height" Value="1.5" />
      <Setter Property="Margin" Value="12,0" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource Brush.StratumLine}" />
      <Setter Property="OpacityMask">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="0.15" Color="#FF000000" />
          <GradientStop Offset="0.85" Color="#FF000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.35" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>

    <!-- Details and console output, recessed into the card. -->
    <Style Selector="#Transcript Border.transcript-well">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassWell}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassDivider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10,12,11" />
    </Style>
    <Style Selector="#Transcript Border.transcript-well sc|StrataMarkdown">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <!-- An open question gets room for its options; once answered it folds to one line. -->
    <Style Selector="sc|StrataQuestionCard:not(:answered)">
      <Setter Property="MinWidth" Value="420" />
    </Style>
    <Style Selector="#Transcript TextBlock.console-text">
      <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Rows inside a card: a source, a changed file. Flat until hovered. -->
    <Style Selector="#Transcript Button.transcript-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="#Transcript Button.transcript-row /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="#Transcript Button.transcript-row:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="#Transcript Button.transcript-row TextBlock.row-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="#Transcript Button.transcript-row:pointerover TextBlock.row-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="#Transcript Button.transcript-row TextBlock.row-detail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="#Transcript Button.transcript-row sc|StrataLineIcon.row-icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,9,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <!-- A source's site initial, like a favicon. -->
    <Style Selector="#Transcript Border.source-initial">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Margin" Value="0,0,9,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="#Transcript Border.source-initial > TextBlock">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Shared by transcript diffs, both checkout pills and the detached git-menu template. -->
    <Style Selector="TextBlock.diff-added">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.diff-removed">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A chip that opens something elsewhere (a plan, a skill, a chat): the step's glass, with a chevron. -->
    <Style Selector="#Transcript Button.transcript-chip">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Height" Value="31" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0,11,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <!-- Strata styles every TextBlock as body text, so a chip's label takes its size and colour here. -->
    <Style Selector="#Transcript Button.transcript-chip TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip sc|StrataLineIcon.chip-icon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip sc|StrataLineIcon.chip-chevron">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="#Transcript Button.transcript-chip:pointerover sc|StrataLineIcon.chip-chevron">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- An app a tool opened (an MCP App or a canvas): a file card's glass that opens into the
         Workspace, and wears the accent while the Workspace shows it. -->
    <Style Selector="Button#AppCard.transcript-app">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="7,7,13,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="MaxWidth" Value="440" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app Border.app-tile">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app Border.app-tile > PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app TextBlock.app-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app TextBlock.app-subtitle">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app TextBlock.app-action">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app sc|StrataLineIcon.app-chevron">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app.showing /template/ Border#PART_Surface">
      <Setter Property="BorderBrush">
        <SolidColorBrush Color="{DynamicResource Color.AccentDefault}" Opacity="0.55" />
      </Setter>
    </Style>
    <Style Selector="Button#AppCard.transcript-app.showing Border.app-tile">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app.showing Border.app-tile > PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button#AppCard.transcript-app.showing sc|StrataLineIcon.app-chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- An error: the step's glass, the danger colour only on its icon, and a way to try again. -->
    <Style Selector="#Transcript Border.transcript-error">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
      <Setter Property="Padding" Value="12,6,12,6" />
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Files Lumi made or used: the same glass, without the status stripe. -->
    <Style Selector="#Transcript sc|StrataFileAttachment.transcript-file /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
    </Style>
    <Style Selector="#Transcript sc|StrataFileAttachment.transcript-file:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
    </Style>
    <Style Selector="#Transcript sc|StrataFileAttachment.transcript-file /template/ Border#PART_Stratum">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="#Transcript sc|StrataFileAttachment.transcript-file /template/ Border#PART_IconBox">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="#Transcript sc|StrataFileAttachment.transcript-file /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <!-- Attachments and chips sit in a wrap with even gaps, never touching. -->
    <Style Selector="#Transcript WrapPanel.transcript-files">
      <Setter Property="ItemSpacing" Value="8" />
      <Setter Property="LineSpacing" Value="8" />
    </Style>
    <Style Selector="#Transcript WrapPanel.transcript-chips">
      <Setter Property="ItemSpacing" Value="6" />
      <Setter Property="LineSpacing" Value="6" />
    </Style>

    <!-- ── Sub-agent runs ──────────────────────────────────────────────
         Chat-side density: one glass chip per agent. The row is a pure hit target — the Strata
         agent-run chip inside owns all chrome, state and hover — so its template draws nothing but
         keyboard focus, as an accent rim over the chip's own. (Strata's button would add its own
         hover surface, shadow and aurora line behind the chip, and clip the chip's shadow.)
         Nothing here moves or draws outside the chip: a turn clips to its bounds, and the row is
         often the first thing in its turn. -->
    <Style Selector="#Transcript Button.agent-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <!-- As wide as a live work card at most: a long task trims rather than stretching the chip. -->
      <Setter Property="MaxWidth" Value="560" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
            <Border Name="PART_FocusRing"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="#Transcript Button.agent-row:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <!-- The affordance is quiet until the row is hovered, so a finished run reads as history. -->
    <Style Selector="#Transcript sc|StrataLineIcon.agent-row-open">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#Transcript Button.agent-row:pointerover sc|StrataLineIcon.agent-row-open">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Fan-out group: same collapsible language as a tool group. Opened, its agents are rows of
         the card rather than chips on chips. -->
    <Style Selector="sc|StrataThink.agent-group">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="760" />
    </Style>
    <Style Selector="sc|StrataThink.agent-group Button.agent-row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MaxWidth" Value="Infinity" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <!-- Rows of a card tint on hover rather than wearing glass of their own. -->
    <Style Selector="sc|StrataThink.agent-group sc|StrataAgentRun.inline /template/ Border#PART_Root">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="sc|StrataThink.agent-group sc|StrataAgentRun.inline:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="#Transcript Border.agent-cluster-avatar">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface1}" />
    </Style>
    <Style Selector="#Transcript Border.agent-cluster-avatar > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="8.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>


    <!-- ── Floating glass header ──
         The transcript runs under the header and the composer (ExtendsTranscriptBehindChrome). A frosted veil appears
         only while history is behind it, and the controls are glass pills anchored to the island's
         edges, so the header never reads as a bar of its own. -->
    <!-- The shell's template sets these locally, so only a class-activated style can replace them. -->
    <Style Selector="sc|StrataChatShell#ChatShell.glass-header /template/ Border#PART_HeaderChrome">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="sc|StrataChatShell#ChatShell.glass-header /template/ Border#PART_HeaderContainer">
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The header owns the full width so its pills anchor to both edges; a content-sized presenter
         would pull the right-hand pills in beside the title. -->
    <Style Selector="sc|StrataChatShell#ChatShell.glass-header /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="DockPanel.Dock" Value="Top" />
    </Style>
    <Style Selector="sc|StrataChatShell#ChatShell.glass-header:has-header /template/ Border#PART_HeaderSeparator">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- The transcript rail in place of the scrollbar (ChatView.TranscriptRail.cs): the user's messages as
         marks to preview and jump to. -->
    <Style Selector="sc|StrataChatShell /template/ sc|StrataTranscriptRail#PART_TranscriptRail">
      <Setter Property="AutomationProperties.Name" Value="{loc:Str TranscriptRail_Name}" />
    </Style>

    <Style Selector="Panel#HeaderEdgeMaterial">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="sc|StrataChatShell:content-under-header Panel#HeaderEdgeMaterial">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Glass pills: StrataGlassButton frosts what passes beneath each pill's tint. -->
    <Style Selector="Button.header-pill">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.header-pill /template/ Border#PART_Surface">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="BoxShadow" Value="0 6 18 -6 #33000000" />
    </Style>
    <!-- A pill only frosts while history passes beneath it; at rest there is nothing to blur. -->
    <Style Selector="Button.header-pill /template/ sc|StrataBackdropBlur#PART_Backdrop">
      <Setter Property="BlurRadius" Value="0" />
      <Setter Property="Saturation" Value="1.3" />
    </Style>
    <Style Selector="sc|StrataChatShell:content-under-header Button.header-pill /template/ sc|StrataBackdropBlur#PART_Backdrop">
      <Setter Property="BlurRadius" Value="14" />
    </Style>
    <Style Selector="sc|StrataBackdropBlur.header-pill-frost">
      <Setter Property="BlurRadius" Value="0" />
      <Setter Property="Saturation" Value="1.3" />
    </Style>
    <Style Selector="sc|StrataChatShell:content-under-header sc|StrataBackdropBlur.header-pill-frost">
      <Setter Property="BlurRadius" Value="14" />
    </Style>
    <Style Selector="Button.header-pill:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFillHover}" />
      <Setter Property="BoxShadow" Value="0 8 22 -6 #40000000" />
    </Style>
    <Style Selector="Button.header-pill:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFillPressed}" />
      <Setter Property="BoxShadow" Value="0 3 10 -4 #2A000000" />
    </Style>
    <Style Selector="Button.header-pill:pointerover /template/ Border#PART_Aurora">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TextBlock.header-pill-text">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Split pills: one piece of glass holding two buttons, lit one at a time like the tools. The title
         pill holds the chat and how full its context window is; the git pill holds the checkout and what
         changed. Each half opens its own card. -->
    <Style Selector="Button.header-seg">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="ToolTip.Placement" Value="Bottom" />
      <Setter Property="ToolTip.VerticalOffset" Value="8" />
    </Style>
    <Style Selector="Button.header-seg /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border.header-seg-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillBorder}" />
    </Style>

    <!-- Title pill: the chat's mark, title and project. It opens the chat's menu. -->
    <Style Selector="Button.header-seg#ChatTitleButton">
      <Setter Property="Padding" Value="3,0,10,0" />
      <Setter Property="MaxWidth" Value="600" />
    </Style>
    <Style Selector="Button.header-seg#ChatTitleButton.no-mark">
      <Setter Property="Padding" Value="12,0,10,0" />
    </Style>
    <!-- The title takes the free row, and gives way only while the live pill needs room beside it. -->
    <Style Selector="sc|StrataChatShell:scrolled-away Panel#ChatHeaderLayer.busy Button#ChatTitleButton">
      <Setter Property="MaxWidth" Value="340" />
    </Style>
    <Style Selector="sc|StrataChatShell:scrolled-away Panel#ChatHeaderLayer.busy.compact Button#ChatTitleButton">
      <Setter Property="MaxWidth" Value="170" />
    </Style>

    <!-- The title pill's second half: how full the context window is. A fill level, not a spinner: a filled
         wedge inside a hairline ring (the arc's stroke is as wide as its radius, so it paints a pie). It is
         quiet until the window fills up; then it warms and gives its percentage. -->
    <Style Selector="Button.header-seg#ContextWindowButton">
      <Setter Property="Padding" Value="8,0,9,0" />
    </Style>
    <Style Selector="Panel.context-ring-gauge">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.context-ring-track">
      <Setter Property="Stroke" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Arc.context-ring-arc">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="StartAngle" Value="-90" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="StrokeThickness" Value="4.5" />
      <Setter Property="StrokeLineCap" Value="Flat" />
    </Style>
    <Style Selector="Button#ContextWindowButton:pointerover Arc.context-ring-arc">
      <Setter Property="Stroke" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button#ContextWindowButton.high Arc.context-ring-arc">
      <Setter Property="Stroke" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
    <Style Selector="TextBlock.context-ring-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chat-mark">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style Selector="TextBlock.chat-mark-glyph">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chat-mark-status">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,-2,-2" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SurfaceOverlay}" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.55" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="TextBlock#ChatTitleText.header-title-text">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Plain text beside the title rather than inline runs: runs create glyph runs even in the drawing-free
         headless tests, and Avalonia's GlyphRun keeps the first renderer it sees for the whole test process. -->
    <Style Selector="TextBlock.header-project-text">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,1,0,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="PathIcon.header-chevron">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Margin" Value="9,1,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Live pill: only while Lumi works and the live step is scrolled out of view. A click jumps back. -->
    <Style Selector="Button.header-pill#HeaderLiveStatusButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="13,0,12,0" />
    </Style>
    <Style Selector="sc|StrataChatShell:scrolled-away Button#HeaderLiveStatusButton.busy">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button#HeaderLiveStatusButton TextBlock.header-pill-text">
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="Panel#ChatHeaderLayer.compact Button#HeaderLiveStatusButton TextBlock.header-pill-text">
      <Setter Property="MaxWidth" Value="250" />
    </Style>
    <Style Selector="Border.header-live-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="3.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.35" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.2" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="PathIcon.header-live-arrow">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Running pill: what still runs in this chat. While Lumi replies it shows the agents at work and opens
         their page in the Workspace; once Lumi is ready it shows everything still running (a command wears a
         terminal) and opens a card that lists it, with Stop session. -->
    <Style Selector="Button.header-pill#HeaderRunningButton">
      <Setter Property="Padding" Value="6,0,13,0" />
    </Style>
    <Style Selector="Panel#ChatHeaderLayer.compact Button#HeaderRunningButton">
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Panel#ChatHeaderLayer.compact Button#HeaderRunningButton > StackPanel > TextBlock.header-pill-text">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.header-agent-avatar">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SurfaceOverlay}" />
    </Style>
    <Style Selector="Border.header-agent-avatar > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Border.header-agent-avatar.command">
      <Setter Property="Background" Value="#FF475569" />
    </Style>
    <Style Selector="Border.header-agent-avatar.command > sc|StrataLineIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="StrokeThickness" Value="2.2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <!-- The checkout: a tile in the project's hue with a branch, the branch in monospace, then where the
         chat runs. In the header it is the git pill's first half; on a new chat's composer, a chip. The
         branch breathes while git refreshes. What changed reads in diff colours. -->
    <Style Selector="Button.header-seg#HeaderGitButton">
      <Setter Property="Padding" Value="4,0,10,0" />
    </Style>
    <Style Selector="Button.header-seg#HeaderGitChangesButton">
      <Setter Property="Padding" Value="10,0,11,0" />
    </Style>
    <Style Selector="Border.git-tile">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.ComposerProjectTile}" />
    </Style>
    <Style Selector="Border.git-tile.card">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="sc|StrataLineIcon.git-icon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="StrokeThickness" Value="2.1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.ComposerProjectHue}" />
    </Style>
    <Style Selector="Button.refreshing sc|StrataLineIcon.git-icon">
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.25" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.9" />
      <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="TextBlock.git-branch">
      <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="220" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.git-branch.card">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MaxWidth" Value="Infinity" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style Selector="TextBlock.git-mode">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.git-card-line">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.git-card-stat">
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="sc|StrataLineIcon.git-chevron">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Button:pointerover sc|StrataLineIcon.git-chevron">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- A narrow island keeps the title readable: the git pill keeps its branch and counts, shorter. Child
         selectors keep these to the pill itself: its card is a logical descendant of the button too. -->
    <Style Selector="Panel#ChatHeaderLayer.compact Button#HeaderGitButton > StackPanel > TextBlock.git-mode,
                     Panel#ChatHeaderLayer.compact Button#HeaderGitButton > StackPanel > PathIcon.header-chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Panel#ChatHeaderLayer.compact Button#HeaderGitButton > StackPanel > TextBlock.git-branch">
      <Setter Property="MaxWidth" Value="96" />
    </Style>

    <!-- On a new chat's composer the checkout is a split chip in the composer's chip language: 28px, the
         project's tile, then what changed. Each half lights on hover, as in the header's pills. -->
    <Style Selector="Border#ComposerGitChip.composer-chip.checkout-chip">
      <Setter Property="Padding" Value="1" />
    </Style>
    <Style Selector="Button.chip-seg">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="2,0,8,0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-6" />
    </Style>
    <Style Selector="Button.chip-seg#ComposerGitChangesButton">
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="Button.chip-seg /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Border#ComposerGitChip.composer-chip.checkout-chip Border.chip-tile">
      <Setter Property="Background" Value="{DynamicResource Brush.ComposerProjectTile}" />
    </Style>
    <Style Selector="Border#ComposerGitChip.composer-chip.checkout-chip sc|StrataLineIcon.chip-icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.ComposerProjectHue}" />
    </Style>
    <Style Selector="Border#ComposerGitChip.composer-chip.checkout-chip Border.chip-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.ComposerChipBorder}" />
    </Style>

    <!-- The context and running cards: chips like the title card's, a quiet icon button, and full-width rows
         that light like the title menu's. -->
    <Style Selector="Border.header-card-chip">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="7,0,9,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuChipFill}" />
    </Style>
    <Style Selector="Border.header-card-chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="200" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.header-card-chip.health">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Border.header-card-chip.health TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.header-card-title">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.header-card-tile">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuChipFill}" />
    </Style>
    <Style Selector="Border.header-card-well">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuChipFill}" />
    </Style>
    <Style Selector="Border.header-card-divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,2,0,6" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuDivider}" />
    </Style>
    <Style Selector="Button#ContextRefreshButton.header-card-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.header-card-row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.header-card-row /template/ Border#PART_Surface, Button#ContextRefreshButton.header-card-icon /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.header-card-row:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemHover}" />
    </Style>
    <Style Selector="Button.header-card-row:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemPressed}" />
    </Style>
    <Style Selector="Button.header-card-row:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.header-card-row.danger:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.MenuDangerHover}" />
    </Style>
    <Style Selector="TextBlock.header-card-row-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button#StopBackgroundSession.danger TextBlock.header-card-row-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="TextBlock.header-card-row-detail">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.header-card-shortcut">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Tools pill: the chat's browser, desktop and Workspace toggles on one piece of glass. -->
    <Style Selector="Border.header-tools">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 6 18 -6 #33000000" />
    </Style>
    <Style Selector="Button.header-tool">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.header-tool PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- One tool lights at a time: the one whose page the Workspace shows. -->
    <Style Selector="Button.header-tool.open">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Button.header-tool.open PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>

    <!-- Signs of life, as in the bar: hovering a tool moves its icon the way the thing moves. The globe
         tips onto its axis and the screen rises on its stand, both overshooting slightly; the
         Workspace's panels trade places, ending where they began. Off when animations are off. -->
    <Style Selector="PathIcon#BrowserToggleIcon.tool-globe">
      <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon.tool-screen">
      <Setter Property="RenderTransformOrigin" Value="50%,94%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="PathIcon#WorkspaceToggleIcon.tool-panels">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.header-tools:not(.motion-disabled) Button.header-tool:pointerover PathIcon.tool-globe">
      <Setter Property="RenderTransform" Value="rotate(-23.5deg) scale(1.1)" />
    </Style>
    <Style Selector="Border.header-tools:not(.motion-disabled) Button.header-tool:pointerover PathIcon.tool-screen">
      <Setter Property="RenderTransform" Value="scale(1.14)" />
    </Style>
    <Style Selector="Border.header-tools:not(.motion-disabled) Button.header-tool:pointerover PathIcon.tool-panels">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>


    <!-- Steering delivery status pill: shown under a user message that was steered into a
         running turn so it's clear when the message actually reaches the session. -->
    <Style Selector="Border.steer-pill">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.steer-pill TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Border.steer-pill Ellipse.steer-dot">
      <Setter Property="Fill" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <!-- In-flight steer: gently pulsing dot signals the message is being delivered. -->
    <Style Selector="Border.steer-pill.steering Ellipse.steer-dot">
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.25" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.1" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <!-- Failed steer: danger treatment. -->
    <Style Selector="Border.steer-pill.failed">
      <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerSubtle}" />
    </Style>
    <Style Selector="Border.steer-pill.failed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="Border.steer-pill.failed Ellipse.steer-dot">
      <Setter Property="Fill" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <!-- Delivered steer: the agent has consumed the message. Success treatment + a check glyph so
         "applied" reads distinctly from the in-flight "Steering…" state. -->
    <Style Selector="Border.steer-pill.delivered">
      <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessSubtle}" />
    </Style>
    <Style Selector="Border.steer-pill.delivered TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
    </Style>
    <Style Selector="Border.steer-pill Path.steer-check">
      <Setter Property="Stroke" Value="{DynamicResource Brush.SuccessDefault}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- Inline "Send now" action beside a pending steering pill. During session/MCP setup the click is
         latched until the first SDK turn starts; only then is that turn aborted, preserving the ready
         session and avoiding an MCP reconnect. -->
    <Style Selector="Button.steer-send-now">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="500" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- Strata's Button renders string content as a TextBlock that keeps its own Foreground, so color it
         explicitly (mirrors Strata's own .accent/.danger TextBlock overrides). -->
    <Style Selector="Button.steer-send-now TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <!-- Flat at rest (no surface fill or shadow); a soft rounded accent wash appears only on hover. -->
    <Style Selector="Button.steer-send-now /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.steer-send-now:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <!-- A steered message bubble stays visually tentative (ghosted) until the agent actually applies it,
         then solidifies to full opacity. The transition is declared on the bubble itself in the template. -->
    <Style Selector="sc|StrataChatMessage.steer-pending">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="sc|StrataChatShell.flat-window /template/ Border#PART_Root">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="sc|StrataChatShell.flat-window /template/ Border#PART_HeaderChrome">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- A background job's wake opens its turn: a step's glass, a tile naming what woke the chat (the
         accent, or the danger colour when its wake script failed), and the job's instructions and the
         script's output folded until the header is clicked. -->
    <Style Selector="#Transcript Border.job-wake">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.GlassChip}" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#Transcript Border.job-wake:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
    </Style>
    <!-- The header is the card's toggle: it draws nothing of its own but keyboard focus. -->
    <Style Selector="#Transcript Button.job-wake-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,11,14,11" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <Border Name="PART_FocusRing"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="#Transcript Button.job-wake-header:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake-tile">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush">
        <SolidColorBrush Color="{DynamicResource Color.AccentDefault}" Opacity="0.28" />
      </Setter>
    </Style>
    <Style Selector="#Transcript Border.job-wake-tile > sc|StrataLineIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="Data" Value="{x:Static sc:StrataIcons.Bolt}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake.scheduled Border.job-wake-tile > sc|StrataLineIcon">
      <Setter Property="Data" Value="{x:Static sc:StrataIcons.Clock}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake.script Border.job-wake-tile > sc|StrataLineIcon">
      <Setter Property="Data" Value="{x:Static sc:StrataIcons.Terminal}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake.chat-event Border.job-wake-tile > sc|StrataLineIcon">
      <Setter Property="Data" Value="{x:Static sc:StrataIcons.Chats}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake.failed Border.job-wake-tile">
      <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
      <Setter Property="BorderBrush">
        <SolidColorBrush Color="{DynamicResource Color.DangerDefault}" Opacity="0.28" />
      </Setter>
    </Style>
    <Style Selector="#Transcript Border.job-wake.failed Border.job-wake-tile > sc|StrataLineIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake TextBlock.job-wake-title">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="#Transcript Border.job-wake WrapPanel.job-wake-meta">
      <Setter Property="ItemSpacing" Value="5" />
    </Style>
    <Style Selector="#Transcript Border.job-wake WrapPanel.job-wake-meta > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="#Transcript Border.job-wake.failed WrapPanel.job-wake-meta > TextBlock.job-wake-reason">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="#Transcript Border.job-wake TextBlock.job-wake-time">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="#Transcript Border.job-wake sc|StrataLineIcon.job-wake-chevron">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#Transcript Border.job-wake:pointerover sc|StrataLineIcon.job-wake-chevron">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="#Transcript Border.job-wake.expanded sc|StrataLineIcon.job-wake-chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <!-- What the wake script said: the card's message, under its title. -->
    <Style Selector="#Transcript Border.job-wake TextBlock.job-wake-body">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="3" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="#Transcript Border.job-wake Border.job-wake-divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="14,0,14,12" />
      <Setter Property="Background" Value="{DynamicResource Brush.GlassDivider}" />
    </Style>
    <!-- Opened, the details line up under the title. -->
    <Style Selector="#Transcript Border.job-wake StackPanel.job-wake-details">
      <Setter Property="Spacing" Value="14" />
      <Setter Property="Margin" Value="58,0,16,12" />
    </Style>
    <Style Selector="#Transcript Border.job-wake TextBlock.job-wake-label">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="#Transcript Border.job-wake TextBlock.job-wake-run">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="#Transcript Border.job-wake SelectableTextBlock.job-wake-instructions">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="#Transcript Border.job-wake SelectableTextBlock.job-wake-output">
      <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TerminalPreviewOutput}" />
    </Style>

    <!-- Token usage badge hover -->
    <Style Selector="Border#TokenUsageBadge:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSubtle}" />
    </Style>

    <!-- ── Panel cross-fade transitions ─────────────────── -->

    <!-- Welcome panel: opacity + hit-testing controlled by .active class -->
    <Style Selector="Panel#WelcomePanel">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel#WelcomePanel.active">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Welcome greeting: subtle slide-up as it fades out -->
    <Style Selector="StackPanel#WelcomeGreeting">
      <Setter Property="Margin" Value="24,28,24,16" />
      <Setter Property="RenderTransform" Value="translateY(16px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#WelcomePanel.active StackPanel#WelcomeGreeting">
      <Setter Property="RenderTransform" Value="translateY(0)" />
    </Style>
    <!-- Short windows: the launchpad drops the mark and tightens so what needs the user stays in view -->
    <Style Selector="StackPanel#WelcomeGreeting.compact">
      <Setter Property="Margin" Value="24,12,24,12" />
    </Style>
    <Style Selector="StackPanel#WelcomeGreeting.compact Border#WelcomeOrb">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel#WelcomeGreeting.compact TextBlock.launchpad-greeting">
      <Setter Property="FontSize" Value="26" />
    </Style>

    <!-- Chat panel: opacity + hit-testing controlled by .active class -->
    <Style Selector="Panel#ChatPanel">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel#ChatPanel.active">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- ── Composer container: animated width + margin transition ── -->
    <Style Selector="StackPanel#ComposerContainer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="MaxWidth" Duration="0:0:0.32" Easing="CubicEaseOut" />
          <ThicknessTransition Property="Margin" Duration="0:0:0.32" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
      <!-- Default (active chat) state — capped to the reading column so the composer
           shares a vertical spine with the centered transcript on wide screens -->
      <Setter Property="MaxWidth" Value="{DynamicResource Chat.ReadingColumnWidth}" />
      <Setter Property="Margin" Value="12,8,12,10" />
    </Style>
    <Style Selector="StackPanel#ComposerContainer.welcome">
      <Setter Property="MaxWidth" Value="680" />
      <Setter Property="Margin" Value="24,0,24,20" />
    </Style>

    <!-- ── Glass composer ──
         The transcript runs beneath the composer (ExtendsTranscriptBehindChrome). Like the header, it
         frosts only while history is behind it; at rest its translucent card lets the presence glow
         through without spending GPU on a blur of nothing. -->
    <Style Selector="sc|StrataChatComposer#Composer.glass:not(.frosted) /template/ sc|StrataBackdropBlur#PART_Backdrop">
      <Setter Property="BlurRadius" Value="0" />
    </Style>
    <Style Selector="Panel#ComposerEdgeMaterial">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="sc|StrataChatShell:content-under-composer Panel#ComposerEdgeMaterial">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ── Follow-up suggestions ──
         One row of glass chips above the composer, of the composer's own material: the overlay surface at
         two thirds with a hairline rim, an accent turn-arrow before the text. The row never wraps
         (FitRowPanel): when the three don't fit, the longest trim and offer their full text in a tip.
         Hovering brightens the glass, tints the rim with the accent and nudges the arrow forward. Each chip
         rises in on the render thread (ChatView), which owns the button's own opacity, transform and
         transitions, so the surface and its content carry the transitions here. -->
    <Style Selector="#ComposerContainer Button.follow-up-chip">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,0,14,0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-6" />
      <Setter Property="ToolTip.ShowDelay" Value="350" />
    </Style>
    <Style Selector="#ComposerContainer Button.follow-up-chip /template/ Border#PART_Surface">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="BoxShadow" Value="0 4 14 -6 #29000000" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#ComposerContainer Button.follow-up-chip:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFillHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource FollowUp.RimHover}" />
      <Setter Property="BoxShadow" Value="0 6 18 -6 #3D000000" />
    </Style>
    <Style Selector="#ComposerContainer Button.follow-up-chip:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFillPressed}" />
      <Setter Property="BoxShadow" Value="0 2 8 -4 #29000000" />
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="#ComposerContainer Button.follow-up-chip /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="#ComposerContainer Path.follow-up-glyph">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Data" Value="{StaticResource FollowUp.Glyph}" />
      <Setter Property="Stroke" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#ComposerContainer Button.follow-up-chip:pointerover Path.follow-up-glyph">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateX(2px)" />
    </Style>
    <Style Selector="#ComposerContainer TextBlock.follow-up-text">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#ComposerContainer Button.follow-up-chip:pointerover TextBlock.follow-up-text">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <!-- Only a trimmed chip offers its full text. A chip that fits has no tip at all rather than a
         disabled one, so the tooltip service looks past it and closes a neighbour's tip. -->
    <Style Selector="#ComposerContainer Button.follow-up-chip[(lc|FitRowPanel.IsShrunk)=True]">
      <Setter Property="ToolTip.Tip" Value="{Binding $self.CommandParameter}" />
    </Style>

    <!-- ── Launchpad starter pills ── -->
    <Style Selector="Panel#WelcomePanel Button.transcript-suggestion">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="Transitions">
        <Transitions>
          <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#WelcomePanel Button.transcript-suggestion:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.transcript-suggestion:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.transcript-suggestion /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── Follow-up placeholders: the chips' glass and height, pulsing while the suggestions are written ── -->
    <Style Selector="Border.suggestion-pill">
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Border.suggestion-pill.pill-a">
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.3" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.95" />
      <Setter Property="sa:LifecycleOpacityPulse.PeakAt" Value="0.38" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="Border.suggestion-pill.pill-b">
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.3" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.95" />
      <Setter Property="sa:LifecycleOpacityPulse.HoldUntil" Value="0.18" />
      <Setter Property="sa:LifecycleOpacityPulse.PeakAt" Value="0.56" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="Border.suggestion-pill.pill-c">
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.3" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.95" />
      <Setter Property="sa:LifecycleOpacityPulse.HoldUntil" Value="0.36" />
      <Setter Property="sa:LifecycleOpacityPulse.PeakAt" Value="0.74" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>

    <!-- ── Pause ──
         Pause holds a run where it stands and keeps everything it has done. While Lumi works it sits on the
         composer beside Stop, a quiet tool like the microphone (Strata's composer-tool: no fill at rest, a
         catch of light under the pointer), so Stop stays the one disc there.
         The paused bar is a piece of the composer's glass: a disc whose rim breathes slowly, like a standby
         light, while the chat holds; what happened; and the way on, with Resume the one accent. While the
         chat is still pausing, the Strata line runs along its foot instead, as under any work in progress.
         Every label sets its own size and colour: Strata's base TextBlock style would otherwise give it
         body text. -->
    <Style Selector="Button#PauseChatButton.composer-pause">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-6" />
    </Style>

    <Style Selector="Border#ChatPauseStatusPanel.pause-bar">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{StaticResource ChatHeader.PillFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 10 26 -12 #4D000000, 0 2 6 -2 #1A000000" />
    </Style>
    <Style Selector="#ComposerContainer Border.pause-badge-disc">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="#ComposerContainer Border.pause-badge-rim">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.12" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.7" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:3.2" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="Border#ChatPauseStatusPanel.pause-bar.motion-disabled Border.pause-badge-rim">
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="False" />
    </Style>
    <Style Selector="Border#ChatPauseStatusPanel.pause-bar.pending Border.pause-badge-rim">
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="#ComposerContainer PathIcon.pause-badge-glyph">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="TextBlock#ChatPauseStatusTitle.pause-bar-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock#ChatPauseStatusDescription.pause-bar-description">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="#ComposerContainer Button.pause-bar-action">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="#ComposerContainer Button.pause-bar-action TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button#StopPausedChatButton.pause-bar-cancel TextBlock">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Button#StopPausedChatButton.pause-bar-cancel:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button#ResumeChatButton.pause-bar-resume">
      <Setter Property="Padding" Value="12,0,15,0" />
    </Style>
    <Style Selector="Button#ResumeChatButton.pause-bar-resume TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The play mark leans forward on hover, the way Resume moves the chat on. -->
    <Style Selector="PathIcon.resume-glyph">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="translateX(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#ChatPauseStatusPanel.pause-bar:not(.motion-disabled) Button.pause-bar-resume:pointerover PathIcon.resume-glyph">
      <Setter Property="RenderTransform" Value="translateX(2px)" />
    </Style>
    <Style Selector="Border#ChatPauseProgressLine.pause-bar-line">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Height" Value="1.5" />
      <Setter Property="Margin" Value="22,0" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="{DynamicResource Brush.StratumLine}" />
      <Setter Property="OpacityMask">
        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="0.15" Color="#FF000000" />
          <GradientStop Offset="0.85" Color="#FF000000" />
          <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.35" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.6" />
      <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="SineEaseInOut" />
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="Border#ChatPauseStatusPanel.pause-bar.pending Border.pause-bar-line">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border#ChatPauseStatusPanel.pause-bar.motion-disabled Border.pause-bar-line">
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="False" />
    </Style>

    <!-- ── Ctrl+F search bar ── -->
    <Style Selector="Border#SearchBar">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(-4px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#SearchBar.open">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0)" />
    </Style>
    <Style Selector="Border#SearchBar TextBox#SearchInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#SearchBar TextBox#SearchInput:focus /template/ Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border#SearchBar TextBox#SearchInput /template/ Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="Button.search-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.search-nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}" />
    </Style>
    <Style Selector="Button.search-nav:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Button.search-nav /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ═══ Launchpad: the new-chat surface ═══ -->
    <Style Selector="TextBlock#LaunchpadGreeting.launchpad-greeting">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.4" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock#LaunchpadBrief.launchpad-brief">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Border#LaunchpadLiveDot.launchpad-live-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.3" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.3" />
      <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
    </Style>
    <!-- Live pulses run only while the launchpad is up. The panel just fades out when a chat starts,
         so its controls would otherwise stay "visible" and keep an idle chat rendering frames. -->
    <Style Selector="Panel#WelcomePanel.active Border.launchpad-live-dot, Panel#WelcomePanel.active Border.launchpad-state-ring.live">
      <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
    </Style>
    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-section-label,
                     StackPanel#LaunchpadSetups TextBlock.launchpad-section-label">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Starters keep the calm pill of the transcript suggestions; the label brightens on hover -->
    <Style Selector="Panel#WelcomePanel Button.launchpad-starter TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-starter TextBlock.starter-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-starter:pointerover TextBlock.starter-label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- The pick-up card: a single glass sheet so chats and automations read as one "what's going on" -->
    <Style Selector="Border#LaunchpadActivity.launchpad-card">
      <Setter Property="Background" Value="{DynamicResource Launchpad.CardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SubtleHover}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Panel#WelcomePanel Border.launchpad-divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="10,4" />
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>

    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-row-title">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-row-time">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-row-state">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-row-meta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel PathIcon.launchpad-row-chevron">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-row:pointerover PathIcon.launchpad-row-chevron">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Row state: a tinted tile carrying an icon (waiting, recent), a dot (new reply) or a ring (working) -->
    <Style Selector="Panel#WelcomePanel Border.launchpad-state-tile">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <Style Selector="Panel#WelcomePanel PathIcon.launchpad-state-icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Border.launchpad-state-dot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Border.launchpad-state-ring">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Border.launchpad-state-ring.live">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
      <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.35" />
      <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.1" />
      <Setter Property="sa:LifecycleOpacityPulse.PlaybackDirection" Value="Alternate" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-row.waiting Border.launchpad-state-tile">
      <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-row.waiting PathIcon.launchpad-state-icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-row.waiting TextBlock.launchpad-row-state">
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-row.reply Border.launchpad-state-tile, Panel#WelcomePanel Button.launchpad-row.working Border.launchpad-state-tile">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    </Style>
    <Style Selector="Panel#WelcomePanel Button.launchpad-row.reply TextBlock.launchpad-row-state, Panel#WelcomePanel Button.launchpad-row.working TextBlock.launchpad-row-state">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>

    <!-- The automations footer -->
    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-footer-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- Setups sit on the composer they configure and fold away with the welcome state -->
    <Style Selector="StackPanel#LaunchpadSetups">
      <Setter Property="MaxHeight" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="MaxHeight" Duration="0:0:0.26" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <ThicknessTransition Property="Margin" Duration="0:0:0.26" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel#ComposerContainer.welcome StackPanel#LaunchpadSetups">
      <Setter Property="MaxHeight" Value="96" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups Border.launchpad-setup-icon">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups PathIcon.launchpad-setup-glyph">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- Applied: a small accent check settles on the tile's icon -->
    <Style Selector="StackPanel#LaunchpadSetups Border.launchpad-setup-check">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,-5,-5,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="BorderThickness" Value="2" />
      <!-- Ring in the active tile's own fill, so the check reads as cut out of it -->
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.4)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups Button.launchpad-setup.active Border.launchpad-setup-check">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups Border.launchpad-setup-check PathIcon">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    </Style>

    <!-- A project's identity: its initial on a tint of its hue (rows and setups share it) -->
    <Style Selector="Panel#WelcomePanel Border.launchpad-badge-tile,
                     StackPanel#LaunchpadSetups Border.launchpad-badge-tile">
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Panel#WelcomePanel TextBlock.launchpad-badge-initial,
                     StackPanel#LaunchpadSetups TextBlock.launchpad-badge-initial">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups TextBlock.launchpad-setup-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups TextBlock.launchpad-setup-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="StackPanel#LaunchpadSetups Button.launchpad-setup.active TextBlock.launchpad-setup-meta">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <!-- The turn currently owning the full composer stays visibly connected to it. -->
    <Style Selector="sc|StrataChatMessage.editing-source /template/ Border#PART_Bubble">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #20818CF8" />
    </Style>

    <!-- ── Reply to ────────────────────────────────────────────────────
         A sent reply quotes its source inside the user bubble; the composer shows the pending quote. -->
    <Style Selector="#Transcript Button.reply-quote">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="#Transcript Button.reply-quote /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="#Transcript Button.reply-quote:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="#Transcript Button.reply-quote:pressed /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="#Transcript Button.reply-quote Border.reply-quote-tint">
      <Setter Property="Background" Value="{DynamicResource Brush.ChatUserBubbleSelection}" />
      <Setter Property="Opacity" Value="0.38" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="#Transcript Button.reply-quote:pointerover Border.reply-quote-tint">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="#Transcript Button.reply-quote Border.reply-quote-bar">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>

    <Style Selector="Border#ComposerReplyCard.composer-reply">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="#ComposerContainer Border.composer-reply-bar">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="#ComposerContainer Button.composer-reply-body">
      <Setter Property="Padding" Value="10,7,8,8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="#ComposerContainer Button.composer-reply-body /template/ Border#PART_Surface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="#ComposerContainer Button.composer-reply-body:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtleHover}" />
    </Style>
    <Style Selector="#ComposerContainer Button.composer-reply-close">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,6,6,0" />
    </Style>

    <!-- Jump-to-message (reply source, Ctrl+Up/Down user message): the target briefly glows so the eye lands on it. -->
    <Style Selector="sc|StrataChatMessage.reply-flash:not(:user) /template/ Border#PART_Bubble">
      <Setter Property="Background" Value="#26818CF8" />
      <Setter Property="BoxShadow" Value="0 0 0 8 #26818CF8" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- User bubbles keep their own fill and shape; only a glow ring is added, at once rather than
         through the bubble's 0.2s shadow transition so it appears with the jump. The ring is drawn just
         inside the bubble's edge: templated controls clip to their bounds, and a right-aligned bubble
         meets its message's and turn's right edge, where an outer ring would be cut off. -->
    <Style Selector="sc|StrataChatMessage.reply-flash:user /template/ Border#PART_Bubble">
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
      <Setter Property="BoxShadow" Value="inset 0 0 0 2 #E6818CF8" />
    </Style>

    <!-- Voice typing cards: a quiet inset in the composer, a tile for what it's about, then words and actions. -->
    <Style Selector="Border.voice-card">
      <Setter Property="Background" Value="{DynamicResource Voice.CardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChatHeader.PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style Selector="Border.voice-tile">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.voice-tile sc|StrataLineIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.voice-tile.brand">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
      <Setter Property="BoxShadow" Value="0 4 10 -4 #40000000" />
    </Style>
    <Style Selector="Border.voice-tile.brand sc|StrataLineIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    </Style>
    <Style Selector="Border.voice-tile.problem">
      <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
    </Style>
    <Style Selector="Border.voice-tile.problem sc|StrataLineIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="Border.voice-tile.quiet">
      <Setter Property="Background" Value="{DynamicResource ChatHeader.MenuChipFill}" />
    </Style>
    <Style Selector="Border.voice-tile.quiet sc|StrataLineIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.voice-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.voice-body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.voice-caption">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.voice-fact">
      <Setter Property="Spacing" Value="7" />
    </Style>
    <Style Selector="StackPanel.voice-fact sc|StrataLineIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="StackPanel.voice-fact TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.voice-action">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Button.voice-action.accent">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.voice-close">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <!-- ── Background job wake: the opening of the turn a job started ── -->
    <DataTemplate DataType="vm:JobWakeItem">
      <!-- Every wake card is as wide as the column allows, up to 560, so opening one grows only its
           height and the cards' times line up. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="560" />
        </Grid.ColumnDefinitions>
        <Border Classes="job-wake"
                Classes.scheduled="{Binding IsScheduled}"
                Classes.script="{Binding IsScript}"
                Classes.chat-event="{Binding IsChatEvent}"
                Classes.failed="{Binding IsFailed}"
                Classes.expanded="{Binding IsExpanded}"
                AutomationProperties.Name="JobWakeCard">
          <StackPanel>
            <Button x:Name="JobWakeHeader"
                    Classes="job-wake-header"
                    Command="{Binding ToggleExpandedCommand}"
                    AutomationProperties.Name="{Binding JobName}"
                    AutomationProperties.HelpText="{Binding ReasonText}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="job-wake-tile">
                  <sc:StrataLineIcon />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="job-wake-title" Text="{Binding JobName}" />
                  <WrapPanel Classes="job-wake-meta">
                    <TextBlock Classes="job-wake-reason" Text="{Binding ReasonText}" />
                    <TextBlock Text="·" IsVisible="{Binding HasDuration}" />
                    <TextBlock Text="{Binding DurationText}" IsVisible="{Binding HasDuration}" />
                  </WrapPanel>
                  <TextBlock Classes="job-wake-body"
                             Text="{Binding BodyText}"
                             IsVisible="{Binding HasBody}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Top" Margin="12,2,0,0">
                  <TextBlock Classes="job-wake-time" Text="{Binding TimestampText}"
                             IsVisible="{Binding HasTimestamp}" />
                  <sc:StrataLineIcon Classes="job-wake-chevron" Data="{x:Static sc:StrataIcons.ChevronDown}" />
                </StackPanel>
              </Grid>
            </Button>

            <!-- Opens and folds with the motion of a "worked for" row. -->
            <lc:RevealPanel IsOpen="{Binding IsExpanded}"
                            Classes.motion-disabled="{Binding !$parent[views:ChatView].((vm:ChatViewModel)DataContext).AreAnimationsEnabled}">
              <StackPanel>
                <Border Classes="job-wake-divider" />
                <StackPanel Classes="job-wake-details">
                  <StackPanel Spacing="5" IsVisible="{Binding HasInstructions}">
                    <TextBlock Classes="job-wake-label" Text="{loc:Str Jobs_FieldPrompt}" />
                    <SelectableTextBlock Classes="job-wake-instructions" Text="{Binding Instructions}" />
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding HasOutput}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="job-wake-run"
                                 Text="{Binding RunText}" IsVisible="{Binding HasRunText}" />
                      <TextBlock Classes="job-wake-label" Text="{loc:Str Jobs_ResultOutput}" />
                    </DockPanel>
                    <Border Classes="transcript-well">
                      <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock Classes="job-wake-output" Text="{Binding DisplayOutput}" />
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                  <WrapPanel Classes="transcript-chips" IsVisible="{Binding HasActions}">
                    <Button x:Name="JobWakeSourceChatButton"
                            Classes="transcript-chip"
                            Command="{Binding OpenSourceChatCommand}"
                            IsVisible="{Binding CanOpenSourceChat}"
                            AutomationProperties.Name="{loc:Str Jobs_OpenChat}">
                      <StackPanel Orientation="Horizontal">
                        <sc:StrataLineIcon Classes="chip-icon" Data="{x:Static sc:StrataIcons.Chat}" />
                        <TextBlock Text="{Binding SourceChatTitle}" MaxWidth="240"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <sc:StrataLineIcon Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="JobWakeOpenJobButton"
                            Classes="transcript-chip"
                            Command="{Binding OpenJobCommand}"
                            IsVisible="{Binding CanOpenJob}">
                      <StackPanel Orientation="Horizontal">
                        <sc:StrataLineIcon Classes="chip-icon" Data="{x:Static sc:StrataIcons.Clock}" />
                        <TextBlock Text="{loc:Str JobWake_OpenJob}" VerticalAlignment="Center" />
                        <sc:StrataLineIcon Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </lc:RevealPanel>
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- ── User message ─────────────────────────────── -->
    <DataTemplate DataType="vm:UserMessageItem">
      <StackPanel HorizontalAlignment="Stretch" Spacing="4">
        <sc:StrataChatMessage Role="User"
                              HorizontalAlignment="Right"
                              MaxWidth="640"
                              Author="{Binding Author}"
                              Timestamp="{Binding TimestampText}"
                              TimestampToolTip="{Binding TimestampToolTip}"
                              IsEditable="{Binding IsEditEnabled}"
                              UseInlineEdit="False"
                              EditText="{Binding Content, Mode=OneWay}"
                              EditCommand="{Binding BeginEditCommand}"
                              EditConfirmedCommand="{Binding ConfirmEditCommand}"
                              RegenerateCommand="{Binding ResendCommand}"
                              CanFork="True"
                              ForkMenuHeader="{loc:Str Menu_ForkAndEdit}"
                              Classes.editing-source="{Binding IsBeingEdited}"
                              Classes.steer-pending="{Binding Source.IsSteerInProgress}">
          <!-- Ghost → solidify transition when a steered message is applied. -->
          <sc:StrataChatMessage.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut" />
            </Transitions>
          </sc:StrataChatMessage.Transitions>
          <sc:StrataChatMessage.Content>
            <StackPanel Spacing="6">
              <!-- Reply quote: what this message replies to. Clicking it jumps back to the source. -->
              <ContentControl Content="{Binding DisplayReply}"
                              IsVisible="{Binding HasReply}"
                              HorizontalContentAlignment="Stretch">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:UserMessageItem">
                    <Button Classes="subtle reply-quote"
                            Command="{Binding OpenReplySourceCommand}"
                            ToolTip.Tip="{loc:Str Chat_ShowReplySource}"
                            AutomationProperties.Name="{loc:Str Chat_ShowReplySource}">
                      <Panel>
                        <Border Classes="reply-quote-tint" />
                        <Grid ColumnDefinitions="3,*">
                          <Border Classes="reply-quote-bar" />
                          <StackPanel Grid.Column="1" Spacing="1" Margin="8,5,10,6">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <PathIcon Width="10" Height="10"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Brush.ChatUserBubbleTextSecondary}"
                                        Data="{x:Static sc:StrataChatMessage.ReplyIconGeometry}" />
                              <TextBlock Text="{Binding ReplyAuthor}"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource Brush.ChatUserBubbleText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ReplyPreview}"
                                       FontSize="12.5"
                                       LineHeight="17"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.ChatUserBubbleTextSecondary}" />
                          </StackPanel>
                        </Grid>
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              <lc:TranscriptTextContent Text="{Binding Content}" />
              <ItemsControl ItemsSource="{Binding DisplayAttachments}"
                            IsVisible="{Binding HasAttachments}"
                            ItemTemplate="{StaticResource SharedFileAttachmentTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Classes="transcript-files" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <!-- Other chats this message brought in; each opens its chat. -->
              <ItemsControl ItemsSource="{Binding DisplayReferencedChats}"
                            IsVisible="{Binding HasReferencedChats}"
                            ItemTemplate="{StaticResource LinkedChatChipTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Classes="transcript-chips" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding DisplaySkills}"
                            IsVisible="{Binding HasSkills}"
                            ItemTemplate="{StaticResource SkillChipTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Classes="transcript-chips" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </sc:StrataChatMessage.Content>
        </sc:StrataChatMessage>

        <Border Name="EditSourceMarker"
                IsVisible="{Binding IsBeingEdited}"
                HorizontalAlignment="Right"
                Padding="8,3"
                CornerRadius="999"
                Background="{DynamicResource Brush.AccentSubtle}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Width="10" Height="10"
                      Foreground="{DynamicResource Brush.AccentDefault}"
                      Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" />
            <TextBlock Text="{loc:Str Chat_EditSourceMarker}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.AccentDefault}" />
          </StackPanel>
        </Border>

        <!-- Steering delivery status pill + inline "Send now" action. The pill stays crisp while the
             bubble ghosts, so it's clear when a steered message reaches (and is applied by) the session;
             "Send now" appears only while still steering, to force delivery without waiting for the tool. -->
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                    IsVisible="{Binding Source.HasSteerBadge}">
          <Border Classes="steer-pill"
                  VerticalAlignment="Center"
                  Classes.steering="{Binding Source.IsSteerInProgress}"
                  Classes.delivered="{Binding Source.IsSteerDelivered}"
                  Classes.failed="{Binding Source.IsSteerFailed}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Classes="steer-dot" Width="6" Height="6" VerticalAlignment="Center"
                       IsVisible="{Binding Source.ShowSteerDot}" />
              <Path Classes="steer-check" Width="10" Height="8" Stretch="None" VerticalAlignment="Center"
                    IsVisible="{Binding Source.IsSteerDelivered}"
                    Data="M1,4.4 L3.6,7 L8.5,1.4" />
              <TextBlock Text="{Binding Source.SteerBadgeText}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Classes="steer-send-now"
                  VerticalAlignment="Center"
                  Command="{Binding SendNowCommand}"
                  IsVisible="{Binding Source.CanSendNow}"
                  Content="{loc:Str Steer_SendNow}"
                  ToolTip.Tip="{loc:Str Steer_SendNowTooltip}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- ── Assistant message ────────────────────────── -->
    <DataTemplate DataType="vm:AssistantMessageItem">
      <sc:StrataChatMessage Role="Assistant"
                            HorizontalAlignment="Left"
                            MaxWidth="900"
                            Author="{Binding HeaderLabel}"
                            Timestamp="{Binding TimestampText}"
                            TimestampToolTip="{Binding TimestampToolTip}"
                            IsEditable="False"
                            CanRegenerate="False"
                            CanFork="True"
                            ForkMenuHeader="{loc:Str Menu_ForkFromHere}"
                            CanReply="{Binding CanReply}"
                            CanShare="{Binding CanSharePrompt}"
                            ShareLabel="{loc:Str Prompt_ShareTitle}"
                            ReplyLabel="{loc:Str Chat_Reply}"
                            ReplySelectionLabel="{loc:Str Chat_ReplyToSelection}"
                            IsReplySource="{Binding IsReplySource}"
                            IsProgressUpdate="{Binding IsProgress}"
                            IsStreaming="{Binding IsStreaming}">
        <sc:StrataChatMessage.Content>
          <StackPanel Spacing="6">
            <lc:TranscriptTextContent Text="{Binding Content}"
                                      InteractionStates="{Binding InteractionStates}"
                                      CanSubmitInteractions="{Binding $parent[views:ChatView].((vm:ChatViewModel)DataContext).CanSubmitInteractions}"
                                      PreferPlainText="{Binding IsStreaming}"
                                      RenderMarkdownWhileStreaming="True" />

            <!-- Skills section -->
            <ItemsControl ItemsSource="{Binding DisplaySkills}"
                          IsVisible="{Binding HasSkills}"
                          ItemTemplate="{StaticResource SkillChipTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Classes="transcript-chips" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- File attachments -->
            <ItemsControl ItemsSource="{Binding DisplayFileAttachments}"
                          IsVisible="{Binding HasFileAttachments}"
                          ItemTemplate="{StaticResource SharedFileAttachmentTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Classes="transcript-files" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Sources section -->
            <ContentControl Content="{Binding DisplaySourcesSection}"
                            IsVisible="{Binding HasSources}">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:AssistantMessageItem">
                  <sc:StrataThink Label="{Binding SourcesLabel}"
                                  Icon="{x:Static sc:StrataIcons.Globe}"
                                  Meta="{Binding SourcesDomains}">
                    <sc:StrataThink.Content>
                      <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SourceItem">
                            <Button Classes="transcript-row"
                                    Command="{Binding OpenCommand}"
                                    ToolTip.Tip="{Binding Url}">
                              <DockPanel>
                                <Border DockPanel.Dock="Left" Classes="source-initial"
                                        Background="{Binding AccentBrush}">
                                  <TextBlock Text="{Binding InitialLetter}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Classes="row-detail"
                                           Margin="12,0,0,0" Text="{Binding Domain}" />
                                <TextBlock Classes="row-title" Text="{Binding Title}" />
                              </DockPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </sc:StrataThink.Content>
                  </sc:StrataThink>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>

          </StackPanel>
        </sc:StrataChatMessage.Content>
      </sc:StrataChatMessage>
    </DataTemplate>

    <!-- ── Turn model label (end of turn) ── -->
    <DataTemplate DataType="vm:TurnModelItem">
      <TextBlock Text="{Binding ModelName}"
                 FontSize="10"
                 Foreground="{DynamicResource Brush.TextTertiary}"
                 Margin="0,4,0,0"
                 HorizontalAlignment="Left" />
    </DataTemplate>

    <!-- ── File changes summary (separate item at end of turn) ── -->
    <DataTemplate DataType="vm:FileChangesSummaryItem">
      <sc:StrataThink Label="{Binding Label}" Icon="{x:Static sc:StrataIcons.Diff}">
        <sc:StrataThink.HeaderExtra>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="diff-added" Text="{Binding TotalStatsAdded}" />
            <TextBlock Classes="diff-removed" Text="{Binding TotalStatsRemoved}"
                       IsVisible="{Binding HasTotalRemovals}" />
          </StackPanel>
        </sc:StrataThink.HeaderExtra>
        <sc:StrataThink.Content>
          <ItemsControl ItemsSource="{Binding FileChanges}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:FileChangeItem">
                <Button Classes="transcript-row" Command="{Binding ShowDiffCommand}"
                        ToolTip.Tip="{Binding FilePath}">
                  <DockPanel>
                    <sc:StrataLineIcon DockPanel.Dock="Left" Classes="row-icon"
                                       Data="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                      <TextBlock Classes="diff-added" Text="{Binding StatsAdded}" />
                      <TextBlock Classes="diff-removed" Text="{Binding StatsRemoved}"
                                 IsVisible="{Binding HasRemovals}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="row-title" Margin="0,0,8,0"
                               Text="{Binding FileName}" />
                    <TextBlock Classes="row-detail" Text="{Binding DirectoryHint}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </sc:StrataThink.Content>
      </sc:StrataThink>
    </DataTemplate>

    <!-- ── Plan card (inline in transcript when agent creates/updates a plan) ── -->
    <DataTemplate DataType="vm:PlanCardItem">
      <Button Classes="transcript-chip" Command="{Binding OpenCommand}" Margin="0,2">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <sc:StrataLineIcon Classes="chip-icon" Data="{x:Static sc:StrataIcons.Checklist}" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
          <sc:StrataLineIcon Classes="chip-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- ── App card (an MCP App or canvas a tool opened; it opens in the Workspace) ── -->
    <DataTemplate DataType="vm:EmbeddedAppItem">
      <Button x:Name="AppCard" Classes="transcript-app" Classes.showing="{Binding IsShowing}"
              Command="{Binding OpenCommand}" Margin="0,2"
              AutomationProperties.Name="{Binding Title}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="app-tile">
            <PathIcon Data="{x:Static vm:WorkspaceIcons.Apps}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,14,0" Spacing="1" VerticalAlignment="Center">
            <TextBlock Classes="app-title" Text="{Binding Title}" />
            <TextBlock Classes="app-subtitle" Text="{Binding Subtitle}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Classes="app-action" Text="{Binding ActionLabel}" />
            <sc:StrataLineIcon Classes="app-chevron" Data="{x:Static sc:StrataIcons.ChevronRight}" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- ── Loaded-skill chip (inline in transcript when a skill is fetched at runtime) ── -->
    <DataTemplate DataType="vm:SkillLoadedItem">
      <ContentControl x:Name="SkillLoadedChip"
                      Content="{Binding Chip}"
                      ContentTemplate="{StaticResource SkillChipTemplate}"
                      HorizontalAlignment="Left"
                      Margin="0,2,0,2" />
    </DataTemplate>

    <!-- ── Linked-chat chip (inline when Lumi orchestrates a chat via manage_chats) ── -->
    <DataTemplate DataType="vm:LinkedChatItem">
      <ContentControl x:Name="LinkedChatChipHost"
                      Content="{Binding Chip}"
                      ContentTemplate="{StaticResource LinkedChatChipTemplate}"
                      HorizontalAlignment="Left"
                      Margin="0,2,0,2" />
    </DataTemplate>

    <!-- ── Error message ─────────────────────────────── -->
    <DataTemplate DataType="vm:ErrorMessageItem">
      <Border Classes="transcript-error" HorizontalAlignment="Left" MaxWidth="700">
        <!-- Grid (not a horizontal StackPanel) so the text column is width-constrained
             and TextWrapping actually wraps instead of overflowing/clipping. The icon sits on the
             first line's centre (a 17px line, as in the chips), so it stays with the text however
             long it wraps. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <sc:StrataLineIcon Width="15" Height="15" Margin="0,1,9,0" VerticalAlignment="Top"
                             Data="{x:Static sc:StrataIcons.Alert}"
                             Foreground="{DynamicResource Brush.DangerDefault}" />
          <TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap"
                     VerticalAlignment="Center" LineHeight="17"
                     FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" />
          <!-- A quiet accent action, like "Show diff": the card stays a single 31px line. -->
          <Button Grid.Column="2" Classes="transcript-diff" Margin="10,-3,-5,-3"
                  VerticalAlignment="Center"
                  Command="{Binding RetryCommand}"
                  IsVisible="{Binding ShowRetryButton}">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <sc:StrataLineIcon Width="12" Height="12" VerticalAlignment="Center"
                                 Data="{x:Static sc:StrataIcons.Retry}" />
              <TextBlock Text="{loc:Str Common_TryAgain}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ── Reasoning block ──────────────────────────── -->
    <DataTemplate DataType="vm:ReasoningItem">
      <sc:StrataThink Label="{loc:Str Tool_ReasoningLabel}"
                      Icon="{x:Static sc:StrataIcons.Lightbulb}"
                      Meta="{Binding Summary}"
                      MaxContentHeight="240"
                      IsExpanded="{Binding IsExpanded}"
                      IsActive="{Binding IsActive}">
        <sc:StrataThink.Content>
          <lc:TranscriptTextContent Margin="7,0,7,4"
                                    Text="{Binding Content}"
                                    PreferPlainText="{Binding IsActive}"
                                    RenderMarkdownWhileStreaming="True" />
        </sc:StrataThink.Content>
      </sc:StrataThink>
    </DataTemplate>

    <!-- ── Tool group (collapsible) ─────────────────── -->
    <DataTemplate DataType="vm:ToolGroupItem">
      <Panel>
        <!-- A lone step stands on its own as a chip, with the Strata line under it while it works. -->
        <Panel Classes="single-step" IsVisible="{Binding IsSingleTool}">
          <ContentControl Content="{Binding SingleTool}" />
          <Border Classes="single-step-line" IsVisible="{Binding IsActive}" />
        </Panel>
        <sc:StrataThink x:Name="ToolGroupCard"
                        Classes="activity-group"
                        Label="{Binding Label}"
                        Icon="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}"
                        HasError="{Binding HasFailures}"
                        AutomationProperties.Name="{Binding Label}"
                        IsVisible="{Binding !IsSingleTool}"
                        Meta="{Binding Meta}"
                        IsExpanded="{Binding IsExpanded}"
                        IsActive="{Binding IsActive}"
                        ProgressValue="{Binding ProgressValue}">
          <sc:StrataThink.PreviewContent>
            <StackPanel x:Name="ToolGroupActivityPreview"
                        IsVisible="{Binding HasActivityPreview}">
              <ItemsControl ItemsSource="{Binding ActivityPreview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ToolActivityPreviewItem">
                    <Panel>
                      <DockPanel Classes="activity-preview-row" IsVisible="{Binding !HasSteps}">
                        <sc:StrataLineIcon DockPanel.Dock="Left"
                                           Data="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}" />
                        <sc:StrataElapsedText DockPanel.Dock="Right"
                                              Classes="activity-preview-elapsed"
                                              Since="{Binding RunningSince}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,5">
                          <TextBlock Classes="activity-preview-label"
                                     Text="{Binding Label}"
                                     ToolTip.Tip="{Binding Label}" />
                          <TextBlock Classes="activity-preview-detail"
                                     Classes.command="{Binding IsCommand}"
                                     Text="{Binding Detail}"
                                     ToolTip.Tip="{Binding Detail}"
                                     IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </DockPanel>
                      <ItemsControl Classes="plan-glance"
                                    ItemsSource="{Binding Steps}"
                                    IsVisible="{Binding HasSteps}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding AdditionalActivityLabel}"
                         Margin="29,2,0,2" FontSize="12"
                         Foreground="{DynamicResource Brush.TextTertiary}"
                         TextTrimming="CharacterEllipsis" MaxLines="1"
                         IsVisible="{Binding AdditionalActivityLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </sc:StrataThink.PreviewContent>
          <sc:StrataThink.Content>
            <ScrollViewer MaxHeight="{StaticResource Chat.ToolGroupContentMaxHeight}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="ToolGroupDetails" ItemsSource="{Binding ToolCalls}">
                <ItemsControl.Styles>
                  <Style Selector="sc|StrataAiToolCall">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MaxWidth" Value="Infinity" />
                  </Style>
                  <Style Selector="sc|StrataTerminalPreview">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MaxWidth" Value="Infinity" />
                  </Style>
                </ItemsControl.Styles>
              </ItemsControl>
            </ScrollViewer>
          </sc:StrataThink.Content>
        </sc:StrataThink>
      </Panel>
    </DataTemplate>

    <!-- ── Single tool (flattened — a chip of its own) ── -->
    <DataTemplate DataType="vm:SingleToolItem">
      <sc:StrataThink Label="{Binding Label}"
                      HeaderCommand="{Binding HeaderCommand}"
                      Icon="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}"
                      HasError="{Binding HasError}"
                      Meta="{Binding Meta}"
                      IsExpanded="{Binding IsExpanded}"
                      IsActive="{Binding IsActive}">
        <sc:StrataThink.HeaderExtra>
          <Button Classes="transcript-diff" Command="{Binding ShowDiffCommand}"
                  IsVisible="{Binding HasDiff}" Margin="4,-3,0,-3">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <sc:StrataLineIcon Width="12" Height="12" VerticalAlignment="Center"
                                 Data="{x:Static sc:StrataIcons.Diff}" />
              <TextBlock Text="{loc:Str ShowDiff}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </sc:StrataThink.HeaderExtra>
        <sc:StrataThink.Content>
          <StackPanel Spacing="8" MaxWidth="760" Margin="7,0,7,4">
            <!-- What the step was given, as fields, and what it reported -->
            <Border Classes="transcript-well" IsVisible="{Binding HasDetails}">
              <sc:StrataToolDetails Parameters="{Binding InputParameters}"
                                    Result="{Binding ResultText}"
                                    IsFailed="{Binding HasError}" />
            </Border>
            <!-- A lone plan lists its steps -->
            <ContentControl Content="{Binding Plan}" IsVisible="{Binding IsPlan}" />
            <!-- Terminal: the command, then its output -->
            <Border Classes="transcript-well" IsVisible="{Binding IsTerminal}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,6,*">
                  <TextBlock Classes="console-text" Text="$" FontSize="12"
                             Foreground="{DynamicResource Brush.TerminalPreviewPrompt}" />
                  <TextBlock Grid.Column="2" Classes="console-text" FontSize="12"
                             Text="{Binding TerminalCommand}"
                             Foreground="{DynamicResource Brush.TerminalPreviewCommand}" />
                </Grid>
                <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding TerminalOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Classes="console-text" Text="{Binding TerminalOutput}"
                             Foreground="{DynamicResource Brush.TerminalPreviewOutput}" />
                </ScrollViewer>
              </StackPanel>
            </Border>
          </StackPanel>
        </sc:StrataThink.Content>
      </sc:StrataThink>
    </DataTemplate>

    <!-- ── Sub-agent run (transcript) ──
         In the chat a delegated agent is one collapsed line: who ran, what it was asked to do, and
         how it ended. Everything else — its reasoning, messages and tool calls — lives on the
         Workspace's read-only Agents page, which the row opens. Keeping this to a single row means
         a fan-out of six agents costs six lines instead of six cards. The model is on the run page,
         so the line keeps to the task and the agent. -->
    <DataTemplate DataType="vm:SubagentToolCallItem">
      <Button Classes="agent-row" Command="{Binding OpenRunCommand}"
              ToolTip.Tip="{loc:Str Subagent_OpenTranscriptTip}">
        <sc:StrataAgentRun Classes="inline"
                           AgentName="{Binding DisplayName}"
                           Title="{Binding Title}"
                           Initial="{Binding Initial}"
                           AccentBrush="{Binding AccentIndex, Converter={StaticResource ChartBrush}}"
                           Status="{Binding Status}"
                           StatusLabel="{Binding StatusText}"
                           DurationMs="{Binding DurationMs}"
                           RunningSince="{Binding StartedAt}">
          <sc:StrataAgentRun.HeaderAction>
            <sc:StrataLineIcon Classes="agent-row-open" Data="{x:Static sc:StrataIcons.ChevronRight}" />
          </sc:StrataAgentRun.HeaderAction>
        </sc:StrataAgentRun>
      </Button>
    </DataTemplate>

    <!-- ── Parallel agents fan-out ──
         Collapsible, like a tool group: one header line while the batch is finished, opened
         automatically only while agents are still working so live work stays visible. -->
    <DataTemplate DataType="vm:SubagentGroupItem">
      <sc:StrataThink Classes="agent-group"
                      Label="{Binding HeaderLabel}"
                      Icon="{x:Static sc:StrataIcons.People}"
                      HasError="{Binding HasFailed}"
                      Meta="{Binding Meta}"
                      IsExpanded="{Binding IsExpanded}"
                      IsActive="{Binding IsActive}"
                      ProgressValue="{Binding ProgressValue}">
        <sc:StrataThink.HeaderExtra>
          <!-- Stacked avatars: who is in this batch, readable before opening it. -->
          <ItemsControl ItemsSource="{Binding Subagents}" VerticalAlignment="Center" Margin="2,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="-6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:SubagentToolCallItem">
                <Border Classes="agent-cluster-avatar"
                        ToolTip.Tip="{Binding DisplayName}"
                        Background="{Binding AccentIndex, Converter={StaticResource ChartBrush}}">
                  <TextBlock Text="{Binding Initial}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </sc:StrataThink.HeaderExtra>
        <sc:StrataThink.Content>
          <ItemsControl ItemsSource="{Binding Subagents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:SubagentToolCallItem">
                <Button Classes="agent-row" Command="{Binding OpenRunCommand}"
                        ToolTip.Tip="{loc:Str Subagent_OpenTranscriptTip}">
                  <sc:StrataAgentRun Classes="inline"
                                     AgentName="{Binding DisplayName}"
                                     Title="{Binding Title}"
                                     Initial="{Binding Initial}"
                                     AccentBrush="{Binding AccentIndex, Converter={StaticResource ChartBrush}}"
                                     Status="{Binding Status}"
                                     StatusLabel="{Binding StatusText}"
                                     DurationMs="{Binding DurationMs}"
                                     RunningSince="{Binding StartedAt}">
                    <sc:StrataAgentRun.HeaderAction>
                      <sc:StrataLineIcon Classes="agent-row-open" Data="{x:Static sc:StrataIcons.ChevronRight}" />
                    </sc:StrataAgentRun.HeaderAction>
                  </sc:StrataAgentRun>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </sc:StrataThink.Content>
      </sc:StrataThink>
    </DataTemplate>


    <!-- ── Question card ────────────────────────────── -->
    <DataTemplate DataType="vm:InputRequestItem">
      <sc:StrataInteractiveBlock Definition="{Binding Definition}" StateJson="{Binding StateJson}"
                                Language="{Binding Language}" InputStatus="{Binding InputStatus}"
                                CanSubmit="{Binding CanSubmit}" IsHosted="True" />
    </DataTemplate>

    <DataTemplate DataType="vm:InteractionReceiptItem">
      <sc:StrataActionReceipt Title="{Binding Receipt.Title}" Summary="{Binding Receipt.Summary}"
                             Detail="{Binding Receipt.Detail}" Status="{Binding Receipt.Status}"
                             Error="{Binding Receipt.Error}" Action="{Binding Receipt.Action}"
                             Language="{Binding Language}" Margin="0,4" />
    </DataTemplate>

    <DataTemplate DataType="vm:QuestionItem">
      <sc:StrataQuestionCard Question="{Binding Question}"
                             OptionsList="{Binding OptionsList}"
                             AllowFreeText="{Binding AllowFreeText}"
                             AllowMultiSelect="{Binding AllowMultiSelect}"
                             SelectedAnswer="{Binding SelectedAnswer, Mode=TwoWay}"
                             IsAnswered="{Binding IsAnswered, Mode=TwoWay}"
                             IsExpired="{Binding IsExpired}"
                             Margin="0,4" />
    </DataTemplate>

    <!-- ── Approval card: a native permission request, where the work waits for it ── -->
    <DataTemplate DataType="vm:ApprovalItem">
      <sc:StrataApprovalCard x:Name="ApprovalCard"
                             Icon="{Binding Request.IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}"
                             Title="{Binding Request.Title}"
                             StatusText="{Binding Request.StatusText}"
                             Intention="{Binding Request.Intention}"
                             Subject="{Binding Request.Subject}"
                             IsSubjectCode="{Binding Request.IsCommand}"
                             NoteLabel="{loc:Str Approval_Reviewer}"
                             Note="{Binding Request.ReviewerReason}"
                             Warning="{Binding Request.CardWarning}"
                             IsEscalation="{Binding Request.IsEscalation}"
                             DetailsLabel="{loc:Str Approval_Details}"
                             ShowDetails="{Binding Request.HasAnyDetail}"
                             Error="{Binding Request.Error}"
                             Status="{Binding Request.CardStatus}"
                             Receipt="{Binding Request.ReceiptText}"
                             Margin="0,4">
        <sc:StrataApprovalCard.Details>
          <Panel>
            <sc:StrataDiffView UnifiedDiffText="{Binding Request.Diff}"
                               FilePath="{Binding Request.Subject}"
                               IsVisible="{Binding Request.HasDiff}" />
            <SelectableTextBlock Text="{Binding Request.Detail}"
                                 IsVisible="{Binding !Request.HasDiff}"
                                 FontFamily="{DynamicResource Font.FamilyMono}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
          </Panel>
        </sc:StrataApprovalCard.Details>
        <sc:StrataApprovalCard.Actions>
          <StackPanel Spacing="8">
            <!-- Deny with a note: the agent reads it and changes course. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding Request.IsFeedbackOpen}">
              <TextBox x:Name="ApprovalFeedbackBox"
                       Text="{Binding Request.Feedback}"
                       PlaceholderText="{loc:Str Approval_FeedbackPlaceholder}"
                       FontSize="13" MinHeight="34" Padding="11,7" CornerRadius="10"
                       Background="{DynamicResource Brush.GlassWell}"
                       BorderBrush="{DynamicResource Brush.GlassDivider}" />
              <Button x:Name="ApprovalSendFeedbackButton" Grid.Column="1" Classes="accent"
                      Content="{loc:Str Approval_DenyAndSend}" Command="{Binding Request.SendFeedbackCommand}"
                      Padding="12,6" MinHeight="0" CornerRadius="10" />
              <Button Grid.Column="2" Classes="subtle"
                      Content="{loc:Str Approval_Cancel}" Command="{Binding Request.CancelFeedbackCommand}"
                      Padding="10,6" MinHeight="0" CornerRadius="10" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !Request.IsFeedbackOpen}">
              <WrapPanel Orientation="Horizontal">
                <Button x:Name="ApprovalAllowButton" Classes="accent"
                        Content="{loc:Str Approval_Allow}" Command="{Binding Request.AllowOnceCommand}"
                        IsVisible="{Binding Request.CanAllow}"
                        Padding="14,6" MinHeight="0" CornerRadius="10" Margin="0,0,6,4" />
                <Button x:Name="ApprovalAllowChatButton" Classes="subtle"
                        Content="{loc:Str Approval_AllowChat}" Command="{Binding Request.AllowForChatCommand}"
                        IsVisible="{Binding Request.CanRemember}"
                        Padding="12,6" MinHeight="0" CornerRadius="10" Margin="0,0,6,4" />
                <Button x:Name="ApprovalAllowProjectButton" Classes="subtle"
                        Content="{Binding Request.AllowForProjectShortLabel}" Command="{Binding Request.AllowForProjectCommand}"
                        IsVisible="{Binding Request.CanRememberForProject}"
                        Padding="12,6" MinHeight="0" CornerRadius="10" Margin="0,0,6,4" />
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <Button x:Name="ApprovalDenyButton" Classes="subtle"
                        Content="{loc:Str Approval_Deny}" Command="{Binding Request.DenyCommand}"
                        Padding="12,6" MinHeight="0" CornerRadius="10" />
                <Button x:Name="ApprovalExplainButton" Classes="subtle"
                        Command="{Binding Request.OpenFeedbackCommand}"
                        ToolTip.Tip="{loc:Str Approval_DenyWithNote}"
                        ToolTip.Placement="Top"
                        AutomationProperties.Name="{loc:Str Approval_DenyWithNote}"
                        Width="32" Height="30" Padding="0" MinHeight="0" CornerRadius="10">
                  <sc:StrataLineIcon Width="14" Height="14" StrokeThickness="1.8"
                                     Data="{x:Static sc:StrataIcons.Pencil}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Request.RememberHint}"
                       IsVisible="{Binding Request.HasRememberHint}"
                       FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
          </StackPanel>
        </sc:StrataApprovalCard.Actions>
      </sc:StrataApprovalCard>
    </DataTemplate>

    <!-- ── Typing indicator ─────────────────────────── -->
    <DataTemplate DataType="vm:TypingIndicatorItem">
      <!-- The indicator gets only the width the action leaves, so a long label still trims. -->
      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
        <sc:StrataTypingIndicator Label="{Binding Label}"
                                  IsActive="{Binding IsActive}"
                                  VerticalAlignment="Top" />
        <!-- An action offered while Lumi waits, such as sending without a connector sign-in.
             A compact Strata button shaped and offset like the indicator pill, so the row keeps its height. -->
        <Button x:Name="TypingIndicatorAction"
                Grid.Column="1"
                Content="{Binding ActionLabel}"
                Command="{Binding ActionCommand}"
                IsVisible="{Binding ActionCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="8,4,0,0" Padding="10,4" MinHeight="0" CornerRadius="999"
                FontSize="12" VerticalAlignment="Top" />
      </Grid>
    </DataTemplate>

    <!-- ── Turn summary ─────────────────────────────── -->
    <DataTemplate DataType="vm:TurnSummaryItem">
      <sc:StrataTurnSummary Label="{Binding Label}"
                            IsExpanded="{Binding IsExpanded}"
                            HasFailures="{Binding HasFailures}"
                            Classes.motion-disabled="{Binding !$parent[views:ChatView].((vm:ChatViewModel)DataContext).AreAnimationsEnabled}">
        <sc:StrataTurnSummary.Content>
          <!-- Long work scrolls within a bounded area, so the row's header is never far away. The
               steps appear from the top a few at a time, so opening hours of work stays instant. -->
          <ScrollViewer MaxHeight="{StaticResource Chat.ToolGroupContentMaxHeight}"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <lc:ProgressiveItemsControl Source="{Binding InnerItems}">
              <lc:ProgressiveItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </lc:ProgressiveItemsControl.ItemsPanel>
            </lc:ProgressiveItemsControl>
          </ScrollViewer>
        </sc:StrataTurnSummary.Content>
      </sc:StrataTurnSummary>
    </DataTemplate>

    <!-- ── Earlier exchange not built yet ───────────── -->
    <!-- Holds the exchange's place (its last measured height, or an estimate) until it is read and
         built as the reader scrolls near it. Empty, so scrolling quickly past history stays calm. -->
    <DataTemplate DataType="vm:HistoryPlaceholderItem">
      <Border Height="{Binding Height}" Background="Transparent" IsHitTestVisible="False" />
    </DataTemplate>

  </UserControl.DataTemplates>

  <Panel DragDrop.AllowDrop="True">
    <!-- Lumi's ambient "presence" glow is NOT here: it lives as a single decoupled layer
         behind this whole chat/workspace surface, owned and driven by PresenceController
         (Lumi.Presence). This view stays presence-free and shows the glow through its
         translucent surfaces. -->

    <!-- Drop overlay -->
    <Panel x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
           ZIndex="100">
      <!-- Dimming backdrop -->
      <Border Background="{DynamicResource Brush.Surface0}" Opacity="0.85" />
      <!-- Accent border inset -->
      <Border Margin="16" CornerRadius="12" BorderThickness="2"
              BorderBrush="{DynamicResource Brush.AccentDefault}" />
      <!-- Centered content -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Border Width="56" Height="56" CornerRadius="28"
                Background="{DynamicResource Brush.AccentSubtle}"
                HorizontalAlignment="Center">
          <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <!-- Upload/drop arrow icon -->
              <Path Stroke="{DynamicResource Brush.AccentDefault}"
                    StrokeThickness="2.2" StrokeLineCap="Round"
                    Data="M12,2 L12,16 M12,2 L7,7 M12,2 L17,7" />
              <Path Stroke="{DynamicResource Brush.AccentDefault}"
                    StrokeThickness="2.2" StrokeLineCap="Round"
                    Data="M4,17 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,17" />
            </Canvas>
          </Viewbox>
        </Border>
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Text="{loc:Str DragDrop_Hint}" Classes="body-strong" FontSize="15"
                     Foreground="{DynamicResource Brush.AccentDefault}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Str DragDrop_Subhint}" Classes="caption"
                     Foreground="{DynamicResource Brush.TextTertiary}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Panel>

    <!-- Welcome state (no active chat): Lumi's launchpad. A personal greeting that says what is
         waiting on the user, starters for the hour, and the chats worth picking up. The user's
         usual setups live on the composer below, which they configure. -->
    <Panel x:Name="WelcomePanel" Classes.active="{Binding IsWelcomeVisible}">
      <!-- Bottom margin tracks the composer's height (code-behind), so the launchpad centers in
           the space above it and scrolls rather than slides under it on short windows. -->
      <ScrollViewer x:Name="WelcomeScroller"
                    Margin="0,0,0,140"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="WelcomeGreeting"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    MaxWidth="680">

          <StackPanel x:Name="LaunchpadHero" HorizontalAlignment="Center" Spacing="8">
            <Border x:Name="WelcomeOrb" Width="56" Height="56" CornerRadius="14"
                    HorizontalAlignment="Center" Opacity="0.95" ClipToBounds="True"
                    Margin="0,0,0,8">
              <Image Source="{DynamicResource Image.LumiMark}"
                     Width="56" Height="56"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
            <TextBlock x:Name="LaunchpadGreeting" Classes="launchpad-greeting">
              <Run Text="{Binding Launchpad.GreetingLead}" /><Run Text="{Binding Launchpad.GreetingName}"
                   Foreground="{DynamicResource Brush.AccentDefault}" /><Run Text="{Binding Launchpad.GreetingTrail}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Border x:Name="LaunchpadLiveDot" Classes="launchpad-live-dot"
                      IsVisible="{Binding Launchpad.HasLiveWork}" />
              <TextBlock x:Name="LaunchpadBrief" Classes="launchpad-brief"
                         Text="{Binding Launchpad.Brief}" />
            </StackPanel>
          </StackPanel>

          <!-- Starters for the hour (the presence glow pools between these and the Lumi mark) -->
          <ItemsControl x:Name="WelcomeSuggestions"
                        ItemsSource="{Binding Launchpad.Starters}"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LaunchpadStarterItem">
                <Button Classes="transcript-suggestion launchpad-starter"
                        Margin="4,0,4,8"
                        Command="{Binding SendCommand}"
                        ToolTip.Tip="{Binding Prompt}"
                        ToolTip.ShowDelay="500"
                        AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Glyph}" />
                    <TextBlock Classes="starter-label" Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- A well-known setup Lumi noticed (such as Microsoft 365), until the user answers it.
               Only the main window's chat has SetupSuggestions; elsewhere this stays empty. -->
          <Panel x:Name="LaunchpadSetupSuggestion" Margin="0,8,0,0"
                 DataContext="{Binding SetupSuggestions}"
                 IsVisible="{Binding HasCurrent, FallbackValue=False}">
            <views:SetupSuggestionView DataContext="{Binding Current}" />
          </Panel>

          <!-- What's going on: chats to pick up (most urgent first) and the automations on watch -->
          <Border x:Name="LaunchpadActivity" Classes="launchpad-card"
                  Margin="0,16,0,0"
                  IsVisible="{Binding Launchpad.HasActivityCard}">
            <StackPanel>
              <TextBlock Classes="launchpad-section-label"
                         Text="{loc:Str Launchpad_PickUpTitle}"
                         Margin="10,6,10,4"
                         IsVisible="{Binding Launchpad.HasPickUpItems}" />
              <ItemsControl x:Name="LaunchpadPickUp" ItemsSource="{Binding Launchpad.PickUpItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LaunchpadChatItem">
                    <Button Theme="{StaticResource LaunchpadRowButton}"
                            Classes="launchpad-row"
                            Classes.waiting="{Binding IsWaiting}"
                            Classes.reply="{Binding IsReply}"
                            Classes.working="{Binding IsWorking}"
                            Command="{Binding OpenCommand}"
                            AutomationProperties.Name="{Binding Title}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Panel Width="32" Height="32" VerticalAlignment="Center">
                          <Border Classes="launchpad-state-tile" />
                          <Border Classes="launchpad-badge-tile"
                                  Background="{Binding BadgeBackground}"
                                  IsVisible="{Binding ShowProjectBadge}" />
                          <TextBlock Classes="launchpad-badge-initial"
                                     Text="{Binding BadgeInitial}"
                                     Foreground="{Binding BadgeForeground}"
                                     IsVisible="{Binding ShowProjectBadge}" />
                          <PathIcon Classes="launchpad-state-icon"
                                    Data="{Binding StateIcon}"
                                    IsVisible="{Binding HasStateIcon}" />
                          <Border Classes="launchpad-state-dot" IsVisible="{Binding IsReply}" />
                          <Border Classes="launchpad-state-ring live" IsVisible="{Binding IsWorking}" />
                          <Border Classes="launchpad-state-ring" IsVisible="{Binding IsBackground}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="launchpad-row-time"
                                       Text="{Binding TimeLabel}" Margin="10,0,0,0" />
                            <TextBlock Classes="launchpad-row-title" Text="{Binding Title}" />
                          </DockPanel>
                          <DockPanel IsVisible="{Binding HasSecondLine}">
                            <TextBlock DockPanel.Dock="Left" Classes="launchpad-row-state"
                                       Text="{Binding StateLabel}"
                                       IsVisible="{Binding HasStateLabel}" />
                            <TextBlock Classes="launchpad-row-meta" Text="{Binding Meta}" />
                          </DockPanel>
                        </StackPanel>
                        <PathIcon Grid.Column="2" Classes="launchpad-row-chevron"
                                  Data="{x:Static vm:WorkspaceIcons.Chevron}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="launchpad-divider" IsVisible="{Binding Launchpad.HasPickUpAndAutomations}" />
              <Button x:Name="LaunchpadAutomations"
                      Theme="{StaticResource LaunchpadRowButton}"
                      Classes="launchpad-row"
                      Padding="10,7"
                      Command="{Binding Launchpad.OpenAutomationsCommand}"
                      IsVisible="{Binding Launchpad.HasAutomations}"
                      ToolTip.Tip="{loc:Str Launchpad_AutomationsTooltip}"
                      AutomationProperties.Name="{Binding Launchpad.AutomationSummary}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Panel Width="32" Height="20">
                    <PathIcon Width="15" Height="15"
                              Foreground="{DynamicResource Brush.TextTertiary}"
                              Data="{x:Static vm:WorkspaceIcons.Clock}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Classes="launchpad-footer-text"
                             Text="{Binding Launchpad.AutomationSummary}" />
                  <PathIcon Grid.Column="2" Classes="launchpad-row-chevron"
                            Data="{x:Static vm:WorkspaceIcons.Chevron}" />
                </Grid>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Panel>

    <!-- Invisible click-guard, raised only while a chat loads / its transcript is still realizing
         (outside ChatPanel so it also guards the welcome screen). It paints NOTHING: the loading
         "look" is now the transcript itself materialising — it clears instantly on load and then
         gently fades + rises back into place once settled (driven from ChatView code-behind). The
         load gap therefore shows Lumi's real translucent, presence-lit surface (the ambient field
         breathing through) instead of a dead opaque slab. The Transparent background still captures
         pointer input so clicks can't reach a half-realized transcript, and the whole guard detaches
         (collapsed + hit-invisible) the instant loading ends. -->
    <Panel x:Name="LoadingOverlay" ZIndex="50"
           Background="Transparent"
           IsVisible="{Binding IsChatSurfaceLoading}"
           IsHitTestVisible="{Binding IsChatSurfaceLoading}" />

    <!-- Active chat -->
    <Panel x:Name="ChatPanel" Classes.active="{Binding IsChatVisible}">
      <!-- ReadingLineGap: jumps land a message clear of the header's frost, which fades out 40px below
           the header (HeaderEdgeMaterial), so the landed message and its glow read crisply. -->
      <sc:StrataChatShell x:Name="ChatShell"
                          Classes="glass-header"
                          IsOnline="False"
                          ExtendsTranscriptBehindChrome="True"
                          ShowsTranscriptRail="True"
                          ReadingLineGap="40"
                          IsStreaming="{Binding IsTranscriptStreaming}">

        <sc:StrataChatShell.Header>
          <!-- Floating glass header: pills anchored to the island's edges over a transcript that runs
               underneath. The veil frosts only while history is behind it. That Lumi is working shows
               in one place, the composer's send button, which also stops it. -->
          <Panel x:Name="ChatHeaderLayer" Classes.busy="{Binding IsBusy}"
                 TextOptions.TextRenderingMode="Antialias">
            <!-- Full frost behind the pills, then a fade, so history never reads crisply beneath them. -->
            <Panel x:Name="HeaderEdgeMaterial"
                   VerticalAlignment="Top"
                   Height="96"
                   Margin="0,0,0,-40"
                   IsHitTestVisible="False">
              <sc:StrataBackdropBlur BlurRadius="12" Saturation="1.15" Fade="Bottom" FadeLength="40" />
              <Border Background="{StaticResource ChatHeader.EdgeVeil}">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FF000000" />
                    <GradientStop Offset="0.5" Color="#E6000000" />
                    <GradientStop Offset="0.62" Color="#B3000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
            </Panel>

            <DockPanel x:Name="ChatHeaderBar" Height="36" Margin="12,10,12,10" LastChildFill="False">
              <!-- Right: what still runs, where the chat works, then its tools. Docked first so they keep
                   their room. -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                <Button x:Name="HeaderRunningButton"
                        Theme="{StaticResource StrataGlassButton}"
                        Classes="header-pill"
                        IsVisible="{Binding ShowHeaderRunning}"
                        Click="OnHeaderRunningClick"
                        ToolTip.Tip="{Binding HeaderRunningToolTip}"
                        ToolTip.Placement="Bottom"
                        ToolTip.VerticalOffset="6"
                        AutomationProperties.Name="{Binding HeaderRunningText}"
                        AutomationProperties.HelpText="{Binding HeaderRunningToolTip}">
                  <!-- Once Lumi is ready, everything still running, live, with the way to stop it. -->
                  <FlyoutBase.AttachedFlyout>
                    <Flyout Placement="BottomEdgeAlignedRight"
                            HorizontalOffset="16"
                            VerticalOffset="-8"
                            FlyoutPresenterTheme="{StaticResource ChatHeaderCardPresenter}">
                      <StackPanel Name="BackgroundSessionStatus" Width="372">
                        <StackPanel.Styles>
                          <!-- One task per row, in the Workspace agents index's row language: flat, hover-lit,
                               and the whole row is the hit area. It opens an agent's run on the Agents page,
                               or shows the newest output of a command or task. -->
                          <Style Selector="Button.session-task">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,8" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                              <ControlTemplate>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Background="{TemplateBinding Background}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center">
                                  <ContentPresenter.Transitions>
                                    <Transitions>
                                      <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.15" />
                                    </Transitions>
                                  </ContentPresenter.Transitions>
                                </ContentPresenter>
                              </ControlTemplate>
                            </Setter>
                          </Style>
                          <Style Selector="Button.session-task:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemHover}" />
                          </Style>
                          <Style Selector="Button.session-task:pressed /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemPressed}" />
                          </Style>
                          <Style Selector="Button.session-task:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource ChatHeader.MenuItemHover}" />
                          </Style>
                          <!-- A task with nothing to open or show yet is just a readout, never greyed out:
                               it is still running. -->
                          <Style Selector="Button.session-task:disabled">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="1" />
                          </Style>
                          <Style Selector="Button.session-task:disabled /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                          </Style>

                          <!-- Every listed task is running, so the pulsing dot and the clock say it all. -->
                          <Style Selector="sc|StrataAgentRun.session-task:inprogress /template/ TextBlock#PART_StatusText">
                            <Setter Property="IsVisible" Value="False" />
                          </Style>
                          <!-- A task wears its kind's colour; commands wear a terminal tile instead. -->
                          <Style Selector="sc|StrataAgentRun.task" x:DataType="vm:SessionActivityItem">
                            <Setter Property="AccentBrush" Value="{Binding AccentIndex, Converter={StaticResource ChartBrush}}" />
                          </Style>
                          <Style Selector="sc|StrataAgentRun.task.command">
                            <Setter Property="AccentBrush" Value="#FF475569" />
                          </Style>
                          <!-- A command has no measurable progress, so it skips the agents' working rail. -->
                          <Style Selector="sc|StrataAgentRun.task.command /template/ ProgressBar#PART_Progress">
                            <Setter Property="IsVisible" Value="False" />
                          </Style>

                          <!-- The row's affordance stays quiet until hovered: › opens a run, ⌄ shows output. -->
                          <Style Selector="PathIcon.session-task-affordance">
                            <Setter Property="Width" Value="11" />
                            <Setter Property="Height" Value="11" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="RenderTransform" Value="rotate(0deg)" />
                            <Setter Property="Transitions">
                              <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                              </Transitions>
                            </Setter>
                          </Style>
                          <Style Selector="Button.session-task:pointerover PathIcon.session-task-affordance">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
                            <Setter Property="Opacity" Value="1" />
                          </Style>
                          <Style Selector="PathIcon.session-task-affordance.expanded">
                            <Setter Property="RenderTransform" Value="rotate(180deg)" />
                          </Style>

                          <!-- The newest output, terminal-style, under the row that owns it. -->
                          <Style Selector="Border.session-task-output">
                            <Setter Property="Margin" Value="46,0,8,6" />
                            <Setter Property="Padding" Value="9,7" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Background" Value="{StaticResource ChatHeader.MenuChipFill}" />
                          </Style>
                        </StackPanel.Styles>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="10,10,10,12">
                          <Border Classes="header-card-tile">
                            <Border Classes="header-live-dot" HorizontalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="header-card-title" Text="{loc:Str Chat_AssistantReady}" />
                            <TextBlock Classes="header-card-row-detail" Text="{Binding BackgroundActivityText}" />
                          </StackPanel>
                        </Grid>
                        <Border Classes="header-card-divider" Margin="0,0,0,4" />
                        <ScrollViewer MaxHeight="380"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding HasRunningSessionActivities}">
                          <ItemsControl Name="RunningSessionActivities"
                                        ItemsSource="{Binding RunningSessionActivities}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SessionActivityItem">
                                <StackPanel>
                                  <Button Classes="session-task"
                                          Command="{Binding ActivateCommand}"
                                          Content="{Binding Presented}"
                                          AutomationProperties.Name="{Binding Title}">
                                    <Button.DataTemplates>
                                      <!-- An agent this chat launched is its live run, exactly as the
                                           Workspace lists it; the row opens that run. -->
                                      <DataTemplate DataType="vm:SubagentToolCallItem">
                                        <sc:StrataAgentRun Classes="list session-task"
                                                           AgentName="{Binding DisplayName}"
                                                           Title="{Binding Title}"
                                                           Initial="{Binding Initial}"
                                                           AccentBrush="{Binding AccentIndex, Converter={StaticResource ChartBrush}}"
                                                           ModelName="{Binding ModelDisplayName}"
                                                           Activity="{Binding LatestActivityText}"
                                                           Status="{Binding Status}"
                                                           StatusLabel="{Binding StatusText}"
                                                           DurationMs="{Binding DurationMs}"
                                                           RunningSince="{Binding StartedAt}"
                                                           ProgressValue="{Binding ProgressValue}">
                                          <sc:StrataAgentRun.HeaderAction>
                                            <PathIcon Classes="session-task-affordance"
                                                      Data="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
                                          </sc:StrataAgentRun.HeaderAction>
                                        </sc:StrataAgentRun>
                                      </DataTemplate>

                                      <!-- Commands, client tasks and agents without a run in this chat. -->
                                      <DataTemplate DataType="vm:SessionActivityItem">
                                        <sc:StrataAgentRun Classes="list session-task task"
                                                           Classes.command="{Binding IsCommand}"
                                                           StatusLabel="{loc:Str Subagent_StatusRunning}"
                                                           AgentName="{Binding Owner}"
                                                           Title="{Binding Title}"
                                                           Initial="{Binding Initial}"
                                                           ModelName="{Binding Detail}"
                                                           Activity="{Binding Activity}"
                                                           RunningSince="{Binding StartedAt}"
                                                           ProgressValue="{Binding ProgressValue}">
                                          <sc:StrataAgentRun.HeaderAction>
                                            <PathIcon Classes="session-task-affordance"
                                                      Classes.expanded="{Binding IsExpanded}"
                                                      IsVisible="{Binding CanExpand}"
                                                      Data="M7 10l5 5 5-5z" />
                                          </sc:StrataAgentRun.HeaderAction>
                                        </sc:StrataAgentRun>
                                      </DataTemplate>
                                    </Button.DataTemplates>
                                  </Button>
                                  <Border Classes="session-task-output" IsVisible="{Binding IsExpanded}">
                                    <TextBlock Text="{Binding Output}"
                                               FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                               FontSize="10.5" LineHeight="15"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                  </Border>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Classes="header-card-row-detail"
                                   Margin="10,4,10,8"
                                   Text="{Binding BackgroundActivityNotice}"
                                   IsVisible="{Binding HasBackgroundActivityNotice}" />
                        <Border Classes="header-card-divider" />
                        <Button Name="StopBackgroundSession"
                                Classes="header-card-row danger"
                                Command="{Binding StopGenerationCommand}"
                                AutomationProperties.Name="{loc:Str Chat_StopSession}">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                               VerticalAlignment="Center"
                                               Data="{x:Static sc:StrataIcons.StopCircle}"
                                               Foreground="{DynamicResource Brush.DangerDefault}" />
                            <TextBlock Grid.Column="1" Classes="header-card-row-title" VerticalAlignment="Center"
                                       Text="{loc:Str Chat_StopSession}" />
                          </Grid>
                        </Button>
                      </StackPanel>
                    </Flyout>
                  </FlyoutBase.AttachedFlyout>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Who is running: the agents' faces and a terminal for commands, or a live dot until
                         the session says what runs. -->
                    <Border Classes="header-live-dot" Margin="6,0,0,0">
                      <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="!HasRunningSubagents" />
                          <Binding Path="!HasRunningCommands" />
                        </MultiBinding>
                      </Border.IsVisible>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="-7" VerticalAlignment="Center">
                      <ItemsControl ItemsSource="{Binding HeaderRunningAgents}"
                                    IsVisible="{Binding HasRunningSubagents}"
                                    VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="-7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SubagentToolCallItem">
                            <Border Classes="header-agent-avatar"
                                    Background="{Binding AccentIndex, Converter={StaticResource ChartBrush}}">
                              <TextBlock Text="{Binding Initial}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="header-agent-avatar command" IsVisible="{Binding HasRunningCommands}">
                        <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Terminal}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="header-pill-text" Text="{Binding HeaderRunningText}" />
                  </StackPanel>
                </Button>

                <!-- Where the chat works, once it has started (a new chat chooses on its composer): the
                     checkout opens its card, and what changed opens the changes in one click. -->
                <Panel x:Name="HeaderGitPill" IsVisible="{Binding ShowHeaderCheckout}">
                  <sc:StrataBackdropBlur Classes="header-pill-frost" CornerRadius="18" />
                  <Border Classes="header-tools">
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="HeaderGitButton"
                              Classes="subtle header-seg"
                              Classes.refreshing="{Binding IsRefreshingGitStatus}"
                              ToolTip.Tip="{loc:Str Git_HeaderTooltip}"
                              AutomationProperties.Name="{Binding GitBranchLabel}"
                              AutomationProperties.HelpText="{loc:Str Git_HeaderTooltip}">
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight"
                                      HorizontalOffset="16"
                                      VerticalOffset="-8"
                                      FlyoutPresenterTheme="{StaticResource ChatGitCardPresenter}"
                                      ItemContainerTheme="{StaticResource ChatTitleMenuItem}">
                            <MenuItem Header="{loc:Str Git_OpenTerminal}" Command="{Binding OpenInTerminalCommand}">
                              <MenuItem.Icon>
                                <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                                   Data="{x:Static sc:StrataIcons.Terminal}" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Git_OpenExplorer}" Command="{Binding OpenInExplorerCommand}">
                              <MenuItem.Icon>
                                <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                                   Data="{x:Static sc:StrataIcons.Folder}" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Git_OpenIDE}" Command="{Binding OpenInIDECommand}">
                              <MenuItem.Icon>
                                <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                                   Data="{StaticResource Chat.Icon.Code}" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <Separator Margin="6" Background="{StaticResource ChatHeader.MenuDivider}" />
                            <MenuItem Header="{loc:Str Git_CopyBranch}" Command="{Binding CopyBranchNameCommand}">
                              <MenuItem.Icon>
                                <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                                   Data="{x:Static sc:StrataIcons.Branch}" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Str Git_CopyPath}" Command="{Binding CopyDirectoryPathCommand}">
                              <MenuItem.Icon>
                                <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                                   Data="{x:Static sc:StrataIcons.Files}" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <Separator Margin="6" Background="{StaticResource ChatHeader.MenuDivider}" />
                            <MenuItem Header="{loc:Str Git_RefreshTooltip}"
                                      Command="{Binding RefreshGitStatusCommand}"
                                      IsEnabled="{Binding !IsRefreshingGitStatus}">
                              <MenuItem.Icon>
                                <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                                   Data="{x:Static sc:StrataIcons.Retry}" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Classes="git-tile">
                            <sc:StrataLineIcon Classes="git-icon" Data="{x:Static sc:StrataIcons.Branch}" />
                          </Border>
                          <TextBlock Classes="git-branch" Text="{Binding GitBranchLabel}" />
                          <TextBlock Classes="git-mode" Margin="-3,0,0,0"
                                     Text="{Binding GitCheckoutModeLabel, StringFormat='· {0}'}" />
                          <PathIcon Classes="header-chevron" Margin="1,1,0,0"
                                    Data="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z" />
                        </StackPanel>
                      </Button>
                      <Border Classes="header-seg-divider" IsVisible="{Binding ShowCheckoutChanges}" />
                      <Button x:Name="HeaderGitChangesButton"
                              Classes="subtle header-seg"
                              IsVisible="{Binding ShowCheckoutChanges}"
                              Command="{Binding ShowGitChangesCommand}"
                              ToolTip.Tip="{loc:Str Git_ShowChanges}"
                              AutomationProperties.Name="{Binding GitChangesLabel}"
                              AutomationProperties.HelpText="{loc:Str Git_ShowChanges}">
                        <Panel x:DataType="vm:GitChangesViewModel" DataContext="{Binding WorkspaceGit}">
                          <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasTotalStats}">
                            <TextBlock Classes="diff-added" Text="{Binding TotalAddedLabel}" />
                            <TextBlock Classes="diff-removed" Text="{Binding TotalRemovedLabel}" />
                          </StackPanel>
                          <TextBlock Classes="header-pill-text" Text="{Binding TotalFilesLabel}"
                                     IsVisible="{Binding !HasTotalStats}" />
                        </Panel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Panel>

                <Panel x:Name="HeaderToolsPill">
                  <sc:StrataBackdropBlur Classes="header-pill-frost" CornerRadius="18" />
                  <Border Classes="header-tools" Classes.motion-disabled="{Binding !AreAnimationsEnabled}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button x:Name="BrowserToggleButton"
                              Classes="subtle header-tool"
                              IsVisible="{Binding ShowBrowserToggle}"
                              Classes.open="{Binding IsBrowserOpen}"
                              Command="{Binding ToggleBrowserVisibilityCommand}"
                              ToolTip.Tip="{loc:Str Browser_ShowBrowser}"
                              ToolTip.Placement="Bottom"
                              ToolTip.VerticalOffset="8"
                              AutomationProperties.Name="{loc:Str Browser_ShowBrowser}">
                        <PathIcon x:Name="BrowserToggleIcon"
                                  Classes="tool-globe"
                                  Width="15"
                                  Height="15"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                      </Button>

                      <Button x:Name="DesktopPreviewButton"
                              Classes="subtle header-tool"
                              IsVisible="{Binding ShowDesktopToggle}"
                              Classes.open="{Binding IsHeaderDesktopActive}"
                              Command="{Binding RequestShowDesktopCommand}"
                              ToolTip.Tip="{loc:Str Desktop_ShowDesktop}"
                              ToolTip.Placement="Bottom"
                              ToolTip.VerticalOffset="8"
                              AutomationProperties.Name="{loc:Str Desktop_ShowDesktop}">
                        <PathIcon Classes="tool-screen"
                                  Width="15"
                                  Height="15"
                                  Data="{x:Static vm:WorkspaceIcons.Desktop}" />
                      </Button>

                      <!-- The Workspace: everything Lumi did in this chat. Running agents have their own pill. -->
                      <Button x:Name="WorkspaceToggleButton"
                              Classes="subtle header-tool"
                              Classes.open="{Binding IsHeaderWorkspaceActive}"
                              Command="{Binding ToggleWorkspacePanelCommand}"
                              ToolTip.Tip="{Binding WorkspaceToggleToolTip}"
                              ToolTip.Placement="Bottom"
                              ToolTip.VerticalOffset="8"
                              AutomationProperties.Name="{loc:Str Workspace_Title}">
                        <PathIcon x:Name="WorkspaceToggleIcon"
                                  Classes="tool-panels"
                                  Width="17"
                                  Height="17"
                                  Data="{x:Static vm:WorkspaceIcons.Workspace}" />
                      </Button>
                    </StackPanel>
                  </Border>
                </Panel>
              </StackPanel>

              <!-- Left: the chat itself. Its mark is the agent's glyph on the project's hue. Once the chat has
                   context, the pill splits like the git pill: the chat, then how full its context window is. -->
              <Panel x:Name="ChatTitlePill" DockPanel.Dock="Left">
                <Panel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="$parent[views:ChatView].ShowInternalTitle" />
                    <Binding Path="HasTokenUsage" />
                  </MultiBinding>
                </Panel.IsVisible>
                <sc:StrataBackdropBlur Classes="header-pill-frost" CornerRadius="18" />
                <Border Classes="header-tools">
                  <DockPanel>
                    <Button x:Name="ContextWindowButton"
                            DockPanel.Dock="Right"
                            Classes="subtle header-seg"
                            Classes.high="{Binding IsContextUsageHigh}"
                            IsVisible="{Binding HasTokenUsage}"
                            Command="{Binding OpenContextDetailsCommand}"
                            ToolTip.Tip="{Binding ContextRingToolTip}"
                            AutomationProperties.Name="{loc:Str Chat_ContextWindow_Title}"
                            AutomationProperties.HelpText="{Binding ContextRingToolTip}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft"
                                HorizontalOffset="-16"
                                VerticalOffset="-8"
                                FlyoutPresenterTheme="{StaticResource ChatHeaderCardPresenter}">
                          <StackPanel x:Name="ContextWindowFlyout" Width="340">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="10,10,6,0">
                              <Border Classes="header-card-tile">
                                <Panel Classes="context-ring-gauge" HorizontalAlignment="Center">
                                  <Ellipse Classes="context-ring-track" />
                                  <Arc Classes="context-ring-arc" SweepAngle="{Binding ContextUsageSweep}" />
                                </Panel>
                              </Border>
                              <TextBlock Grid.Column="1" Classes="header-card-title"
                                         Text="{loc:Str Chat_ContextWindow_Title}" />
                              <Button x:Name="ContextRefreshButton"
                                      Grid.Column="2"
                                      Classes="subtle header-card-icon"
                                      Command="{Binding RefreshContextDetailsCommand}"
                                      IsEnabled="{Binding CanRefreshContextDetails}"
                                      ToolTip.Tip="{loc:Str Chat_ContextWindow_Refresh}"
                                      AutomationProperties.Name="{loc:Str Chat_ContextWindow_Refresh}">
                                <sc:StrataLineIcon Width="14" Height="14" StrokeThickness="2"
                                                   Data="{x:Static sc:StrataIcons.Retry}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                              </Button>
                            </Grid>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="10,11,10,12">
                              <Border Classes="header-card-chip"
                                      IsVisible="{Binding ContextDetailsModelId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Width="10" Height="10" VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.AccentDefault}"
                                            Data="M8,1 L10,6 L15,8 L10,10 L8,15 L6,10 L1,8 L6,6 Z" />
                                  <TextBlock Text="{Binding ContextDetailsModelId, Converter={StaticResource ModelDisplayConverter}}" />
                                </StackPanel>
                              </Border>
                              <Border Classes="header-card-chip"
                                      IsVisible="{Binding ContextDetailsTierDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ContextDetailsTierDisplay}" />
                              </Border>
                              <Border Classes="header-card-chip health"
                                      IsVisible="{Binding ContextHealthDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ContextHealthDisplay}" />
                              </Border>
                            </WrapPanel>
                            <ProgressBar Height="2" MinHeight="2" Margin="10,0,10,8"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsContextPanelBusy}" />
                            <Border Classes="header-card-well" Margin="4,0,4,6" Padding="12,10,12,12">
                              <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                  <TextBlock Text="{Binding TokenUsageSummary}" FontSize="26" FontWeight="SemiBold"
                                             Foreground="{DynamicResource Brush.TextPrimary}" />
                                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding ContextUsageDetailDisplay}" FontSize="11.5"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextTertiary}" />
                                    <TextBlock Text="{Binding ContextRemainingDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" />
                                  </StackPanel>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ContextUsageProgress}"
                                             Height="6" MinHeight="6" CornerRadius="3" />
                                <TextBlock Text="{Binding ContextCompactionHeadroomDisplay}"
                                           IsVisible="{Binding HasContextCompactionThreshold}"
                                           FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" />
                              </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ContextBreakdownItems}"
                                          IsVisible="{Binding HasContextBreakdown}" Margin="1,0,1,6">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Columns="3" Rows="1" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContextTokenBreakdownItem">
                                  <Border Classes="header-card-well" Margin="3,0" Padding="9,8" CornerRadius="9">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding ShareDisplay}" FontSize="15" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource Brush.TextPrimary}" />
                                      <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                                      <TextBlock Text="{Binding TokensDisplay}" FontSize="10"
                                                 Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="4,0,4,6" Padding="9,7" CornerRadius="9"
                                    Background="{DynamicResource Brush.DangerSubtle}"
                                    IsVisible="{Binding HasContextDetailsError}">
                              <TextBlock Text="{Binding ContextDetailsError}" FontSize="11" TextWrapping="Wrap"
                                         Foreground="{DynamicResource Brush.DangerDefault}" />
                            </Border>
                            <TextBlock Text="{Binding ContextLastCompactionDisplay}"
                                       IsVisible="{Binding HasContextLastCompactionDisplay}"
                                       Margin="10,0,10,8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Border Classes="header-card-divider" />
                            <Button x:Name="ContextCompactButton"
                                    Classes="header-card-row"
                                    Command="{Binding CompactContextCommand}"
                                    IsEnabled="{Binding CanCompactContext}">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                                          Foreground="{DynamicResource Brush.TextSecondary}"
                                          Data="M4 5h16v2H4V5zm3 6h10v2H7v-2zm-3 6h16v2H4v-2z" />
                                <StackPanel Grid.Column="1" Spacing="1" Margin="0,7">
                                  <TextBlock Classes="header-card-row-title" Text="{loc:Str Chat_ContextWindow_CompactNow}" />
                                  <TextBlock Classes="header-card-row-detail" Text="{loc:Str Chat_ContextWindow_CompactDescription}" />
                                </StackPanel>
                              </Grid>
                            </Button>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel Classes="context-ring-gauge">
                          <Ellipse Classes="context-ring-track" />
                          <Arc Classes="context-ring-arc" SweepAngle="{Binding ContextUsageSweep}" />
                        </Panel>
                        <TextBlock Classes="context-ring-text"
                                   Text="{Binding ContextUsagePercent, StringFormat='{}{0}%'}"
                                   IsVisible="{Binding IsContextUsageHigh}" />
                      </StackPanel>
                    </Button>
                    <Border DockPanel.Dock="Right" Classes="header-seg-divider">
                      <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="$parent[views:ChatView].ShowInternalTitle" />
                          <Binding Path="HasTokenUsage" />
                        </MultiBinding>
                      </Border.IsVisible>
                    </Border>
                    <Button x:Name="ChatTitleButton"
                            Classes="subtle header-seg"
                            Classes.no-mark="{Binding HeaderMark, Converter={x:Static ObjectConverters.IsNull}}"
                            IsVisible="{Binding $parent[views:ChatView].ShowInternalTitle}"
                            ToolTip.Tip="{loc:Str ChatHeader_TitleMenu}"
                            ToolTip.Placement="Bottom"
                            ToolTip.VerticalOffset="8"
                            AutomationProperties.Name="{Binding CurrentChatTitle}"
                            AutomationProperties.HelpText="{loc:Str ChatHeader_TitleMenu}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Grid.Column="0"
                               Width="26"
                               Height="26"
                               Margin="0,0,9,0"
                               IsVisible="{Binding HeaderMark, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Panel x:DataType="vm:ChatHeaderMark" DataContext="{Binding HeaderMark}">
                            <Border Classes="chat-mark" Background="{Binding Background}" />
                            <TextBlock Classes="chat-mark-glyph" Text="{Binding Glyph}" Foreground="{Binding Foreground}" />
                          </Panel>
                          <Border Classes="chat-mark-status" IsVisible="{Binding IsBusy}" />
                        </Panel>
                        <!-- The project takes only the room the title leaves, so it trims away first. -->
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="ChatTitleText"
                                     DockPanel.Dock="Left"
                                     Classes="header-title-text"
                                     Text="{Binding CurrentChatTitle}" />
                          <TextBlock Classes="header-project-text"
                                     Text="{Binding ProjectBadgeText}"
                                     IsVisible="{Binding ProjectBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </DockPanel>
                        <PathIcon Grid.Column="2"
                                  Classes="header-chevron"
                                  Data="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z" />
                      </Grid>
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                    HorizontalOffset="-19"
                                    VerticalOffset="-8"
                                    FlyoutPresenterTheme="{StaticResource ChatTitleMenuPresenter}"
                                    ItemContainerTheme="{StaticResource ChatTitleMenuItem}"
                                    Opening="OnChatTitleMenuOpening">
                          <MenuItem x:Name="ChatTitleRenameItem" Header="{loc:Str Menu_Rename}">
                            <MenuItem.Icon>
                              <PathIcon Data="{DynamicResource Icon.Rename}" Width="15" Height="15" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem x:Name="ChatTitlePinItem" Header="{loc:Str Menu_Pin}">
                            <MenuItem.Icon>
                              <!-- Pin or unpin: the menu picks the glyph each time it opens. -->
                              <PathIcon Width="15" Height="15" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem x:Name="ChatTitleDuplicateItem" Header="{loc:Str Menu_Fork}">
                            <MenuItem.Icon>
                              <PathIcon Data="{x:Static sc:StrataChatMessage.ForkIconGeometry}" Width="15" Height="15" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem x:Name="ChatTitleMoveItem" Header="{loc:Str Menu_MoveToProject}"
                                    ItemContainerTheme="{StaticResource ChatTitleMenuItem}">
                            <MenuItem.Icon>
                              <PathIcon Data="{DynamicResource Icon.Folder}" Width="15" Height="15" />
                            </MenuItem.Icon>
                            <MenuItem IsVisible="False" IsEnabled="False" />
                          </MenuItem>
                          <MenuItem x:Name="ChatTitleTagItem" Header="{loc:Str Menu_ChatTag}"
                                    ItemContainerTheme="{StaticResource ChatTitleMenuItem}">
                            <MenuItem.Icon>
                              <PathIcon Data="{DynamicResource Icon.Tag}" Width="15" Height="15" />
                            </MenuItem.Icon>
                            <MenuItem IsVisible="False" IsEnabled="False" />
                          </MenuItem>
                          <MenuItem x:Name="ChatTitleNewWindowItem" Header="{loc:Str Menu_OpenInNewWindow}">
                            <MenuItem.Icon>
                              <PathIcon Data="{DynamicResource Icon.Window}" Width="15" Height="15" />
                            </MenuItem.Icon>
                          </MenuItem>
                          <Separator Margin="6" Background="{StaticResource ChatHeader.MenuDivider}" />
                          <MenuItem x:Name="ChatTitleDeleteItem" Classes="danger" Header="{loc:Str Menu_Delete}">
                            <MenuItem.Icon>
                              <PathIcon Data="{DynamicResource Icon.Trash}" Width="15" Height="15" />
                            </MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </DockPanel>
                </Border>
              </Panel>

              <!-- What Lumi is doing now, while the live step is scrolled out of view. -->
              <Button x:Name="HeaderLiveStatusButton"
                      DockPanel.Dock="Left"
                      Theme="{StaticResource StrataGlassButton}"
                      Classes="header-pill"
                      Classes.busy="{Binding IsBusy}"
                      Click="OnHeaderLiveStatusClick"
                      ToolTip.Tip="{loc:Str ChatHeader_JumpToLive}"
                      ToolTip.Placement="Bottom"
                      ToolTip.VerticalOffset="6"
                      AutomationProperties.Name="{Binding HeaderActivityText}"
                      AutomationProperties.HelpText="{loc:Str ChatHeader_JumpToLive}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Border Classes="header-live-dot" />
                  <TextBlock Classes="header-pill-text" Text="{Binding HeaderActivityText}" />
                  <PathIcon Classes="header-live-arrow"
                            Data="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" />
                </StackPanel>
              </Button>
            </DockPanel>
          </Panel>
        </sc:StrataChatShell.Header>



        <sc:StrataChatShell.Transcript>
          <StackPanel HorizontalAlignment="Stretch"
                      MaxWidth="{DynamicResource Chat.ReadingColumnWidth}">
            <Border Height="{Binding TranscriptTopSpacerHeight}"
                    IsHitTestVisible="False" />
            <vm:TranscriptItemsControl x:Name="Transcript"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MountedTranscriptTurns}">
              <vm:TranscriptItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:TranscriptTurn">
                  <vm:TranscriptTurnControl Turn="{Binding}"
                                            IsViewportManaged="True" />
                </DataTemplate>
              </vm:TranscriptItemsControl.ItemTemplate>
              <vm:TranscriptItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </vm:TranscriptItemsControl.ItemsPanel>
            </vm:TranscriptItemsControl>
            <Border Height="{Binding TranscriptBottomSpacerHeight}"
                    IsHitTestVisible="False" />
          </StackPanel>
        </sc:StrataChatShell.Transcript>

        <sc:StrataChatShell.Composer>
          <!-- Transparent spacer the size of the floating composer: the transcript rests clear of it
               and scrolls beneath it. While history is behind it, full frost runs from the follow-ups
               down with a short fade above them, so history dissolves before the dock rather than
               smearing behind the rows above the composer. -->
          <Panel x:Name="ComposerSpacer">
            <Panel x:Name="ComposerEdgeMaterial"
                   Margin="-12,-28,-12,-10"
                   IsHitTestVisible="False">
              <sc:StrataBackdropBlur BlurRadius="16" Saturation="1.15" Fade="Top" FadeLength="28" />
              <Grid RowDefinitions="28,*">
                <Border Background="{StaticResource ChatHeader.EdgeVeil}">
                  <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0" Color="#00000000" />
                      <GradientStop Offset="1" Color="#CC000000" />
                    </LinearGradientBrush>
                  </Border.OpacityMask>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource ChatHeader.EdgeVeil}" Opacity="0.8" />
              </Grid>
            </Panel>
          </Panel>
        </sc:StrataChatShell.Composer>

      </sc:StrataChatShell>

      <!-- ── Ctrl+F search bar overlay ── -->
      <Border x:Name="SearchBar"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,54,12,0"
              ZIndex="10"
              Padding="6,3,3,3"
              CornerRadius="{DynamicResource Radius.Base}"
              Background="{DynamicResource Brush.Surface1}"
              BorderBrush="{DynamicResource Brush.BorderSubtle}"
              BorderThickness="1"
              BoxShadow="0 2 8 0 #18000000">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <PathIcon Width="11" Height="11" Margin="2,0,2,0"
                    Foreground="{DynamicResource Brush.TextTertiary}"
                    Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
          <TextBox x:Name="SearchInput" Width="140"           PlaceholderText="{loc:Str Chat_SearchPlaceholder}" />
          <TextBlock x:Name="SearchMatchCounter" Classes="caption"
                     Foreground="{DynamicResource Brush.TextTertiary}"
                     VerticalAlignment="Center" Margin="2,0"
                     FontSize="10.5" />
          <Border Width="1" Height="14" Background="{DynamicResource Brush.BorderSubtle}"
                  VerticalAlignment="Center" Margin="2,0" />
          <Button x:Name="SearchPrevBtn" Classes="search-nav"
                  ToolTip.Tip="{loc:Str Chat_SearchPrevious}">
            <PathIcon Width="10" Height="10"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      Data="M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z" />
          </Button>
          <Button x:Name="SearchNextBtn" Classes="search-nav"
                  ToolTip.Tip="{loc:Str Chat_SearchNext}">
            <PathIcon Width="10" Height="10"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
          </Button>
          <Button x:Name="SearchCloseBtn" Classes="search-nav"
                  ToolTip.Tip="{loc:Str Chat_SearchClose}">
            <PathIcon Width="8" Height="8"
                      Foreground="{DynamicResource Brush.TextTertiary}"
                      Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
          </Button>
        </StackPanel>
      </Border>

  <Border IsVisible="{Binding ShowTranscriptDiagnostics}"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Margin="0,96,12,0"
      MaxWidth="360"
      Padding="10,8"
      CornerRadius="12"
      Background="#CC101521"
      BorderBrush="#404E6B"
      BorderThickness="1"
      ZIndex="6">
    <TextBlock Classes="caption"
       Foreground="#FFDDE7F7"
       FontFamily="Consolas, Cascadia Code, monospace"
       TextWrapping="Wrap"
       Text="{Binding TranscriptDiagnosticsText}" />
  </Border>
    </Panel>

    <!-- Single composer — always visible, animates between welcome and active states.
         Rows above the composer space themselves (bottom margins) rather than using Spacing, so a
         folded row adds nothing to the layout. -->
    <StackPanel x:Name="ComposerContainer" VerticalAlignment="Bottom" ZIndex="5"
                HorizontalAlignment="Stretch"
                Classes.welcome="{Binding IsWelcomeVisible}">

      <!-- Lumi is waiting on the user: one line above the composer, even when the card scrolled away. -->
      <Border x:Name="ApprovalsWaitingBar"
              IsVisible="{Binding HasPendingPermissionRequests}"
              Margin="4,0,4,8" Padding="12,6,8,6"
              CornerRadius="14"
              Background="{DynamicResource Brush.GlassFill}"
              BorderBrush="{DynamicResource Brush.GlassRim}"
              BorderThickness="1"
              BoxShadow="{DynamicResource Shadow.GlassChip}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.8"
                             Data="{x:Static sc:StrataIcons.Shield}"
                             Foreground="{DynamicResource Brush.WarningDefault}"
                             VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ApprovalsWaitingText}"
                     FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
          <Button x:Name="ApprovalsReviewButton" Grid.Column="2" Classes="subtle"
                  Content="{loc:Str Approval_Review}" Command="{Binding ReviewPendingApprovalsCommand}"
                  Padding="10,4" MinHeight="0" CornerRadius="9" FontSize="12" />
          <Button x:Name="ApprovalsAllowAllButton" Grid.Column="3" Classes="accent"
                  Content="{Binding AllowAllApprovalsLabel}" Command="{Binding AllowAllPendingApprovalsCommand}"
                  IsVisible="{Binding HasSeveralPendingPermissionRequests}"
                  Padding="10,4" MinHeight="0" CornerRadius="9" FontSize="12" />
        </Grid>
      </Border>

      <!-- The user's usual setups, learned from the chats they start: one click configures this new
           chat's project, checkout, agent and model. Folds away once the chat starts. -->
      <StackPanel x:Name="LaunchpadSetups" Spacing="6" IsVisible="{Binding Launchpad.HasSetups}">
        <TextBlock Classes="launchpad-section-label" Text="{loc:Str Launchpad_SetupsTitle}" Margin="6,0,0,0" />
        <ItemsControl x:Name="LaunchpadSetupTiles" ItemsSource="{Binding Launchpad.Setups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LaunchpadSetupItem">
              <Button Theme="{StaticResource LaunchpadTileButton}"
                      Classes="launchpad-setup"
                      Classes.active="{Binding IsActive}"
                      Margin="3,0"
                      Command="{Binding SelectCommand}"
                      ToolTip.Tip="{Binding ToolTip}"
                      ToolTip.ShowDelay="450"
                      AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Panel Width="30" Height="30" VerticalAlignment="Center">
                    <Border Classes="launchpad-setup-icon" />
                    <Border Classes="launchpad-badge-tile"
                            Background="{Binding BadgeBackground}"
                            IsVisible="{Binding HasBadge}" />
                    <TextBlock Classes="launchpad-badge-initial"
                               Text="{Binding BadgeInitial}"
                               Foreground="{Binding BadgeForeground}"
                               IsVisible="{Binding HasBadge}" />
                    <PathIcon Classes="launchpad-setup-glyph" Data="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                    <TextBlock Text="{Binding GlyphText}" IsVisible="{Binding HasGlyphText}"
                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Classes="launchpad-setup-check" RenderTransformOrigin="0.5,0.5">
                      <PathIcon Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" />
                    </Border>
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Classes="launchpad-setup-title" Text="{Binding Title}" />
                    <TextBlock Classes="launchpad-setup-meta" Text="{Binding Meta}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Follow-up placeholders, shown while a reply's suggestions are being written -->
      <StackPanel x:Name="SuggestionLoadingRow"
                  Orientation="Horizontal"
                  Margin="4,0,4,8" Spacing="8"
                  IsVisible="{Binding IsSuggestionsGenerating}"
                  IsHitTestVisible="False">
        <Border Classes="suggestion-pill pill-a" Width="132" />
        <Border Classes="suggestion-pill pill-b" Width="168" />
        <Border Classes="suggestion-pill pill-c" Width="116" />
      </StackPanel>

      <!-- Follow-up suggestions: one row that never wraps. When the three don't fit, the longest trim,
           and only a trimmed chip offers its full text in a tip. -->
      <lc:FitRowPanel x:Name="SuggestionChipsRow"
                      TextOptions.TextRenderingMode="Antialias"
                      Spacing="8"
                      Margin="4,0,4,8"
                      IsVisible="{Binding HasSuggestions}">
        <Button Classes="follow-up-chip"
                Command="{Binding SelectSuggestionCommand}"
                CommandParameter="{Binding SuggestionA}"
                AutomationProperties.Name="{Binding SuggestionA}"
                IsVisible="{Binding SuggestionA, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <Path Classes="follow-up-glyph" />
            <TextBlock Grid.Column="1" Classes="follow-up-text" Text="{Binding SuggestionA}" />
          </Grid>
        </Button>
        <Button Classes="follow-up-chip"
                Command="{Binding SelectSuggestionCommand}"
                CommandParameter="{Binding SuggestionB}"
                AutomationProperties.Name="{Binding SuggestionB}"
                IsVisible="{Binding SuggestionB, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <Path Classes="follow-up-glyph" />
            <TextBlock Grid.Column="1" Classes="follow-up-text" Text="{Binding SuggestionB}" />
          </Grid>
        </Button>
        <Button Classes="follow-up-chip"
                Command="{Binding SelectSuggestionCommand}"
                CommandParameter="{Binding SuggestionC}"
                AutomationProperties.Name="{Binding SuggestionC}"
                IsVisible="{Binding SuggestionC, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <Path Classes="follow-up-glyph" />
            <TextBlock Grid.Column="1" Classes="follow-up-text" Text="{Binding SuggestionC}" />
          </Grid>
        </Button>
      </lc:FitRowPanel>

      <!-- Paused: the chat holds where it stopped, its draft kept in the composer below. -->
      <Border x:Name="ChatPauseStatusPanel"
              TextOptions.TextRenderingMode="Antialias"
              Classes="pause-bar"
              Classes.pending="{Binding IsPausePending}"
              Classes.motion-disabled="{Binding !AreAnimationsEnabled}"
              IsVisible="{Binding IsPaused}"
              AutomationProperties.Name="{Binding PauseStatusTitle}"
              AutomationProperties.HelpText="{Binding PauseStatusDescription}">
        <Panel>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11" Margin="10,9,9,9">
            <Panel VerticalAlignment="Center">
              <Border Classes="pause-badge-disc">
                <PathIcon Classes="pause-badge-glyph" Data="{StaticResource Chat.Icon.Pause}" />
              </Border>
              <Border Classes="pause-badge-rim" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="2" MinWidth="0" VerticalAlignment="Center">
              <TextBlock x:Name="ChatPauseStatusTitle"
                         Classes="pause-bar-title"
                         Text="{Binding PauseStatusTitle}" />
              <TextBlock x:Name="ChatPauseStatusDescription"
                         Classes="pause-bar-description"
                         Text="{Binding PauseStatusDescription}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button x:Name="StopPausedChatButton"
                      Classes="subtle pause-bar-action pause-bar-cancel"
                      Command="{Binding StopGenerationCommand}"
                      Content="{loc:Str Chat_CancelPausedRun}"
                      AutomationProperties.Name="{loc:Str Chat_CancelPausedRun}"
                      Focusable="True" />
              <Button x:Name="ResumeChatButton"
                      Classes="accent pause-bar-action pause-bar-resume"
                      Command="{Binding ResumeChatCommand}"
                      ToolTip.Tip="{loc:Str Chat_ResumeTooltip}"
                      ToolTip.Placement="Top"
                      ToolTip.VerticalOffset="-6"
                      AutomationProperties.Name="{loc:Str Chat_Resume}"
                      AutomationProperties.HelpText="{loc:Str Chat_ResumeTooltip}"
                      Focusable="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="resume-glyph" Data="{StaticResource Chat.Icon.Play}" />
                  <TextBlock Text="{loc:Str Chat_Resume}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border x:Name="ChatPauseProgressLine" Classes="pause-bar-line" />
        </Panel>
      </Border>

      <sc:StrataChatComposer x:Name="Composer"
                             Classes="glass"
                             TextOptions.TextRenderingMode="Antialias"
                             Classes.motion-disabled="{Binding !AreAnimationsEnabled}"
                             Classes.frosted="{Binding #ChatShell.IsContentUnderComposer}"
                             Placeholder="{Binding ComposerPlaceholder}"
                             PromptText="{Binding PromptText, Mode=TwoWay}"
                             IsBusy="{Binding IsComposerBusy}"
                             IsEditing="{Binding IsEditingMessage}"
                             CancelEditCommand="{Binding CancelComposerEditCommand}"
                             EditingSubmitLabel="{loc:Str Chat_EditSubmit}"
                             McpToolTip="{Binding ConnectorsButtonToolTip}"
                             McpHeader="{loc:Str Chat_ConnectorsHeader}"
                             McpErrorActionCommand="{Binding FixMcpConnectorCommand}"
                             McpErrorActionLabel="{loc:Str Connector_FixWithLumi}"
                             McpErrorDetailsLabel="{loc:Str Connector_ErrorDetails}"
                             McpCopyErrorDetailsLabel="{loc:Str Connector_CopyErrorDetails}"
                             McpBrowseCommand="{Binding FindConnectorsCommand}"
                             McpManageCommand="{Binding ManageConnectorsCommand}"
                             McpIsLoading="{Binding IsConnectorCatalogLoading}"
                             IsRecording="{Binding IsRecording}"
                             CanVoice="{Binding IsVoiceAvailable}"
                             VoiceLevel="{Binding VoiceLevel}"
                             VoicePreview="{Binding VoicePreview}"
                             VoiceStatus="{Binding VoiceStatus}"
                             VoiceLanguages="{Binding VoiceLanguages}"
                             MoreVoiceLanguages="{Binding MoreVoiceLanguages}"
                             SelectedVoiceLanguage="{Binding SelectedVoiceLanguage}"
                             VoiceCancelCommand="{Binding DiscardVoiceCommand}"
                             SendWithEnter="{Binding SendWithEnter}"
                             SendCommand="{Binding SendMessageCommand}"
                             StopCommand="{Binding StopGenerationCommand}"
                             StopAndSendCommand="{Binding StopAndSendMessageCommand}"
                             AttachCommand="{Binding RequestAttachFilesCommand}"
                             VoiceCommand="{Binding ToggleVoiceCommand}"
                             AgentRemovedCommand="{Binding RemoveAgentCommand}"
                             ProjectRemovedCommand="{Binding RemoveProjectCommand}"
                             SkillRemovedCommand="{Binding RemoveSkillCommand}"
                             McpRemovedCommand="{Binding RemoveMcpCommand}"
                             FileQueryChangedCommand="{Binding HandleFileQueryCommand}"
                             FileSelectedCommand="{Binding HandleFileSelectionCommand}"
                             ClipboardPasteCommand="{Binding RequestClipboardPasteCommand}"
                             Models="{Binding ModelOptions}"
                             ModelPickerOpenedCommand="{Binding RefreshModelCatalogCommand}"
                             ModelPinCommand="{Binding TogglePinnedModelCommand}"
                             ModelPinToolTip="{Binding ModelPinToolTip}"
                             ModelUnpinToolTip="{Binding ModelUnpinToolTip}"
                             ModelNote="{Binding ModelPlanNote}"
                             ModelNoteActionLabel="{Binding ModelPlanAction}"
                             ModelNoteCommand="{Binding OpenModelPlanUsageCommand}"
                             SelectedModel="{Binding SelectedModel, Mode=TwoWay}"
                             QualityLevels="{Binding QualityLevels}"
                             SelectedQuality="{Binding SelectedQuality, Mode=TwoWay}"
                             ContextWindowTiers="{Binding ContextWindowTiers}"
                             SelectedContextWindowTier="{Binding SelectedContextWindowTier, Mode=TwoWay}"
                             AgentName="{Binding SelectedAgentName, Mode=TwoWay}"
                             AgentGlyph="{Binding SelectedAgentGlyph}"
                             ProjectName="{Binding SelectedProjectName, Mode=TwoWay}"
                             ProjectValue="{Binding SelectedProjectValue, Mode=TwoWay}"
                             SkillItems="{Binding ActiveSkillChips}"
                             McpItems="{Binding ActiveMcpChips}"
                             ChatItems="{Binding ReferencedChatChips}"
                             AvailableAgents="{Binding AvailableAgentChips}"
                             AvailableSkills="{Binding AvailableSkillChips}"
                             AvailableMcps="{Binding AvailableMcpChips}"
                             AvailableProjects="{Binding AvailableProjectChips}"
                             AvailableChats="{Binding AvailableChatChips}"
                             ChatsRequestedCommand="{Binding RefreshChatReferencesCommand}"
                             SkillsManageCommand="{Binding ManageSkillsCommand}"
                             AvailableFiles="{Binding AvailableFileSuggestions}">
        <!-- How much this chat may do on its own: a setting like the model, beside it. -->
        <sc:StrataChatComposer.TrailingContent>
          <sc:StrataModePicker x:Name="ApprovalModePicker"
                               Icon="{Binding CurrentApprovalMode, Converter={x:Static conv:ApprovalModeIconConverter.Instance}}"
                               Label="{Binding CurrentApprovalModeOption.Title}"
                               ShowLabel="{Binding !IsFullAccessMode}"
                               Tone="{Binding ApprovalModeTone}"
                               ButtonToolTip="{Binding ApprovalModeToolTip}"
                               Header="{loc:Str ApprovalMode_PickerHeader}"
                               Description="{loc:Str ApprovalMode_PickerDescription}"
                               Items="{Binding ApprovalModeOptions}"
                               SelectedItem="{Binding CurrentApprovalModeOption}"
                               SelectCommand="{Binding SelectApprovalModeCommand}"
                               Margin="0,0,2,0">
            <sc:StrataModePicker.ItemTemplate>
              <DataTemplate x:DataType="vm:ApprovalModeOption">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Width="30" Height="30" CornerRadius="10" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.GlassWell}"
                          BorderBrush="{DynamicResource Brush.GlassDivider}" BorderThickness="1">
                    <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.8"
                                       Data="{Binding Mode, Converter={x:Static conv:ApprovalModeIconConverter.Instance}}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.TextPrimary}" />
                      <Border IsVisible="{Binding HasBadge}" CornerRadius="999" Padding="7,1"
                              VerticalAlignment="Center" Background="{DynamicResource Brush.GlassWell}">
                        <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                  </StackPanel>
                  <sc:StrataLineIcon Grid.Column="2" Width="16" Height="16" StrokeThickness="2"
                                     VerticalAlignment="Center"
                                     Data="{x:Static sc:StrataIcons.Check}"
                                     Foreground="{DynamicResource Brush.AccentDefault}"
                                     IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                </Grid>
              </DataTemplate>
            </sc:StrataModePicker.ItemTemplate>
            <sc:StrataModePicker.FooterContent>
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ApprovalModeOrigin}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding ApprovalRulesSummary}" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                  <Button x:Name="ApprovalModeFollowDefaultButton" Grid.Column="1" Classes="subtle"
                          Content="{loc:Str ApprovalMode_FollowDefault}"
                          Command="{Binding FollowDefaultApprovalModeCommand}"
                          IsVisible="{Binding HasOwnApprovalMode}"
                          Padding="9,4" MinHeight="0" CornerRadius="9" FontSize="12" />
                  <Button x:Name="ApprovalModeManageButton" Grid.Column="2" Classes="subtle"
                          Content="{loc:Str ApprovalMode_Manage}"
                          Command="{Binding ManageApprovalsCommand}"
                          Padding="9,4" MinHeight="0" CornerRadius="9" FontSize="12" />
                </Grid>
              </StackPanel>
            </sc:StrataModePicker.FooterContent>
          </sc:StrataModePicker>
        </sc:StrataChatComposer.TrailingContent>
        <!-- A new chat's checkout, beside its project: where this message will work. Once the chat starts it
             is the chat's state, and moves to the header's git pill. -->
        <sc:StrataChatComposer.ContextChipsContent>
          <Border x:Name="ComposerGitChip" Classes="composer-chip checkout-chip"
                  IsVisible="{Binding ShowComposerCheckout}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ComposerGitButton"
                      Classes="subtle chip-seg"
                      Classes.refreshing="{Binding IsRefreshingGitStatus}"
                      ToolTip.Tip="{loc:Str Git_DraftTooltip}"
                      AutomationProperties.Name="{Binding GitBranchLabel}"
                      AutomationProperties.HelpText="{loc:Str Git_DraftTooltip}">
                <Button.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedLeft"
                              HorizontalOffset="-17"
                              VerticalOffset="8"
                              FlyoutPresenterTheme="{StaticResource ChatGitCardPresenter}"
                              ItemContainerTheme="{StaticResource ChatTitleMenuItem}">
                    <MenuItem x:Name="ComposerGitLocalItem"
                              ToggleType="Radio"
                              GroupName="ComposerCheckout"
                              IsChecked="{Binding !IsWorktreeMode, Mode=OneWay}"
                              Command="{Binding SwitchToLocalPreChatCommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Monitor}" />
                      </MenuItem.Icon>
                      <MenuItem.Header>
                        <StackPanel Spacing="1" Margin="0,7">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="header-card-shortcut"
                                       Text="{loc:Str Git_LocalShortcut}" />
                            <TextBlock Classes="header-card-row-title" Text="{loc:Str Git_Local}" />
                          </DockPanel>
                          <TextBlock Classes="header-card-row-detail" Text="{Binding GitLocalChoiceDescription}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="ComposerGitWorktreeItem"
                              ToggleType="Radio"
                              GroupName="ComposerCheckout"
                              IsChecked="{Binding IsWorktreeMode, Mode=OneWay}"
                              Command="{Binding SwitchToWorktreePreChatCommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Layers}" />
                      </MenuItem.Icon>
                      <MenuItem.Header>
                        <StackPanel Spacing="1" Margin="0,7">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="header-card-shortcut"
                                       Text="{loc:Str Git_WorktreeShortcut}" />
                            <TextBlock Classes="header-card-row-title" Text="{loc:Str Git_Worktree}" />
                          </DockPanel>
                          <TextBlock Classes="header-card-row-detail" Text="{loc:Str Git_WorktreeChoice}" />
                        </StackPanel>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="{loc:Str Git_ExistingWorktrees}"
                              ItemsSource="{Binding AvailableWorktrees}"
                              IsVisible="{Binding HasAvailableWorktrees}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Branch}" />
                      </MenuItem.Icon>
                      <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource ChatTitleMenuItem}"
                                      x:DataType="services:WorktreeInfo">
                          <Setter Property="Header" Value="{Binding DisplayName}" />
                          <Setter Property="Command" Value="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).SelectExistingWorktreeCommand}" />
                          <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </ControlTheme>
                      </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <Separator Margin="6" Background="{StaticResource ChatHeader.MenuDivider}" />
                    <MenuItem Header="{loc:Str Git_OpenTerminal}" Command="{Binding OpenInTerminalCommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Terminal}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Str Git_OpenExplorer}" Command="{Binding OpenInExplorerCommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Folder}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Str Git_OpenIDE}" Command="{Binding OpenInIDECommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{StaticResource Chat.Icon.Code}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator Margin="6" Background="{StaticResource ChatHeader.MenuDivider}" />
                    <MenuItem Header="{loc:Str Git_CopyBranch}" Command="{Binding CopyBranchNameCommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Branch}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Str Git_CopyPath}" Command="{Binding CopyDirectoryPathCommand}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Files}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator Margin="6" Background="{StaticResource ChatHeader.MenuDivider}" />
                    <MenuItem Header="{loc:Str Git_RefreshTooltip}"
                              Command="{Binding RefreshGitStatusCommand}"
                              IsEnabled="{Binding !IsRefreshingGitStatus}">
                      <MenuItem.Icon>
                        <sc:StrataLineIcon Width="15" Height="15" StrokeThickness="1.9"
                                           Data="{x:Static sc:StrataIcons.Retry}" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="chip-tile">
                    <sc:StrataLineIcon Classes="chip-icon" Data="{x:Static sc:StrataIcons.Branch}" />
                  </Border>
                  <!-- A new worktree is made from the branch when the chat starts, and starts clean. -->
                  <TextBlock Classes="chip-name" Text="{loc:Str Git_NewWorktree}"
                             IsVisible="{Binding IsWorktreePending}" />
                  <TextBlock Classes="git-mode" Margin="-2,0,0,0" Text="{loc:Str Git_FromBranch}"
                             IsVisible="{Binding IsWorktreePending}" />
                  <TextBlock Classes="git-branch" Text="{Binding GitBranchLabel}" />
                  <TextBlock Classes="git-mode" Margin="-2,0,0,0"
                             Text="{Binding GitCheckoutModeLabel, StringFormat='· {0}'}"
                             IsVisible="{Binding !IsWorktreePending}" />
                  <sc:StrataLineIcon Classes="git-chevron" Data="{x:Static sc:StrataIcons.ChevronDown}" />
                </StackPanel>
              </Button>
              <Border Classes="chip-divider" IsVisible="{Binding ShowCheckoutChanges}" />
              <Button x:Name="ComposerGitChangesButton"
                      Classes="subtle chip-seg"
                      IsVisible="{Binding ShowCheckoutChanges}"
                      Command="{Binding ShowGitChangesCommand}"
                      ToolTip.Tip="{loc:Str Git_ShowChanges}"
                      AutomationProperties.Name="{Binding GitChangesLabel}"
                      AutomationProperties.HelpText="{loc:Str Git_ShowChanges}">
                <Panel x:DataType="vm:GitChangesViewModel" DataContext="{Binding WorkspaceGit}">
                  <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasTotalStats}">
                    <TextBlock Classes="diff-added" Text="{Binding TotalAddedLabel}" />
                    <TextBlock Classes="diff-removed" Text="{Binding TotalRemovedLabel}" />
                  </StackPanel>
                  <TextBlock Classes="git-mode" Text="{Binding TotalFilesLabel}" IsVisible="{Binding !HasTotalStats}" />
                </Panel>
              </Button>
            </StackPanel>
          </Border>
        </sc:StrataChatComposer.ContextChipsContent>
        <!-- While Lumi works, Pause sits beside Stop: hold the run where it stands, or end it. -->
        <sc:StrataChatComposer.SendAccessoryContent>
          <Button x:Name="PauseChatButton"
                  Classes="composer-tool composer-pause"
                  IsVisible="{Binding CanPauseChat}"
                  Command="{Binding TogglePauseCommand}"
                  ToolTip.Tip="{loc:Str Chat_PauseTooltip}"
                  AutomationProperties.Name="{loc:Str Chat_Pause}"
                  AutomationProperties.HelpText="{loc:Str Chat_PauseTooltip}"
                  Focusable="True">
            <sc:StrataLineIcon Width="18" Height="18" StrokeThickness="2.2" Data="{x:Static sc:StrataIcons.Pause}" />
          </Button>
        </sc:StrataChatComposer.SendAccessoryContent>
        <sc:StrataChatComposer.StatusContent>
          <StackPanel MinWidth="0" Spacing="4">
          <!-- Voice typing: asking before the one-time download, its progress, and what stopped dictation. -->
          <Border x:Name="VoiceSetupCard" Classes="voice-card" IsVisible="{Binding IsVoiceSetupVisible}">
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="voice-tile brand">
                <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Mic}" />
              </Border>
              <StackPanel Grid.Column="1" MinWidth="0" Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Classes="voice-title" Text="{loc:Str Voice_SetupTitle}" />
                  <TextBlock Classes="voice-body" Text="{Binding VoiceSetupMessage}" />
                </StackPanel>
                <StackPanel Spacing="5">
                  <StackPanel Classes="voice-fact" Orientation="Horizontal">
                    <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Lock}" />
                    <TextBlock Text="{loc:Str Voice_SetupPrivate}" />
                  </StackPanel>
                  <StackPanel Classes="voice-fact" Orientation="Horizontal">
                    <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Globe}" />
                    <TextBlock Text="{loc:Str Voice_SetupOffline}" />
                  </StackPanel>
                </StackPanel>
                <WrapPanel>
                  <Button x:Name="VoiceSetupDownloadButton"
                          Classes="accent voice-action"
                          Content="{loc:Str Voice_SetupDownload}"
                          Command="{Binding DownloadVoiceModelCommand}" />
                  <Button Classes="subtle voice-action"
                          Content="{loc:Str Voice_SetupLater}"
                          Command="{Binding DismissVoiceCommand}" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="VoiceDownloadCard" Classes="voice-card" IsVisible="{Binding IsVoiceDownloadVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="voice-tile brand">
                <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Download}" />
              </Border>
              <StackPanel Grid.Column="1" MinWidth="0" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="voice-title" Text="{loc:Str Voice_DownloadTitle}" />
                <ProgressBar x:Name="VoiceDownloadProgress"
                             Minimum="0" Maximum="100"
                             Value="{Binding VoiceDownloadPercent}"
                             Height="4" MinHeight="4" />
                <TextBlock Classes="voice-caption" Text="{Binding VoiceDownloadText}" />
              </StackPanel>
              <Button Grid.Column="2"
                      Classes="subtle voice-action"
                      Margin="12,0,0,0"
                      VerticalAlignment="Top"
                      Content="{loc:Str Common_Cancel}"
                      Command="{Binding DismissVoiceCommand}" />
            </Grid>
          </Border>
          <Border x:Name="VoiceProblemCard" Classes="voice-card" IsVisible="{Binding IsVoiceProblemVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Classes="voice-tile quiet" IsVisible="{Binding IsVoiceNoSpeech}">
                <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Mic}" />
              </Border>
              <Border Classes="voice-tile problem" IsVisible="{Binding !IsVoiceNoSpeech}">
                <Panel>
                  <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.MicOff}" IsVisible="{Binding IsVoiceMicrophoneProblem}" />
                  <sc:StrataLineIcon Data="{x:Static sc:StrataIcons.Alert}" IsVisible="{Binding !IsVoiceMicrophoneProblem}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" MinWidth="0" Spacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Classes="voice-title" Text="{Binding VoiceProblemTitle}" />
                  <TextBlock Classes="voice-body" Text="{Binding VoiceProblemMessage}" />
                  <TextBlock Classes="voice-caption"
                             Text="{Binding VoiceProblemDetail}"
                             IsVisible="{Binding VoiceProblemDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <WrapPanel>
                  <Button Classes="accent voice-action"
                          Content="{loc:Str Common_TryAgain}"
                          Command="{Binding RetryVoiceCommand}" />
                  <Button Classes="subtle voice-action"
                          Content="{loc:Str Voice_OpenSettings}"
                          Command="{Binding OpenMicrophoneSettingsCommand}"
                          IsVisible="{Binding CanOpenMicrophoneSettings}" />
                </WrapPanel>
              </StackPanel>
              <Button Grid.Column="2"
                      Classes="subtle voice-close"
                      VerticalAlignment="Top"
                      Command="{Binding DismissVoiceCommand}"
                      ToolTip.Tip="{loc:Str Voice_Dismiss}"
                      ToolTip.Placement="Top"
                      ToolTip.VerticalOffset="-4"
                      AutomationProperties.Name="{loc:Str Voice_Dismiss}">
                <sc:StrataLineIcon Width="12" Height="12" StrokeThickness="2.2" Data="{x:Static sc:StrataIcons.Cross}" />
              </Button>
            </Grid>
          </Border>
          <Grid x:Name="ComposerEditStatus"
                ColumnDefinitions="Auto,*"
                MinWidth="0"
                IsVisible="{Binding IsEditingMessage}"
                Margin="2,4,2,2">
            <Border Grid.Column="0"
                    Width="28" Height="28"
                    Margin="0,1,8,0"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.AccentSubtle}">
              <PathIcon Width="13" Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.AccentDefault}"
                        Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" />
            </Border>
            <StackPanel Grid.Column="1" MinWidth="0" Spacing="6">
              <TextBlock Text="{loc:Str Chat_EditTitle}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.TextPrimary}" />
              <TextBlock Text="{Binding EditingMessageStatusText}"
                         MinWidth="0"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Button Content="{loc:Str Chat_EditSubmit}"
                        Classes="accent"
                        Command="{Binding SendMessageCommand}"
                        Margin="0,0,6,0"
                        Padding="10,5"
                        MinHeight="0"
                        FontSize="11.5"
                        FontWeight="SemiBold" />
                <Button Content="{loc:Str Common_Cancel}"
                        Classes="subtle"
                        Command="{Binding CancelComposerEditCommand}"
                        Padding="10,5"
                        MinHeight="0"
                        FontSize="11.5" />
              </WrapPanel>
            </StackPanel>
          </Grid>
          </StackPanel>
        </sc:StrataChatComposer.StatusContent>
        <sc:StrataChatComposer.ModelItemTemplate>
          <!-- One line per model: name, an optional status, then cost (when the catalog reports
               one) and context size in fixed right-aligned columns. Context stays rightmost so it
               lines up even when some rows have no cost. Everything else the catalog reports
               (capabilities, account) is in the row tooltip. -->
          <DataTemplate x:DataType="vm:ModelOption" DataType="vm:ModelOption">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Background="Transparent"
                  ToolTip.Tip="{Binding DetailsToolTip}"
                  ToolTip.ShowDelay="700">
              <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding DisplayName}" />
                <Run Text="{Binding PinnedProviderSuffix}"
                     FontSize="11.5"
                     Foreground="{DynamicResource Brush.TextTertiary}" />
              </TextBlock>
              <TextBlock Grid.Column="1"
                         Classes="model-status warning"
                         Margin="8,0,0,0"
                         Text="{loc:Str ModelPicker_NeedsEnabling}"
                         IsVisible="{Binding RequiresOptIn}" />
              <TextBlock Grid.Column="2"
                         Classes="model-meta emphasis"
                         Width="48"
                         Margin="8,0,0,0"
                         Text="{Binding CostBadge}"
                         IsVisible="{Binding HasCostBadge}" />
              <TextBlock Grid.Column="3"
                         Classes="model-meta"
                         Width="40"
                         Text="{Binding ContextShort}" />
            </Grid>
          </DataTemplate>
        </sc:StrataChatComposer.ModelItemTemplate>
        <sc:StrataChatComposer.SelectedModelTemplate>
          <!-- The collapsed picker button shows the selected model *id*, not the row item, and has
               nowhere near the width for badges. -->
          <DataTemplate>
            <TextBlock Text="{Binding $parent[sc:StrataModelPicker].SelectedModelDisplayName}" />
          </DataTemplate>
        </sc:StrataChatComposer.SelectedModelTemplate>
        <sc:StrataChatComposer.AttachmentContent>
          <StackPanel>
            <!-- Reply card: the quote the next message replies to. Click to revisit it; Esc or × dismisses. -->
            <Border x:Name="ComposerReplyCard"
                    Classes="composer-reply"
                    IsVisible="{Binding HasPendingReply}"
                    Margin="4,2,4,6">
              <Grid ColumnDefinitions="3,*,Auto">
                <Border Classes="composer-reply-bar" />
                <Button Grid.Column="1"
                        Classes="subtle composer-reply-body"
                        Command="{Binding JumpToPendingReplySourceCommand}"
                        ToolTip.Tip="{loc:Str Chat_ShowReplySource}"
                        AutomationProperties.Name="{Binding PendingReplyTitle}">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="11" Height="11"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.AccentDefault}"
                                Data="{x:Static sc:StrataChatMessage.ReplyIconGeometry}" />
                      <TextBlock Text="{Binding PendingReplyTitle}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.AccentDefault}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PendingReplyPreview}"
                               FontSize="12.5"
                               LineHeight="17"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Classes="subtle composer-reply-close"
                        Command="{Binding CancelReplyCommand}"
                        ToolTip.Tip="{loc:Str Chat_CancelReply}"
                        AutomationProperties.Name="{loc:Str Chat_CancelReply}">
                  <PathIcon Width="9" Height="9"
                            Foreground="{DynamicResource Brush.TextTertiary}"
                            Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
              </Grid>
            </Border>
            <sc:StrataAttachmentList ShowAddButton="False"
                                     ItemsSource="{Binding PendingAttachmentItems}"
                                     IsVisible="{Binding HasPendingAttachments}">
              <sc:StrataAttachmentList.ItemTemplate>
                <DataTemplate DataType="vm:FileAttachmentItem">
                  <sc:StrataFileAttachment FileName="{Binding FileName}"
                                           FileSize="{Binding FileSize}"
                                           IconImage="{Binding IconImage}"
                                           Status="Completed"
                                           IsCompact="True"
                                           views:FileDrag.FilePath="{Binding FilePath}"
                                           IsRemovable="{Binding IsRemovable}"
                                           RemoveCommand="{Binding RemoveCommand}"
                                           Margin="0,0,6,4" />
                </DataTemplate>
              </sc:StrataAttachmentList.ItemTemplate>
            </sc:StrataAttachmentList>
          </StackPanel>
        </sc:StrataChatComposer.AttachmentContent>
      </sc:StrataChatComposer>
    </StackPanel>
  </Panel>
</UserControl>
