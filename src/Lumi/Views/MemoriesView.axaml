<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:controls="using:Lumi.Views.Controls"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.Views.MemoriesView"
             x:DataType="vm:MemoriesViewModel"
             x:CompileBindings="True">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Lumi/Views/Management/Hue.Memory.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://Lumi/Views/Management/ManagementStyles.axaml" />
    <Style Selector="TextBlock.mg-memory-text">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="4" />
    </Style>
    <Style Selector="Border.mg-group-count">
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
      <Setter Property="Background" Value="{DynamicResource Mg.TileBackground}" />
      <Setter Property="Padding" Value="8,1,8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.mg-group-count TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <!-- ══════════════════════════ OVERVIEW ══════════════════════════ -->
    <Panel x:Name="MemoriesOverview" Classes="mg-surface" IsVisible="{Binding !IsEditing}">
      <Border Classes="mg-wash" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,30,32,40" Spacing="22">

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <Border Grid.RowSpan="2" Classes="mg-tile" Width="48" Height="48" CornerRadius="14" Margin="0,0,16,0" VerticalAlignment="Top">
              <PathIcon Classes="mg-glyph" Data="{StaticResource Icon.Memory}" Width="22" Height="22" />
            </Border>
            <DockPanel Grid.Column="1" MinHeight="48">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="MemoriesNewButton" Classes="mg-button accent" Command="{Binding NewMemoryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource Icon.Plus}" />
                    <TextBlock Text="{loc:Str Memories_New}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <TextBlock Classes="mg-page-title" Text="{loc:Str Memories_Title}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mg-page-lede" Margin="0,2,0,0" Text="{loc:Str Memories_Lede}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasAnyMemories}">
            <Border Classes="mg-stat">
              <StackPanel Spacing="1">
                <TextBlock Classes="mg-stat-value" Text="{Binding TotalCountText}" />
                <TextBlock Classes="mg-stat-label" Text="{loc:Str Memories_StatTotal}" />
              </StackPanel>
            </Border>
            <Border Classes="mg-stat">
              <StackPanel Spacing="1">
                <TextBlock Classes="mg-stat-value" Text="{Binding CategoryCountText}" />
                <TextBlock Classes="mg-stat-label" Text="{loc:Str Memories_StatCategories}" />
              </StackPanel>
            </Border>
            <Border Classes="mg-stat">
              <StackPanel Spacing="1">
                <TextBlock Classes="mg-stat-value" Text="{Binding ProjectMemoryCountText}" />
                <TextBlock Classes="mg-stat-label" Text="{loc:Str Memories_StatProject}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Category filter -->
          <ItemsControl x:Name="MemoryCategoryFilters" ItemsSource="{Binding CategoryFilters}" IsVisible="{Binding HasAnyMemories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ManagementFilterOption">
                <Button Classes="mg-filter" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Classes="mg-filter-count" Text="{Binding CountText}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="mg-chip hue" HorizontalAlignment="Left" IsVisible="{Binding IsSearching}" Padding="12,5,6,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Search}" />
              <TextBlock Text="{Binding SearchQuery}" MaxWidth="320" TextTrimming="CharacterEllipsis" />
              <Button Classes="subtle" Padding="4" MinHeight="0" CornerRadius="{DynamicResource Radius.Full}"
                      Command="{Binding ClearSearchCommand}" ToolTip.Tip="{loc:Str Mg_ClearSearch}">
                <PathIcon Data="{StaticResource Icon.Close}" Width="8" Height="8" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Groups -->
          <ItemsControl x:Name="MemoryGroupsList" ItemsSource="{Binding MemoryGroups}" IsVisible="{Binding HasResults}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="28" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MemoryGroup">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <TextBlock Classes="mg-section-title" Text="{Binding Category}" FontSize="15" />
                    <Border Classes="mg-group-count">
                      <TextBlock Text="{Binding CountText}" />
                    </Border>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:AdaptiveGridPanel MinItemWidth="240" ColumnSpacing="12" RowSpacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MemoryCard">
                        <Button Classes="mg-card" Command="{Binding OpenCommand}">
                          <Border Classes="mg-card-frame" Padding="16,14,16,13">
                            <DockPanel>
                              <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Classes="mg-meta" Text="{Binding UpdatedLabel}" Margin="10,0,0,0" />
                                <DockPanel>
                                  <PathIcon DockPanel.Dock="Left" Margin="0,0,6,0" Classes="mg-meta-icon" Data="{StaticResource Icon.Folder}" IsVisible="{Binding IsProjectScoped}" />
                                  <PathIcon DockPanel.Dock="Left" Margin="0,0,6,0" Classes="mg-meta-icon" Data="{StaticResource Icon.Globe}" IsVisible="{Binding !IsProjectScoped}" />
                                  <TextBlock Classes="mg-meta" Text="{Binding ScopeLabel}" />
                                </DockPanel>
                              </DockPanel>
                              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <PathIcon DockPanel.Dock="Right" Classes="mg-card-arrow" Data="{StaticResource Icon.ChevronRight}" Margin="8,0,0,0" />
                                <TextBlock Classes="mg-card-title" Text="{Binding Key}" FontSize="14" />
                              </DockPanel>
                              <TextBlock Classes="mg-memory-text" Text="{Binding Content}" IsVisible="{Binding HasContent}" />
                            </DockPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding ShowNoResults}" Spacing="8" Margin="0,40,0,0" HorizontalAlignment="Center">
            <TextBlock Classes="mg-empty-title" Text="{Binding NoResultsText}" />
            <TextBlock Classes="mg-empty-text" Text="{loc:Str Mg_NoResultsHint}" />
            <Button Classes="mg-button" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Command="{Binding ClearSearchCommand}" Content="{loc:Str Mg_ClearSearch}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowEmptyState}" Spacing="12" Margin="0,48,0,0" HorizontalAlignment="Center">
            <Border Classes="mg-empty-hero">
              <PathIcon Data="{StaticResource Icon.Memory}" />
            </Border>
            <TextBlock Classes="mg-empty-title" Text="{loc:Str Memories_EmptyTitle}" Margin="0,6,0,0" />
            <TextBlock Classes="mg-empty-text" Text="{loc:Str Memories_EmptyText}" />
            <Button Classes="mg-button accent" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding NewMemoryCommand}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource Icon.Plus}" />
                <TextBlock Text="{loc:Str Memories_New}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>

    <!-- ══════════════════════════ DETAIL ══════════════════════════ -->
    <Panel x:Name="MemoryDetail" Classes="mg-surface" IsVisible="{Binding IsEditing}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="mg-topbar">
          <DockPanel>
            <Button x:Name="DeleteMemoryButton" DockPanel.Dock="Right" Classes="mg-icon-button subtle"
                    IsVisible="{Binding !IsNewMemory}"
                    Command="{Binding RequestDeleteCommand}" ToolTip.Tip="{loc:Str Menu_Delete}">
              <PathIcon Data="{StaticResource Icon.Trash}" />
            </Button>
            <DockPanel>
              <Button DockPanel.Dock="Left" x:Name="MemoryBackButton" Classes="subtle mg-back" Command="{Binding CloseDetailCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource Icon.ChevronLeft}" />
                  <TextBlock Text="{loc:Str Memories_Title}" />
                </StackPanel>
              </Button>
              <TextBlock DockPanel.Dock="Left" Classes="mg-crumb" Text="/" Margin="2,0,6,0" />
              <TextBlock Classes="mg-crumb current" Text="{Binding DetailTitle}" />
            </DockPanel>
          </DockPanel>
        </Border>

        <ScrollViewer x:Name="MemoryDetailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,32,40,120" MaxWidth="780" Spacing="20">

            <DockPanel>
              <Border DockPanel.Dock="Left" Classes="mg-tile lg" Margin="0,0,22,0">
                <PathIcon Classes="mg-glyph" Data="{StaticResource Icon.Memory}" />
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBox x:Name="MemoryKeyInput" Classes="mg-title-input" Text="{Binding EditKey}"
                         PlaceholderText="{loc:Str Memories_KeyPlaceholder}" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
                  <Border Classes="mg-chip hue">
                    <TextBlock Text="{Binding EditCategory}" />
                  </Border>
                  <Button Classes="mg-pill-link" IsVisible="{Binding IsProjectMemory}"
                          Command="{Binding OpenProjectCommand}">
                    <Border Classes="mg-chip">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Folder}" />
                        <TextBlock Text="{Binding ScopeLabel}" />
                      </StackPanel>
                    </Border>
                  </Button>
                  <Border Classes="mg-chip" IsVisible="{Binding !IsProjectMemory}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.Globe}" />
                      <TextBlock Text="{Binding ScopeLabel}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mg-chip" IsVisible="{Binding !IsNewMemory}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.Sparkle}" />
                      <TextBlock Text="{Binding SourceLabel}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mg-chip" IsVisible="{Binding !IsNewMemory}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.Clock}" />
                      <TextBlock Text="{Binding UpdatedLabel}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mg-chip" IsVisible="{Binding HasLastUsed}">
                    <TextBlock Text="{Binding LastUsedLabel}" />
                  </Border>
                </WrapPanel>
              </StackPanel>
            </DockPanel>

            <Border Classes="mg-section">
              <StackPanel Spacing="14">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Classes="mg-section-icon">
                    <PathIcon Data="{StaticResource Icon.Memory}" />
                  </Border>
                  <StackPanel Spacing="1">
                    <TextBlock Classes="mg-section-title" Text="{loc:Str Memories_Content}" />
                    <TextBlock Classes="mg-section-caption" Text="{loc:Str Memories_ContentCaption}" />
                  </StackPanel>
                </DockPanel>
                <TextBox x:Name="MemoryContentEditor" Classes="mg-editor prose" Text="{Binding EditContent}"
                         PlaceholderText="{loc:Str Watermark_MemoryContent}" />
              </StackPanel>
            </Border>

            <Border Classes="mg-section">
              <StackPanel Spacing="14">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Classes="mg-section-icon">
                    <PathIcon Data="{StaticResource Icon.Tag}" />
                  </Border>
                  <StackPanel Spacing="1">
                    <TextBlock Classes="mg-section-title" Text="{loc:Str Memories_Category}" />
                    <TextBlock Classes="mg-section-caption" Text="{loc:Str Memories_CategoryCaption}" />
                  </StackPanel>
                </DockPanel>
                <TextBox Classes="mg-field" Text="{Binding EditCategory}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260"
                         PlaceholderText="{loc:Str Memories_CategoryPlaceholder}" />
                <ItemsControl ItemsSource="{Binding CategorySuggestions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManagementFilterOption">
                      <Button Classes="mg-filter" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          <TextBlock Classes="mg-filter-count" Text="{Binding CountText}" IsVisible="{Binding Count}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <Border x:Name="MemorySaveBar" Classes="mg-floatbar" IsVisible="{Binding ShowSaveBar}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <DockPanel VerticalAlignment="Center">
            <Ellipse DockPanel.Dock="Left" Classes="mg-dot" Fill="{DynamicResource Brush.AccentDefault}" Margin="0,0,9,0" />
            <TextBlock DockPanel.Dock="Right" x:Name="MemorySaveHint" Classes="mg-floatbar-hint" Text="Ctrl+S" Margin="9,0,0,0" />
            <TextBlock Classes="mg-floatbar-text" Text="{Binding SaveBarText}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="subtle mg-button" Content="{Binding DiscardButtonText}" Command="{Binding DiscardChangesCommand}" />
            <Button x:Name="SaveMemoryButton" Classes="accent mg-button" Content="{Binding SaveButtonText}"
                    Command="{Binding SaveMemoryCommand}" IsEnabled="{Binding CanSave}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="mg-floatbar danger" IsVisible="{Binding IsConfirmingDelete}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <DockPanel VerticalAlignment="Center">
            <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Trash}" Width="13" Height="13"
                      Foreground="{DynamicResource Brush.DangerDefault}" Margin="0,0,9,0" />
            <TextBlock Classes="mg-floatbar-text" Text="{Binding DeleteConfirmText}" MaxWidth="420"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DeleteConfirmText}" />
          </DockPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Classes="subtle mg-button" Content="{loc:Str Common_Cancel}" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="danger mg-button" Content="{loc:Str Mg_Delete}" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="mg-saved-toast" IsVisible="{Binding ShowSavedToast}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12"
                    Foreground="{DynamicResource Brush.SuccessDefault}" />
          <TextBlock Text="{loc:Str Mg_Saved}" FontSize="12.5" FontWeight="Medium"
                     Foreground="{DynamicResource Brush.TextPrimary}" />
        </StackPanel>
      </Border>
    </Panel>
  </Panel>
</UserControl>
