<!-- Page hue for MCP servers: sage. Deliberately muted: it only tints identity glyphs (page tile, item
     tiles, empty states) and a barely-there header wash; everything else on the page stays neutral
     and uses Lumi's own accent for selection and focus. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Mg.Hue" Color="#84BDB2" />
      <LinearGradientBrush x:Key="Mg.HueWash" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#0D84BDB2" />
        <GradientStop Offset="1" Color="#0084BDB2" />
      </LinearGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Mg.Hue" Color="#33786D" />
      <LinearGradientBrush x:Key="Mg.HueWash" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#0A33786D" />
        <GradientStop Offset="1" Color="#0033786D" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
