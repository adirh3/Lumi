<!--
  Settings' glyphs and page hues. Shared by the Settings page and its sidebar in the main window, so
  a page's row and its header tile always wear the same colour. Hues are muted like the management
  pages' (Hue.*.axaml): they only tint identity glyphs; selection and focus stay on Lumi's accent.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="St.Hue.Profile" Color="#E0A890" />
      <SolidColorBrush x:Key="St.Hue.Memories" Color="#CC9AB3" />
      <SolidColorBrush x:Key="St.Hue.General" Color="#A7B1C4" />
      <SolidColorBrush x:Key="St.Hue.Appearance" Color="#C6A2DD" />
      <SolidColorBrush x:Key="St.Hue.Chat" Color="#8DB8DE" />
      <SolidColorBrush x:Key="St.Hue.Permissions" Color="#E6A372" />
      <SolidColorBrush x:Key="St.Hue.AI" Color="#A59BDD" />
      <SolidColorBrush x:Key="St.Hue.Mobile" Color="#84BDB2" />
      <SolidColorBrush x:Key="St.Hue.Privacy" Color="#9CC49B" />
      <SolidColorBrush x:Key="St.Hue.About" Color="#CDAE70" />
      <SolidColorBrush x:Key="St.DangerBorder" Color="#4DF06060" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="St.Hue.Profile" Color="#A4583A" />
      <SolidColorBrush x:Key="St.Hue.Memories" Color="#98506F" />
      <SolidColorBrush x:Key="St.Hue.General" Color="#4E5B73" />
      <SolidColorBrush x:Key="St.Hue.Appearance" Color="#7B4A9C" />
      <SolidColorBrush x:Key="St.Hue.Chat" Color="#2F6EA3" />
      <SolidColorBrush x:Key="St.Hue.Permissions" Color="#A1531F" />
      <SolidColorBrush x:Key="St.Hue.AI" Color="#5E50B5" />
      <SolidColorBrush x:Key="St.Hue.Mobile" Color="#33786D" />
      <SolidColorBrush x:Key="St.Hue.Privacy" Color="#3F7A3E" />
      <SolidColorBrush x:Key="St.Hue.About" Color="#8F6A22" />
      <SolidColorBrush x:Key="St.DangerBorder" Color="#40BA1A1A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

