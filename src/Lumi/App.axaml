<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:conv="using:Lumi.Converters"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.App"
             Name="Lumi"
             RequestedThemeVariant="Dark">

  <!-- Transcript tool cards live at application scope because the same tool call is rendered in two
       places: the main chat transcript and the read-only sub-agent run island (a sibling of the chat
       view, so it cannot reach ChatView's local templates). Keeping one definition here guarantees a
       sub-agent's steps look exactly like Lumi's own. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TerminalPreviewItem">
      <sc:StrataTerminalPreview ToolName="{Binding ToolName}"
                                Command="{Binding Command}"
                                Output="{Binding Output}"
                                Status="{Binding Status}"
                                IsRunningInBackground="{Binding IsRunningInBackground}"
                                RunningSince="{Binding RunningSince}"
                                DurationMs="{Binding DurationMs}"
                                IsExpanded="{Binding IsExpanded}" />
    </DataTemplate>

    <!-- A plan lists its steps: done, being worked on, failed, blocked, or still to come. -->
    <DataTemplate DataType="vm:TodoProgressItem">
      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,2" />
    </DataTemplate>

    <!-- One step of a plan, in its card and in the live card at a glance. -->
    <DataTemplate DataType="vm:PlanStepItem">
      <DockPanel Classes="plan-step"
                 Classes.done="{Binding IsDone}"
                 Classes.current="{Binding IsCurrent}"
                 Classes.failed="{Binding IsFailed}"
                 Classes.blocked="{Binding IsBlocked}">
        <Panel DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
          <Border Classes="plan-ring" />
          <sc:StrataLineIcon Classes="plan-done" Data="{x:Static sc:StrataIcons.Check}" />
          <sc:StrataLineIcon Classes="plan-failed" Data="{x:Static sc:StrataIcons.Cross}" />
          <sc:StrataLineIcon Classes="plan-blocked" Data="{x:Static sc:StrataIcons.Clock}" />
        </Panel>
        <TextBlock Classes="plan-title" Text="{Binding Title}" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:ToolCallItem">
      <sc:StrataAiToolCall ToolName="{Binding ToolName}"
                           Icon="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}"
                           Detail="{Binding LiveDetail}"
                           Classes.compact="{Binding IsCompact}"
                           Status="{Binding Status}"
                           IsExpanded="{Binding IsExpanded}"
                           InputParameters="{Binding InputParameters}"
                           Progress="{Binding ProgressText}"
                           MoreInfo="{Binding ResultText}"
                           DurationMs="{Binding DurationMs}"
                           RunningSince="{Binding RunningSince}">
        <sc:StrataAiToolCall.HeaderAction>
          <Button Classes="transcript-diff" Command="{Binding ShowDiffCommand}"
                  IsVisible="{Binding HasDiff}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <sc:StrataLineIcon Width="12" Height="12" VerticalAlignment="Center"
                                 Data="{x:Static sc:StrataIcons.Diff}" />
              <TextBlock Text="{loc:Str ShowDiff}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </sc:StrataAiToolCall.HeaderAction>
      </sc:StrataAiToolCall>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <x:Double x:Key="Lumi.UiScale">1</x:Double>
      <!-- Lumi-local override of Strata's glass-surface token. The presence field sits BEHIND the
           translucent islands, so the island fill is the only readability substrate between the chat
           text and whatever is on the desktop behind the (transparent) window. Strata's stock opacity
           is tuned for benign backdrops; over a bright/busy backdrop (white docs etc.) it lets too much
           through and text gets hard to read. We firm the islands up here (less transparency) — and the
           presence light is boosted in PresenceController to keep blooming through the thicker glass.
           Dark is Lumi's default; HighContrast intentionally falls through to Strata's already-solid value. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{DynamicResource Color.Surface1}" Opacity="0.72" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{DynamicResource Color.Surface1}" Opacity="0.78" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
    <StyleInclude Source="avares://StrataTheme/StrataTheme.axaml" />

    <!-- Hide the fullscreen button from drawn window decorations (added by Simple theme) -->
    <Style Selector="Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Make drawn decorations fully transparent so acrylic/mica blur shows through -->
    <Style Selector="WindowDrawnDecorations">
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="DefaultFrameThickness" Value="0" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Border#PART_WindowBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── Transcript work, shared by the chat and the read-only agent run ── -->
    <Style Selector="sc|StrataChatMessage">
      <Setter Property="CopyLabel" Value="{loc:Str Chat_CopyMessage}" />
      <Setter Property="CopyAsLabel" Value="{loc:Str Chat_CopyAs}" />
      <Setter Property="CopyPlainTextLabel" Value="{loc:Str Chat_CopyPlainText}" />
      <Setter Property="CopyMarkdownLabel" Value="{loc:Str Chat_CopyMarkdown}" />
      <Setter Property="CopyRichTextLabel" Value="{loc:Str Chat_CopyRichText}" />
      <Setter Property="SelectAllLabel" Value="{loc:Str Chat_SelectMessage}" />
      <Setter Property="CopiedLabel" Value="{loc:Str Chat_Copied}" />
      <Setter Property="MoreActionsLabel" Value="{loc:Str Chat_MoreMessageActions}" />
    </Style>

    <!-- Reads and searches sit a little tighter, so a long run of them stays compact. -->
    <Style Selector="sc|StrataAiToolCall.compact /template/ Border#PART_Header">
      <Setter Property="Padding" Value="7,4,8,4" />
    </Style>

    <!-- "Show diff": an accent action beside the step, tinted on hover. Its negative vertical margin
         keeps a row with the action as tall as one without. -->
    <Style Selector="Button.transcript-diff">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,-3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.transcript-diff /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.transcript-diff:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassAccentTint}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.transcript-diff:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
    </Style>
    <!-- Strata styles every TextBlock as body text, so the label takes the action's size and colour here. -->
    <Style Selector="Button.transcript-diff TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button.transcript-diff:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
    </Style>

    <!-- A plan's steps: a check when done, a ring while open (the accent on the current one), a clock
         while blocked. They share a tool row's height and text column, so a plan reads as part of the
         card's list. -->
    <Style Selector="DockPanel.plan-step">
      <Setter Property="Height" Value="31" />
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="DockPanel.plan-step Border.plan-ring">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextDisabled}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DockPanel.plan-step sc|StrataLineIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DockPanel.plan-step TextBlock.plan-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="DockPanel.plan-step.done Border.plan-ring, DockPanel.plan-step.failed Border.plan-ring, DockPanel.plan-step.blocked Border.plan-ring">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DockPanel.plan-step.done sc|StrataLineIcon.plan-done">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="DockPanel.plan-step.done TextBlock.plan-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="DockPanel.plan-step.current Border.plan-ring">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="DockPanel.plan-step.current TextBlock.plan-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="DockPanel.plan-step.failed sc|StrataLineIcon.plan-failed">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="DockPanel.plan-step.blocked sc|StrataLineIcon.plan-blocked">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
  </Application.Styles>

</Application>
