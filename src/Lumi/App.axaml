<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:models="using:Lumi.Models"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:conv="using:Lumi.Converters"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.App"
             Name="Lumi"
             RequestedThemeVariant="Dark">

  <!-- Transcript tool cards live at application scope because the same tool call is rendered in two
       places: the main chat transcript and the read-only sub-agent run island (a sibling of the chat
       view, so it cannot reach ChatView's local templates). Keeping one definition here guarantees a
       sub-agent's steps look exactly like Lumi's own. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TerminalPreviewItem">
      <sc:StrataTerminalPreview ToolName="{Binding ToolName}"
                                Command="{Binding Command}"
                                Output="{Binding Output}"
                                Status="{Binding Status}"
                                IsRunningInBackground="{Binding IsRunningInBackground}"
                                RunningSince="{Binding RunningSince}"
                                DurationMs="{Binding DurationMs}"
                                IsExpanded="{Binding IsExpanded}" />
    </DataTemplate>

    <!-- A plan lists its steps: done, being worked on, failed, blocked, or still to come. -->
    <DataTemplate DataType="vm:TodoProgressItem">
      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,2" />
    </DataTemplate>

    <!-- One step of a plan, in its card and in the live card at a glance. -->
    <DataTemplate DataType="vm:PlanStepItem">
      <DockPanel x:Name="PlanStep" Classes="plan-step"
                 Classes.done="{Binding IsDone}"
                 Classes.current="{Binding IsCurrent}"
                 Classes.failed="{Binding IsFailed}"
                 Classes.blocked="{Binding IsBlocked}">
        <Panel DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
          <Border Classes="plan-ring" />
          <sc:StrataLineIcon Classes="plan-done" Data="{x:Static sc:StrataIcons.Check}" />
          <sc:StrataLineIcon Classes="plan-failed" Data="{x:Static sc:StrataIcons.Cross}" />
          <sc:StrataLineIcon Classes="plan-blocked" Data="{x:Static sc:StrataIcons.Clock}" />
        </Panel>
        <TextBlock Classes="plan-title" Text="{Binding Title}" />
      </DockPanel>
    </DataTemplate>

    <!-- An image step: the row every step has, then the images it created, under the row's details.
         Before ToolCallItem's template, which would otherwise match it too. -->
    <DataTemplate DataType="vm:ImageGenerationToolItem">
      <StackPanel>
        <sc:StrataAiToolCall ToolName="{Binding ToolName}"
                             Icon="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}"
                             Detail="{Binding LiveDetail}"
                             Status="{Binding Status}"
                             IsExpanded="{Binding IsExpanded}"
                             InputParameters="{Binding InputParameters}"
                             Progress="{Binding ProgressText}"
                             MoreInfo="{Binding ResultText}"
                             DurationMs="{Binding DurationMs}"
                             RunningSince="{Binding RunningSince}" />
        <ItemsControl x:Name="GeneratedImages" Classes="generated-images" ItemsSource="{Binding Images}"
                      IsVisible="{Binding HasImages}" Margin="29,2,8,8" />
      </StackPanel>
    </DataTemplate>

    <!-- A created image: its thumbnail opens it; its menu opens, reveals or copies the file. -->
    <DataTemplate DataType="vm:GeneratedImageItem">
      <Button x:Name="GeneratedImage" Classes="generated-image" Command="{Binding PreviewCommand}"
              AutomationProperties.Name="{Binding FileName}">
        <Button.ContextFlyout>
          <MenuFlyout>
            <MenuItem Header="{loc:Str FileMenu_Open}" Command="{Binding OpenCommand}" />
            <MenuItem Header="{loc:Str FileMenu_ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
            <MenuItem Header="{loc:Str FileMenu_Copy}" Command="{Binding CopyCommand}" />
          </MenuFlyout>
        </Button.ContextFlyout>
        <Panel Classes="generated-image-frame">
          <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
          <sc:StrataLineIcon Classes="generated-image-missing" Data="{x:Static sc:StrataIcons.Image}"
                             IsVisible="{Binding IsMissing}" />
        </Panel>
      </Button>
    </DataTemplate>

    <DataTemplate DataType="vm:ToolCallItem">
      <sc:StrataAiToolCall ToolName="{Binding ToolName}"
                           Icon="{Binding IconKey, Converter={x:Static conv:TranscriptIconConverter.Instance}}"
                           Detail="{Binding LiveDetail}"
                           Classes.compact="{Binding IsCompact}"
                           Status="{Binding Status}"
                           HeaderCommand="{Binding HeaderCommand}"
                           IsExpanded="{Binding IsExpanded}"
                           InputParameters="{Binding InputParameters}"
                           Progress="{Binding ProgressText}"
                           MoreInfo="{Binding ResultText}"
                           DurationMs="{Binding DurationMs}"
                           RunningSince="{Binding RunningSince}">
        <sc:StrataAiToolCall.HeaderAction>
          <Button x:Name="TranscriptAction" Classes="transcript-diff" Command="{Binding ShowDiffCommand}"
                  IsVisible="{Binding HasDiff}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <sc:StrataLineIcon Width="12" Height="12" VerticalAlignment="Center"
                                 Data="{x:Static sc:StrataIcons.Diff}" />
              <TextBlock Text="{loc:Str ShowDiff}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </sc:StrataAiToolCall.HeaderAction>
      </sc:StrataAiToolCall>
    </DataTemplate>

    <!-- A folder in a sandbox's list, with what its commands may do there. Settings → Permissions and a
         project's page both show these, and both bring the management styles the row wears. -->
    <DataTemplate DataType="vm:SandboxFolderRow">
      <Border Classes="mg-inset" Padding="12,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="mg-icon-button subtle" Width="26" Height="26" Margin="8,0,0,0"
                  Command="{Binding RemoveCommand}" AutomationProperties.Name="{loc:Str Projects_RemoveFromList}">
            <sc:StrataLineIcon Width="11" Height="11" StrokeThickness="1.9" Data="{x:Static sc:StrataIcons.Cross}"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
          </Button>
          <Border DockPanel.Dock="Right" Classes="mg-segmented" VerticalAlignment="Center" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="mg-segment" Classes.selected="{Binding IsReadWrite}"
                      Command="{Binding SetAccessCommand}" CommandParameter="{x:Static models:SandboxFolderAccess.ReadWrite}">
                <TextBlock Text="{loc:Str Sandbox_ReadWrite}" />
              </Button>
              <Button Classes="mg-segment" Classes.selected="{Binding IsReadOnly}"
                      Command="{Binding SetAccessCommand}" CommandParameter="{x:Static models:SandboxFolderAccess.ReadOnly}">
                <TextBlock Text="{loc:Str Sandbox_ReadOnly}" />
              </Button>
              <Button Classes="mg-segment" Classes.selected="{Binding IsBlocked}"
                      Command="{Binding SetAccessCommand}" CommandParameter="{x:Static models:SandboxFolderAccess.Blocked}"
                      IsVisible="{Binding CanBlock}">
                <TextBlock Text="{loc:Str Sandbox_Blocked}" />
              </Button>
            </StackPanel>
          </Border>
          <sc:StrataLineIcon DockPanel.Dock="Left" Width="15" Height="15" StrokeThickness="1.7" Margin="0,0,11,0"
                             VerticalAlignment="Center" Data="{x:Static sc:StrataIcons.Folder}"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                       Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="mg-meta mg-mono" Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <x:Double x:Key="Lumi.UiScale">1</x:Double>
      <!-- Chat menus are shared by the main window and separate chat windows. -->
      <StreamGeometry x:Key="Icon.Folder">M2 6a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Gear">M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915z M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Window">M9 3.5h7.5a2 2 0 0 1 2 2V11a2 2 0 0 1-2 2H15v-1.6h1.5a.4.4 0 0 0 .4-.4V5.5a.4.4 0 0 0-.4-.4H9a.4.4 0 0 0-.4.4V7H7V5.5a2 2 0 0 1 2-2zM5.5 7h8a2 2 0 0 1 2 2v4.5a2 2 0 0 1-2 2h-2.1l-2.78 2.08c-.43.32-1.04.01-1.04-.52V15.5H5.5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2zM5.5 8.6a.4.4 0 0 0-.4.4v4.5c0 .22.18.4.4.4h2.88c.44 0 .8.36.8.8v.82l1.38-1.04c.28-.21.62-.32.97-.32h1.97c.22 0 .4-.18.4-.4V9a.4.4 0 0 0-.4-.4h-8z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Trash">M9 3h6a1 1 0 0 1 1 1H7a1 1 0 0 1 1-1zM4 6h16v1H4V6zm2 2h12l-1 13H7L6 8zm4 2v8h1v-8h-1zm3 0v8h1v-8h-1z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Rename">M4 18h4l10-10a2 2 0 0 0 0-2.83l-1.17-1.17a2 2 0 0 0-2.83 0L4 14v4zm2-3.17L14.59 6.24l1.17 1.17L7.17 16H6v-1.17z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Browse">M4 4h4v4H4V4zm6 0h4v4h-4V4zm6 0h4v4h-4V4zM4 10h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4zM4 16h4v4H4v-4zm6 0h4v4h-4v-4zm6 0h4v4h-4v-4z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Tag">M4 3h7.2a2 2 0 0 1 1.42.59l7.79 7.79a2 2 0 0 1 0 2.83l-6.2 6.2a2 2 0 0 1-2.83 0L3.59 12.62A2 2 0 0 1 3 11.2V4a1 1 0 0 1 1-1zm3.25 3a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Pin">M10.0589 2.44535C9.34701 1.73087 8.14697 1.90854 7.67261 2.79864L5.6526 6.58902L2.8419 7.52592C2.6775 7.58072 2.5532 7.71673 2.51339 7.88539C2.47357 8.05404 2.52392 8.23128 2.64646 8.35382L4.79291 10.5003L2.14645 13.1467L2 14.0003L2.85356 13.8538L5.50002 11.2074L7.64646 13.3538C7.76899 13.4764 7.94623 13.5267 8.11489 13.4869C8.28354 13.4471 8.41955 13.3228 8.47435 13.1584L9.41143 10.3472L13.1897 8.32448C14.0759 7.85006 14.2538 6.65535 13.5443 5.9433L10.0589 2.44535ZM8.55511 3.26895C8.71323 2.97225 9.11324 2.91303 9.35055 3.15119L12.836 6.64914C13.0725 6.88648 13.0131 7.28472 12.7178 7.44286L8.76403 9.55946C8.65137 9.61977 8.56608 9.72092 8.52567 9.84215L7.7815 12.0746L3.92562 8.21877L6.15812 7.47461C6.27966 7.43409 6.38101 7.34848 6.44126 7.23542L8.55511 3.26895Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.PinOff">M9.56016 10.2673L14.1464 14.8536C14.3417 15.0488 14.6583 15.0488 14.8536 14.8536C15.0488 14.6583 15.0488 14.3417 14.8536 14.1464L1.85355 1.14645C1.65829 0.951184 1.34171 0.951184 1.14645 1.14645C0.951184 1.34171 0.951184 1.65829 1.14645 1.85355L5.73223 6.43934L5.6526 6.58876L2.8419 7.52566C2.6775 7.58046 2.5532 7.71648 2.51339 7.88513C2.47357 8.05378 2.52392 8.23102 2.64646 8.35356L4.79291 10.5L2.14645 13.1465L2 14L2.85356 13.8536L5.50002 11.2071L7.64646 13.3536C7.76899 13.4761 7.94623 13.5264 8.11489 13.4866C8.28354 13.4468 8.41955 13.3225 8.47435 13.1581L9.41143 10.3469L9.56016 10.2673ZM8.82138 9.52849L8.76403 9.5592C8.65137 9.61951 8.56608 9.72066 8.52567 9.84189L7.7815 12.0744L3.92562 8.21851L6.15812 7.47435C6.27966 7.43383 6.38101 7.34822 6.44126 7.23516L6.47143 7.17854L8.82138 9.52849ZM12.7178 7.4426L10.6636 8.54227L11.4024 9.28105L13.1897 8.32422C14.0759 7.84981 14.2538 6.65509 13.5443 5.94304L10.0589 2.44509C9.34701 1.73062 8.14697 1.90828 7.67261 2.79838L6.71556 4.59421L7.45476 5.33341L8.55511 3.26869C8.71323 2.97199 9.11324 2.91277 9.35055 3.15093L12.836 6.64888C13.0725 6.88623 13.0131 7.28446 12.7178 7.4426Z</StreamGeometry>
      <!-- Lumi-local override of Strata's glass-surface token. The presence field sits BEHIND the
           translucent islands, so the island fill is the only readability substrate between the chat
           text and whatever is on the desktop behind the (transparent) window. Strata's stock opacity
           is tuned for benign backdrops; over a bright/busy backdrop (white docs etc.) it lets too much
           through and text gets hard to read. We firm the islands up here (less transparency) — and the
           presence light is boosted in PresenceController to keep blooming through the thicker glass.
           Dark is Lumi's default; HighContrast intentionally falls through to Strata's already-solid value. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{DynamicResource Color.Surface1}" Opacity="0.72" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{DynamicResource Color.Surface1}" Opacity="0.78" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
    <StyleInclude Source="avares://StrataTheme/StrataTheme.axaml" />

    <!-- Hide the fullscreen button from drawn window decorations (added by Simple theme) -->
    <Style Selector="Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Make drawn decorations fully transparent so acrylic/mica blur shows through -->
    <Style Selector="WindowDrawnDecorations">
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="DefaultFrameThickness" Value="0" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Border#PART_WindowBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ── Transcript work, shared by the chat and the read-only agent run ── -->
    <!-- Reads and searches sit a little tighter, so a long run of them stays compact. -->
    <Style Selector="sc|StrataAiToolCall.compact /template/ Border#PART_Header">
      <Setter Property="Padding" Value="7,4,8,4" />
    </Style>

    <!-- "Show diff": an accent action beside the step, tinted on hover. Its negative vertical margin
         keeps a row with the action as tall as one without. -->
    <Style Selector="Button#TranscriptAction.transcript-diff">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,-3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button#TranscriptAction.transcript-diff /template/ Border#PART_Aurora">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button#TranscriptAction.transcript-diff:pointerover /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassAccentTint}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button#TranscriptAction.transcript-diff:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
    </Style>
    <!-- Strata styles every TextBlock as body text, so the label takes the action's size and colour here. -->
    <Style Selector="Button#TranscriptAction.transcript-diff TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button#TranscriptAction.transcript-diff:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
    </Style>

    <!-- Images a step created: rounded thumbnails in a row that wraps, each opening its image. -->
    <Style Selector="ItemsControl#GeneratedImages.generated-images">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="8" LineSpacing="8" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="Button#GeneratedImage.generated-image">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Brush.GlassWell}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassDivider}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button#GeneratedImage.generated-image:pointerover /template/ Border#PART_Surface">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="Button#GeneratedImage.generated-image Panel.generated-image-frame">
      <Setter Property="Height" Value="148" />
      <Setter Property="MinWidth" Value="148" />
      <Setter Property="MaxWidth" Value="264" />
    </Style>
    <Style Selector="Button#GeneratedImage.generated-image sc|StrataLineIcon.generated-image-missing">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- A plan's steps: a check when done, a ring while open (the accent on the current one), a clock
         while blocked. They share a tool row's height and text column, so a plan reads as part of the
         card's list. -->
    <Style Selector="DockPanel#PlanStep.plan-step">
      <Setter Property="Height" Value="31" />
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step Border.plan-ring">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextDisabled}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step sc|StrataLineIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step TextBlock.plan-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.done Border.plan-ring, DockPanel#PlanStep.plan-step.failed Border.plan-ring, DockPanel#PlanStep.plan-step.blocked Border.plan-ring">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.done sc|StrataLineIcon.plan-done">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.done TextBlock.plan-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.current Border.plan-ring">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.current TextBlock.plan-title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.failed sc|StrataLineIcon.plan-failed">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    </Style>
    <Style Selector="DockPanel#PlanStep.plan-step.blocked sc|StrataLineIcon.plan-blocked">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
  </Application.Styles>

</Application>
