<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:vm="using:Lumi.ViewModels"
             xmlns:sc="using:StrataTheme.Controls"
             xmlns:loc="using:Lumi.Localization"
             x:Class="Lumi.App"
             Name="Lumi"
             RequestedThemeVariant="Dark">

  <!-- Transcript tool cards live at application scope because the same tool call is rendered in two
       places: the main chat transcript and the read-only sub-agent run island (a sibling of the chat
       view, so it cannot reach ChatView's local templates). Keeping one definition here guarantees a
       sub-agent's steps look exactly like Lumi's own. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TerminalPreviewItem">
      <sc:StrataTerminalPreview ToolName="{Binding ToolName}"
                                Command="{Binding Command}"
                                Output="{Binding Output}"
                                Status="{Binding Status}"
                                IsRunningInBackground="{Binding IsRunningInBackground}"
                                RunningSince="{Binding RunningSince}"
                                DurationMs="{Binding DurationMs}"
                                IsExpanded="{Binding IsExpanded}" />
    </DataTemplate>

    <DataTemplate DataType="vm:TodoProgressItem">
      <sc:StrataAiToolCall ToolName="{Binding ToolName}"
                           Status="{Binding Status}"
                           IsExpanded="{Binding IsExpanded}"
                           InputParameters="{Binding InputParameters}"
                           MoreInfo="{Binding MoreInfo}" />
    </DataTemplate>

    <DataTemplate DataType="vm:ToolCallItem">
      <sc:StrataAiToolCall ToolName="{Binding ToolName}"
                           Classes.compact="{Binding IsCompact}"
                           Status="{Binding Status}"
                           IsExpanded="{Binding IsExpanded}"
                           InputParameters="{Binding InputParameters}"
                           MoreInfo="{Binding MoreInfo}"
                           DurationMs="{Binding DurationMs}"
                           RunningSince="{Binding RunningSince}">
        <sc:StrataAiToolCall.HeaderAction>
          <Button Classes="subtle" Command="{Binding ShowDiffCommand}"
                  IsVisible="{Binding HasDiff}"
                  Padding="5,0" MinHeight="0" Height="18"
                  Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <OnPlatform>
                <On Options="macOS, Linux">
                  <PathIcon Data="M4 4h6v16H4z M14 4h6v16h-6z" Width="9" Height="9"
                            VerticalAlignment="Center" />
                </On>
                <On Options="Default">
                  <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="9" VerticalAlignment="Center" />
                </On>
              </OnPlatform>
              <TextBlock Text="{loc:Str ShowDiff}" FontSize="9" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </sc:StrataAiToolCall.HeaderAction>
      </sc:StrataAiToolCall>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <x:Double x:Key="Lumi.UiScale">1</x:Double>
      <!-- Lumi-local override of Strata's glass-surface token. The presence field sits BEHIND the
           translucent islands, so the island fill is the only readability substrate between the chat
           text and whatever is on the desktop behind the (transparent) window. Strata's stock opacity
           is tuned for benign backdrops; over a bright/busy backdrop (white docs etc.) it lets too much
           through and text gets hard to read. We firm the islands up here (less transparency) — and the
           presence light is boosted in PresenceController to keep blooming through the thicker glass.
           Dark is Lumi's default; HighContrast intentionally falls through to Strata's already-solid value. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{DynamicResource Color.Surface1}" Opacity="0.72" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Brush.Surface1Glass" Color="{DynamicResource Color.Surface1}" Opacity="0.78" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
    <StyleInclude Source="avares://StrataTheme/StrataTheme.axaml" />

    <!-- Hide the fullscreen button from drawn window decorations (added by Simple theme) -->
    <Style Selector="Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Make drawn decorations fully transparent so acrylic/mica blur shows through -->
    <Style Selector="WindowDrawnDecorations">
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="DefaultFrameThickness" Value="0" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Border#PART_WindowBorder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>

</Application>
