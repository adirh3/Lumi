# Auto detect text files and perform LF normalization
* text=auto

# C# / .NET
*.cs text diff=csharp
*.csproj text
*.slnx text
*.axaml text
*.xaml text
*.json text
*.md text
*.txt text
*.xml text

# Binary
*.nupkg binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text

# Keep checksum-pinned vendor build inputs byte-for-byte identical on every platform.
vendor/avalonia/12.1.2.2/** -text -whitespace
vendor/avalonia/12.1.3.1/** -text -whitespace
