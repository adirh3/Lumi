<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>$(Features);runtime-async=on</Features>
    <!-- Receive Lumi's verified full CLI through the project reference, not the SDK bundle. -->
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <!-- Match Lumi's platform-conditional TFM -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Strata\src\StrataSearch\StrataSearch.csproj" />
    <ProjectReference Include="..\..\src\Lumi\Lumi.csproj" />
    <ProjectReference Include="..\..\src\Lumi.Mcp\Lumi.Mcp.csproj" />
    <!-- The phone client, so the remote protocol can be exercised end to end against the real server. -->
    <ProjectReference Include="..\..\src\Lumi.Mobile\Lumi.Mobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\build\AcquireFullCopilotCli.cs" Link="Packaging\AcquireFullCopilotCli.cs" />
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildToolsPath)\Microsoft.Build.Framework.dll" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildToolsPath)\Microsoft.Build.Utilities.Core.dll" />
    <Content Include="..\..\build\CopilotCliPins.props"
             Link="Packaging\CopilotCliPins.props"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Lumi.Mobile.Browser\wwwroot\index.html"
             Link="BrowserAssets\index.html"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Lumi.Mobile.Browser\wwwroot\manifest.webmanifest"
             Link="BrowserAssets\manifest.webmanifest"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Lumi.Mobile.Browser\wwwroot\icons\*.png"
             Link="BrowserAssets\icons\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Lumi.Mobile.Android\Resources\mipmap-xxxhdpi\ic_launcher.png"
             Link="BrowserAssets\android-launcher.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
