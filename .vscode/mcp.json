{
  "servers": {
    "avalonia-mcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["avalonia-mcp"]
    },
    "lumi-mcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
