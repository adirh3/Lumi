<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="lumi-vendored" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="lumi-vendored">
      <package pattern="Avalonia.Native" />
    </packageSource>
  </packageSourceMapping>
</configuration>
